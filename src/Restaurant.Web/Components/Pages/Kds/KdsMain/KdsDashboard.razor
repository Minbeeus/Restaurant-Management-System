@page "/kds"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.KdsLayout
@using Restaurant.Web.Components.UI.Cards
@using Restaurant.Web.Components.UI.Buttons
@using Restaurant.Application.DTOs
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable

<div class="flex flex-col h-full bg-slate-900 text-slate-100">
    <!-- Header -->
    <header class="h-16 flex items-center justify-between px-6 bg-slate-800 border-b border-slate-700 shrink-0 shadow-sm">
        <div class="flex flex-col justify-center">
            <h1 class="font-headline-sm text-headline-sm font-bold text-white m-0 leading-tight">Màn Hình Bếp (KDS)</h1>
            <span class="text-xs text-slate-400 leading-tight">Cập nhật chế biến thời gian thực</span>
        </div>
        
        <!-- Status Counters -->
        <div class="flex items-center gap-6">
            <div class="flex items-center gap-2 cursor-pointer" @onclick='() => SetFilterStatus("All")'>
                <span class="text-xs text-slate-400 font-label-bold uppercase">Tất cả:</span>
                <span class="bg-slate-700 text-slate-200 px-3 py-1 rounded-full font-bold text-sm">@ActiveTickets.Count</span>
            </div>
            <div class="flex items-center gap-2 cursor-pointer" @onclick='() => SetFilterStatus("Pending")'>
                <span class="text-xs text-slate-400 font-label-bold uppercase">Chờ làm:</span>
                <span class="bg-amber-900/40 text-amber-500 px-3 py-1 rounded-full font-bold text-sm">@PendingCount</span>
            </div>
            <div class="flex items-center gap-2 cursor-pointer" @onclick='() => SetFilterStatus("Processing")'>
                <span class="text-xs text-slate-400 font-label-bold uppercase">Đang làm:</span>
                <span class="bg-emerald-900/40 text-emerald-400 px-3 py-1 rounded-full font-bold text-sm">@ProcessingCount</span>
            </div>
        </div>

        <!-- Station and View Filters -->
        <div class="flex items-center gap-3">
            <select class="bg-slate-700 text-slate-200 text-xs px-3 py-2 rounded-lg border border-slate-600 focus:outline-none focus:ring-1 focus:ring-emerald-500 font-medium"
                    @bind="SelectedStationId" @bind:after="OnStationChangedAsync">
                <option value="">-- Tất cả Trạm Bếp --</option>
                <option value="1">Bếp Nóng (Kitchen)</option>
                <option value="2">Quầy Pha Chế (Bar)</option>
                <option value="3">Trạm Chiên/Nướng (Fry/Grill)</option>
            </select>

            <button class="px-4 py-2 text-slate-200 hover:bg-slate-700 rounded-lg transition-colors font-label-bold flex items-center gap-2 text-sm border border-slate-600"
                    @onclick="ToggleCompletedViewAsync">
                <span class="material-symbols-outlined text-[20px]">history</span>
                @(ShowCompletedOnly ? "Xem Vé Đang Chờ" : "Xem Vé Đã Xong")
            </button>
        </div>
    </header>

    @if (NewTicketNotification)
    {
        <div class="bg-primary text-on-primary px-6 py-2 flex justify-between items-center animate-bounce shrink-0">
            <div class="flex items-center gap-2 font-bold text-sm">
                <span class="material-symbols-outlined">notifications_active</span>
                CÓ PHIẾU BẾP MỚI ĐƯỢC GỬI XUỐNG!
            </div>
            <button class="text-xs border border-white px-2 py-1 rounded hover:bg-white/20" @onclick="() => NewTicketNotification = false">Đóng</button>
        </div>
    }

    <!-- Main Workspace -->
    <main class="flex-1 overflow-x-auto p-6 bg-slate-900">
        @if (IsLoading)
        {
            <div class="flex items-center justify-center h-full gap-3 text-slate-400">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-emerald-500"></div>
                <span class="font-medium text-sm">Đang tải danh sách phiếu bếp...</span>
            </div>
        }
        else if (!DisplayedTickets.Any())
        {
            <div class="flex flex-col items-center justify-center h-full text-slate-400 py-12">
                <span class="material-symbols-outlined text-4xl mb-2">skillet</span>
                <p class="text-sm font-medium">Hiện không có phiếu bếp nào cần xử lý.</p>
            </div>
        }
        else
        {
            <div class="flex gap-6 h-full items-stretch">
                @foreach (var ticket in DisplayedTickets)
                {
                    <KdsTicketCard 
                        OrderId="@ticket.OrderCode" 
                        TableName="@ticket.TableName" 
                        CreatedAt="@ticket.CreatedAt"
                        OnComplete="() => CompleteAllItemsInTicketAsync(ticket)">
                        <ItemsList>
                            <div class="flex flex-col">
                                @{
                                    var parentGrouped = ticket.Items.Where(i => !i.ParentItemId.HasValue).ToList();
                                    var childrenByParent = ticket.Items.Where(i => i.ParentItemId.HasValue)
                                        .GroupBy(i => i.ParentItemId!.Value)
                                        .ToDictionary(g => g.Key, g => g.ToList());
                                    var processedChildrenIds = childrenByParent.Values.SelectMany(x => x).Select(x => x.OrderItemId).ToHashSet();
                                    var orphanChildren = ticket.Items.Where(i => i.ParentItemId.HasValue && !processedChildrenIds.Contains(i.OrderItemId)).ToList();
                                }

                                @foreach (var topItem in parentGrouped)
                                {
                                    @if (topItem.IsComboHeader)
                                    {
                                        <!-- Combo Header Container -->
                                        <div class="flex flex-col p-3 border-b border-slate-700 bg-slate-800/80 rounded-lg my-1.5 border border-slate-600">
                                            <div class="flex justify-between items-center mb-2 pb-1 border-b border-slate-700">
                                                <div class="flex items-center gap-2">
                                                    <span class="material-symbols-outlined text-amber-400 text-lg">lunch_dining</span>
                                                    <span class="font-bold text-amber-300 text-sm tracking-wide uppercase">@topItem.MenuItemName</span>
                                                    <span class="bg-amber-950/60 text-amber-400 text-xs px-2 py-0.5 rounded font-bold">x@topItem.Quantity</span>
                                                </div>
                                                <span class="text-[11px] font-semibold px-2 py-0.5 rounded @(topItem.KitchenStatus == 2 ? "bg-emerald-950 text-emerald-400" : (topItem.KitchenStatus == 1 ? "bg-amber-950 text-amber-400" : "bg-slate-700 text-slate-300"))">
                                                    @(topItem.KitchenStatus == 2 ? "Đã Xong Hết" : (topItem.KitchenStatus == 1 ? "Đang Làm" : "Chờ Làm"))
                                                </span>
                                            </div>

                                            <!-- Children Inside Combo -->
                                            <div class="space-y-2 pl-2">
                                                @if (childrenByParent.TryGetValue(topItem.OrderItemId, out var comboChildren))
                                                {
                                                    @foreach (var child in comboChildren)
                                                    {
                                                        <div class="flex flex-col p-2.5 rounded bg-slate-900/90 border border-slate-700/80 @(child.KitchenStatus == 2 ? "opacity-50" : "") @(child.Status == 1 ? "border-rose-700/60 bg-rose-950/20" : "")">
                                                            <div class="flex gap-3">
                                                                <div class="font-bold text-white bg-slate-700 px-2 py-0.5 rounded text-xs h-fit shrink-0">@child.Quantity x</div>
                                                                <div class="flex flex-col flex-1">
                                                                    <div class="font-bold text-slate-200 text-sm flex items-center justify-between">
                                                                        <span>
                                                                            @child.MenuItemName
                                                                            @if (!string.IsNullOrEmpty(child.KitchenStationName))
                                                                            {
                                                                                <span class="text-[10px] text-cyan-400 bg-cyan-950/60 px-1.5 py-0.5 rounded ml-1 font-normal">@child.KitchenStationName</span>
                                                                            }
                                                                        </span>
                                                                        <span class="text-[11px] text-slate-400">(@child.KitchenStatusName)</span>
                                                                    </div>
                                                                    @if (child.Status == 1)
                                                                    {
                                                                        <div class="text-rose-400 font-bold text-xs mt-1 flex items-center gap-1">
                                                                            <span class="material-symbols-outlined text-[14px]">cancel</span>
                                                                            MÓN ĐÃ ĐƯỢC HỦY TỪ POS!
                                                                        </div>
                                                                    }
                                                                    @if (child.Modifiers != null && child.Modifiers.Any())
                                                                    {
                                                                        <div class="text-xs text-slate-300 mt-1 font-medium bg-slate-800 p-1 rounded">
                                                                            + @string.Join(", ", child.Modifiers)
                                                                        </div>
                                                                    }
                                                                    @if (!string.IsNullOrEmpty(child.Note))
                                                                    {
                                                                        <div class="text-rose-400 text-xs mt-1 flex items-start gap-1 font-medium bg-rose-900/30 p-1.5 rounded border border-rose-800">
                                                                            <span class="material-symbols-outlined text-[14px]">warning</span>
                                                                            @child.Note
                                                                        </div>
                                                                    }
                                                                </div>
                                                            </div>
                                                            <div class="flex gap-2 justify-end mt-2">
                                                                @if (child.Status == 1)
                                                                {
                                                                    <span class="text-rose-400 text-xs italic font-bold">Đã hủy bỏ</span>
                                                                }
                                                                else if (child.KitchenStatus == 0) // Pending
                                                                {
                                                                    <AppButton Variant="Outline" Disabled="ProcessingItems.Contains(child.OrderItemId)" OnClick="() => UpdateItemStatusAsync(child.OrderItemId, 1)">Nhận Làm</AppButton>
                                                                }
                                                                else if (child.KitchenStatus == 1) // Processing
                                                                {
                                                                    <AppButton Variant="Primary" Disabled="ProcessingItems.Contains(child.OrderItemId)" OnClick="() => UpdateItemStatusAsync(child.OrderItemId, 2)">Xong</AppButton>
                                                                }
                                                                else if (child.KitchenStatus == 2)
                                                                {
                                                                    <span class="text-success font-bold text-xs flex items-center gap-1">
                                                                        <span class="material-symbols-outlined text-[14px]">check</span>
                                                                        Đã Xong
                                                                    </span>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <!-- Regular Standalone Item -->
                                        <div class="flex flex-col p-4 border-b border-slate-700 last:border-b-0 @(topItem.KitchenStatus == 2 ? "opacity-50 bg-slate-800" : "") @(topItem.Status == 1 ? "border-rose-700/60 bg-rose-950/20" : "")">
                                            <div class="flex gap-4">
                                                <div class="font-bold text-white bg-slate-700 px-2 py-1 rounded h-fit shrink-0">@topItem.Quantity x</div>
                                                <div class="flex flex-col flex-1">
                                                    <div class="font-bold text-slate-200 text-lg flex items-center justify-between">
                                                        <span>
                                                            @topItem.MenuItemName
                                                            @if (!string.IsNullOrEmpty(topItem.KitchenStationName))
                                                            {
                                                                <span class="text-xs text-cyan-400 bg-cyan-950/60 px-2 py-0.5 rounded ml-2 font-normal">@topItem.KitchenStationName</span>
                                                            }
                                                        </span>
                                                        <span class="text-xs text-slate-400 ml-2">(@topItem.KitchenStatusName)</span>
                                                    </div>
                                                    @if (topItem.Status == 1)
                                                    {
                                                        <div class="text-rose-400 font-bold text-xs mt-1 flex items-center gap-1">
                                                            <span class="material-symbols-outlined text-[14px]">cancel</span>
                                                            MÓN ĐÃ ĐƯỢC HỦY TỪ POS!
                                                        </div>
                                                    }
                                                    @if (topItem.Modifiers != null && topItem.Modifiers.Any())
                                                    {
                                                        <div class="text-xs text-slate-300 mt-1 font-medium bg-slate-700 p-1.5 rounded">
                                                            + @string.Join(", ", topItem.Modifiers)
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(topItem.Note))
                                                    {
                                                        <div class="text-rose-400 text-xs mt-1 flex items-start gap-1 font-medium bg-rose-900/30 p-2 rounded border border-rose-800">
                                                            <span class="material-symbols-outlined text-[14px]">warning</span>
                                                            @topItem.Note
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                            <div class="flex gap-2 justify-end mt-3">
                                                @if (topItem.Status == 1)
                                                {
                                                    <span class="text-rose-400 text-xs italic font-bold">Đã hủy bỏ</span>
                                                }
                                                else if (topItem.KitchenStatus == 0) // Pending
                                                {
                                                    <AppButton Variant="Outline" Disabled="ProcessingItems.Contains(topItem.OrderItemId)" OnClick="() => UpdateItemStatusAsync(topItem.OrderItemId, 1)">Nhận Chế Biến</AppButton>
                                                }
                                                else if (topItem.KitchenStatus == 1) // Processing
                                                {
                                                    <AppButton Variant="Primary" Disabled="ProcessingItems.Contains(topItem.OrderItemId)" OnClick="() => UpdateItemStatusAsync(topItem.OrderItemId, 2)">Hoàn Thành Món</AppButton>
                                                }
                                                else if (topItem.KitchenStatus == 2)
                                                {
                                                    <span class="text-success font-bold text-xs flex items-center gap-1">
                                                        <span class="material-symbols-outlined text-[16px]">check</span>
                                                        Đã Xong
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    }
                                }

                                @if (orphanChildren.Any())
                                {
                                    @foreach (var orphan in orphanChildren)
                                    {
                                        <div class="flex flex-col p-3 border-b border-slate-700 @(orphan.KitchenStatus == 2 ? "opacity-50 bg-slate-800" : "")">
                                            <div class="flex gap-3">
                                                <div class="font-bold text-white bg-slate-700 px-2 py-1 rounded h-fit shrink-0">@orphan.Quantity x</div>
                                                <div class="flex flex-col flex-1">
                                                    <div class="font-bold text-slate-200 text-md">
                                                        @orphan.MenuItemName
                                                        <span class="text-xs text-slate-400 ml-2">(@orphan.KitchenStatusName)</span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="flex gap-2 justify-end mt-2">
                                                @if (orphan.KitchenStatus == 0)
                                                {
                                                    <AppButton Variant="Outline" Disabled="ProcessingItems.Contains(orphan.OrderItemId)" OnClick="() => UpdateItemStatusAsync(orphan.OrderItemId, 1)">Nhận Chế Biến</AppButton>
                                                }
                                                else if (orphan.KitchenStatus == 1)
                                                {
                                                    <AppButton Variant="Primary" Disabled="ProcessingItems.Contains(orphan.OrderItemId)" OnClick="() => UpdateItemStatusAsync(orphan.OrderItemId, 2)">Hoàn Thành Món</AppButton>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </ItemsList>
                    </KdsTicketCard>
                }
            </div>
        }
    </main>
</div>

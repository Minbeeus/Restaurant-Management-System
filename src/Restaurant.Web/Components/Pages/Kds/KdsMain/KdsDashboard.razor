@page "/kds"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.KdsLayout
@using Restaurant.Web.Components.UI.Cards
@using Restaurant.Web.Components.UI.Buttons
@using Restaurant.Application.DTOs
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable

<div class="flex flex-col h-full bg-slate-900 text-slate-100">
    <!-- Header -->
    <header class="h-16 flex items-center justify-between px-6 bg-slate-800 border-b border-slate-700 shrink-0 shadow-sm">
        <div class="flex flex-col justify-center">
            <h1 class="font-headline-sm text-headline-sm font-bold text-white m-0 leading-tight">Màn Hình Bếp (KDS)</h1>
            <span class="text-xs text-slate-400 leading-tight">Cập nhật chế biến thời gian thực</span>
        </div>
        
        <!-- Status Counters -->
        <div class="flex items-center gap-6">
            <div class="flex items-center gap-2 cursor-pointer" @onclick='() => SetFilterStatus("All")'>
                <span class="text-xs text-slate-400 font-label-bold uppercase">Tất cả:</span>
                <span class="bg-slate-700 text-slate-200 px-3 py-1 rounded-full font-bold text-sm">@ActiveTickets.Count</span>
            </div>
            <div class="flex items-center gap-2 cursor-pointer" @onclick='() => SetFilterStatus("Pending")'>
                <span class="text-xs text-slate-400 font-label-bold uppercase">Chờ làm:</span>
                <span class="bg-amber-900/40 text-amber-500 px-3 py-1 rounded-full font-bold text-sm">@PendingCount</span>
            </div>
            <div class="flex items-center gap-2 cursor-pointer" @onclick='() => SetFilterStatus("Processing")'>
                <span class="text-xs text-slate-400 font-label-bold uppercase">Đang làm:</span>
                <span class="bg-emerald-900/40 text-emerald-400 px-3 py-1 rounded-full font-bold text-sm">@ProcessingCount</span>
            </div>
        </div>

        <div class="flex items-center gap-3">
            <button class="px-4 py-2 text-slate-200 hover:bg-slate-700 rounded-lg transition-colors font-label-bold flex items-center gap-2 text-sm border border-slate-600"
                    @onclick="ToggleCompletedViewAsync">
                <span class="material-symbols-outlined text-[20px]">history</span>
                @(ShowCompletedOnly ? "Xem Vé Đang Chờ" : "Xem Vé Đã Xong")
            </button>
        </div>
    </header>

    @if (NewTicketNotification)
    {
        <div class="bg-primary text-on-primary px-6 py-2 flex justify-between items-center animate-bounce shrink-0">
            <div class="flex items-center gap-2 font-bold text-sm">
                <span class="material-symbols-outlined">notifications_active</span>
                CÓ PHIẾU BẾP MỚI ĐƯỢC GỬI XUỐNG!
            </div>
            <button class="text-xs border border-white px-2 py-1 rounded hover:bg-white/20" @onclick="() => NewTicketNotification = false">Đóng</button>
        </div>
    }

    <!-- Main Workspace -->
    <main class="flex-1 overflow-x-auto p-6 bg-slate-900">
        @if (IsLoading)
        {
            <div class="flex items-center justify-center h-full gap-3 text-slate-400">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-emerald-500"></div>
                <span class="font-medium text-sm">Đang tải danh sách phiếu bếp...</span>
            </div>
        }
        else if (!DisplayedTickets.Any())
        {
            <div class="flex flex-col items-center justify-center h-full text-slate-400 py-12">
                <span class="material-symbols-outlined text-4xl mb-2">skillet</span>
                <p class="text-sm font-medium">Hiện không có phiếu bếp nào cần xử lý.</p>
            </div>
        }
        else
        {
            <div class="flex gap-6 h-full items-stretch">
                @foreach (var ticket in DisplayedTickets)
                {
                    <KdsTicketCard 
                        OrderId="@ticket.OrderCode" 
                        TableName="@ticket.TableName" 
                        CreatedAt="@ticket.CreatedAt"
                        OnComplete="() => CompleteAllItemsInTicketAsync(ticket)">
                        <ItemsList>
                            <div class="flex flex-col">
                                @foreach (var item in ticket.Items)
                                {
                                    <div class="flex flex-col p-4 border-b border-slate-700 last:border-b-0 @(item.KitchenStatus == 2 ? "opacity-50 bg-slate-800" : "")">
                                        <div class="flex gap-4">
                                            <div class="font-bold text-white bg-slate-700 px-2 py-1 rounded h-fit shrink-0">@item.Quantity x</div>
                                            <div class="flex flex-col flex-1">
                                                <div class="font-bold text-slate-200 text-lg">
                                                    @item.MenuItemName 
                                                    <span class="text-xs text-slate-400 ml-2">(@item.KitchenStatusName)</span>
                                                </div>
                                                @if (item.Modifiers != null && item.Modifiers.Any())
                                                {
                                                    <div class="text-xs text-slate-300 mt-1 font-medium bg-slate-700 p-1.5 rounded">
                                                        + @string.Join(", ", item.Modifiers)
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(item.Note))
                                                {
                                                    <div class="text-rose-400 text-xs mt-1 flex items-start gap-1 font-medium bg-rose-900/30 p-2 rounded border border-rose-800">
                                                        <span class="material-symbols-outlined text-[14px]">warning</span>
                                                        @item.Note
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        <div class="flex gap-2 justify-end mt-3">
                                            @if (item.KitchenStatus == 0) // Pending
                                            {
                                                <AppButton Variant="Outline" Disabled="ProcessingItems.Contains(item.OrderItemId)" OnClick="() => UpdateItemStatusAsync(item.OrderItemId, 1)">Nhận Chế Biến</AppButton>
                                            }
                                            else if (item.KitchenStatus == 1) // Processing
                                            {
                                                <AppButton Variant="Primary" Disabled="ProcessingItems.Contains(item.OrderItemId)" OnClick="() => UpdateItemStatusAsync(item.OrderItemId, 2)">Hoàn Thành Món</AppButton>
                                            }
                                            else if (item.KitchenStatus == 2)
                                            {
                                                <span class="text-success font-bold text-xs flex items-center gap-1">
                                                    <span class="material-symbols-outlined text-[16px]">check</span>
                                                    Đã Xong
                                                </span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </ItemsList>
                    </KdsTicketCard>
                }
            </div>
        }
    </main>
</div>

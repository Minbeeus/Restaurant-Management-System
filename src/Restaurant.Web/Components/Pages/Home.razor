@page "/"
@using Restaurant.Application.Interfaces
@using Restaurant.Web.Components.Pages.Dashboard.Widgets
@inject IServiceProvider ServiceProvider
@layout Restaurant.Web.Components.Layout.AdminLayout

<PageTitle>Dashboard</PageTitle>

<div class="flex flex-col gap-6 w-full max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex justify-between items-end pb-sm">
        <div>
            <h1 class="font-display-lg text-display-lg text-on-surface tracking-tight">Tổng quan hôm nay</h1>
            <p class="font-body-md text-body-md text-outline mt-1">Ca làm việc: Sáng • 08:00 - 15:00</p>
        </div>
        <button class="bg-primary-container text-on-primary px-4 py-2 rounded shadow-sm hover:bg-surface-tint transition-colors font-label-bold text-sm">
            Tạo đơn mới (POS)
        </button>
    </div>

    <!-- Stat Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <StatCard Title="Doanh thu" Value="@(_todayRevenue.ToString("N0") + "đ")" SubText="+12.5% so với hôm qua" IconName="payments" TrendText="Tăng" TrendColor="text-success-green" IconBgColor="bg-primary-container" IconColor="text-on-primary" />
        
        <StatCard Title="Đơn hàng mới" Value="@_activeOrders.ToString()" SubText="Cần duyệt ngay" SubTextColor="text-warning-amber" IconName="receipt" TrendText="" StatusColor="bg-warning-amber" IconBgColor="bg-warning-bg" IconColor="text-warning-amber" />
        
        <StatCard Title="Bàn đang phục vụ" Value="12/30" SubText="Tỉ lệ lấp đầy 40%" IconName="table_restaurant" TrendText="" IconBgColor="bg-secondary-container" IconColor="text-on-secondary-container" />
        
        <StatCard Title="Nguyên liệu sắp hết" Value="@_lowStockCount.ToString()" SubText="Cần nhập hàng" SubTextColor="text-tomato-container" IconName="inventory_2" TrendText="" StatusColor="@(_lowStockCount > 0 ? "bg-tomato-container" : "")" IconBgColor="bg-error-container" IconColor="text-tomato-container" />
    </div>

    <!-- Main Grid Area -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
        <!-- Left Column (Chart + Top Movers) -->
        <div class="lg:col-span-2 flex flex-col gap-6">
            <SalesChartWidget />
            <TopMoversWidget />
        </div>
        
        <!-- Right Column (Activity Feed) -->
        <div class="lg:col-span-1 h-[800px]">
            <ActivityFeedWidget />
        </div>
    </div>
</div>

@code {
    private int _lowStockCount = 0;
    private int _activeOrders = 12; // fallback to 12 if no service
    private decimal _todayRevenue = 3500000; // default for demo

    [Inject]
    public NavigationManager Navigation { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // Redirect to POS login for now
        Navigation.NavigateTo("/pos/login");
        return;
    }
}

@page "/login"
@layout Restaurant.Web.Components.Layout.EmptyLayout
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="shared-login-container" @onkeydown="HandleKeyDown" tabindex="0" @ref="containerRef">
    <div class="shared-login-card @(IsError ? "shake-animation" : "")">
        <div class="header-section">
            <h2 class="brand-title">🍕 RESTAURANT MANAGEMENT POS & KDS</h2>
            <p class="subtitle">Nhập mã PIN nhân viên để đăng nhập</p>
        </div>
        
        <!-- Display dots for PIN length -->
        <div class="flex items-center justify-center gap-3 my-6">
            @for (int i = 0; i < 6; i++)
            {
                var isFilled = i < pinCode.Length;
                <div class="w-4 h-4 rounded-full border transition-all duration-200 @(isFilled ? "bg-primary-container border-primary-container scale-110 shadow-sm" : "bg-white border-gray-300") @(IsError ? "!bg-red-600 !border-red-600" : "")"></div>
            }
        </div>
        
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="error-text">@ErrorMessage</div>
        }
        else
        {
            <div class="error-placeholder"></div>
        }
        
        <!-- Numpad Grid -->
        <div class="numpad-grid">
            <button type="button" class="numpad-key" @onclick="() => AppendDigit(1)">1</button>
            <button type="button" class="numpad-key" @onclick="() => AppendDigit(2)">2</button>
            <button type="button" class="numpad-key" @onclick="() => AppendDigit(3)">3</button>
            <button type="button" class="numpad-key" @onclick="() => AppendDigit(4)">4</button>
            <button type="button" class="numpad-key" @onclick="() => AppendDigit(5)">5</button>
            <button type="button" class="numpad-key" @onclick="() => AppendDigit(6)">6</button>
            <button type="button" class="numpad-key" @onclick="() => AppendDigit(7)">7</button>
            <button type="button" class="numpad-key" @onclick="() => AppendDigit(8)">8</button>
            <button type="button" class="numpad-key" @onclick="() => AppendDigit(9)">9</button>
            
            <!-- Bottom Row: CLEAR, 0, CONFIRM -->
            <button type="button" class="numpad-key clear-key" @onclick="ClearLast">
                <span class="material-symbols-outlined">backspace</span>
            </button>
            <button type="button" class="numpad-key" @onclick="() => AppendDigit(0)">0</button>
            <button type="button" class="numpad-key confirm-key" @onclick="ConfirmPin" disabled="@(pinCode.Length < 6 || IsLoading)">
                @if (IsLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <span>Vào ca</span>
                }
            </button>
        </div>
    </div>
</div>

<!-- Area Selector Modal (Shown when User has BOTH POS & KDS access) -->
@if (ShowAreaSelector)
{
    <div class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl p-6 max-w-md w-full shadow-2xl border border-gray-100 flex flex-col items-center">
            <div class="w-12 h-12 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center mb-4">
                <span class="material-symbols-outlined text-2xl">apps</span>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-1">CHỌN KHU VỰC LÀM VIỆC</h3>
            <p class="text-sm text-gray-500 mb-6 text-center">Xin chào <strong>@AuthenticatedUserFullName</strong> (@AuthenticatedRoleName)! Vui lòng chọn khu vực bạn muốn truy cập.</p>

            <div class="grid grid-cols-1 gap-3 w-full">
                <button type="button" class="w-full py-4 px-6 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold flex items-center justify-center gap-3 transition-colors shadow-sm" @onclick='() => SelectArea("/pos")'>
                    <span class="material-symbols-outlined text-2xl">point_of_sale</span>
                    <span>Hệ Thống Thu Ngân POS</span>
                </button>
                <button type="button" class="w-full py-4 px-6 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-semibold flex items-center justify-center gap-3 transition-colors shadow-sm" @onclick='() => SelectArea("/kds")'>
                    <span class="material-symbols-outlined text-2xl">soup_kitchen</span>
                    <span>Màn Hình Bếp KDS</span>
                </button>
            </div>
        </div>
    </div>
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap');

    .shared-login-container {
        min-height: 100vh;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #F9F9FF;
        outline: none;
    }

    .shared-login-card {
        width: 100%;
        max-width: 440px;
        background-color: #FFFFFF;
        border-radius: 16px;
        box-shadow: 0px 10px 25px rgba(68, 99, 113, 0.1);
        border: 1px solid #E5E7EB;
        padding: 40px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .header-section {
        margin-bottom: 24px;
        text-align: center;
    }

    .brand-title {
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-size: 20px;
        color: #446371;
        margin: 0;
    }

    .subtitle {
        font-family: 'Montserrat', sans-serif;
        font-size: 13px;
        font-weight: 600;
        color: #6B7280;
        margin-top: 8px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .error-text {
        color: #AD2B19;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 20px;
        height: 20px;
        text-align: center;
    }

    .error-placeholder {
        height: 20px;
        margin-bottom: 20px;
    }

    .numpad-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        width: 100%;
        place-items: center;
    }

    .numpad-key {
        width: 76px;
        height: 76px;
        border-radius: 12px;
        background-color: #EFF3FF;
        color: #121C2A;
        font-family: 'Montserrat', sans-serif;
        font-size: 28px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: all 0.15s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        user-select: none;
    }

    .numpad-key:hover, .numpad-key:active {
        background-color: #DEE9FD;
        transform: scale(0.96);
    }

    .clear-key {
        background-color: #FFDAD6;
        color: #AD2B19;
    }

    .clear-key:hover, .clear-key:active {
        background-color: #FFB4AB;
    }

    .confirm-key {
        background-color: #486500;
        color: #FFFFFF;
        font-size: 16px;
    }

    .confirm-key:hover:not(:disabled), .confirm-key:active:not(:disabled) {
        background-color: #3d5600;
    }

    .confirm-key:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
    }

    @@keyframes shake {
        0%, 100% { transform: translateX(0); }
        20%, 60% { transform: translateX(-6px); }
        40%, 80% { transform: translateX(6px); }
    }

    .shake-animation {
        animation: shake 0.4s ease-in-out;
    }
</style>

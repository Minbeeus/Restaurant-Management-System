@page "/admin/login"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.EmptyLayout
@using Restaurant.Web.Services

<div class="bg-background min-h-screen flex items-center justify-center font-body-md text-on-surface">
    <main class="w-full h-screen flex flex-col md:flex-row">
        <!-- Left Side: Imagery -->
        <div class="hidden md:flex md:w-1/2 relative bg-surface-variant overflow-hidden items-center justify-center">
            <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/images/login-bg.jpg')"></div>
            <!-- Subtle Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-black/20"></div>
            <div class="relative z-10 p-margin-page flex flex-col justify-end h-full text-white">
                <h2 class="font-display-lg text-display-lg mb-4 max-w-lg leading-tight drop-shadow-md">Mang trải nghiệm ẩm thực đỉnh cao đến khách hàng</h2>
                <div class="h-1.5 w-16 bg-primary-fixed rounded-full shadow-sm"></div>
            </div>
        </div>
        
        <!-- Right Side: Login Form -->
        <div class="w-full md:w-1/2 flex items-center justify-center bg-mozzarella-white p-margin-mobile md:p-margin-page">
            <div class="w-full max-w-md bg-surface-container-lowest rounded-xl shadow-[0_8px_24px_rgba(18,28,42,0.08)] p-8 md:p-10 flex flex-col gap-6">
                <!-- Header -->
                <div class="flex flex-col items-center gap-4 mb-2 text-center">
                    <img alt="Pizza Conner Logo" class="h-16 object-contain" src="/logo.png"/>
                    <h1 class="font-headline-md text-headline-md text-primary">Đăng nhập hệ thống Quản trị</h1>
                    <p class="font-body-md text-body-md text-on-surface-variant">Pizza Conner - BOH Administration</p>
                </div>

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="bg-red-50 text-error border border-red-200 p-3.5 rounded-xl text-xs font-bold flex items-center gap-2">
                        <span class="material-symbols-outlined text-base">error</span>
                        <span>@ErrorMessage</span>
                    </div>
                }
                
                <!-- Form -->
                <div class="flex flex-col gap-4" @onkeydown="HandleKeyDown">
                    <!-- Username -->
                    <div class="flex flex-col gap-1.5">
                        <label class="text-xs font-bold text-on-surface-variant uppercase tracking-wider" for="username">Tên đăng nhập</label>
                        <div class="relative focus-ring-primary rounded-xl border border-outline-variant/60 bg-surface flex items-center">
                            <span class="material-symbols-outlined text-outline ml-3.5 absolute text-lg pointer-events-none">person</span>
                            <input @bind="Request.Username" disabled="@IsLoading" class="w-full h-11 pl-11 pr-3 bg-transparent border-none focus:ring-0 text-on-surface text-sm font-medium" id="username" name="username" placeholder="Nhập tên đăng nhập" type="text" autocomplete="username"/>
                        </div>
                    </div>
                    
                    <!-- Password -->
                    <div class="flex flex-col gap-1.5">
                        <label class="text-xs font-bold text-on-surface-variant uppercase tracking-wider" for="password">Mật khẩu</label>
                        <div class="relative focus-ring-primary rounded-xl border border-outline-variant/60 bg-surface flex items-center">
                            <span class="material-symbols-outlined text-outline ml-3.5 absolute text-lg pointer-events-none">lock</span>
                            <input @bind="Request.Password" disabled="@IsLoading" class="w-full h-11 pl-11 pr-11 bg-transparent border-none focus:ring-0 text-on-surface text-sm font-medium" id="password" name="password" placeholder="Nhập mật khẩu" type="@PasswordInputType" autocomplete="current-password"/>
                            <button class="absolute right-3.5 text-outline hover:text-on-surface-variant transition-colors flex items-center justify-center cursor-pointer" type="button" @onclick="TogglePasswordVisibility" @onclick:preventDefault>
                                <span class="material-symbols-outlined text-lg">@PasswordIcon</span>
                            </button>
                        </div>
                    </div>
                    
                    <!-- Options -->
                    <div class="flex items-center justify-between mt-1">
                        <label class="flex items-center gap-2 cursor-pointer select-none">
                            <input @bind="RememberMe" disabled="@IsLoading" class="rounded text-primary focus:ring-2 focus:ring-primary/40 w-4 h-4 cursor-pointer" type="checkbox"/>
                            <span class="text-xs font-medium text-on-surface-variant">Ghi nhớ đăng nhập</span>
                        </label>
                        <a class="text-xs font-bold text-secondary hover:text-primary transition-colors" href="#">Quên mật khẩu?</a>
                    </div>
                    
                    <!-- Submit -->
                    <button class="w-full h-[44px] bg-primary hover:bg-[#3d5600] active:scale-[0.98] text-on-primary font-bold text-sm rounded-xl transition-all shadow-xs mt-3 flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50" type="button" @onclick="HandleLogin" disabled="@IsLoading">
                        @if (IsLoading)
                        {
                            <span class="animate-spin rounded-full h-4 w-4 border-2 border-white border-t-transparent"></span>
                            <span>Đang xác thực...</span>
                        }
                        else
                        {
                            <span>ĐĂNG NHẬP</span>
                            <span class="material-symbols-outlined text-[18px]">login</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </main>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    [Inject]
    protected NavigationManager NavigationManager { get; set; } = default!;
    
    [Inject]
    protected IAuthApiClient AuthApiClient { get; set; } = default!;

    protected Restaurant.Application.DTOs.LoginRequest Request { get; set; } = new();
    protected bool RememberMe { get; set; }
    protected bool IsLoading { get; set; }
    protected string? ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            if (authState.User.Identity?.IsAuthenticated == true && (authState.User.IsInRole("Admin") || authState.User.IsInRole("Manager")))
            {
                NavigationManager.NavigateTo("/admin/dashboard");
            }
        }
    }
    
    protected string PasswordInputType { get; set; } = "password";
    protected string PasswordIcon { get; set; } = "visibility";

    protected void TogglePasswordVisibility()
    {
        if (PasswordInputType == "password")
        {
            PasswordInputType = "text";
            PasswordIcon = "visibility_off";
        }
        else
        {
            PasswordInputType = "password";
            PasswordIcon = "visibility";
        }
    }
    
    protected async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(Request.Username) || string.IsNullOrWhiteSpace(Request.Password))
        {
            ErrorMessage = "Vui lòng nhập tên đăng nhập và mật khẩu.";
            return;
        }

        ErrorMessage = null;
        IsLoading = true;
        StateHasChanged();
        
        try
        {
            var response = await AuthApiClient.LoginAsync(Request);

            if (response != null && !string.IsNullOrEmpty(response.Token))
            {
                if (response.RoleName != "Admin" && response.RoleName != "Manager")
                {
                    ErrorMessage = "Tài khoản không có quyền truy cập trang quản trị.";
                }
                else
                {
                    // Redirect to the Account Controller to set the cookie
                    NavigationManager.NavigateTo($"/Account/Login?token={response.Token}", forceLoad: true);
                    return;
                }
            }
            else
            {
                ErrorMessage = "Tên đăng nhập hoặc mật khẩu không chính xác.";
            }
        }
        catch (Exception)
        {
            ErrorMessage = "Đã xảy ra lỗi kết nối. Vui lòng thử lại sau.";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    protected async Task HandleKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !IsLoading)
        {
            await HandleLogin();
        }
    }
}

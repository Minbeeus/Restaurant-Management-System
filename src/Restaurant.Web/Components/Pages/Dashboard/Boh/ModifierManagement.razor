@page "/dashboard/modifiers"
@layout Restaurant.Web.Components.Layout.AdminLayout
@inject HttpClient Http

<div class="flex justify-between items-center mb-6">
    <h2 class="text-2xl font-bold text-primary">Quản lý Nhóm Lựa Chọn (Modifiers)</h2>
    <button class="bg-primary text-white px-4 py-2 rounded shadow hover:bg-primary/90" @onclick="OpenAddModal">
        + Thêm Nhóm Modifier
    </button>
</div>

@if (modifierGroups == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        @foreach (var group in modifierGroups)
        {
            <div class="bg-surface rounded-lg shadow border border-outline-variant p-6">
                <div class="flex justify-between items-start mb-4">
                    <div>
                        <h3 class="text-xl font-bold text-on-surface">@group.Name</h3>
                        <div class="text-sm text-on-surface-variant mt-1">
                            Bắt buộc chọn: 
                            <span class="font-bold @(group.MinSelections > 0 ? "text-error" : "text-primary")">
                                @(group.MinSelections > 0 ? $"Có (Min: {group.MinSelections})" : "Không")
                            </span>
                            &bull; Tối đa: @(group.MaxSelections > 0 ? group.MaxSelections.ToString() : "Không giới hạn")
                        </div>
                    </div>
                    <div class="space-x-2">
                        <button class="text-primary hover:bg-primary-container/20 p-2 rounded-full transition-colors">
                            <span class="material-symbols-outlined text-sm">edit</span>
                        </button>
                    </div>
                </div>
                
                <div class="space-y-2 mt-4">
                    <div class="text-sm font-semibold text-on-surface-variant uppercase tracking-wider mb-2">Các tùy chọn</div>
                    @foreach (var opt in group.Options)
                    {
                        <div class="flex justify-between items-center bg-surface-low p-3 rounded border border-outline-variant/50">
                            <span class="font-medium">@opt.Name</span>
                            <span class="text-primary font-bold">
                                @(opt.Price > 0 ? $"+{opt.Price.ToString("N0")}đ" : "Miễn phí")
                            </span>
                        </div>
                    }
                    <button class="w-full mt-2 py-2 border border-dashed border-primary text-primary rounded hover:bg-primary-container/10 font-medium">
                        + Thêm Tùy chọn
                    </button>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<ModifierGroupDto> modifierGroups;

    protected override async Task OnInitializedAsync()
    {
        // Mocking Data
        modifierGroups = new List<ModifierGroupDto>
        {
            new ModifierGroupDto 
            { 
                Id = Guid.NewGuid(), 
                Name = "Chọn Size", 
                MinSelections = 1, 
                MaxSelections = 1,
                Options = new List<ModifierOptionDto>
                {
                    new ModifierOptionDto { Name = "Size M", Price = 0 },
                    new ModifierOptionDto { Name = "Size L", Price = 30000 }
                }
            },
            new ModifierGroupDto 
            { 
                Id = Guid.NewGuid(), 
                Name = "Thêm Topping", 
                MinSelections = 0, 
                MaxSelections = 3,
                Options = new List<ModifierOptionDto>
                {
                    new ModifierOptionDto { Name = "Phô mai thêm", Price = 15000 },
                    new ModifierOptionDto { Name = "Xúc xích", Price = 20000 }
                }
            }
        };
    }

    private void OpenAddModal()
    {
        // To be implemented
    }

    public class ModifierGroupDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; }
        public int MinSelections { get; set; }
        public int MaxSelections { get; set; }
        public List<ModifierOptionDto> Options { get; set; }
    }

    public class ModifierOptionDto
    {
        public string Name { get; set; }
        public decimal Price { get; set; }
    }
}

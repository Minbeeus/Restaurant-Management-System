@page "/dashboard/menu-items"
@layout Restaurant.Web.Components.Layout.AdminLayout
@inject HttpClient Http

<div class="flex justify-between items-center mb-6">
    <h2 class="text-2xl font-bold text-primary">Quản lý Món ăn (Menu Items)</h2>
    <button class="bg-primary text-white px-4 py-2 rounded shadow hover:bg-primary/90" @onclick="OpenAddModal">
        + Thêm Món ăn
    </button>
</div>

@if (menuItems == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="bg-surface rounded-lg shadow overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead class="bg-surface-low border-b border-outline-variant">
                <tr>
                    <th class="p-4 font-semibold">Hình ảnh</th>
                    <th class="p-4 font-semibold">Tên Món</th>
                    <th class="p-4 font-semibold">Danh mục</th>
                    <th class="p-4 font-semibold text-right">Giá bán</th>
                    <th class="p-4 font-semibold text-center">Loại (Combo?)</th>
                    <th class="p-4 font-semibold text-center">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in menuItems)
                {
                    <tr class="border-b border-outline-variant last:border-0 hover:bg-surface-low/50">
                        <td class="p-4">
                            <div class="w-12 h-12 bg-surface-low rounded flex items-center justify-center text-on-surface-variant overflow-hidden">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    <span class="material-symbols-outlined">image</span>
                                }
                            </div>
                        </td>
                        <td class="p-4">
                            <div class="font-bold">@item.Name</div>
                            <div class="text-sm text-on-surface-variant">@item.Description</div>
                        </td>
                        <td class="p-4">@item.CategoryName</td>
                        <td class="p-4 text-right">@item.Price.ToString("N0") đ</td>
                        <td class="p-4 text-center">
                            @if (item.IsCombo)
                            {
                                <span class="px-2 py-1 bg-secondary-container/20 text-secondary rounded text-sm font-bold">Combo</span>
                            }
                            else
                            {
                                <span class="px-2 py-1 bg-surface-low text-on-surface rounded text-sm">Đơn món</span>
                            }
                        </td>
                        <td class="p-4 text-center space-x-2">
                            <button class="text-primary hover:underline">Sửa</button>
                            <button class="text-error hover:underline">Xóa</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<MenuItemDto> menuItems;

    protected override async Task OnInitializedAsync()
    {
        // Mocking Data
        menuItems = new List<MenuItemDto>
        {
            new MenuItemDto { Id = Guid.NewGuid(), Name = "Pizza Hải sản", Description = "Hải sản tươi ngon", Price = 150000, CategoryName = "Món chính", IsCombo = false },
            new MenuItemDto { Id = Guid.NewGuid(), Name = "Combo 2 Người", Description = "1 Pizza + 2 Nước", Price = 250000, CategoryName = "Combo", IsCombo = true }
        };
    }

    private void OpenAddModal()
    {
        // To be implemented
    }

    public class MenuItemDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; }
        public string Description { get; set; }
        public decimal Price { get; set; }
        public string ImageUrl { get; set; }
        public string CategoryName { get; set; }
        public bool IsCombo { get; set; }
    }
}

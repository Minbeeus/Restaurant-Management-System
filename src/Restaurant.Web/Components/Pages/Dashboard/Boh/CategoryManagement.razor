@page "/dashboard/categories"
@layout Restaurant.Web.Components.Layout.AdminLayout
@using Restaurant.Application.DTOs
@using Restaurant.Web.Services
@inject HttpClient Http

<div class="flex justify-between items-center mb-6">
    <h2 class="text-2xl font-bold text-primary">Quản lý Danh mục (Categories)</h2>
    <button class="bg-primary text-white px-4 py-2 rounded shadow hover:bg-primary/90" @onclick="OpenAddModal">
        + Thêm Danh mục
    </button>
</div>

@if (categories == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="bg-surface rounded-lg shadow overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead class="bg-surface-low border-b border-outline-variant">
                <tr>
                    <th class="p-4 font-semibold">Tên Danh Mục</th>
                    <th class="p-4 font-semibold">Mô tả</th>
                    <th class="p-4 font-semibold text-center">Trạng thái</th>
                    <th class="p-4 font-semibold text-center">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cat in categories)
                {
                    <tr class="border-b border-outline-variant last:border-0 hover:bg-surface-low/50">
                        <td class="p-4">@cat.Name</td>
                        <td class="p-4 text-on-surface-variant">@cat.Description</td>
                        <td class="p-4 text-center">
                            @if (cat.IsActive)
                            {
                                <span class="px-2 py-1 bg-success-container/20 text-success rounded text-sm">Hoạt động</span>
                            }
                            else
                            {
                                <span class="px-2 py-1 bg-error-container/20 text-error rounded text-sm">Tạm ẩn</span>
                            }
                        </td>
                        <td class="p-4 text-center space-x-2">
                            <button class="text-primary hover:underline">Sửa</button>
                            <button class="text-error hover:underline">Xóa</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<CategoryDto> categories;

    protected override async Task OnInitializedAsync()
    {
        // Mocking Data temporarily before API integration is fully verified. 
        // Real implementation will fetch from API: Http.GetFromJsonAsync<List<CategoryDto>>("/api/v1/categories")
        categories = new List<CategoryDto>
        {
            new CategoryDto { Id = Guid.NewGuid(), Name = "Khai vị", Description = "Món ăn mở đầu", IsActive = true },
            new CategoryDto { Id = Guid.NewGuid(), Name = "Món chính", Description = "Món ăn no", IsActive = true },
            new CategoryDto { Id = Guid.NewGuid(), Name = "Đồ uống", Description = "Các loại nước", IsActive = true }
        };
    }

    private void OpenAddModal()
    {
        // To be implemented
    }

    // A simple DTO stub if not referencing application DTO directly
    public class CategoryDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; }
        public string Description { get; set; }
        public bool IsActive { get; set; }
    }
}

@using Restaurant.Application.DTOs.Dashboard

<div class="bg-surface rounded-2xl border border-outline-variant/60 shadow-sm flex flex-col p-6 space-y-4">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 pb-3 border-b border-outline-variant/40">
        <div>
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-xl">query_stats</span>
                <h3 class="text-base font-black text-on-surface tracking-tight m-0">@L["Dashboard_Chart_Title"]</h3>
            </div>
            <p class="text-xs text-on-surface-variant mt-0.5">@GetSubtitleText()</p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <!-- Total badge -->
            <span class="px-3 py-1 bg-primary/10 text-primary border border-primary/20 rounded-full text-xs font-black shadow-xs flex items-center gap-1">
                <span class="material-symbols-outlined text-sm">payments</span>
                <span>@string.Format(L["Dashboard_Chart_Total"], TotalDayAmount.ToString("N0"))</span>
            </span>

            <!-- Peak hour badge (if any) -->
            @if (PeakPoint != null && PeakPoint.Amount > 0)
            {
                <span class="px-2.5 py-1 bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 rounded-full text-[11px] font-bold flex items-center gap-1" title="Khung giờ doanh thu cao nhất">
                    <span class="material-symbols-outlined text-xs">local_fire_department</span>
                    <span>Cao điểm: @PeakPoint.TimeLabel (@PeakPoint.Amount.ToString("N0")đ)</span>
                </span>
            }

            <!-- Chart view toggle (Bar / Line) -->
            <div class="flex items-center bg-surface-high p-0.5 rounded-lg border border-outline-variant/40 text-xs">
                <button class="px-2.5 py-1 rounded-md font-bold transition-all cursor-pointer flex items-center gap-1 @(ChartType == "bar" ? "bg-surface text-primary shadow-xs" : "text-on-surface-variant hover:text-on-surface")"
                        @onclick='() => ChartType = "bar"'
                        title="Biểu đồ hình cột">
                    <span class="material-symbols-outlined text-sm">bar_chart</span>
                    <span>Cột</span>
                </button>
                <button class="px-2.5 py-1 rounded-md font-bold transition-all cursor-pointer flex items-center gap-1 @(ChartType == "line" ? "bg-surface text-primary shadow-xs" : "text-on-surface-variant hover:text-on-surface")"
                        @onclick='() => ChartType = "line"'
                        title="Biểu đồ đường / miền">
                    <span class="material-symbols-outlined text-sm">show_chart</span>
                    <span>Đường</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Chart Body -->
    <div class="relative w-full h-64 flex flex-col justify-between select-none">
        @if (Data == null)
        {
            <div class="w-full h-full flex flex-col items-center justify-center gap-2 text-on-surface-variant">
                <span class="material-symbols-outlined animate-spin text-3xl text-primary">progress_activity</span>
                <span class="text-xs font-semibold">@L["Dashboard_Chart_Loading"]</span>
            </div>
        }
        else
        {
            <!-- Main Plot with Left Y-Axis and Right Plotting Area -->
            <div class="flex-1 flex gap-2 relative">
                <!-- Y-Axis Labels (HTML, 5 levels: Max, 75%, 50%, 25%, 0) -->
                <div class="w-12 shrink-0 flex flex-col justify-between items-end pr-2 text-[10px] font-bold font-mono text-on-surface-variant/70 pb-5 pt-1">
                    <span>@FormatYLabel(MaxAmount)</span>
                    <span>@FormatYLabel(MaxAmount * 0.75m)</span>
                    <span>@FormatYLabel(MaxAmount * 0.50m)</span>
                    <span>@FormatYLabel(MaxAmount * 0.25m)</span>
                    <span>0đ</span>
                </div>

                <!-- Plotting Canvas Area -->
                <div class="flex-1 relative pb-5 pt-1 flex flex-col justify-between">
                    <!-- 5 Horizontal Grid Lines -->
                    <div class="absolute inset-0 pb-5 pt-1 pointer-events-none flex flex-col justify-between z-0">
                        <div class="w-full border-b border-dashed border-outline-variant/30"></div>
                        <div class="w-full border-b border-dashed border-outline-variant/30"></div>
                        <div class="w-full border-b border-dashed border-outline-variant/30"></div>
                        <div class="w-full border-b border-dashed border-outline-variant/30"></div>
                        <div class="w-full border-b border-outline-variant/60"></div>
                    </div>

                    @if (ChartType == "bar")
                    {
                        <!-- BAR CHART MODE (24 Hours) -->
                        <div class="relative w-full h-full flex items-end justify-between gap-1 z-10 px-0.5">
                            @for (int i = 0; i < Data.Count; i++)
                            {
                                var pt = Data[i];
                                var hourIdx = i;
                                var isPeak = PeakPoint != null && PeakPoint.Amount > 0 && pt.TimeLabel == PeakPoint.TimeLabel;
                                var hasSales = pt.Amount > 0;
                                var heightPct = GetBarHeightPercent(pt.Amount);

                                <div class="flex-1 flex flex-col items-center justify-end h-full group/bar relative">
                                    <!-- Bar Column -->
                                    @if (hasSales)
                                    {
                                        <div class="w-full max-w-[22px] rounded-t-sm transition-all duration-300 group-hover/bar:brightness-110 group-hover/bar:scale-x-110 cursor-pointer shadow-xs @(isPeak ? "bg-gradient-to-t from-amber-600 to-amber-400" : "bg-gradient-to-t from-primary to-primary-container")"
                                             style="height: @(heightPct.ToString("F1"))%;"></div>
                                    }
                                    else
                                    {
                                        <!-- Subtle baseline dot/pill for 0 revenue -->
                                        <div class="w-full max-w-[14px] h-[3px] rounded-full bg-outline-variant/40 group-hover/bar:bg-primary/50 transition-colors cursor-pointer"></div>
                                    }

                                    <!-- Interactive Tooltip on hover -->
                                    <div class="opacity-0 group-hover/bar:opacity-100 transition-opacity duration-150 pointer-events-none absolute bottom-full mb-2 z-40 whitespace-nowrap bg-on-background/95 text-surface text-[11px] p-2 rounded-xl shadow-lg border border-outline/20">
                                        <div class="font-bold flex items-center gap-1.5 border-b border-surface/20 pb-1 mb-1">
                                            <span class="material-symbols-outlined text-xs">schedule</span>
                                            <span>@pt.TimeLabel - @GetNextHourLabel(hourIdx)</span>
                                            @if (isPeak)
                                            {
                                                <span class="text-[10px] text-amber-300 font-black">★ CAO ĐIỂM</span>
                                            }
                                        </div>
                                        <div class="text-xs font-black text-primary-fixed">
                                            @pt.Amount.ToString("N0") đ
                                        </div>
                                        @if (TotalDayAmount > 0 && hasSales)
                                        {
                                            <div class="text-[10px] text-surface/70 mt-0.5">
                                                @( (pt.Amount * 100m / TotalDayAmount).ToString("0.#") )% tổng ngày
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <!-- LINE / AREA CHART MODE (24 Hours) -->
                        <div class="relative w-full h-full z-10">
                            <svg viewBox="0 0 1000 200" class="w-full h-full overflow-visible" preserveAspectRatio="none">
                                <defs>
                                    <linearGradient id="dashboardAreaGrad" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#059669" stop-opacity="0.30" />
                                        <stop offset="100%" stop-color="#059669" stop-opacity="0.0" />
                                    </linearGradient>
                                    <linearGradient id="dashboardLineGrad" x1="0" y1="0" x2="1" y2="0">
                                        <stop offset="0%" stop-color="#10b981" />
                                        <stop offset="100%" stop-color="#059669" />
                                    </linearGradient>
                                </defs>

                                @if (!string.IsNullOrEmpty(LineAreaPath))
                                {
                                    <path d="@LineAreaPath" fill="url(#dashboardAreaGrad)" />
                                }

                                @if (!string.IsNullOrEmpty(LineStrokePath))
                                {
                                    <path d="@LineStrokePath" fill="none" stroke="url(#dashboardLineGrad)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                                }

                                <!-- Data Points and Hover Tooltips -->
                                @for (int i = 0; i < Points.Count; i++)
                                {
                                    var p = Points[i];
                                    var pt = Data[i];
                                    var isPeak = PeakPoint != null && PeakPoint.Amount > 0 && pt.TimeLabel == PeakPoint.TimeLabel;
                                    var hasSales = pt.Amount > 0;

                                    <g class="group/point cursor-pointer">
                                        <circle cx="@p.X.ToString("F1")" cy="@p.Y.ToString("F1")" r="@(hasSales ? "4" : "2")"
                                                class="@(hasSales ? (isPeak ? "fill-amber-400 stroke-surface stroke-2" : "fill-primary stroke-surface stroke-2") : "fill-outline-variant/60") transition-all group-hover/point:r-5 group-hover/point:stroke-3" />
                                        
                                        <!-- Tooltip -->
                                        <g class="opacity-0 group-hover/point:opacity-100 transition-opacity duration-150 pointer-events-none">
                                            <rect x="@((Math.Clamp(p.X - 60, 0, 880)).ToString("F1"))" y="@((p.Y - 45 < 0 ? p.Y + 10 : p.Y - 45).ToString("F1"))" width="120" height="38" rx="6" class="fill-on-background/95" />
                                            @((MarkupString)$"<text x='{Math.Clamp(p.X, 60, 940):F1}' y='{(p.Y - 45 < 0 ? p.Y + 26 : p.Y - 29):F1}' text-anchor='middle' font-size='11' font-weight='bold' fill='#ffffff'>{pt.TimeLabel}: {pt.Amount:N0}đ</text>")
                                            @((MarkupString)$"<text x='{Math.Clamp(p.X, 60, 940):F1}' y='{(p.Y - 45 < 0 ? p.Y + 40 : p.Y - 15):F1}' text-anchor='middle' font-size='9' fill='#a7f3d0'>{(TotalDayAmount > 0 ? (pt.Amount * 100m / TotalDayAmount).ToString("0.#") + "% ngày" : "0%")}</text>")
                                        </g>
                                    </g>
                                }
                            </svg>
                        </div>
                    }

                    <!-- Empty state overlay if total is 0 -->
                    @if (TotalDayAmount == 0)
                    {
                        <div class="absolute inset-0 pb-5 pt-1 flex items-center justify-center pointer-events-none z-20">
                            <div class="px-4 py-2 bg-surface/90 border border-outline-variant/60 rounded-xl shadow-xs text-xs font-semibold text-on-surface-variant flex items-center gap-2">
                                <span class="material-symbols-outlined text-sm text-outline">info</span>
                                <span>Chưa ghi nhận doanh thu trong các khung giờ ngày này</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Bottom X-Axis Timeline (Rendered via clean HTML Flex, never stretched/truncated) -->
            <div class="flex items-center pl-12 pr-1 text-[10px] font-bold text-on-surface-variant/80 select-none">
                <div class="flex-1 flex justify-between">
                    <span>00:00</span>
                    <span class="hidden sm:inline">02:00</span>
                    <span>04:00</span>
                    <span class="hidden sm:inline">06:00</span>
                    <span>08:00</span>
                    <span class="hidden sm:inline">10:00</span>
                    <span>12:00</span>
                    <span class="hidden sm:inline">14:00</span>
                    <span>16:00</span>
                    <span class="hidden sm:inline">18:00</span>
                    <span>20:00</span>
                    <span class="hidden sm:inline">22:00</span>
                    <span>23:59</span>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public List<SalesChartPointDto>? Data { get; set; }
    [Parameter] public DateTime? SelectedDate { get; set; }

    private string ChartType { get; set; } = "bar"; // "bar" or "line"

    private decimal TotalDayAmount => Data?.Sum(x => x.Amount) ?? 0m;

    private SalesChartPointDto? PeakPoint => Data?.Where(x => x.Amount > 0).OrderByDescending(x => x.Amount).FirstOrDefault();

    private decimal MaxAmount
    {
        get
        {
            if (Data == null || !Data.Any()) return 100000m;
            var max = Data.Max(x => x.Amount);
            if (max <= 0m) return 100000m;
            if (max <= 100000m) return 100000m;
            if (max <= 200000m) return 200000m;
            if (max <= 500000m) return 500000m;
            if (max <= 1000000m) return 1000000m;
            if (max <= 2000000m) return 2000000m;
            if (max <= 5000000m) return 5000000m;
            if (max <= 10000000m) return 10000000m;
            return Math.Ceiling(max / 1000000m) * 1000000m;
        }
    }

    private struct Point2D { public double X; public double Y; }
    private List<Point2D> Points = new();
    private string LineStrokePath = "";
    private string LineAreaPath = "";

    protected override void OnParametersSet()
    {
        CalculateLinePoints();
    }

    private void CalculateLinePoints()
    {
        Points.Clear();
        LineStrokePath = "";
        LineAreaPath = "";

        if (Data == null || !Data.Any()) return;

        double width = 1000.0;
        double minY = 10.0;
        double maxY = 195.0; // Baseline at bottom of SVG
        double chartHeight = maxY - minY;

        int count = Data.Count;
        double stepX = count > 1 ? width / (count - 1) : 0;
        double maxVal = (double)MaxAmount;

        for (int i = 0; i < count; i++)
        {
            double x = i * stepX;
            double val = (double)Data[i].Amount;
            double normalizedY = maxVal > 0 ? (val / maxVal) : 0;
            double y = maxY - (normalizedY * chartHeight);

            Points.Add(new Point2D { X = x, Y = y });
        }

        if (Points.Count > 0)
        {
            var sbLine = new System.Text.StringBuilder();
            sbLine.Append($"M {Points[0].X:F1} {Points[0].Y:F1}");

            for (int i = 1; i < Points.Count; i++)
            {
                sbLine.Append($" L {Points[i].X:F1} {Points[i].Y:F1}");
            }
            LineStrokePath = sbLine.ToString();

            var sbArea = new System.Text.StringBuilder(LineStrokePath);
            sbArea.Append($" L {Points.Last().X:F1} {maxY:F1}");
            sbArea.Append($" L {Points.First().X:F1} {maxY:F1} Z");
            LineAreaPath = sbArea.ToString();
        }
    }

    private double GetBarHeightPercent(decimal amount)
    {
        if (MaxAmount <= 0 || amount <= 0) return 0;
        var pct = (double)(amount / MaxAmount) * 100.0;
        return Math.Min(Math.Max(pct, 2.5), 100.0);
    }

    private string GetNextHourLabel(int hourIndex)
    {
        var next = (hourIndex + 1) % 24;
        return $"{next:D2}:00";
    }

    private string FormatYLabel(decimal value)
    {
        if (value >= 1_000_000)
        {
            var m = value / 1_000_000m;
            return m % 1 == 0 ? $"{m:0}M" : $"{m:0.#}M";
        }
        if (value >= 1_000)
        {
            var k = value / 1_000m;
            return k % 1 == 0 ? $"{k:0}k" : $"{k:0.#}k";
        }
        return $"{value:0}đ";
    }

    private string GetSubtitleText()
    {
        var d = SelectedDate ?? DateTime.Today;
        return d.Date == DateTime.Today ? "Hôm nay (" + d.ToString("dd/MM/yyyy") + ")" : "Ngày " + d.ToString("dd/MM/yyyy");
    }
}

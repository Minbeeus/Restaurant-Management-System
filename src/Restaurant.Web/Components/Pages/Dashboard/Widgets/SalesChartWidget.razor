@using Restaurant.Application.DTOs.Dashboard

<div class="bg-surface-container-lowest rounded-xl border border-surface-low shadow-sm flex flex-col h-96">
    <div class="p-6 border-b border-surface-variant flex justify-between items-center bg-surface-mid rounded-t-xl shrink-0">
        <div>
            <h3 class="font-headline-sm text-headline-sm text-on-background m-0">@L["Dashboard_Chart_Title"]</h3>
            <p class="text-xs text-on-surface-variant mt-0.5">@GetSubtitleText()</p>
        </div>
        <div class="flex items-center gap-3">
            <span class="px-3 py-1 bg-primary-container text-on-primary rounded-full text-xs font-bold shadow-xs">
                @string.Format(L["Dashboard_Chart_Total"], TotalDayAmount.ToString("N0"))
            </span>
        </div>
    </div>
    
    <div class="p-6 flex-1 relative flex items-center justify-center overflow-hidden">
        @if (Data == null)
        {
            <div class="flex flex-col items-center gap-2 text-on-surface-variant">
                <span class="material-symbols-outlined animate-spin text-3xl text-primary" data-icon="progress_activity">progress_activity</span>
                <span class="text-sm">@L["Dashboard_Chart_Loading"]</span>
            </div>
        }
        else if (!Data.Any() || MaxAmount == 0)
        {
            <div class="w-full h-full flex flex-col items-center justify-center text-on-surface-variant/60 gap-3 border-2 border-dashed border-outline-variant/40 rounded-lg bg-surface-container/30">
                <span class="material-symbols-outlined text-4xl text-outline-variant" data-icon="show_chart">show_chart</span>
                <p class="font-body-md text-sm font-semibold">@L["Dashboard_Chart_Empty"]</p>
            </div>
        }
        else
        {
            <!-- SVG Chart -->
            <div class="w-full h-full relative">
                <svg viewBox="0 0 800 240" class="w-full h-full overflow-visible" preserveAspectRatio="none">
                    <defs>
                        <linearGradient id="areaGradient" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="var(--color-primary, #2D6A4F)" stop-opacity="0.35" />
                            <stop offset="100%" stop-color="var(--color-primary, #2D6A4F)" stop-opacity="0.0" />
                        </linearGradient>
                        <linearGradient id="lineGradient" x1="0" y1="0" x2="1" y2="0">
                            <stop offset="0%" stop-color="#52B788" />
                            <stop offset="100%" stop-color="#1B4332" />
                        </linearGradient>
                    </defs>

                    <!-- Horizontal Grid Lines -->
                    @for (int i = 0; i <= 4; i++)
                    {
                        var y = 20 + i * 45;
                        var gridValue = MaxAmount - (MaxAmount * i / 4.0m);
                        <line x1="50" y1="@y" x2="780" y2="@y" stroke="currentColor" class="text-outline-variant/20" stroke-dasharray="4,4" stroke-width="1" />
                        @((MarkupString)$"<text x='42' y='{y + 4}' text-anchor='end' font-size='10' class='fill-on-surface-variant font-medium'>{FormatYLabel(gridValue)}</text>")
                    }

                    <!-- Area Path -->
                    @if (!string.IsNullOrEmpty(AreaPathData))
                    {
                        <path d="@AreaPathData" fill="url(#areaGradient)" />
                    }

                    <!-- Line Path -->
                    @if (!string.IsNullOrEmpty(LinePathData))
                    {
                        <path d="@LinePathData" fill="none" stroke="url(#lineGradient)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                    }

                    <!-- Data Circles & Hover Tooltips -->
                    @for (int i = 0; i < Points.Count; i++)
                    {
                        var p = Points[i];
                        var pt = Data[i];
                        <g class="group/point">
                            <circle cx="@p.X.ToString("F1")" cy="@p.Y.ToString("F1")" r="4" class="fill-white stroke-primary stroke-2 cursor-pointer transition-all duration-150 group-hover/point:r-6 group-hover/point:stroke-[3]" />
                            
                            @if (pt.Amount > 0)
                            {
                                <!-- Tooltip on hover -->
                                <g class="opacity-0 group-hover/point:opacity-100 transition-opacity duration-150 pointer-events-none">
                                    <rect x="@((p.X - 55).ToString("F1"))" y="@((p.Y - 35).ToString("F1"))" width="110" height="24" rx="4" class="fill-on-background/90" />
                                    @((MarkupString)$"<text x='{p.X:F1}' y='{(p.Y - 19):F1}' text-anchor='middle' font-size='11' font-weight='bold' fill='#ffffff'>{pt.TimeLabel}: {pt.Amount:N0}đ</text>")
                                </g>
                            }
                        </g>
                    }

                    <!-- X Axis Labels -->
                    @for (int i = 0; i < Data.Count; i += 2)
                    {
                        var p = Points[i];
                        @((MarkupString)$"<text x='{p.X:F1}' y='225' text-anchor='middle' font-size='10' class='fill-on-surface-variant font-medium'>{Data[i].TimeLabel}</text>")
                    }
                </svg>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public List<SalesChartPointDto>? Data { get; set; }
    [Parameter] public DateTime? SelectedDate { get; set; }

    private decimal TotalDayAmount => Data?.Sum(x => x.Amount) ?? 0;
    private decimal MaxAmount => Data != null && Data.Any() ? Math.Max(Data.Max(x => x.Amount), 100000m) : 100000m;

    private struct Point2D { public double X; public double Y; }
    private List<Point2D> Points = new();
    private string LinePathData = "";
    private string AreaPathData = "";

    protected override void OnParametersSet()
    {
        CalculatePoints();
    }

    private void CalculatePoints()
    {
        Points.Clear();
        LinePathData = "";
        AreaPathData = "";

        if (Data == null || !Data.Any()) return;

        double startX = 60;
        double endX = 770;
        double minY = 20;
        double maxY = 200;
        double chartHeight = maxY - minY;

        int count = Data.Count;
        double stepX = count > 1 ? (endX - startX) / (count - 1) : 0;

        double maxVal = (double)MaxAmount;

        for (int i = 0; i < count; i++)
        {
            double x = startX + (i * stepX);
            double val = (double)Data[i].Amount;
            double normalizedY = maxVal > 0 ? (val / maxVal) : 0;
            double y = maxY - (normalizedY * chartHeight);

            Points.Add(new Point2D { X = x, Y = y });
        }

        if (Points.Count > 0)
        {
            var sbLine = new System.Text.StringBuilder();
            sbLine.Append($"M {Points[0].X:F1} {Points[0].Y:F1}");

            for (int i = 1; i < Points.Count; i++)
            {
                sbLine.Append($" L {Points[i].X:F1} {Points[i].Y:F1}");
            }
            LinePathData = sbLine.ToString();

            var sbArea = new System.Text.StringBuilder(LinePathData);
            sbArea.Append($" L {Points.Last().X:F1} {maxY:F1}");
            sbArea.Append($" L {Points.First().X:F1} {maxY:F1} Z");
            AreaPathData = sbArea.ToString();
        }
    }

    private string FormatYLabel(decimal value)
    {
        if (value >= 1_000_000) return $"{value / 1_000_000:0.#}M";
        if (value >= 1_000) return $"{value / 1_000:0}k";
        return value.ToString("0");
    }

    private string GetSubtitleText()
    {
        var d = SelectedDate ?? DateTime.Today;
        return d.Date == DateTime.Today ? "Hôm nay (" + d.ToString("dd/MM/yyyy") + ")" : "Ngày " + d.ToString("dd/MM/yyyy");
    }
}

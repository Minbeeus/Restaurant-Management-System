@using Restaurant.Application.DTOs.Dashboard
@inject NavigationManager Navigation

<div class="bg-surface-container-lowest rounded-xl border border-surface-low shadow-sm h-full flex flex-col">
    <div class="p-6 border-b border-surface-variant bg-surface-mid rounded-t-xl flex justify-between items-center shrink-0">
        <h3 class="font-headline-sm text-headline-sm text-on-background m-0">@L["Dashboard_Activity_Title"]</h3>
        <button class="text-on-surface-variant hover:text-primary transition-colors rounded-full p-1.5 hover:bg-surface-low active:scale-95" @onclick="TriggerRefresh" title="@L["Dashboard_Activity_Refresh"]">
            <span class="material-symbols-outlined text-sm" data-icon="refresh">refresh</span>
        </button>
    </div>
    <div class="p-6 flex-1 overflow-y-auto">
        @if (Items == null)
        {
            <div class="flex flex-col items-center justify-center h-48 gap-2 text-on-surface-variant">
                <span class="material-symbols-outlined animate-spin text-2xl text-primary" data-icon="progress_activity">progress_activity</span>
                <span class="text-sm">@L["Dashboard_Activity_Loading"]</span>
            </div>
        }
        else if (!Items.Any())
        {
            <div class="flex flex-col items-center justify-center h-48 text-on-surface-variant/60 gap-2">
                <span class="material-symbols-outlined text-3xl" data-icon="notifications_off">notifications_off</span>
                <p class="text-sm">@L["Dashboard_Activity_Empty"]</p>
            </div>
        }
        else
        {
            <ul class="relative border-l-2 border-outline-variant/30 ml-3 space-y-6">
                @foreach (var item in Items)
                {
                    <li class="relative pl-6">
                        @{
                            var iconColor = item.ActivityType == "Order" ? "bg-success-green ring-success-bg" : "bg-warning-amber ring-warning-bg";
                        }
                        <span class="absolute -left-[9px] top-1 w-4 h-4 rounded-full @iconColor border-2 border-surface-container-lowest ring-2 flex items-center justify-center"></span>
                        <div class="flex flex-col gap-1">
                            <p class="font-body-md text-on-background">
                                <span class="font-label-bold">@item.Title</span>
                            </p>
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <div class="mt-1 bg-surface-container p-2.5 rounded-lg text-xs font-medium text-on-surface border border-outline-variant/20">
                                    @item.Description
                                </div>
                            }
                            <span class="text-[11px] text-on-surface-variant mt-0.5">@item.Timestamp.ToString("HH:mm - dd/MM/yyyy")</span>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
    <div class="p-4 border-t border-surface-variant text-center bg-surface-container-lowest rounded-b-xl shrink-0">
        <button class="text-primary font-label-bold hover:underline text-sm" @onclick="GoToOrders">@L["Dashboard_Activity_ViewAll"]</button>
    </div>
</div>

@code {
    [Parameter] public List<ActivityFeedItemDto>? Items { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }

    private async Task TriggerRefresh()
    {
        if (OnRefresh.HasDelegate)
        {
            await OnRefresh.InvokeAsync();
        }
    }

    private void GoToOrders()
    {
        Navigation.NavigateTo("/admin/orders");
    }
}

@using Restaurant.Application.DTOs.Dashboard

<div class="bg-surface-container-lowest rounded-xl border border-surface-low shadow-sm h-full flex flex-col">
    <div class="p-6 border-b border-surface-variant bg-surface-mid rounded-t-xl flex justify-between items-center">
        <h3 class="font-headline-sm text-headline-sm text-on-background m-0">Hoạt động gần nhất</h3>
        <button class="text-on-surface-variant hover:text-primary transition-colors rounded-full p-1 hover:bg-surface-low">
            <span class="material-symbols-outlined text-sm" data-icon="refresh">refresh</span>
        </button>
    </div>
    <div class="p-6 flex-1 overflow-y-auto">
        @if (Items == null)
        {
            <p class="text-on-surface-variant text-center">Đang tải dữ liệu...</p>
        }
        else if (!Items.Any())
        {
            <p class="text-on-surface-variant text-center">Chưa có hoạt động nào</p>
        }
        else
        {
            <ul class="relative border-l-2 border-outline-variant/30 ml-3 space-y-6">
                @foreach (var item in Items)
                {
                    <li class="relative pl-6">
                        @{
                            var iconColor = item.ActivityType == "Order" ? "bg-success-green ring-success-bg" : "bg-warning-amber ring-warning-bg";
                        }
                        <span class="absolute -left-[9px] top-1 w-4 h-4 rounded-full @iconColor border-2 border-surface-container-lowest ring-2 flex items-center justify-center"></span>
                        <div class="flex flex-col gap-1">
                            <p class="font-body-md text-on-background">
                                <span class="font-label-bold">@item.Title</span>
                            </p>
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <div class="mt-2 bg-surface-container p-3 rounded-lg text-sm border border-outline-variant/20">
                                    @item.Description
                                </div>
                            }
                            <span class="text-xs text-on-surface-variant mt-1">@item.Timestamp.ToString("HH:mm dd/MM/yyyy")</span>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
    <div class="p-4 border-t border-surface-variant text-center bg-surface-container-lowest rounded-b-xl">
        <button class="text-primary font-label-bold hover:underline text-sm">Tải thêm hoạt động</button>
    </div>
</div>

@code {
    [Parameter]
    public List<ActivityFeedItemDto>? Items { get; set; }
}

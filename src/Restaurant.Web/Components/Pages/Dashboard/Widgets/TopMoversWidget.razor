@using Restaurant.Application.DTOs.Dashboard

<div class="bg-surface-container-lowest rounded-xl border border-surface-low shadow-sm">
    <div class="p-6 border-b border-surface-variant bg-surface-mid rounded-t-xl flex justify-between items-center">
        <h3 class="font-headline-sm text-headline-sm text-on-background m-0">Món bán chạy</h3>
        <button class="text-primary font-label-bold hover:underline">Xem tất cả</button>
    </div>
    <div class="p-0">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="border-b border-outline-variant/30 text-on-surface-variant font-label-bold text-label-bold bg-surface-container-low">
                    <th class="py-3 px-6 font-normal">Tên món</th>
                    <th class="py-3 px-6 font-normal text-right">Số lượng bán</th>
                </tr>
            </thead>
            <tbody>
                @if (Items == null)
                {
                    <tr>
                        <td colspan="2" class="py-4 px-6 text-center text-on-surface-variant">Đang tải dữ liệu...</td>
                    </tr>
                }
                else if (!Items.Any())
                {
                    <tr>
                        <td colspan="2" class="py-4 px-6 text-center text-on-surface-variant">Chưa có dữ liệu hôm nay</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Items)
                    {
                        <tr class="border-b border-outline-variant/20 hover:bg-surface-low transition-colors group">
                            <td class="py-4 px-6 flex items-center gap-3">
                                <span class="font-body-lg text-on-background font-semibold group-hover:text-primary transition-colors">@item.ItemName</span>
                            </td>
                            <td class="py-4 px-6 text-right font-body-md text-on-background font-label-bold">@item.QuantitySold</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter]
    public List<TopMoverDto>? Items { get; set; }
}

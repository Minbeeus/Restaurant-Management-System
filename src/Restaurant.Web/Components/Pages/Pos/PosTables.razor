@page "/pos/tables"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.PosLayout
@using Restaurant.Web.Components.Layout
@using Restaurant.Web.Components.UI.Cards
@using Restaurant.Application.DTOs
@using Restaurant.Web.Components.Pages.Pos.Components
@using Microsoft.AspNetCore.SignalR.Client
@using System.Text.Json.Serialization
@inject NavigationManager Navigation
@inject HttpClient Http
@implements IAsyncDisposable

<div class="flex flex-col h-full bg-background overflow-hidden">
    <!-- Top Nav Bar -->
    <PosHeader />

    <!-- Main Workspace: 90% / 10% Layout -->
    <div class="flex flex-1 overflow-hidden bg-surface-low p-4 gap-4">
        
        <!-- Left Section (~90% width): Areas & Table Floorplan Canvas / Grid -->
        <main class="w-full lg:w-[90%] flex flex-col bg-surface rounded-2xl border border-outline-variant p-5 shadow-sm overflow-hidden">
            <!-- Area Tabs & View Switcher -->
            <div class="flex items-center justify-between gap-2 overflow-x-auto pb-3 mb-4 border-b border-outline-variant shrink-0">
                <div class="flex items-center gap-2 overflow-x-auto">
                    <span class="text-xs font-bold uppercase tracking-wider text-on-surface-variant mr-2 shrink-0 flex items-center gap-1">
                        <span class="material-symbols-outlined text-base">map</span>
                        Khu Vực:
                    </span>
                    <button class="px-4 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer shrink-0 @(SelectedAreaId == 0 ? "bg-primary text-on-primary shadow-xs" : "bg-surface-high text-on-surface hover:bg-surface-high/80")"
                            @onclick="() => SelectArea(0)">
                        Tất Cả Bàn (@Tables.Count)
                    </button>
                    @foreach (var area in Areas)
                    {
                        var count = Tables.Count(t => t.AreaId == area.Id);
                        <button class="px-4 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer shrink-0 @(SelectedAreaId == area.Id ? "bg-primary text-on-primary shadow-xs" : "bg-surface-high text-on-surface hover:bg-surface-high/80")"
                                @onclick="() => SelectArea(area.Id)">
                            @area.DisplayName (@count)
                        </button>
                    }
                </div>

                <!-- Canvas vs Grid Switcher & Floorplan Background Toggle -->
                <div class="flex items-center gap-2 shrink-0">
                    @if (ViewMode == "Canvas")
                    {
                        <!-- Background Floorplan Toggle & Custom Upload -->
                        <div class="flex items-center bg-surface-high p-1 border border-outline-variant rounded-xl text-xs font-bold gap-1">
                            <button class="px-2.5 py-1.5 rounded-lg transition-all cursor-pointer flex items-center gap-1.5 @(ShowFloorplanBackground ? "bg-primary text-on-primary shadow-xs" : "text-on-surface-variant hover:text-on-surface")"
                                    @onclick="() => ShowFloorplanBackground = !ShowFloorplanBackground"
                                    title="Bật/Tắt hiển thị sơ đồ mặt bằng quán">
                                <span class="material-symbols-outlined text-[16px]">layers</span>
                                <span>Mặt Bằng</span>
                            </button>

                            <label class="px-2 py-1.5 rounded-lg transition-all cursor-pointer flex items-center justify-center text-on-surface-variant hover:text-primary hover:bg-surface/80"
                                   title="Tải lên ảnh sơ đồ mặt bằng của quán">
                                <span class="material-symbols-outlined text-[18px]">add_photo_alternate</span>
                                <InputFile OnChange="HandleCustomFloorplanUpload" class="hidden" accept="image/*" />
                            </label>

                            @if (!string.IsNullOrEmpty(CustomFloorplanUrl))
                            {
                                <button class="px-1.5 py-1.5 rounded-lg transition-all cursor-pointer flex items-center justify-center text-error hover:bg-error-container/30"
                                        @onclick="ClearCustomFloorplan"
                                        title="Xóa ảnh tải lên và dùng sơ đồ mặc định">
                                    <span class="material-symbols-outlined text-[16px]">restart_alt</span>
                                </button>
                            }
                        </div>
                    }

                    <div class="flex items-center bg-surface-high p-1 border border-outline-variant rounded-xl text-xs font-bold">
                        <button class="px-3 py-1.5 rounded-lg transition-all cursor-pointer flex items-center gap-1 @(ViewMode == "Canvas" ? "bg-primary text-on-primary shadow-xs" : "text-on-surface-variant hover:text-on-surface")"
                                @onclick='() => ViewMode = "Canvas"'>
                            <span class="material-symbols-outlined text-[16px]">dashboard</span>
                            <span>Sơ Đồ Mặt Bằng</span>
                        </button>
                        <button class="px-3 py-1.5 rounded-lg transition-all cursor-pointer flex items-center gap-1 @(ViewMode == "Grid" ? "bg-primary text-on-primary shadow-xs" : "text-on-surface-variant hover:text-on-surface")"
                                @onclick='() => ViewMode = "Grid"'>
                            <span class="material-symbols-outlined text-[16px]">grid_view</span>
                            <span>Dạng Lưới</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Main Content Area -->
            <div class="flex-1 overflow-hidden relative flex flex-col items-center justify-center">
                @if (IsLoading)
                {
                    <div class="flex items-center justify-center h-full gap-3 text-on-surface-variant">
                        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
                        <span class="font-medium text-sm">Đang tải sơ đồ bàn...</span>
                    </div>
                }
                else if (!FilteredTables.Any())
                {
                    <div class="flex flex-col items-center justify-center h-full text-on-surface-variant py-12">
                        <span class="material-symbols-outlined text-4xl mb-2 opacity-40">table_restaurant</span>
                        <p class="text-sm font-medium">Không tìm thấy bàn nào trong khu vực này.</p>
                    </div>
                }
                else if (ViewMode == "Canvas")
                {
                    var bgUrl = !string.IsNullOrEmpty(CustomFloorplanUrl) ? CustomFloorplanUrl : "images/restaurant_floorplan.svg";

                    <!-- 2D Interactive Canvas Floorplan - Auto-fit entire viewport with 0 scrollbars -->
                    <div class="w-full h-full flex items-center justify-center bg-surface-high/20 border border-outline-variant/40 rounded-2xl p-2 select-none overflow-hidden"
                         @onclick="DeselectTable">
                        <div class="relative w-full h-full max-w-[1240px] max-h-[720px] aspect-[1240/720] flex items-center justify-center">
                            <svg viewBox="0 0 1240 720" class="w-full h-full select-none" preserveAspectRatio="xMidYMid meet">
                                <!-- Architectural Floor Plan Background -->
                                @if (ShowFloorplanBackground)
                                {
                                    <image href="@bgUrl" x="0" y="0" width="1240" height="720" opacity="0.9" preserveAspectRatio="none" />
                                }

                                @foreach (var table in FilteredTables)
                                {
                                    var isSelected = SelectedTable?.TableId == table.TableId;
                                    var shapeClass = table.Shape == 0 ? "rounded-full" : "rounded-2xl";
                                    var statusClass = GetStatusBadgeClass(table.Status);
                                    var (posX, posY, width, height) = GetTableCoordinates(table);

                                    <foreignObject x="@posX" y="@posY" width="@width" height="@height" class="overflow-visible">
                                        <div xmlns="http://www.w3.org/1999/xhtml"
                                             class="w-full h-full select-none flex flex-col items-center justify-center cursor-pointer transition-all hover:scale-[1.05] hover:shadow-xl shadow-md p-1.5 text-center border-2 @shapeClass @statusClass @(isSelected ? "ring-4 ring-primary ring-offset-2 z-20" : "z-10")"
                                             @onclick="() => SelectTableCard(table)"
                                             @onclick:stopPropagation="true"
                                             @ondblclick="() => OpenTableOrder(table)">
                                            
                                            <span class="font-black text-sm md:text-base leading-tight truncate max-w-full">@table.TableName</span>
                                            <span class="text-xs font-bold opacity-85 mt-1">👤 @table.Capacity chỗ</span>
                                        </div>
                                    </foreignObject>
                                }
                            </svg>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Grid View Mode (Scrollable Vertically) -->
                    <div class="flex-1 overflow-y-auto pr-2 pb-6 min-h-0 select-none">
                        <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-5 md:gap-6 pr-1"
                             @onclick="DeselectTable">
                            @foreach (var table in FilteredTables)
                            {
                                var isSelected = SelectedTable?.TableId == table.TableId;
                                <div class="relative cursor-pointer transition-all duration-150 transform hover:-translate-y-1 @(isSelected ? "ring-4 ring-primary ring-offset-2 rounded-2xl" : "")"
                                     @onclick="() => SelectTableCard(table)"
                                     @onclick:stopPropagation="true">
                                    <TableCard 
                                        TableName="@table.TableName" 
                                        Capacity="@table.Capacity" 
                                        Status="@table.StatusName" 
                                        TotalAmount="@table.TotalAmount" 
                                        OnClick="() => OpenTableOrder(table)" />
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </main>

        <!-- Right Section (~10% width): Action Buttons & Back Button -->
        <aside class="w-full lg:w-[10%] min-w-[120px] bg-surface rounded-2xl border border-outline-variant p-3 shadow-sm flex flex-col justify-between shrink-0">
            <!-- Top Action Buttons -->
            <div class="flex flex-col gap-2.5">
                <!-- 1. Xem Hóa Đơn -->
                <button class="flex flex-col items-center justify-center p-2.5 bg-sky-500/10 hover:bg-sky-600 hover:text-white border border-sky-500/30 rounded-xl transition-all cursor-pointer text-center group shadow-2xs text-sky-700 dark:text-sky-300 @(SelectedTable?.CurrentOrderId == null ? "opacity-50 cursor-not-allowed" : "")"
                        disabled="@(SelectedTable?.CurrentOrderId == null)"
                        @onclick="() => ShowReceiptForOrderAsync(SelectedTable!.CurrentOrderId!.Value)"
                        title="Xem chi tiết hóa đơn của bàn đang chọn">
                    <span class="material-symbols-outlined text-xl text-sky-600 group-hover:text-white mb-0.5">receipt_long</span>
                    <span class="text-xs font-bold">Xem Hóa Đơn</span>
                </button>

                <!-- 2. In Hóa Đơn -->
                <button class="flex flex-col items-center justify-center p-2.5 bg-surface-high hover:bg-primary hover:text-on-primary border border-outline-variant rounded-xl transition-all cursor-pointer text-center group shadow-2xs @(SelectedTable?.CurrentOrderId == null ? "opacity-50 cursor-not-allowed" : "")"
                        disabled="@(SelectedTable?.CurrentOrderId == null)"
                        @onclick="PrintPreBillAsync">
                    <span class="material-symbols-outlined text-xl text-primary group-hover:text-on-primary mb-0.5">print</span>
                    <span class="text-xs font-bold">In Hóa Đơn</span>
                </button>

                <!-- 3. Thanh Toán -->
                <button class="flex flex-col items-center justify-center p-2.5 bg-emerald-500/10 hover:bg-emerald-600 hover:text-white border border-emerald-500/30 rounded-xl transition-all cursor-pointer text-center group shadow-2xs text-emerald-700 dark:text-emerald-400 @(SelectedTable?.Status != 3 ? "opacity-50" : "")"
                        @onclick="OpenPaymentModal">
                    <span class="material-symbols-outlined text-xl text-emerald-600 group-hover:text-white mb-0.5">payments</span>
                    <span class="text-xs font-bold">Thanh Toán</span>
                </button>

                <!-- 4. Chuyển Bàn -->
                <button class="flex flex-col items-center justify-center p-2 bg-blue-500/10 hover:bg-blue-600 hover:text-white border border-blue-500/30 rounded-xl transition-all cursor-pointer text-center group shadow-2xs text-blue-700 dark:text-blue-400 @(SelectedTable?.CurrentOrderId == null ? "opacity-50 cursor-not-allowed" : "")"
                        disabled="@(SelectedTable?.CurrentOrderId == null)"
                        @onclick="OpenMoveModal">
                    <span class="material-symbols-outlined text-lg text-blue-600 group-hover:text-white mb-0.5">move_up</span>
                    <span class="text-[11px] font-bold">Chuyển Bàn</span>
                </button>

                <!-- 5. Gộp Bàn -->
                <button class="flex flex-col items-center justify-center p-2 bg-amber-500/10 hover:bg-amber-600 hover:text-white border border-amber-500/30 rounded-xl transition-all cursor-pointer text-center group shadow-2xs text-amber-800 dark:text-amber-300 @(SelectedTable?.CurrentOrderId == null ? "opacity-50 cursor-not-allowed" : "")"
                        disabled="@(SelectedTable?.CurrentOrderId == null)"
                        @onclick="OpenMergeModal">
                    <span class="material-symbols-outlined text-lg text-amber-600 group-hover:text-white mb-0.5">merge</span>
                    <span class="text-[11px] font-bold">Gộp Bàn</span>
                </button>

                @if (SelectedTable != null)
                {
                    var hasOrder = SelectedTable.CurrentOrderId != null && SelectedTable.Status != 0;
                    <!-- 6. Đặt Món / Chỉnh Sửa Đơn -->
                    <button class="flex flex-col items-center justify-center p-3 bg-primary text-on-primary hover:bg-primary/90 rounded-xl transition-all cursor-pointer text-center group shadow-xs mt-1"
                            @onclick="() => OpenTableOrder(SelectedTable)">
                        <span class="material-symbols-outlined text-2xl mb-1">@(hasOrder ? "edit_note" : "restaurant_menu")</span>
                        <span class="text-xs font-bold leading-tight">@(hasOrder ? $"Chỉnh Sửa Đơn ({SelectedTable.TableName})" : $"Đặt Món ({SelectedTable.TableName})")</span>
                    </button>
                    
                    @if (SelectedTable.Status == 4)
                    {
                        <button class="flex flex-col items-center justify-center p-2.5 bg-blue-500 text-white hover:bg-blue-600 rounded-xl transition-all cursor-pointer text-center group shadow-xs mt-1"
                                @onclick="ClearTableAsync">
                            <span class="material-symbols-outlined text-xl mb-0.5">cleaning_services</span>
                            <span class="text-xs font-bold">Dọn Bàn</span>
                        </button>
                    }
                }
            </div>

            <!-- Bottom Back Button -->
            <div class="pt-3 border-t border-outline-variant">
                <button class="w-full flex flex-col items-center justify-center p-3 bg-surface-high hover:bg-error hover:text-on-error border border-outline-variant rounded-xl transition-all cursor-pointer text-center group"
                        @onclick='() => Navigation.NavigateTo("/pos")'>
                    <span class="material-symbols-outlined text-2xl text-on-surface-variant group-hover:text-on-error mb-1">arrow_back</span>
                    <span class="text-xs font-bold">Quay Lại</span>
                </button>
            </div>
        </aside>
    </div>
</div>

<!-- POS Payment Modal -->
@if (ShowPaymentModalState && SelectedTable != null)
{
    <PosPaymentModal 
        @bind-IsOpen="ShowPaymentModalState"
        OrderId="@(SelectedTable.CurrentOrderId ?? 0)" 
        OrderCode="@(SelectedTable.CurrentOrderCode ?? "N/A")" 
        TableName="@SelectedTable.TableName" 
        SubTotal="@SelectedTable.TotalAmount" 
        OnPaymentCompleted="HandlePaymentCompleted" />
}

<!-- Move Table Modal -->
@if (ShowMoveModalState && SelectedTable != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-sm p-4 animate-fade-in select-none">
        <div class="bg-surface rounded-2xl shadow-2xl w-full max-w-4xl overflow-hidden border border-outline-variant p-6 flex flex-col max-h-[90vh]">
            <div class="flex items-center justify-between pb-3 border-b border-outline-variant mb-4 shrink-0">
                <div class="flex items-center gap-2.5">
                    <span class="material-symbols-outlined text-blue-600 text-2xl">move_up</span>
                    <div>
                        <h3 class="text-base font-extrabold text-on-surface m-0">Chuyển Bàn (@SelectedTable.TableName)</h3>
                        <p class="text-xs text-on-surface-variant m-0">Chọn một bàn trống để chuyển đơn hàng tới</p>
                    </div>
                </div>
                <button class="p-1 rounded-full hover:bg-surface-high text-on-surface-variant cursor-pointer" @onclick="() => ShowMoveModalState = false">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <div class="flex-1 overflow-y-auto pr-1 min-h-0">
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 mb-2">
                    @foreach (var availableTable in Tables.Where(t => t.Status == 0 && t.TableId != SelectedTable.TableId))
                    {
                        var isSelected = TargetMoveTableId == availableTable.TableId;
                        <div class="p-3.5 border-2 rounded-xl cursor-pointer transition-all flex flex-col justify-between gap-2 shadow-2xs @(isSelected ? "border-primary bg-primary/10 font-bold" : "border-outline-variant hover:bg-surface-high")"
                             @onclick="() => TargetMoveTableId = availableTable.TableId">
                            <div class="flex items-center justify-between">
                                <span class="text-sm font-extrabold text-on-surface">@availableTable.TableName</span>
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-600">Trống</span>
                            </div>
                            <div class="flex items-center justify-between text-xs text-on-surface-variant">
                                <span>@availableTable.AreaName</span>
                                <span>👤 @availableTable.Capacity chỗ</span>
                            </div>
                        </div>
                    }
                </div>
                @if (!Tables.Any(t => t.Status == 0 && t.TableId != SelectedTable.TableId))
                {
                    <div class="p-8 text-center text-error font-medium text-sm">
                        <span class="material-symbols-outlined text-4xl block mb-2 opacity-60">no_meeting_room</span>
                        Không có bàn trống nào khả dụng trong quán để chuyển.
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(MoveErrorMessage))
            {
                <div class="p-2.5 bg-error-container text-error rounded-xl font-bold text-xs my-3 shrink-0">
                    @MoveErrorMessage
                </div>
            }

            <div class="flex justify-end gap-3 pt-4 border-t border-outline-variant shrink-0 mt-3">
                <button class="px-5 py-2.5 text-xs font-bold border border-outline-variant rounded-xl hover:bg-surface-high cursor-pointer"
                        @onclick="() => ShowMoveModalState = false">
                    Hủy Bỏ
                </button>
                <button class="px-6 py-2.5 text-xs font-extrabold bg-primary text-on-primary rounded-xl hover:bg-primary/90 disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer shadow-sm"
                        disabled="@(TargetMoveTableId == 0)"
                        @onclick="ConfirmMoveTableAsync">
                    Xác Nhận Chuyển Bàn
                </button>
            </div>
        </div>
    </div>
}

<!-- Toast Notification -->
@if (!string.IsNullOrEmpty(ToastMessage))
{
    <div class="fixed bottom-6 left-1/2 -translate-x-1/2 z-[100] bg-gray-900/95 backdrop-blur-sm text-white px-6 py-3 rounded-2xl shadow-2xl flex items-center gap-3 animate-fade-in-up border border-gray-800"
         @onclick="() => ToastMessage = string.Empty">
        <span class="material-symbols-outlined text-emerald-400 text-2xl">info</span>
        <span class="font-bold text-sm tracking-wide">@ToastMessage</span>
        <button class="ml-2 text-gray-400 hover:text-white transition-colors" @onclick:stopPropagation="true" @onclick="() => ToastMessage = string.Empty">
            <span class="material-symbols-outlined text-sm">close</span>
        </button>
    </div>
}

<!-- Merge Table Modal -->
@if (ShowMergeModalState && SelectedTable != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-sm p-4 animate-fade-in select-none">
        <div class="bg-surface rounded-2xl shadow-2xl w-full max-w-4xl overflow-hidden border border-outline-variant p-6 flex flex-col max-h-[90vh]">
            <div class="flex items-center justify-between pb-3 border-b border-outline-variant mb-4 shrink-0">
                <div class="flex items-center gap-2.5">
                    <span class="material-symbols-outlined text-amber-600 text-2xl">merge</span>
                    <div>
                        <h3 class="text-base font-extrabold text-on-surface m-0">Gộp Bàn Vào (@SelectedTable.TableName)</h3>
                        <p class="text-xs text-on-surface-variant m-0">Chọn một hoặc nhiều bàn đang có khách cần gộp chung vào bàn này</p>
                    </div>
                </div>
                <button class="p-1 rounded-full hover:bg-surface-high text-on-surface-variant cursor-pointer" @onclick="() => ShowMergeModalState = false">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <div class="flex-1 overflow-y-auto pr-1 min-h-0">
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 mb-2">
                    @foreach (var occupiedTable in Tables.Where(t => t.Status != 0 && t.TableId != SelectedTable.TableId))
                    {
                        var isChecked = SelectedSourceMergeTableIds.Contains(occupiedTable.TableId);
                        <div class="p-3.5 border-2 rounded-xl cursor-pointer transition-all flex flex-col justify-between gap-2 shadow-2xs @(isChecked ? "border-amber-500 bg-amber-500/10 font-bold" : "border-outline-variant hover:bg-surface-high")"
                             @onclick="() => ToggleSourceMergeTable(occupiedTable.TableId)">
                            <div class="flex items-center justify-between">
                                <span class="text-sm font-extrabold text-on-surface">@occupiedTable.TableName</span>
                                <span class="material-symbols-outlined text-base @(isChecked ? "text-amber-600" : "text-gray-400")">
                                    @(isChecked ? "check_box" : "check_box_outline_blank")
                                </span>
                            </div>
                            <div class="flex items-center justify-between text-xs">
                                <span class="text-on-surface-variant">@occupiedTable.AreaName</span>
                                <span class="font-extrabold text-primary">@occupiedTable.TotalAmount.ToString("N0")đ</span>
                            </div>
                        </div>
                    }
                </div>
                @if (!Tables.Any(t => t.Status != 0 && t.TableId != SelectedTable.TableId))
                {
                    <div class="p-8 text-center text-error font-medium text-sm">
                        <span class="material-symbols-outlined text-4xl block mb-2 opacity-60">table_bar</span>
                        Không có bàn nào khác đang có khách để thực hiện gộp.
                    </div>
                }
            </div>

            <div class="flex justify-end gap-3 pt-4 border-t border-outline-variant shrink-0 mt-3">
                <button class="px-5 py-2.5 text-xs font-bold border border-outline-variant rounded-xl hover:bg-surface-high cursor-pointer"
                        @onclick="() => ShowMergeModalState = false">
                    Hủy Bỏ
                </button>
                <button class="px-6 py-2.5 text-xs font-extrabold bg-amber-600 text-white rounded-xl hover:bg-amber-700 disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer shadow-sm"
                        disabled="@(!SelectedSourceMergeTableIds.Any())"
                        @onclick="PromptMergeConfirmation">
                    Tiếp Tục (@SelectedSourceMergeTableIds.Count bàn đã chọn)
                </button>
            </div>
        </div>
    </div>
}

<!-- POS-010: Merge Table Confirmation Modal -->
@if (ShowMergeConfirmModalState && SelectedTable != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-sm p-4 animate-fade-in select-none">
        <div class="bg-surface rounded-2xl shadow-2xl w-full max-w-2xl overflow-hidden border border-amber-500/40 p-6 flex flex-col">
            <div class="flex items-center gap-3 text-amber-600 mb-3">
                <span class="material-symbols-outlined text-3xl">warning</span>
                <h3 class="text-lg font-black text-on-surface m-0">Xác Nhận Gộp Bàn</h3>
            </div>
            
            <p class="text-sm text-on-surface mb-4">
                Bạn có chắc chắn muốn gộp <strong>@SelectedSourceMergeTableIds.Count bàn</strong> đã chọn vào <strong>@SelectedTable.TableName</strong>?
            </p>

            <div class="bg-surface-high p-4 rounded-xl border border-outline-variant mb-6 space-y-2 text-xs">
                <div class="flex justify-between font-bold text-on-surface pb-2 border-b border-outline-variant">
                    <span>Bàn đích:</span>
                    <span class="text-primary font-black">@SelectedTable.TableName (@SelectedTable.AreaName)</span>
                </div>

                <div class="font-bold text-on-surface-variant pt-1">Danh sách bàn nguồn sẽ gộp:</div>
                <div class="grid grid-cols-2 gap-2 pl-2">
                    @foreach (var srcId in SelectedSourceMergeTableIds)
                    {
                        var srcTbl = Tables.FirstOrDefault(t => t.TableId == srcId);
                        if (srcTbl != null)
                        {
                            <div class="flex justify-between p-2 bg-surface rounded-lg border border-outline-variant text-on-surface">
                                <span>• @srcTbl.TableName (@srcTbl.AreaName)</span>
                                <span class="font-bold text-primary">@srcTbl.TotalAmount.ToString("N0")đ</span>
                            </div>
                        }
                    }
                </div>

                <div class="flex justify-between font-black text-sm text-on-surface pt-2 border-t border-outline-variant mt-2">
                    <span>Tổng tiền sau khi gộp:</span>
                    <span class="text-emerald-600">
                        @((SelectedTable.TotalAmount + Tables.Where(t => SelectedSourceMergeTableIds.Contains(t.TableId)).Sum(t => t.TotalAmount)).ToString("N0"))đ
                    </span>
                </div>
            </div>

            <div class="flex justify-end gap-3 pt-2">
                <button class="px-5 py-2.5 text-xs font-bold border border-outline-variant rounded-xl hover:bg-surface-high cursor-pointer"
                        @onclick="() => ShowMergeConfirmModalState = false">
                    Hủy Bỏ
                </button>
                <button class="px-6 py-2.5 text-xs font-black bg-amber-600 hover:bg-amber-700 text-white rounded-xl shadow-md transition-all cursor-pointer flex items-center gap-1.5"
                        @onclick="ConfirmMergeTablesAsync">
                    <span class="material-symbols-outlined text-base">check_circle</span>
                    Xác Nhận Gộp Bàn Ngay
                </button>
            </div>
        </div>
    </div>
}

<K80ReceiptModal IsOpen="ShowK80Modal" IsOpenChanged="val => ShowK80Modal = val" OrderData="ReceiptData" />

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;

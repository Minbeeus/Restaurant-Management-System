@using System.Net.Http.Json
@using Restaurant.Application.DTOs
@inject HttpClient Http
@inject IJSRuntime JS

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md p-4 animate-fade-in select-none">
        <div class="bg-surface rounded-3xl shadow-2xl w-full max-w-5xl h-[88vh] overflow-hidden border border-outline-variant flex flex-col">
            
            <!-- Sleek Modern Header -->
            <div class="px-6 py-4 bg-slate-900 text-white flex justify-between items-center shrink-0 border-b border-slate-800">
                <div class="flex items-center gap-3.5">
                    <div class="w-11 h-11 rounded-2xl bg-primary/20 border border-primary/30 flex items-center justify-center text-primary-fixed shadow-inner">
                        <span class="material-symbols-outlined text-2xl">point_of_sale</span>
                    </div>
                    <div>
                        <div class="flex items-center gap-2.5">
                            <h2 class="font-black text-lg tracking-wide text-white m-0">CÔNG CỤ THU NGÂN</h2>
                            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 bg-slate-800 px-2 py-0.5 rounded-md">Cashier Tools</span>
                        </div>
                        <p class="text-xs text-slate-400 m-0 mt-0.5 font-medium">Quản lý Ca làm việc • Nộp/Rút két tiền • Lịch sử biến động • Tra cứu hóa đơn</p>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <!-- Live Shift Status Pill -->
                    @if (CurrentShift != null)
                    {
                        <span class="px-3 py-1.5 rounded-full text-xs font-black bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 flex items-center gap-1.5 shadow-2xs">
                            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                            <span>Đang Mở Ca #@CurrentShift.ShiftId</span>
                        </span>
                    }
                    else
                    {
                        <span class="px-3 py-1.5 rounded-full text-xs font-black bg-rose-500/15 text-rose-400 border border-rose-500/30 flex items-center gap-1.5 shadow-2xs">
                            <span class="w-2 h-2 rounded-full bg-rose-400"></span>
                            <span>Chưa Mở Ca</span>
                        </span>
                    }

                    <button class="hover:bg-slate-800 text-slate-400 hover:text-white p-2 rounded-full transition-colors cursor-pointer" 
                            @onclick="CloseAsync" title="Đóng">
                        <span class="material-symbols-outlined text-xl">close</span>
                    </button>
                </div>
            </div>

            <!-- Modern Navigation Tabs -->
            <div class="flex border-b border-outline-variant bg-surface-high/50 px-6 pt-2 shrink-0 gap-3">
                <button class="px-5 py-3 text-xs font-extrabold transition-all cursor-pointer flex items-center gap-2 rounded-t-xl border-b-2 @(ActiveTab == "Shift" ? "border-primary text-primary bg-surface shadow-2xs" : "border-transparent text-on-surface-variant hover:text-on-surface hover:bg-surface/50")"
                        @onclick='() => SetTab("Shift")'>
                    <span class="material-symbols-outlined text-lg">badge</span>
                    <span>1. CA LÀM VIỆC</span>
                </button>

                <button class="px-5 py-3 text-xs font-extrabold transition-all cursor-pointer flex items-center gap-2 rounded-t-xl border-b-2 @(ActiveTab == "Cash" ? "border-primary text-primary bg-surface shadow-2xs" : "border-transparent text-on-surface-variant hover:text-on-surface hover:bg-surface/50")"
                        @onclick='() => SetTab("Cash")'>
                    <span class="material-symbols-outlined text-lg">payments</span>
                    <span>2. TIỀN MẶT & RÚT KÉT</span>
                </button>

                <button class="px-5 py-3 text-xs font-extrabold transition-all cursor-pointer flex items-center gap-2 rounded-t-xl border-b-2 @(ActiveTab == "Bills" ? "border-primary text-primary bg-surface shadow-2xs" : "border-transparent text-on-surface-variant hover:text-on-surface hover:bg-surface/50")"
                        @onclick='() => SetTab("Bills")'>
                    <span class="material-symbols-outlined text-lg">receipt_long</span>
                    <span>3. TRA CỨU HÓA ĐƠN</span>
                </button>
            </div>

            <!-- Tab Content -->
            <div class="flex-1 overflow-y-auto p-6 bg-surface-low space-y-4">

                <!-- Alert Messages -->
                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="p-3.5 bg-rose-500/10 border border-rose-500/30 text-rose-700 dark:text-rose-300 rounded-2xl font-bold text-xs flex items-center gap-2">
                        <span class="material-symbols-outlined text-base text-rose-600">error</span>
                        <span>@ErrorMessage</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(SuccessMessage))
                {
                    <div class="p-3.5 bg-emerald-500/15 text-emerald-800 dark:text-emerald-200 border border-emerald-500/30 rounded-2xl font-bold text-xs flex items-center gap-2">
                        <span class="material-symbols-outlined text-base text-emerald-600">check_circle</span>
                        <span>@SuccessMessage</span>
                    </div>
                }

                <!-- TAB 1: SHIFT MANAGEMENT -->
                @if (ActiveTab == "Shift")
                {
                    @if (CurrentShift == null)
                    {
                        <!-- State: NO ACTIVE SHIFT -> OPEN SHIFT FORM -->
                        <div class="bg-surface rounded-3xl border border-outline-variant p-8 max-w-xl mx-auto shadow-sm space-y-6">
                            <div class="text-center space-y-2">
                                <div class="w-14 h-14 rounded-2xl bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex items-center justify-center mx-auto shadow-2xs">
                                    <span class="material-symbols-outlined text-3xl">play_circle</span>
                                </div>
                                <h3 class="font-black text-xl text-on-surface m-0 tracking-tight">MỞ CA LÀM VIỆC MỚI</h3>
                                <p class="text-xs text-on-surface-variant max-w-sm mx-auto">
                                    Vui lòng nhập số tiền mặt có sẵn trong két để bắt đầu ca bán hàng. Hệ thống yêu cầu phải mở ca trước khi tạo đơn và nhận order.
                                </p>
                            </div>

                            <div class="space-y-4">
                                <div>
                                    <div class="flex justify-between items-center mb-1.5">
                                        <label class="text-xs font-black uppercase tracking-wider text-on-surface-variant">Tiền Đầu Ca (VNĐ)</label>
                                        <span class="text-sm font-black text-primary">@OpenInitialCash.ToString("N0") đ</span>
                                    </div>

                                    <!-- Quick Amount Chips -->
                                    <div class="grid grid-cols-4 gap-2 mb-2">
                                        <button type="button" class="py-1.5 px-2 rounded-xl text-xs font-bold border transition-all cursor-pointer @(OpenInitialCash == 1000000 ? "bg-primary text-on-primary border-primary shadow-xs" : "bg-surface-high border-outline-variant text-on-surface hover:border-primary/50")"
                                                @onclick="() => OpenInitialCash = 1000000">
                                            1.000.000đ
                                        </button>
                                        <button type="button" class="py-1.5 px-2 rounded-xl text-xs font-bold border transition-all cursor-pointer @(OpenInitialCash == 2000000 ? "bg-primary text-on-primary border-primary shadow-xs" : "bg-surface-high border-outline-variant text-on-surface hover:border-primary/50")"
                                                @onclick="() => OpenInitialCash = 2000000">
                                            2.000.000đ
                                        </button>
                                        <button type="button" class="py-1.5 px-2 rounded-xl text-xs font-bold border transition-all cursor-pointer @(OpenInitialCash == 3000000 ? "bg-primary text-on-primary border-primary shadow-xs" : "bg-surface-high border-outline-variant text-on-surface hover:border-primary/50")"
                                                @onclick="() => OpenInitialCash = 3000000">
                                            3.000.000đ
                                        </button>
                                        <button type="button" class="py-1.5 px-2 rounded-xl text-xs font-bold border transition-all cursor-pointer @(OpenInitialCash == 5000000 ? "bg-primary text-on-primary border-primary shadow-xs" : "bg-surface-high border-outline-variant text-on-surface hover:border-primary/50")"
                                                @onclick="() => OpenInitialCash = 5000000">
                                            5.000.000đ
                                        </button>
                                    </div>

                                    <div class="relative">
                                        <span class="material-symbols-outlined absolute left-3.5 top-3.5 text-on-surface-variant text-xl">payments</span>
                                        <input type="number" class="w-full pl-11 pr-4 py-3 rounded-2xl border border-outline-variant font-black text-2xl text-primary bg-surface-high focus:ring-2 focus:ring-primary focus:outline-hidden"
                                               @bind="OpenInitialCash" step="50000" min="0" />
                                    </div>
                                </div>

                                <div>
                                    <label class="block text-xs font-black uppercase tracking-wider text-on-surface-variant mb-1.5">Ghi Chú Mở Ca (Tùy chọn)</label>
                                    <input type="text" class="w-full px-4 py-3 rounded-2xl border border-outline-variant text-sm bg-surface-high focus:ring-2 focus:ring-primary focus:outline-hidden"
                                           placeholder="Ví dụ: Tiền thối lẻ 2 triệu, bàn giao từ ca sáng..." @bind="OpenNote" />
                                </div>

                                <!-- Manager PIN Verification -->
                                <div class="p-4 rounded-2xl bg-amber-500/10 border border-amber-500/30 space-y-3">
                                    <div class="flex justify-between items-center">
                                        <label class="text-xs font-black uppercase tracking-wider text-amber-800 dark:text-amber-300 flex items-center gap-1.5">
                                            <span class="material-symbols-outlined text-lg text-amber-600">lock_person</span>
                                            Mã PIN Quản Lý Xác Nhận (*)
                                        </label>
                                        <span class="text-[11px] font-bold text-amber-700 dark:text-amber-400">Bắt buộc</span>
                                    </div>
                                    <div class="relative">
                                        <span class="material-symbols-outlined absolute left-3.5 top-3 text-amber-600 text-xl">password</span>
                                        <input type="password" maxlength="6" inputmode="numeric"
                                               class="w-full pl-11 pr-4 py-2.5 rounded-xl border border-amber-500/40 font-black text-xl tracking-[0.35em] bg-surface text-on-surface focus:ring-2 focus:ring-amber-500 focus:outline-hidden"
                                               placeholder="••••••" @bind="OpenManagerPin" @bind:event="oninput" @onkeyup="HandleOpenPinKeyUp" />
                                    </div>
                                    <p class="text-[11px] text-amber-800/80 dark:text-amber-300/80 m-0 font-medium flex items-center gap-1">
                                        <span class="material-symbols-outlined text-xs">info</span>
                                        Tương tự thao tác huỷ món, mở ca bán hàng bắt buộc phải có mã PIN xác nhận của Quản lý.
                                    </p>
                                </div>

                                @if (!string.IsNullOrEmpty(ErrorMessage))
                                {
                                    <div class="p-3.5 bg-rose-500/15 border border-rose-500/40 text-rose-700 dark:text-rose-300 rounded-2xl font-bold text-xs flex items-center gap-2 shadow-xs">
                                        <span class="material-symbols-outlined text-base text-rose-600 shrink-0">error</span>
                                        <span>@ErrorMessage</span>
                                    </div>
                                }

                                <button class="w-full py-3.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-2xl font-black text-sm shadow-md hover:shadow-lg transition-all cursor-pointer flex items-center justify-center gap-2 disabled:opacity-50"
                                        disabled="@IsProcessing" @onclick="OpenShiftAsync">
                                    @if (IsProcessing)
                                    {
                                        <span class="animate-spin rounded-full h-4 w-4 border-b-2 border-white"></span>
                                        <span>Đang mở ca...</span>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined text-xl">key</span>
                                        <span>XÁC NHẬN MỞ CA LÀM VIỆC</span>
                                    }
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- State: ACTIVE SHIFT IS OPEN -> DETAILS & CLOSE SHIFT -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            
                            <!-- Left: Active Shift Details -->
                            <div class="bg-surface rounded-3xl border border-outline-variant p-6 shadow-sm flex flex-col justify-between space-y-4">
                                <div>
                                    <div class="flex justify-between items-center pb-3 border-b border-outline-variant">
                                        <span class="font-black text-base text-primary flex items-center gap-2">
                                            <span class="material-symbols-outlined text-xl">schedule</span>
                                            THÔNG TIN CA HIỆN TẠI (#@CurrentShift.ShiftId)
                                        </span>
                                        <span class="px-3 py-1 bg-emerald-500/10 text-emerald-600 rounded-full text-xs font-black border border-emerald-500/20">
                                            @CurrentShift.StatusName
                                        </span>
                                    </div>

                                    <div class="mt-4 space-y-3 text-xs">
                                        <div class="flex justify-between text-on-surface-variant">
                                            <span>Thu ngân phụ trách:</span>
                                            <span class="font-extrabold text-on-surface text-sm">@CurrentShift.StaffName</span>
                                        </div>
                                        <div class="flex justify-between text-on-surface-variant">
                                            <span>Giờ mở ca:</span>
                                            <span class="font-bold text-on-surface">@CurrentShift.StartTime.ToString("dd/MM/yyyy HH:mm:ss")</span>
                                        </div>
                                        <div class="flex justify-between text-on-surface-variant">
                                            <span>Tiền đầu ca:</span>
                                            <span class="font-extrabold text-on-surface">@CurrentShift.InitialCash.ToString("N0") đ</span>
                                        </div>
                                        <div class="flex justify-between text-on-surface-variant">
                                            <span>Doanh thu Tiền mặt (Cash):</span>
                                            <span class="font-extrabold text-emerald-600">+@CurrentShift.CashRevenue.ToString("N0") đ</span>
                                        </div>
                                        <div class="flex justify-between text-on-surface-variant">
                                            <span>Doanh thu Chuyển khoản (Bank):</span>
                                            <span class="font-extrabold text-blue-600">+@CurrentShift.BankingRevenue.ToString("N0") đ</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Expected Cash Box -->
                                <div class="p-4 rounded-2xl bg-primary/10 border border-primary/30 space-y-1">
                                    <span class="text-xs font-bold uppercase tracking-wider text-primary">TỔNG TIỀN MẶT KỲ VỌNG TRONG KÉT</span>
                                    <div class="text-2xl font-black text-primary">
                                        @CurrentShift.ExpectedCash.ToString("N0") đ
                                    </div>
                                    <span class="text-[11px] text-on-surface-variant">
                                        (Tiền đầu ca + Tiền mặt đơn hàng + Nộp thêm - Rút két)
                                    </span>
                                </div>

                                <button type="button" class="w-full py-2.5 bg-surface-high hover:bg-outline-variant/30 text-on-surface border border-outline-variant rounded-xl font-bold text-xs cursor-pointer flex items-center justify-center gap-1.5 transition-colors"
                                        @onclick="ViewCurrentK80Report">
                                    <span class="material-symbols-outlined text-base text-primary">print</span>
                                    <span>Xem & In Thử Báo Cáo K80</span>
                                </button>
                            </div>

                            <!-- Right: Count Cash & Close Shift Form -->
                            <div class="bg-surface rounded-3xl border border-outline-variant p-6 shadow-sm space-y-4">
                                <div class="flex items-center justify-between pb-3 border-b border-outline-variant">
                                    <h3 class="font-black text-base text-amber-700 dark:text-amber-400 flex items-center gap-2 m-0">
                                        <span class="material-symbols-outlined text-xl">lock</span>
                                        KIỂM ĐẾM & ĐÓNG CA
                                    </h3>
                                    <button class="text-xs text-primary font-bold hover:underline cursor-pointer flex items-center gap-1"
                                            @onclick="() => ActualCashCounted = CurrentShift.ExpectedCash">
                                        <span class="material-symbols-outlined text-sm">magic_button</span>
                                        Khớp số kỳ vọng
                                    </button>
                                </div>

                                <!-- Mandatory Order Settlement Alert -->
                                <div class="p-3 bg-rose-500/10 border border-rose-500/30 text-rose-800 dark:text-rose-300 text-xs rounded-2xl font-bold flex items-start gap-2">
                                    <span class="material-symbols-outlined text-base text-rose-600 shrink-0 mt-0.5">error</span>
                                    <div>
                                        <span>Bắt buộc thanh toán và hoàn tất 100% tất cả đơn hàng tại bàn và mang đi trước khi đóng ca. Hệ thống sẽ từ chối đóng ca nếu còn bất kỳ đơn nào chưa thanh toán.</span>
                                    </div>
                                </div>

                                <div>
                                    <label class="block text-xs font-black uppercase tracking-wider text-on-surface-variant mb-1.5">
                                        Số Tiền Thực Tế Kiểm Đếm Trong Két (VNĐ)
                                    </label>
                                    <div class="relative">
                                        <span class="material-symbols-outlined absolute left-3.5 top-3.5 text-on-surface-variant text-xl">point_of_sale</span>
                                        <input type="number" class="w-full pl-11 pr-4 py-3 rounded-2xl border border-outline-variant font-black text-2xl text-emerald-600 bg-surface-high focus:ring-2 focus:ring-emerald-500 focus:outline-hidden"
                                               @bind="ActualCashCounted" step="10000" min="0" />
                                    </div>
                                </div>

                                <!-- Calculated Variance Box -->
                                <div class="p-3.5 rounded-2xl border text-xs flex justify-between items-center font-bold @(Variance == 0 ? "bg-emerald-500/10 border-emerald-500/30 text-emerald-700" : (Variance > 0 ? "bg-amber-500/10 border-amber-500/30 text-amber-800" : "bg-rose-500/10 border-rose-500/30 text-rose-700"))">
                                    <span>Chênh Lệch (Thực tế - Kỳ vọng):</span>
                                    <span class="text-sm font-black">
                                        @(Variance > 0 ? $"+{Variance:N0} đ (Thừa tiền)" : Variance < 0 ? $"{Variance:N0} đ (Thiếu tiền)" : "✓ Khớp 0 đ (Khớp tiền)")
                                    </span>
                                </div>

                                @if (Variance != 0)
                                {
                                    <div class="p-3 bg-amber-500/15 border border-amber-500/30 text-amber-800 dark:text-amber-300 text-xs rounded-2xl font-bold flex items-start gap-2">
                                        <span class="material-symbols-outlined text-base text-amber-600 shrink-0 mt-0.5">warning</span>
                                        <span>Chênh lệch khác 0đ sẽ tự động tạo <strong>Yêu cầu Phê duyệt Đóng ca</strong> gửi tới Quản lý xét duyệt.</span>
                                    </div>
                                }

                                <div>
                                    <label class="block text-xs font-black uppercase tracking-wider text-on-surface-variant mb-1.5">Ghi Chú Đóng Ca</label>
                                    <input type="text" class="w-full px-4 py-3 rounded-2xl border border-outline-variant text-sm bg-surface-high focus:ring-2 focus:ring-primary focus:outline-hidden"
                                           placeholder="Nhập lý do chênh lệch hoặc ghi chú bàn giao ca..." @bind="CloseNote" />
                                </div>

                                <button class="w-full py-3.5 bg-amber-600 hover:bg-amber-700 text-white rounded-2xl font-black text-sm shadow-md hover:shadow-lg transition-all cursor-pointer flex items-center justify-center gap-2 disabled:opacity-50"
                                        disabled="@IsProcessing" @onclick="CloseShiftAsync">
                                    @if (IsProcessing)
                                    {
                                        <span class="animate-spin rounded-full h-4 w-4 border-b-2 border-white"></span>
                                        <span>Đang đóng ca...</span>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined text-xl">lock_clock</span>
                                        <span>@(Variance == 0 ? "XÁC NHẬN ĐÓNG CA" : "GỬI DUYỆT ĐÓNG CA CHÊNH LỆCH")</span>
                                    }
                                </button>
                            </div>

                        </div>
                    }
                }

                <!-- TAB 2: TILL IN & TILL OUT -->
                @if (ActiveTab == "Cash")
                {
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                        
                        <!-- Left Form: Till In / Till Out -->
                        <div class="lg:col-span-5 bg-surface rounded-3xl border border-outline-variant p-6 shadow-sm space-y-4">
                            <div class="flex items-center justify-between pb-3 border-b border-outline-variant">
                                <span class="font-black text-sm text-primary flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-lg">swap_horiz</span>
                                    THAO TÁC TIỀN KÉT (TILL)
                                </span>
                            </div>

                            <!-- Operation Selector -->
                            <div class="grid grid-cols-2 gap-2 p-1 bg-surface-high rounded-2xl border border-outline-variant text-xs font-black">
                                <button class="py-2.5 rounded-xl transition-all cursor-pointer flex items-center justify-center gap-1.5 @(CashActionType == "TillIn" ? "bg-emerald-600 text-white shadow-xs" : "text-on-surface-variant hover:text-on-surface")"
                                        @onclick='() => CashActionType = "TillIn"'>
                                    <span class="material-symbols-outlined text-base">move_to_inbox</span>
                                    <span>Nộp Tiền (Till In)</span>
                                </button>
                                <button class="py-2.5 rounded-xl transition-all cursor-pointer flex items-center justify-center gap-1.5 @(CashActionType == "TillOut" ? "bg-rose-600 text-white shadow-xs" : "text-on-surface-variant hover:text-on-surface")"
                                        @onclick='() => CashActionType = "TillOut"'>
                                    <span class="material-symbols-outlined text-base">outbox</span>
                                    <span>Rút Tiền (Till Out)</span>
                                </button>
                            </div>

                            <div>
                                <label class="block text-xs font-black uppercase tracking-wider text-on-surface-variant mb-1.5">Số Tiền (VNĐ)</label>
                                
                                <!-- Quick chips -->
                                <div class="grid grid-cols-4 gap-1.5 mb-2">
                                    <button type="button" class="py-1 px-1.5 rounded-xl text-[11px] font-bold border transition-all cursor-pointer bg-surface-high border-outline-variant hover:border-primary/50"
                                            @onclick="() => CashAmount = 100000">100k</button>
                                    <button type="button" class="py-1 px-1.5 rounded-xl text-[11px] font-bold border transition-all cursor-pointer bg-surface-high border-outline-variant hover:border-primary/50"
                                            @onclick="() => CashAmount = 200000">200k</button>
                                    <button type="button" class="py-1 px-1.5 rounded-xl text-[11px] font-bold border transition-all cursor-pointer bg-surface-high border-outline-variant hover:border-primary/50"
                                            @onclick="() => CashAmount = 500000">500k</button>
                                    <button type="button" class="py-1 px-1.5 rounded-xl text-[11px] font-bold border transition-all cursor-pointer bg-surface-high border-outline-variant hover:border-primary/50"
                                            @onclick="() => CashAmount = 1000000">1.000k</button>
                                </div>

                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3.5 top-3.5 text-on-surface-variant text-xl">payments</span>
                                    <input type="number" class="w-full pl-11 pr-4 py-3 rounded-2xl border border-outline-variant font-black text-xl text-primary bg-surface-high focus:ring-2 focus:ring-primary focus:outline-hidden"
                                           @bind="CashAmount" step="50000" min="0" />
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-black uppercase tracking-wider text-on-surface-variant mb-1.5">Lý Do / Mục Đích</label>
                                <input type="text" class="w-full px-4 py-3 rounded-2xl border border-outline-variant text-sm bg-surface-high focus:ring-2 focus:ring-primary focus:outline-hidden"
                                       placeholder="@(CashActionType == "TillIn" ? "Ví dụ: Bổ sung tiền thối 500k..." : "Ví dụ: Rút nộp ngân hàng 3 triệu...")"
                                       @bind="CashReason" />
                            </div>

                            @if (CashActionType == "TillOut")
                            {
                                <div class="p-3 bg-blue-500/10 border border-blue-500/30 text-blue-800 dark:text-blue-300 text-xs rounded-2xl font-medium">
                                    ℹ️ Hạn mức rút tiền két của Thu ngân: <strong>1.000.000 đ</strong>. Nếu vượt quá hạn mức, hệ thống sẽ tự động gửi Yêu cầu Phê duyệt cho Quản lý.
                                </div>
                            }

                            <button class="w-full py-3.5 rounded-2xl font-black text-sm shadow-md transition-all cursor-pointer flex items-center justify-center gap-2 @(CashActionType == "TillIn" ? "bg-emerald-600 hover:bg-emerald-700 text-white" : "bg-rose-600 hover:bg-rose-700 text-white")"
                                    disabled="@IsProcessing" @onclick="SubmitCashActionAsync">
                                <span class="material-symbols-outlined text-lg">send</span>
                                <span>XÁC NHẬN @(CashActionType == "TillIn" ? "NỘP TIỀN" : "RÚT TIỀN")</span>
                            </button>
                        </div>

                        <!-- Right List: Cash Movements History -->
                        <div class="lg:col-span-7 bg-surface rounded-3xl border border-outline-variant p-6 shadow-sm flex flex-col justify-between">
                            <div>
                                <h3 class="font-black text-sm text-primary pb-3 border-b border-outline-variant flex items-center justify-between">
                                    <span class="flex items-center gap-2">
                                        <span class="material-symbols-outlined text-lg">history</span>
                                        LỊCH SỬ BIẾN ĐỘNG TIỀN KÉT (CASH MOVEMENTS)
                                    </span>
                                    <span class="text-xs text-on-surface-variant font-medium">Ca hiện tại</span>
                                </h3>

                                <div class="overflow-y-auto max-h-[350px] space-y-2.5 mt-3 pr-1">
                                    @if (CashSummary == null || !CashSummary.Movements.Any())
                                    {
                                        <div class="text-center text-xs text-on-surface-variant py-12 flex flex-col items-center gap-2">
                                            <span class="material-symbols-outlined text-3xl opacity-30">receipt</span>
                                            <span>Chưa có giao dịch biến động tiền két nào trong ca này.</span>
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (var move in CashSummary.Movements)
                                        {
                                            <div class="p-3.5 bg-surface-high/60 rounded-2xl border border-outline-variant/60 flex justify-between items-center text-xs hover:border-primary/40 transition-colors">
                                                <div>
                                                    <div class="font-black text-on-surface">@move.TypeName</div>
                                                    <div class="text-[11px] text-on-surface-variant mt-0.5">@move.Reason (@move.CreatedAt.ToString("HH:mm:ss"))</div>
                                                </div>
                                                <div class="font-black text-sm text-right @(move.Amount >= 0 ? "text-emerald-600" : "text-rose-600")">
                                                    @(move.Amount >= 0 ? $"+{move.Amount:N0}đ" : $"{move.Amount:N0}đ")
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>

                    </div>
                }

                <!-- TAB 3: BILL VIEWER -->
                @if (ActiveTab == "Bills")
                {
                    <div class="bg-surface rounded-3xl border border-outline-variant p-6 shadow-sm space-y-4">
                        <div class="flex items-center gap-3">
                            <div class="relative flex-1">
                                <span class="material-symbols-outlined absolute left-3.5 top-3 text-on-surface-variant text-xl">search</span>
                                <input type="text" class="w-full pl-11 pr-4 py-2.5 rounded-2xl border border-outline-variant bg-surface-high text-sm font-medium focus:ring-2 focus:ring-primary focus:outline-hidden"
                                       placeholder="Tìm kiếm mã hóa đơn, tên khách hàng, số điện thoại..." @bind="SearchBillKeyword" @onkeyup="HandleSearchKeyUp" />
                            </div>
                            <button class="px-6 py-2.5 bg-primary text-on-primary font-black text-xs rounded-2xl shadow-xs hover:bg-primary/90 cursor-pointer"
                                    @onclick="SearchBillsAsync">
                                TÌM KIẾM
                            </button>
                        </div>

                        <!-- Bill List Table -->
                        <div class="overflow-x-auto border border-outline-variant/60 rounded-2xl">
                            <table class="w-full text-left text-xs">
                                <thead>
                                    <tr class="bg-surface-high border-b border-outline-variant text-on-surface-variant uppercase font-black text-[11px]">
                                        <th class="p-3.5">Mã Đơn</th>
                                        <th class="p-3.5">Bàn / Kênh</th>
                                        <th class="p-3.5">Khách Hàng</th>
                                        <th class="p-3.5">Thời Gian</th>
                                        <th class="p-3.5">Tổng Tiền</th>
                                        <th class="p-3.5">Phương Thức</th>
                                        <th class="p-3.5 text-right">Thao Tác</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-outline-variant/60">
                                    @if (!BillList.Any())
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center p-8 text-on-surface-variant">Không tìm thấy hóa đơn nào phù hợp.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var bill in BillList)
                                        {
                                            <tr class="hover:bg-surface-high/40 transition-colors">
                                                <td class="p-3.5 font-black text-primary">@bill.OrderCode</td>
                                                <td class="p-3.5 font-bold">@bill.TableName</td>
                                                <td class="p-3.5">@bill.CustomerName (@(string.IsNullOrEmpty(bill.CustomerPhone) ? "Khách lẻ" : bill.CustomerPhone))</td>
                                                <td class="p-3.5 text-on-surface-variant">@bill.CreatedAt.ToString("dd/MM HH:mm")</td>
                                                <td class="p-3.5 font-black text-emerald-600">@bill.TotalAmount.ToString("N0")đ</td>
                                                <td class="p-3.5 font-semibold">@bill.PaymentMethodName</td>
                                                <td class="p-3.5 text-right">
                                                    <button class="px-3.5 py-1.5 bg-surface-high hover:bg-primary hover:text-white border border-outline-variant rounded-xl font-bold text-[11px] transition-all cursor-pointer shadow-2xs"
                                                            @onclick="() => OpenBillDetail(bill.OrderId)">
                                                        Xem & In Bill
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

            </div>

            <!-- Footer -->
            <div class="px-6 py-4 bg-surface border-t border-outline-variant flex justify-between items-center shrink-0">
                <div class="flex items-center gap-2 text-xs text-on-surface-variant font-medium">
                    <span>Trạng thái ca:</span>
                    <strong class="text-on-surface">@(CurrentShift?.StatusName ?? "Không có ca mở")</strong>
                    @if (CurrentShift != null)
                    {
                        <span class="text-outline">|</span>
                        <span>Mở lúc: @CurrentShift.StartTime.ToString("HH:mm dd/MM")</span>
                    }
                </div>
                <button class="px-6 py-2.5 bg-surface-high hover:bg-outline-variant/40 border border-outline-variant rounded-xl font-black text-xs cursor-pointer shadow-2xs"
                        @onclick="CloseAsync">
                    ĐÓNG CỬA SỔ
                </button>
            </div>
        </div>
    </div>

    <!-- Print Thermal K80 Modal -->
    @if (SelectedBillK80 != null)
    {
        <K80ReceiptModal IsOpen="true" IsOpenChanged="() => SelectedBillK80 = null" OrderData="SelectedBillK80" />
    }

    <!-- End of Day K80 Report Modal -->
    @if (ShowEndOfDayModal && EndOfDayReportData != null)
    {
        <K80EndOfDayModal IsOpen="true" IsOpenChanged="val => ShowEndOfDayModal = val" ReportData="EndOfDayReportData" />
    }
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback OnShiftChanged { get; set; }

    protected string ActiveTab { get; set; } = "Shift";
    protected ShiftReportDto? CurrentShift { get; set; }
    protected CashMovementSummaryDto? CashSummary { get; set; }

    protected decimal OpenInitialCash { get; set; } = 2000000;
    protected string OpenNote { get; set; } = string.Empty;
    protected string OpenManagerPin { get; set; } = string.Empty;

    protected decimal ActualCashCounted { get; set; } = 0;
    protected string CloseNote { get; set; } = string.Empty;

    protected string CashActionType { get; set; } = "TillIn";
    protected decimal CashAmount { get; set; } = 100000;
    protected string CashReason { get; set; } = string.Empty;

    protected string SearchBillKeyword { get; set; } = string.Empty;
    protected List<BillDetailDto> BillList { get; set; } = new();
    protected K80ReceiptDto? SelectedBillK80 { get; set; }

    protected bool ShowEndOfDayModal { get; set; } = false;
    protected ShiftReportDto? EndOfDayReportData { get; set; }

    protected bool IsProcessing { get; set; } = false;
    protected string ErrorMessage { get; set; } = string.Empty;
    protected string SuccessMessage { get; set; } = string.Empty;

    protected decimal Variance => CurrentShift == null ? 0 : ActualCashCounted - CurrentShift.ExpectedCash;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen)
        {
            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        ErrorMessage = string.Empty;
        try
        {
            var shiftResp = await Http.GetAsync("api/v1/shifts/current");
            if (shiftResp.IsSuccessStatusCode)
            {
                var wrapper = await shiftResp.Content.ReadFromJsonAsync<ApiResponseWrapper<ShiftReportDto>>();
                CurrentShift = wrapper?.Data;
                if (CurrentShift != null)
                {
                    ActualCashCounted = CurrentShift.ExpectedCash;
                    await LoadCashSummaryAsync(CurrentShift.ShiftId);
                }
            }
            else
            {
                CurrentShift = null;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private async Task LoadCashSummaryAsync(int shiftId)
    {
        try
        {
            var summaryResp = await Http.GetFromJsonAsync<ApiResponseWrapper<CashMovementSummaryDto>>($"api/v1/cashier/cash-movements/{shiftId}");
            CashSummary = summaryResp?.Data;
        }
        catch { }
    }

    private void SetTab(string tab)
    {
        ActiveTab = tab;
        ErrorMessage = string.Empty;
        SuccessMessage = string.Empty;
        if (tab == "Bills" && !BillList.Any())
        {
            _ = SearchBillsAsync();
        }
    }

    private async Task HandleOpenPinKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(OpenManagerPin) && !IsProcessing)
        {
            await OpenShiftAsync();
        }
    }

    private async Task OpenShiftAsync()
    {
        if (string.IsNullOrWhiteSpace(OpenManagerPin))
        {
            ErrorMessage = "Vui lòng nhập mã PIN của Quản lý để mở ca làm việc.";
            return;
        }

        IsProcessing = true;
        ErrorMessage = string.Empty;
        try
        {
            var req = new OpenShiftRequest 
            { 
                InitialCash = OpenInitialCash, 
                Note = OpenNote,
                ManagerPin = OpenManagerPin.Trim()
            };
            var res = await Http.PostAsJsonAsync("api/v1/shifts/open", req);
            if (res.IsSuccessStatusCode)
            {
                SuccessMessage = "Mở ca làm việc thành công!";
                OpenManagerPin = string.Empty;
                await LoadDataAsync();
                await OnShiftChanged.InvokeAsync();
            }
            else
            {
                try
                {
                    var errWrapper = await res.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                    if (errWrapper.TryGetProperty("error", out var errorProp) && errorProp.TryGetProperty("message", out var msgProp))
                    {
                        ErrorMessage = msgProp.GetString() ?? "Lỗi xác thực mã PIN Quản lý.";
                    }
                    else
                    {
                        ErrorMessage = await res.Content.ReadAsStringAsync();
                    }
                }
                catch
                {
                    ErrorMessage = "Lỗi xác thực mã PIN hoặc không thể mở ca làm việc.";
                }
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally { IsProcessing = false; }
    }

    private async Task CloseShiftAsync()
    {
        if (CurrentShift == null) return;
        IsProcessing = true;
        ErrorMessage = string.Empty;
        try
        {
            var req = new CloseShiftRequest { ActualCashCounted = ActualCashCounted, Note = CloseNote };
            var res = await Http.PostAsJsonAsync("api/v1/shifts/close", req);
            if (res.IsSuccessStatusCode)
            {
                var wrapper = await res.Content.ReadFromJsonAsync<ApiResponseWrapper<ShiftReportDto>>();
                var report = wrapper?.Data;

                SuccessMessage = Variance == 0 ? "Đóng ca thành công!" : "Đã tạo Yêu cầu Phê duyệt Đóng ca chênh lệch cho Quản lý!";
                
                // Tự động mở phiếu in K80 End of Day
                if (report != null)
                {
                    EndOfDayReportData = report;
                    ShowEndOfDayModal = true;
                }

                await LoadDataAsync();
                await OnShiftChanged.InvokeAsync();
            }
            else
            {
                try
                {
                    var errWrapper = await res.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                    if (errWrapper.TryGetProperty("error", out var errorProp) && errorProp.TryGetProperty("message", out var msgProp))
                    {
                        ErrorMessage = msgProp.GetString() ?? "Lỗi đóng ca.";
                    }
                    else
                    {
                        ErrorMessage = await res.Content.ReadAsStringAsync();
                    }
                }
                catch
                {
                    ErrorMessage = "Lỗi đóng ca làm việc. Vui lòng thử lại.";
                }
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally { IsProcessing = false; }
    }

    private void ViewCurrentK80Report()
    {
        if (CurrentShift != null)
        {
            EndOfDayReportData = CurrentShift;
            ShowEndOfDayModal = true;
        }
    }

    private async Task SubmitCashActionAsync()
    {
        if (CurrentShift == null || CashAmount <= 0) return;
        IsProcessing = true;
        ErrorMessage = string.Empty;
        try
        {
            if (CashActionType == "TillIn")
            {
                var req = new TillInRequest { Amount = CashAmount, Reason = string.IsNullOrEmpty(CashReason) ? "Nộp tiền két" : CashReason };
                var res = await Http.PostAsJsonAsync($"api/v1/cashier/till-in/{CurrentShift.ShiftId}", req);
                if (res.IsSuccessStatusCode)
                {
                    SuccessMessage = "Nộp tiền két (Till In) thành công!";
                    await LoadDataAsync();
                }
            }
            else
            {
                var req = new TillOutRequest { Amount = CashAmount, Reason = string.IsNullOrEmpty(CashReason) ? "Rút tiền két" : CashReason };
                var res = await Http.PostAsJsonAsync($"api/v1/cashier/till-out/{CurrentShift.ShiftId}", req);
                if (res.IsSuccessStatusCode)
                {
                    SuccessMessage = CashAmount > 1000000 ? "Đã gửi Yêu cầu Phê duyệt Rút tiền cho Quản lý!" : "Rút tiền két (Till Out) thành công!";
                    await LoadDataAsync();
                }
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally { IsProcessing = false; }
    }

    private async Task HandleSearchKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchBillsAsync();
        }
    }

    private async Task SearchBillsAsync()
    {
        if (CurrentShift == null)
        {
            BillList = new List<BillDetailDto>();
            return;
        }

        try
        {
            var queryReq = new BillQueryRequest 
            { 
                SearchKeyword = SearchBillKeyword, 
                ShiftId = CurrentShift.ShiftId, 
                Page = 1, 
                PageSize = 50 
            };
            var res = await Http.PostAsJsonAsync("api/v1/bills/query", queryReq);
            if (res.IsSuccessStatusCode)
            {
                var wrapper = await res.Content.ReadFromJsonAsync<ApiResponseWrapper<List<BillDetailDto>>>();
                BillList = wrapper?.Data ?? new List<BillDetailDto>();
            }
        }
        catch { }
    }

    private async Task OpenBillDetail(int orderId)
    {
        try
        {
            var res = await Http.GetFromJsonAsync<ApiResponseWrapper<K80ReceiptDto>>($"api/v1/bills/{orderId}/k80");
            SelectedBillK80 = res?.Data;
        }
        catch { }
    }

    private async Task CloseAsync()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private class ApiResponseWrapper<T>
    {
        public bool Success { get; set; }
        public T? Data { get; set; }
        public object? Error { get; set; }
    }
}
@using System.Net.Http.Json
@using Restaurant.Application.DTOs
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.JSInterop
@inject HttpClient Http
@inject IJSRuntime JS

@if (IsOpen && Order != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-sm p-2 sm:p-4 animate-fade-in select-none">
        <div class="bg-surface rounded-2xl shadow-2xl w-full h-full max-w-[98vw] max-h-[96vh] overflow-hidden border border-outline-variant flex flex-col">
            
            <!-- Header -->
            <div class="px-6 py-3.5 bg-primary text-on-primary flex justify-between items-center shrink-0">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-3xl">takeout_dining</span>
                    <div>
                        <h2 class="font-extrabold text-lg sm:text-xl m-0 tracking-wide uppercase">THANH TOÁN ĐƠN MANG VỀ @Order.OrderCode</h2>
                        <span class="text-xs opacity-90">
                            Khách hàng: <strong class="text-white">@Order.CustomerName</strong> (@(string.IsNullOrEmpty(Order.CustomerPhone) ? "Khách lẻ" : Order.CustomerPhone)) | Kênh: @Order.OrderChannel
                        </span>
                    </div>
                </div>
                <button class="hover:bg-white/20 p-2 rounded-full transition-colors cursor-pointer text-white" @onclick="CloseAsync" title="Đóng">
                    <span class="material-symbols-outlined text-2xl">close</span>
                </button>
            </div>

            <!-- Body: 3-Column Grid without Page/Card Scrollbars -->
            <div class="flex-1 grid grid-cols-12 gap-3 p-3 overflow-hidden bg-surface-low min-h-0">
                
                <!-- Section 10.1 (Left, 4 cols): Cart & Order Items Breakdown -->
                <div class="col-span-12 lg:col-span-4 bg-surface rounded-xl border border-outline-variant p-3.5 flex flex-col justify-between overflow-hidden shadow-xs min-h-0">
                    <div class="flex flex-col flex-1 min-h-0">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-on-surface-variant pb-2 border-b border-outline-variant flex items-center justify-between shrink-0">
                            <span class="flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-base">shopping_cart</span>
                                Danh Sách Món Đặt (@Order.Items.Sum(i => i.Quantity))
                            </span>
                            <span class="text-[11px] text-primary font-bold">@Order.Items.Count món</span>
                        </h3>

                        <!-- Scrollable items list: the ONLY scrollbar allowed -->
                        <div class="flex-1 overflow-y-auto space-y-2 my-2 pr-1 min-h-0">
                            @foreach (var item in Order.Items)
                            {
                                <div class="p-2.5 bg-surface-high/50 rounded-xl border border-outline-variant/60 flex justify-between items-center text-xs">
                                    <div class="flex-1 pr-2 min-w-0">
                                        <div class="font-bold text-on-surface truncate">@item.MenuItemName</div>
                                        <div class="text-[11px] text-on-surface-variant font-medium mt-0.5">
                                            @item.UnitPrice.ToString("N0")đ × <span class="font-extrabold text-primary">@item.Quantity</span>
                                        </div>
                                        @if (item.Modifiers != null && item.Modifiers.Any(m => !m.Contains("Sốt", StringComparison.OrdinalIgnoreCase) && !m.Contains("Sauce", StringComparison.OrdinalIgnoreCase) && !m.Contains("Cay", StringComparison.OrdinalIgnoreCase) && !m.Contains("Spice", StringComparison.OrdinalIgnoreCase)))
                                        {
                                            var cleanModifiers = item.Modifiers.Where(m => !m.Contains("Sốt", StringComparison.OrdinalIgnoreCase) && !m.Contains("Sauce", StringComparison.OrdinalIgnoreCase) && !m.Contains("Cay", StringComparison.OrdinalIgnoreCase) && !m.Contains("Spice", StringComparison.OrdinalIgnoreCase));
                                            <div class="text-[10px] text-on-surface-variant opacity-80 truncate">
                                                + @string.Join(", ", cleanModifiers)
                                            </div>
                                        }
                                    </div>
                                    <div class="font-extrabold text-primary text-right shrink-0">
                                        @item.TotalPrice.ToString("N0")đ
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Summary Bottom (Sticky) -->
                    <div class="pt-2.5 border-t border-outline-variant space-y-1 shrink-0 bg-surface text-xs">
                        <div class="flex justify-between text-on-surface-variant">
                            <span>Tạm tính món:</span>
                            <span class="font-bold">@Order.SubTotal.ToString("N0") đ</span>
                        </div>
                        @if (Order.DiscountAmount > 0)
                        {
                            <div class="flex justify-between text-primary font-bold">
                                <span>Giảm giá:</span>
                                <span>-@Order.DiscountAmount.ToString("N0") đ</span>
                            </div>
                        }
                        <div class="flex justify-between text-on-surface-variant">
                            <span>Thuế (VAT 8% bóc tách):</span>
                            <span class="font-bold text-on-surface">@Math.Round(Order.TotalAmount - (Order.TotalAmount / 1.08m), 0).ToString("N0") đ</span>
                        </div>
                        <div class="flex justify-between text-base font-extrabold text-on-surface pt-1.5 border-t border-outline-variant/60">
                            <span>TỔNG CẦN THU:</span>
                            <span class="text-primary text-xl font-black">@Order.TotalAmount.ToString("N0") đ</span>
                        </div>
                    </div>
                </div>

                <!-- Section 10.2 (Middle, 3 cols): Payment Methods -->
                <div class="col-span-12 lg:col-span-3 bg-surface rounded-xl border border-outline-variant p-3.5 flex flex-col justify-between overflow-hidden shadow-xs min-h-0">
                    <div class="space-y-3">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-on-surface-variant pb-2 border-b border-outline-variant flex items-center gap-1.5 shrink-0">
                            <span class="material-symbols-outlined text-base">credit_card</span>
                            Phương Thức Thanh Toán
                        </h3>

                        <div class="grid grid-cols-1 gap-2">
                            <!-- Method 1: Cash -->
                            <button class="w-full p-3 rounded-xl border-2 transition-all cursor-pointer flex items-center gap-3 text-left @(ActivePaymentMethod == "Cash" ? "border-primary bg-primary/10 text-primary shadow-xs" : "border-outline-variant hover:bg-surface-high")"
                                    @onclick='() => SetPaymentMethod("Cash")'>
                                <div class="w-9 h-9 rounded-lg bg-emerald-500/10 text-emerald-600 flex items-center justify-center shrink-0">
                                    <span class="material-symbols-outlined text-xl">local_atm</span>
                                </div>
                                <div>
                                    <div class="font-extrabold text-sm">Tiền Mặt</div>
                                    <div class="text-[11px] opacity-70">Thanh toán tiền mặt tại quầy</div>
                                </div>
                            </button>

                            <!-- Method 2: VietQR Transfer -->
                            <button class="w-full p-3 rounded-xl border-2 transition-all cursor-pointer flex items-center gap-3 text-left @(ActivePaymentMethod == "VietQR" ? "border-primary bg-primary/10 text-primary shadow-xs" : "border-outline-variant hover:bg-surface-high")"
                                    @onclick='() => SetPaymentMethod("VietQR")'>
                                <div class="w-9 h-9 rounded-lg bg-blue-500/10 text-blue-600 flex items-center justify-center shrink-0">
                                    <span class="material-symbols-outlined text-xl">qr_code_2</span>
                                </div>
                                <div>
                                    <div class="font-extrabold text-sm">Chuyển Khoản VietQR</div>
                                    <div class="text-[11px] opacity-70">Quét mã QR tĩnh hoặc theo đơn</div>
                                </div>
                            </button>
                        </div>
                    </div>

                    <!-- Bottom Notice -->
                    <div class="p-2.5 bg-surface-high rounded-xl border border-outline-variant text-[11px] text-on-surface-variant shrink-0 mt-2">
                        @if (ActivePaymentMethod == "VietQR")
                        {
                            <span class="text-blue-700 dark:text-blue-300 font-medium">💡 Quét mã QR tĩnh hoặc theo đơn để test chuyển khoản, sau đó bấm xác nhận.</span>
                        }
                        else
                        {
                            <span>💡 Thu tiền mặt tại quầy, sử dụng bàn phím số bên phải để tính tiền thừa trả khách.</span>
                        }
                    </div>
                </div>

                <!-- Section 10.3 (Right, 5 cols): Numpad & Quick Presets OR VietQR (Strictly No Vertical Scrollbar) -->
                <div class="col-span-12 lg:col-span-5 bg-surface rounded-xl border border-outline-variant p-3.5 flex flex-col justify-between overflow-hidden shadow-xs min-h-0">
                    @if (ActivePaymentMethod == "Cash")
                    {
                        <div class="flex flex-col justify-between h-full min-h-0">
                            <!-- Cash Input Header & Result Display -->
                            <div class="bg-surface-high p-3 rounded-xl border border-outline-variant shrink-0">
                                <div class="flex items-center justify-between mb-0.5">
                                    <label class="block text-[11px] font-bold text-on-surface-variant uppercase m-0">Tiền Khách Trả (VNĐ)</label>
                                    <button class="px-2.5 py-1 text-xs font-black bg-rose-500/15 hover:bg-rose-500 hover:text-white text-rose-600 rounded-lg transition-all cursor-pointer flex items-center gap-1 shadow-2xs border border-rose-500/30"
                                            @onclick="ClearCashReceived" title="Đặt lại tiền khách trả về 0đ">
                                        <span class="material-symbols-outlined text-sm">restart_alt</span>
                                        XÓA (0đ)
                                    </button>
                                </div>
                                <div class="text-2xl sm:text-3xl font-black text-primary tracking-tight">
                                    @CashReceived.ToString("N0") đ
                                </div>

                                <!-- Change / Remaining Calculation -->
                                <div class="mt-2 pt-2 border-t border-outline-variant flex justify-between items-center text-xs">
                                    @if (CashReceived >= Order.TotalAmount)
                                    {
                                        <span class="font-bold text-on-surface-variant">Tiền thừa trả khách:</span>
                                        <span class="font-black text-lg text-emerald-600">@ChangeAmount.ToString("N0") đ</span>
                                    }
                                    else
                                    {
                                        <span class="font-bold text-on-surface-variant">Còn thiếu:</span>
                                        <span class="font-black text-lg text-rose-600">@MissingAmount.ToString("N0") đ</span>
                                    }
                                </div>
                            </div>

                            <!-- Digital Numpad (Compact, Responsive) -->
                            <div class="grid grid-cols-3 gap-1.5 my-2">
                                @foreach (var digit in new[] { "1", "2", "3", "4", "5", "6", "7", "8", "9" })
                                {
                                    <button class="py-2.5 bg-surface-high hover:bg-primary/20 text-on-surface font-extrabold text-base rounded-xl border border-outline-variant transition-all active:scale-95 cursor-pointer shadow-2xs"
                                            @onclick="() => AppendDigit(digit)">
                                        @digit
                                    </button>
                                }
                                <button class="py-2.5 bg-rose-500/15 hover:bg-rose-500 hover:text-white text-rose-600 font-black text-xs sm:text-sm rounded-xl border border-rose-500/30 transition-all active:scale-95 cursor-pointer shadow-2xs flex items-center justify-center gap-1"
                                        @onclick="ClearCashReceived" title="Xóa và đặt lại tiền khách trả về 0">
                                    <span class="material-symbols-outlined text-base">restart_alt</span>
                                    <span>XÓA (0đ)</span>
                                </button>
                                <button class="py-2.5 bg-surface-high hover:bg-primary/20 text-on-surface font-extrabold text-base rounded-xl border border-outline-variant transition-all active:scale-95 cursor-pointer shadow-2xs"
                                        @onclick='() => AppendDigit("0")'>
                                    0
                                </button>
                                <button class="py-2.5 bg-error-container/20 hover:bg-error/30 text-error font-extrabold text-base rounded-xl border border-error/30 transition-all active:scale-95 cursor-pointer flex items-center justify-center shadow-2xs"
                                        @onclick="BackspaceDigit" title="Lùi 1 số">
                                    <span class="material-symbols-outlined text-lg">backspace</span>
                                </button>
                            </div>

                            <!-- Quick Denomination Presets -->
                            <div class="mb-2 shrink-0">
                                <span class="text-[10px] font-bold text-on-surface-variant uppercase tracking-wider block mb-1">Mệnh giá nhanh (+Cộng dồn):</span>
                                <div class="grid grid-cols-3 gap-1.5">
                                    @foreach (var denom in new[] { 10000, 20000, 50000, 100000, 200000, 500000 })
                                    {
                                        <button class="py-2 bg-surface-high hover:bg-primary/10 text-on-surface font-bold text-xs rounded-xl border border-outline-variant transition-all cursor-pointer shadow-2xs"
                                                @onclick="() => AddDenomination(denom)">
                                            +@denom.ToString("N0")đ
                                        </button>
                                    }
                                </div>
                            </div>

                            <!-- KHỚP Button -->
                            <button class="w-full py-2 bg-amber-500/15 hover:bg-amber-500 hover:text-white text-amber-800 dark:text-amber-200 border border-amber-500/40 rounded-xl font-black text-xs transition-all cursor-pointer flex items-center justify-center gap-1.5 shrink-0 shadow-2xs"
                                    @onclick="SetExactAmount">
                                <span class="material-symbols-outlined text-base">fact_check</span>
                                KHỚP VỪA ĐỦ SỐ TIỀN (@Order.TotalAmount.ToString("N0")đ)
                            </button>
                        </div>
                    }
                    else if (ActivePaymentMethod == "VietQR")
                    {
                        <div class="flex flex-col items-center justify-between h-full py-1 text-center min-h-0 space-y-2">
                            @if (_isLoadingQr)
                            {
                                <div class="flex flex-col items-center justify-center h-full gap-3">
                                    <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-primary"></div>
                                    <span class="text-xs text-on-surface-variant font-medium">Đang tạo mã VietQR...</span>
                                </div>
                            }
                            else if (_isPaymentSuccess)
                            {
                                <div class="flex flex-col items-center justify-center h-full bg-emerald-500/10 p-6 rounded-2xl border border-emerald-500/30 text-emerald-700 dark:text-emerald-300 animate-fade-in w-full">
                                    <span class="material-symbols-outlined text-6xl text-emerald-600 mb-2">check_circle</span>
                                    <span class="font-black text-lg">Thanh toán thành công!</span>
                                    <span class="text-xs opacity-90 mt-1">Đơn hàng mang về đã được thanh toán.</span>
                                </div>
                            }
                            else if (_qrData != null)
                            {
                                <!-- Mode Selector: Static QR vs Dynamic Order QR -->
                                <div class="inline-flex p-1 bg-surface-high rounded-xl border border-outline-variant text-xs font-bold shrink-0">
                                    <button type="button"
                                            class="px-3 py-1 rounded-lg transition-all cursor-pointer @(_qrViewMode == "Static" ? "bg-primary text-on-primary shadow-xs" : "text-on-surface hover:text-primary")"
                                            @onclick='() => _qrViewMode = "Static"'>
                                        <span class="material-symbols-outlined text-sm align-middle mr-1">qr_code_2</span>
                                        Mã QR Tĩnh (Tài Khoản)
                                    </button>
                                    <button type="button"
                                            class="px-3 py-1 rounded-lg transition-all cursor-pointer @(_qrViewMode == "Order" ? "bg-primary text-on-primary shadow-xs" : "text-on-surface hover:text-primary")"
                                            @onclick='() => _qrViewMode = "Order"'>
                                        <span class="material-symbols-outlined text-sm align-middle mr-1">receipt</span>
                                        Mã QR Đơn (@Order.TotalAmount.ToString("N0")đ)
                                    </button>
                                </div>

                                <!-- QR Image Display -->
                                <div class="bg-white p-2.5 rounded-2xl border-2 border-primary/20 shadow-md flex items-center justify-center shrink-0">
                                    <img src="@DisplayQrUrl" alt="VietQR TPBank" class="w-44 h-44 sm:w-48 sm:h-48 object-contain rounded-lg" />
                                </div>

                                <!-- Account details card with 1-click copy -->
                                <div class="space-y-1.5 my-0.5 w-full max-w-sm text-xs bg-surface-high/60 p-2.5 rounded-xl border border-outline-variant text-left">
                                    <div class="flex items-center justify-between">
                                        <span class="text-on-surface-variant font-medium">Ngân hàng:</span>
                                        <span class="font-black text-primary">TPBank (Tiên Phong)</span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-on-surface-variant font-medium">Số tài khoản:</span>
                                        <div class="flex items-center gap-1.5">
                                            <span class="font-mono font-black text-on-surface select-all text-sm">@_qrData.BankAccountNo</span>
                                            <button type="button" class="p-1 hover:bg-primary/10 rounded text-primary transition-colors cursor-pointer flex items-center"
                                                    @onclick='() => CopyToClipboardAsync(_qrData.BankAccountNo, "stk")' title="Sao chép STK">
                                                <span class="material-symbols-outlined text-base">@(_copiedField == "stk" ? "done" : "content_copy")</span>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-on-surface-variant font-medium">Chủ tài khoản:</span>
                                        <span class="font-extrabold uppercase text-on-surface">@_qrData.AccountHolder</span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-on-surface-variant font-medium">Số tiền:</span>
                                        <div class="flex items-center gap-1.5">
                                            <span class="font-black text-primary text-sm select-all">@Order.TotalAmount.ToString("N0") đ</span>
                                            <button type="button" class="p-1 hover:bg-primary/10 rounded text-primary transition-colors cursor-pointer flex items-center"
                                                    @onclick='() => CopyToClipboardAsync(Order.TotalAmount.ToString("0"), "amount")' title="Sao chép số tiền">
                                                <span class="material-symbols-outlined text-base">@(_copiedField == "amount" ? "done" : "content_copy")</span>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-on-surface-variant font-medium">Nội dung CK:</span>
                                        <div class="flex items-center gap-1.5">
                                            <span class="font-mono bg-surface px-1.5 py-0.5 rounded text-primary font-black border border-primary/30 select-all">@_qrData.SepayContent</span>
                                            <button type="button" class="p-1 hover:bg-primary/10 rounded text-primary transition-colors cursor-pointer flex items-center"
                                                    @onclick='() => CopyToClipboardAsync(_qrData.SepayContent, "memo")' title="Sao chép nội dung">
                                                <span class="material-symbols-outlined text-base">@(_copiedField == "memo" ? "done" : "content_copy")</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Testing instructions banner -->
                                <div class="bg-amber-500/10 border border-amber-500/30 rounded-xl p-2 text-[11px] text-amber-900 dark:text-amber-100 text-left space-y-0.5 w-full max-w-sm">
                                    <div class="font-bold flex items-center gap-1 text-amber-800 dark:text-amber-200">
                                        <span class="material-symbols-outlined text-sm">verified_user</span>
                                        <span>Chế độ kiểm thử mã QR tĩnh</span>
                                    </div>
                                    <p class="m-0 text-[10.5px] opacity-90 leading-tight">
                                        Quét mã chuyển khoản để test. Khi test xong, bấm <strong>"XÁC NHẬN ĐÃ NHẬN CHUYỂN KHOẢN"</strong> để hoàn tất đơn hàng.
                                    </p>
                                </div>
                            }
                            else
                            {
                                <div class="flex flex-col items-center justify-center h-full gap-3">
                                    <button class="px-6 py-3 bg-primary text-on-primary rounded-xl font-bold hover:bg-primary/90 flex items-center gap-2 cursor-pointer shadow-md text-sm"
                                            @onclick="GenerateQrCodeAsync">
                                        <span class="material-symbols-outlined">qr_code_2</span>
                                        Tạo Mã VietQR
                                    </button>
                                </div>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="p-2 bg-error-container text-error rounded-xl text-xs font-bold mt-2 shrink-0">
                            @ErrorMessage
                        </div>
                    }
                </div>
            </div>

            <!-- Footer: HUỶ (Red) & XÁC NHẬN (Green) -->
            <div class="px-6 py-3.5 bg-surface border-t border-outline-variant flex justify-between items-center shrink-0">
                <!-- Nút HUỶ (Đỏ) -->
                <button class="px-5 py-2.5 bg-rose-600 text-white hover:bg-rose-700 rounded-xl font-extrabold text-xs sm:text-sm transition-all cursor-pointer shadow-sm flex items-center gap-2"
                        @onclick="CloseAsync">
                    <span class="material-symbols-outlined text-lg">cancel</span>
                    HUỶ THANH TOÁN
                </button>

                <!-- Nút XÁC NHẬN (Xanh lá - Active when CashReceived >= TotalAmount or VietQR) -->
                <button class="px-8 py-2.5 bg-emerald-600 text-white hover:bg-emerald-700 disabled:bg-gray-300 disabled:text-gray-500 disabled:cursor-not-allowed rounded-xl font-extrabold text-xs sm:text-base transition-all cursor-pointer shadow-md flex items-center gap-2"
                        disabled="@((ActivePaymentMethod == "Cash" && CashReceived < Order.TotalAmount) || IsProcessing)"
                        @onclick="ConfirmPaymentAsync">
                    <span class="material-symbols-outlined text-xl">@(ActivePaymentMethod == "VietQR" ? "task_alt" : "check_circle")</span>
                    @(ActivePaymentMethod == "VietQR" ? "XÁC NHẬN ĐÃ NHẬN CHUYỂN KHOẢN" : "XÁC NHẬN THANH TOÁN")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public TakeawayOrderDto? Order { get; set; }
    [Parameter] public EventCallback<bool> OnPaymentSuccess { get; set; }

    protected string ActivePaymentMethod { get; set; } = "Cash";
    protected decimal CashReceived { get; set; } = 0;
    protected bool IsProcessing { get; set; } = false;
    protected string ErrorMessage { get; set; } = string.Empty;

    private VietQrResponse? _qrData;
    private string _qrViewMode = "Static"; // "Static" vs "Order"
    private string _copiedField = string.Empty;
    private bool _isLoadingQr;
    private bool _isPaymentSuccess;
    private HubConnection? _hubConnection;

    protected decimal ChangeAmount => Math.Max(0, CashReceived - (Order?.TotalAmount ?? 0));
    protected decimal MissingAmount => Math.Max(0, (Order?.TotalAmount ?? 0) - CashReceived);

    private string DisplayQrUrl
    {
        get
        {
            if (_qrData == null) return string.Empty;
            return _qrViewMode == "Static"
                ? (!string.IsNullOrEmpty(_qrData.StaticQrUrl) ? _qrData.StaticQrUrl : _qrData.QrImageUrl)
                : (!string.IsNullOrEmpty(_qrData.SepayQrUrl) ? _qrData.SepayQrUrl : _qrData.QrImageUrl);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _hubConnection = new HubConnectionBuilder()
            .WithUrl("http://localhost:5011/hubs/restaurant")
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<int>("OrderPaid", async (orderId) =>
        {
            if (Order != null && orderId == Order.OrderId)
            {
                _isPaymentSuccess = true;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(1500);
                await CloseAsync();
                await OnPaymentSuccess.InvokeAsync(true);
            }
        });

        try
        {
            await _hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SignalR error in PosTakeawayPaymentModal: {ex.Message}");
        }
    }

    protected override void OnParametersSet()
    {
        if (!IsOpen)
        {
            CashReceived = 0;
            _qrData = null;
            _isPaymentSuccess = false;
            ErrorMessage = string.Empty;
        }
    }

    private async Task SetPaymentMethod(string method)
    {
        ActivePaymentMethod = method;
        ErrorMessage = string.Empty;
        if (method == "VietQR" && _qrData == null)
        {
            await GenerateQrCodeAsync();
        }
    }

    private void ClearCashReceived()
    {
        CashReceived = 0;
    }

    private void AppendDigit(string digit)
    {
        var currentStr = CashReceived.ToString("F0");
        if (currentStr == "0") currentStr = "";
        currentStr += digit;
        if (decimal.TryParse(currentStr, out decimal parsed))
        {
            CashReceived = parsed;
        }
    }

    private void BackspaceDigit()
    {
        var currentStr = CashReceived.ToString("F0");
        if (currentStr.Length <= 1)
        {
            CashReceived = 0;
        }
        else
        {
            currentStr = currentStr.Substring(0, currentStr.Length - 1);
            if (decimal.TryParse(currentStr, out decimal parsed))
            {
                CashReceived = parsed;
            }
        }
    }

    private void AddDenomination(decimal amount)
    {
        CashReceived += amount;
    }

    private void SetExactAmount()
    {
        if (Order != null)
        {
            CashReceived = Order.TotalAmount;
        }
    }

    private async Task CopyToClipboardAsync(string text, string fieldName)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            _copiedField = fieldName;
            StateHasChanged();
            await Task.Delay(2000);
            if (_copiedField == fieldName)
            {
                _copiedField = string.Empty;
                StateHasChanged();
            }
        }
        catch { }
    }

    private async Task GenerateQrCodeAsync()
    {
        if (Order == null) return;
        _isLoadingQr = true;
        ErrorMessage = string.Empty;
        try
        {
            var req = new GenerateVietQrRequest
            {
                OrderId = Order.OrderId,
                BankName = "TPBank",
                BankAccountNo = "11102042003"
            };
            var response = await Http.PostAsJsonAsync("api/v1/payments/vietqr", req);
            if (response.IsSuccessStatusCode)
            {
                var wrapper = await response.Content.ReadFromJsonAsync<ApiResponseWrapper<VietQrResponse>>();
                if (wrapper?.Success == true && wrapper.Data != null)
                {
                    _qrData = wrapper.Data;
                }
                else
                {
                    _qrData = await response.Content.ReadFromJsonAsync<VietQrResponse>();
                }
            }
            else
            {
                ErrorMessage = "Không thể tạo mã VietQR.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Lỗi: {ex.Message}";
        }
        finally
        {
            _isLoadingQr = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ConfirmPaymentAsync()
    {
        if (Order == null || (ActivePaymentMethod == "Cash" && CashReceived < Order.TotalAmount) || IsProcessing) return;

        IsProcessing = true;
        ErrorMessage = string.Empty;

        try
        {
            var request = new ProcessCashPaymentRequest
            {
                OrderId = Order.OrderId,
                CashReceived = ActivePaymentMethod == "Cash" ? CashReceived : Order.TotalAmount,
                CustomerId = null,
                VoucherCode = null,
                PaymentMethod = ActivePaymentMethod == "VietQR" ? 1 : 0
            };

            var response = await Http.PostAsJsonAsync("api/v1/payments/cash", request);
            if (response.IsSuccessStatusCode)
            {
                await CloseAsync();
                await OnPaymentSuccess.InvokeAsync(true);
            }
            else
            {
                var errStr = await response.Content.ReadAsStringAsync();
                ErrorMessage = $"Thanh toán thất bại: {errStr}";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Lỗi thanh toán: {ex.Message}";
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task CloseAsync()
    {
        IsOpen = false;
        CashReceived = 0;
        _qrData = null;
        _isPaymentSuccess = false;
        ErrorMessage = string.Empty;
        await IsOpenChanged.InvokeAsync(false);
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection != null)
        {
            await _hubConnection.DisposeAsync();
        }
    }

    private class ApiResponseWrapper<T>
    {
        public bool Success { get; set; }
        public T? Data { get; set; }
    }
}

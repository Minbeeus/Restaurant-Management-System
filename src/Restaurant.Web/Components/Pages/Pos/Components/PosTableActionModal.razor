@using System.Net.Http.Json
@using Restaurant.Application.DTOs
@inject HttpClient Http

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4 animate-fade-in select-none">
        <div class="bg-surface rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden border border-outline-variant p-6 space-y-4">
            
            <div class="flex items-center gap-3 text-primary border-b border-outline-variant pb-3">
                <span class="material-symbols-outlined text-3xl">@(ActionType == "Move" ? "move_item" : "merge")</span>
                <div>
                    <h3 class="font-black text-lg text-on-surface m-0 tracking-wide">
                        @(ActionType == "Move" ? "CHUYỂN BÀN" : "GỘP BÀN")
                    </h3>
                    <span class="text-xs text-on-surface-variant font-medium">
                        Chọn bàn đích để thực hiện @(ActionType == "Move" ? "chuyển" : "gộp")
                    </span>
                </div>
            </div>

            <div class="bg-surface-high p-4 rounded-xl border border-outline-variant space-y-2 text-xs mb-4">
                <div class="flex justify-between font-bold text-on-surface">
                    <span>Bàn hiện tại:</span>
                    <span class="text-primary font-black">Bàn @SourceTableId</span>
                </div>
            </div>

            @if (_isLoading)
            {
                <div class="flex justify-center p-8">
                    <span class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></span>
                </div>
            }
            else
            {
                <div class="grid grid-cols-4 gap-3 max-h-[40vh] overflow-y-auto p-1">
                    @foreach (var table in _availableTables)
                    {
                        var isOccupied = table.CurrentOrderId > 0;
                        var isTargetOccupiedNeeded = ActionType == "Merge";
                        var isSelectable = ActionType == "Move" ? !isOccupied : isOccupied;

                        <button class="p-3 rounded-xl border flex flex-col items-center justify-center gap-1 transition-all cursor-pointer @(_selectedTargetTableId == table.TableId ? "border-primary bg-primary/10" : "border-outline-variant hover:bg-surface-high")"
                                disabled="!isSelectable"
                                @onclick="() => _selectedTargetTableId = table.TableId"
                                style="opacity: @(isSelectable ? 1 : 0.4)">
                            <span class="material-symbols-outlined @(isOccupied ? "text-error" : "text-emerald-500")">
                                table_restaurant
                            </span>
                            <span class="font-bold text-sm">@table.TableName</span>
                        </button>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="p-2.5 bg-error-container text-error rounded-xl font-bold text-xs mt-3">
                    @ErrorMessage
                </div>
            }

            <div class="flex justify-end gap-3 pt-4 border-t border-outline-variant">
                <button class="px-5 py-2.5 text-xs font-bold border border-outline-variant rounded-xl hover:bg-surface-high cursor-pointer"
                        @onclick="CloseAsync">
                    HỦY BỎ
                </button>
                <button class="px-6 py-2.5 text-xs font-black bg-primary hover:bg-primary/90 text-on-primary rounded-xl shadow-md transition-all cursor-pointer flex items-center gap-1.5"
                        disabled="@(IsProcessing || _selectedTargetTableId == 0)" @onclick="ConfirmActionAsync">
                    <span class="material-symbols-outlined text-lg">check</span>
                    XÁC NHẬN
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string ActionType { get; set; } = "Move"; // "Move" or "Merge"
    [Parameter] public int SourceTableId { get; set; }
    [Parameter] public EventCallback<int> OnActionCompleted { get; set; } // Returns TargetTableId

    private bool _isLoading = false;
    private List<TableStatusOverviewDto> _availableTables = new();
    private int _selectedTargetTableId = 0;

    protected bool IsProcessing { get; set; } = false;
    protected string ErrorMessage { get; set; } = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && _availableTables.Count == 0)
        {
            await LoadTablesAsync();
        }
        else if (!IsOpen)
        {
            _selectedTargetTableId = 0;
            ErrorMessage = string.Empty;
        }
    }

    private async Task LoadTablesAsync()
    {
        _isLoading = true;
        try
        {
            var res = await Http.GetFromJsonAsync<ApiResponseWrapper<List<TableStatusOverviewDto>>>("api/v1/pos/tables/overview");
            if (res?.Data != null)
            {
                _availableTables = res.Data.Where(t => t.TableId != SourceTableId).ToList();
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmActionAsync()
    {
        if (_selectedTargetTableId <= 0) return;

        IsProcessing = true;
        ErrorMessage = string.Empty;

        try
        {
            if (ActionType == "Move")
            {
                var req = new MoveTableRequest { SourceTableId = SourceTableId, TargetTableId = _selectedTargetTableId };
                var res = await Http.PostAsJsonAsync("api/v1/pos/tables/move", req);
                if (res.IsSuccessStatusCode)
                {
                    await CloseAsync();
                    await OnActionCompleted.InvokeAsync(_selectedTargetTableId);
                }
                else
                {
                    var err = await res.Content.ReadAsStringAsync();
                    ErrorMessage = $"Lỗi chuyển bàn: {err}";
                }
            }
            else if (ActionType == "Merge")
            {
                var req = new MergeTableRequest { SourceTableIds = new List<int> { SourceTableId }, TargetTableId = _selectedTargetTableId };
                var res = await Http.PostAsJsonAsync("api/v1/pos/tables/merge", req);
                if (res.IsSuccessStatusCode)
                {
                    await CloseAsync();
                    await OnActionCompleted.InvokeAsync(_selectedTargetTableId);
                }
                else
                {
                    var err = await res.Content.ReadAsStringAsync();
                    ErrorMessage = $"Lỗi gộp bàn: {err}";
                }
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task CloseAsync()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private class ApiResponseWrapper<T>
    {
        public bool Success { get; set; }
        public T? Data { get; set; }
    }
}

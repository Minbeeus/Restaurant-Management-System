@using Restaurant.Application.DTOs
@using Restaurant.Web.Components.Pages.Pos.Components.MenuItemCard

<div class="pos-menu-grid h-full overflow-y-auto pr-1 select-none">
    @if (Items == null || !Items.Any())
    {
        <div class="flex flex-col items-center justify-center h-full text-on-surface-variant py-16">
            <span class="material-symbols-outlined text-4xl mb-2 opacity-30">restaurant_menu</span>
            <p class="text-sm font-bold">Không tìm thấy món ăn phù hợp.</p>
        </div>
    }
    else
    {
        <div class="grid @(ShowImage ? "grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6" : "grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-8") gap-3 pb-6">
            @foreach (var item in Items)
            {
                <MenuItemCard 
                    Item="item" 
                    ShowImage="ShowImage" 
                    OnItemClicked="HandleItemClicked" />
            }
        </div>
    }
</div>


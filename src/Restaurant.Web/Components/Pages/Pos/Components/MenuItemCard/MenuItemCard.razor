@using Restaurant.Application.DTOs

<div class="pos-menu-item bg-surface hover:bg-surface-high border border-outline-variant/70 rounded-2xl p-3 flex flex-col justify-between transition-all duration-150 hover:shadow-md hover:border-primary/50 cursor-pointer select-none relative overflow-hidden group @(Item.IsSoldOut ? "opacity-60 grayscale" : "")"
     @onclick="HandleClick">
    @if (ShowImage)
    {
        <div class="w-full h-28 rounded-xl bg-surface-high/60 overflow-hidden relative mb-2 flex items-center justify-center shrink-0 border border-outline-variant/30">
            @if (!string.IsNullOrEmpty(Item.ImageUrl))
            {
                <img src="@Item.ImageUrl" alt="@Item.Name" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            }
            else
            {
                <div class="text-3xl opacity-80 group-hover:scale-110 transition-transform">🍕</div>
            }
            
            @if (Item.IsSoldOut)
            {
                <div class="absolute inset-0 bg-black/60 backdrop-blur-2xs flex items-center justify-center">
                    <span class="px-2 py-0.5 bg-rose-600 text-white font-black text-[10px] uppercase rounded-full tracking-wider shadow-xs">Hết Hàng</span>
                </div>
            }
        </div>
    }
    
    <div class="flex flex-col justify-between flex-1">
        <div>
            <h3 class="font-extrabold text-xs text-on-surface group-hover:text-primary transition-colors line-clamp-2 leading-snug">@Item.Name</h3>
            @if (!string.IsNullOrEmpty(Item.CategoryName))
            {
                <span class="text-[10px] text-on-surface-variant/70 block mt-0.5">@Item.CategoryName</span>
            }
        </div>
        <div class="mt-2 flex items-center justify-between">
            <span class="font-black text-xs text-primary bg-primary/10 px-2 py-0.5 rounded-lg border border-primary/20">
                @Item.Price.ToString("N0")đ
            </span>
            <span class="material-symbols-outlined text-base text-on-surface-variant/40 group-hover:text-primary transition-colors">add_circle</span>
        </div>
    </div>
</div>


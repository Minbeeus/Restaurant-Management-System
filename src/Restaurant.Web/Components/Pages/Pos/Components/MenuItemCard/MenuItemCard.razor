@using Restaurant.Application.DTOs

<div class="pos-menu-item bg-surface hover:bg-surface-high border border-outline-variant/70 rounded-xl p-3.5 flex flex-col justify-between transition-all duration-150 hover:shadow-md hover:border-primary/50 cursor-pointer select-none relative overflow-hidden group min-h-[90px] w-full @(Item.IsSoldOut ? "opacity-60 grayscale" : "")"
     @onclick="HandleClick">
    <div>
        <div class="flex items-start justify-between gap-1.5">
            <h3 class="font-extrabold text-xs md:text-sm text-on-surface group-hover:text-primary transition-colors line-clamp-2 leading-snug">
                @DisplayName
            </h3>
            @if (Item.IsSoldOut)
            {
                <span class="px-1.5 py-0.5 bg-rose-600 text-white font-black text-[9px] uppercase rounded-full shrink-0">Hết</span>
            }
        </div>
    </div>

    <div class="mt-3 flex items-center justify-between">
        <span class="font-black text-xs md:text-sm text-primary bg-primary/10 px-2 py-0.5 rounded-md border border-primary/20 font-mono">
            @((Item.Price + ExtraPriceForConfig).ToString("N0"))đ
        </span>
        <div class="flex items-center gap-1.5">
            @if (Item.IsCombo)
            {
                <span class="px-1.5 py-0.5 rounded text-[9px] font-black uppercase bg-primary text-on-primary">
                    Combo
                </span>
            }
            else if (Item.ModifierGroups != null && Item.ModifierGroups.Any(g => !g.Name.Contains("Kích thước", StringComparison.OrdinalIgnoreCase) && !g.Name.Contains("Đế", StringComparison.OrdinalIgnoreCase)))
            {
                <span class="px-1.5 py-0.5 rounded text-[9px] font-bold uppercase bg-surface-high border border-outline-variant text-on-surface-variant">
                    Tùy chọn
                </span>
            }
            <span class="material-symbols-outlined text-lg text-primary/70 group-hover:text-primary transition-colors">add_circle</span>
        </div>
    </div>
</div>


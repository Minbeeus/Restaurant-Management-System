@using System.Net.Http.Json
@using Restaurant.Application.DTOs
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.JSInterop
@inject HttpClient Http
@inject IJSRuntime JS

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-sm p-2 sm:p-4 animate-fade-in select-none">
        <div class="bg-surface rounded-2xl shadow-2xl w-full h-full max-w-[98vw] max-h-[96vh] overflow-hidden border border-outline-variant flex flex-col">
            
            <!-- Header -->
            <div class="px-6 py-3.5 bg-primary text-on-primary flex justify-between items-center shrink-0">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-3xl">payments</span>
                    <div>
                        <h2 class="font-extrabold text-lg sm:text-xl m-0 tracking-wide uppercase">THANH TOÁN ĐƠN HÀNG @OrderCode</h2>
                        <span class="text-xs opacity-90">
                            Bàn: <strong class="text-white">@TableName</strong> | Khách hàng: @(_foundCustomer != null ? $"{_foundCustomer.FullName} ({_customerPhone})" : "Khách lẻ")
                        </span>
                    </div>
                </div>
                <button class="hover:bg-white/20 p-2 rounded-full transition-colors cursor-pointer text-white" @onclick="CloseAsync" title="Đóng">
                    <span class="material-symbols-outlined text-2xl">close</span>
                </button>
            </div>

            <!-- Body: 3-Column Grid without Page Scrollbars -->
            <div class="flex-1 grid grid-cols-12 gap-3 p-3 overflow-hidden bg-surface-low min-h-0">
                
                <!-- Column 1 (Left, 4 cols): Order Items Breakdown -->
                <div class="col-span-12 lg:col-span-4 bg-surface rounded-xl border border-outline-variant p-3.5 flex flex-col justify-between overflow-hidden shadow-xs min-h-0">
                    <div class="flex flex-col flex-1 min-h-0">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-on-surface-variant pb-2 border-b border-outline-variant flex items-center justify-between shrink-0">
                            <span class="flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-base">shopping_cart</span>
                                Danh Sách Món Đặt (@_orderItems.Sum(i => i.Quantity))
                            </span>
                            <span class="text-[11px] text-primary font-bold">@_orderItems.Count món</span>
                        </h3>

                        <!-- Scrollable items list: the ONLY scrollbar allowed -->
                        <div class="flex-1 overflow-y-auto space-y-2 my-2 pr-1 min-h-0">
                            @if (_isLoadingItems)
                            {
                                <div class="flex items-center justify-center h-32 gap-2 text-on-surface-variant">
                                    <div class="animate-spin rounded-full h-5 w-5 border-b-2 border-primary"></div>
                                    <span class="text-xs">Đang tải món...</span>
                                </div>
                            }
                            else if (!_orderItems.Any())
                            {
                                <div class="flex flex-col items-center justify-center h-32 text-on-surface-variant opacity-60">
                                    <span class="material-symbols-outlined text-3xl mb-1">receipt_long</span>
                                    <span class="text-xs">Không có dữ liệu món</span>
                                </div>
                            }
                            else
                            {
                                @foreach (var item in _orderItems)
                                {
                                    <div class="p-2.5 bg-surface-high/50 rounded-xl border border-outline-variant/60 flex justify-between items-center text-xs">
                                        <div class="flex-1 pr-2 min-w-0">
                                            <div class="font-bold text-on-surface truncate">@item.MenuItemName</div>
                                            <div class="text-[11px] text-on-surface-variant font-medium mt-0.5">
                                                @item.UnitPrice.ToString("N0")đ × <span class="font-extrabold text-primary">@item.Quantity</span>
                                            </div>
                                            @if (item.Modifiers != null && item.Modifiers.Any())
                                            {
                                                <div class="text-[10px] text-on-surface-variant opacity-80 truncate">
                                                    + @string.Join(", ", item.Modifiers)
                                                </div>
                                            }
                                        </div>
                                        <div class="font-extrabold text-primary text-right shrink-0">
                                            @item.TotalPrice.ToString("N0")đ
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <!-- Summary Breakdown Bottom (Sticky) -->
                    <div class="pt-2.5 border-t border-outline-variant space-y-1 shrink-0 bg-surface text-xs">
                        <div class="flex justify-between items-center text-on-surface-variant">
                            <span>Tạm tính món:</span>
                            <span class="font-bold text-on-surface whitespace-nowrap shrink-0 ml-2">@SubTotal.ToString("N0") đ</span>
                        </div>
                        @if (_memberDiscountAmount > 0)
                        {
                            <div class="flex justify-between items-center text-amber-600 dark:text-amber-400 font-bold">
                                <span class="flex items-center gap-1 min-w-0">
                                    <span class="material-symbols-outlined text-[13px] shrink-0">stars</span>
                                    <span class="whitespace-nowrap">Giảm TV (@GetShortTierName(_foundCustomer?.TierName) -@_foundCustomer?.DiscountPercent.ToString("G29")% món lẻ):</span>
                                </span>
                                <span class="whitespace-nowrap shrink-0 ml-2">-@_memberDiscountAmount.ToString("N0") đ</span>
                            </div>
                        }
                        @if (_discountAmount + AppliedDiscount > 0)
                        {
                            <div class="flex justify-between items-center text-emerald-600 font-bold">
                                <span>Giảm giá khác:</span>
                                <span class="whitespace-nowrap shrink-0 ml-2">-@((_discountAmount + AppliedDiscount).ToString("N0")) đ</span>
                            </div>
                        }
                        <div class="flex justify-between items-center text-on-surface-variant">
                            <span>Thuế (VAT 8% bóc tách):</span>
                            <span class="font-bold text-on-surface whitespace-nowrap shrink-0 ml-2">@TaxAmount.ToString("N0") đ</span>
                        </div>
                        <div class="flex justify-between items-center text-base font-extrabold text-on-surface pt-1.5 border-t border-outline-variant/60">
                            <span class="shrink-0">TỔNG CẦN THU:</span>
                            <span class="text-primary text-xl font-black whitespace-nowrap shrink-0 ml-2">@FinalAmount.ToString("N0") đ</span>
                        </div>
                    </div>
                </div>

                <!-- Column 2 (Middle, 3 cols): Payment Methods & Member/Voucher -->
                <div class="col-span-12 lg:col-span-3 bg-surface rounded-xl border border-outline-variant p-3.5 flex flex-col justify-between overflow-hidden shadow-xs min-h-0">
                    <div class="space-y-3">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-on-surface-variant pb-2 border-b border-outline-variant flex items-center gap-1.5 shrink-0">
                            <span class="material-symbols-outlined text-base">credit_card</span>
                            Phương Thức Thanh Toán
                        </h3>

                        <!-- Methods Selection -->
                        <div class="grid grid-cols-1 gap-2">
                            <!-- Method 1: Cash -->
                            <button class="w-full p-3 rounded-xl border-2 transition-all cursor-pointer flex items-center gap-3 text-left @(_activeTab == "Cash" ? "border-primary bg-primary/10 text-primary shadow-xs" : "border-outline-variant hover:bg-surface-high")"
                                    @onclick='() => SetTab("Cash")'>
                                <div class="w-9 h-9 rounded-lg bg-emerald-500/10 text-emerald-600 flex items-center justify-center shrink-0">
                                    <span class="material-symbols-outlined text-xl">local_atm</span>
                                </div>
                                <div>
                                    <div class="font-extrabold text-sm">Tiền Mặt</div>
                                    <div class="text-[11px] opacity-70">Nhận tiền mặt & thối lại</div>
                                </div>
                            </button>

                            <!-- Method 2: VietQR -->
                            <button class="w-full p-3 rounded-xl border-2 transition-all cursor-pointer flex items-center gap-3 text-left @(_activeTab == "VietQR" ? "border-primary bg-primary/10 text-primary shadow-xs" : "border-outline-variant hover:bg-surface-high")"
                                    @onclick='() => SetTab("VietQR")'>
                                <div class="w-9 h-9 rounded-lg bg-blue-500/10 text-blue-600 flex items-center justify-center shrink-0">
                                    <span class="material-symbols-outlined text-xl">qr_code_2</span>
                                </div>
                                <div>
                                    <div class="font-extrabold text-sm">Chuyển Khoản VietQR</div>
                                    <div class="text-[11px] opacity-70">Quét mã SePay tự động</div>
                                </div>
                            </button>
                        </div>

                        <!-- Member & Voucher Box -->
                        <div class="pt-2 border-t border-outline-variant space-y-2.5">
                            <!-- Customer Search -->
                            <div>
                                <label class="block text-[11px] font-bold text-on-surface-variant uppercase mb-1">Khách Hàng Thành Viên</label>
                                <div class="flex gap-1.5">
                                    <input type="text" class="w-full px-2.5 py-1.5 text-xs border rounded-lg focus:outline-none focus:ring-1 focus:ring-primary bg-surface"
                                           placeholder="Số điện thoại..." @bind="_customerPhone" />
                                    <button class="px-2.5 py-1.5 bg-secondary text-on-secondary rounded-lg font-bold text-xs shrink-0 hover:opacity-90 cursor-pointer"
                                            @onclick="SearchCustomerAsync">
                                        Tìm
                                    </button>
                                </div>
                                @if (_foundCustomer != null)
                                {
                                    <div class="mt-1.5 text-[11px] bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 p-2 rounded-lg flex justify-between items-center border border-emerald-500/20">
                                        <div class="truncate pr-1">
                                            <span class="font-bold">@_foundCustomer.FullName</span> (@_foundCustomer.TierName@(_foundCustomer.DiscountPercent > 0 ? $" - Giảm {_foundCustomer.DiscountPercent:G29}% món lẻ" : ""))
                                        </div>
                                        <span class="shrink-0 font-extrabold">Điểm: @_foundCustomer.AvailablePoints.ToString("N0")</span>
                                    </div>
                                }
                            </div>

                            <!-- Voucher input -->
                            <div>
                                <label class="block text-[11px] font-bold text-on-surface-variant uppercase mb-1">Mã Giảm Giá (Voucher)</label>
                                <div class="flex gap-1.5">
                                    <input type="text" class="w-full px-2.5 py-1.5 text-xs border rounded-lg focus:outline-none focus:ring-1 focus:ring-primary uppercase bg-surface"
                                           placeholder="Nhập mã..." @bind="_voucherCode" />
                                    <button class="px-2.5 py-1.5 bg-secondary text-on-secondary rounded-lg font-bold text-xs shrink-0 hover:opacity-90 cursor-pointer"
                                            @onclick="ApplyVoucher">
                                        Áp dụng
                                    </button>
                                </div>
                                @if (_discountAmount > 0)
                                {
                                    <div class="mt-1 text-[11px] text-primary font-bold">
                                        Đã giảm: -@_discountAmount.ToString("N0") đ
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Bottom Method Note -->
                    <div class="p-2.5 bg-surface-high rounded-xl border border-outline-variant text-[11px] text-on-surface-variant shrink-0 mt-2">
                        @if (_activeTab == "VietQR")
                        {
                            <span class="text-blue-700 dark:text-blue-300 font-medium">💡 Quét mã QR tĩnh hoặc theo đơn để test chuyển khoản, sau đó bấm xác nhận.</span>
                        }
                        else
                        {
                            <span>💡 Nhập số tiền khách đưa bằng bàn phím số hoặc chọn nhanh mệnh giá bên phải.</span>
                        }
                    </div>
                </div>

                <!-- Column 3 (Right, 5 cols): Numpad or VietQR Display (Strictly No Vertical Scrollbar) -->
                <div class="col-span-12 lg:col-span-5 bg-surface rounded-xl border border-outline-variant p-3.5 flex flex-col justify-between overflow-hidden shadow-xs min-h-0">
                    @if (_activeTab == "Cash")
                    {
                        <div class="flex flex-col justify-between h-full min-h-0">
                            <!-- Cash Display Card -->
                            <div class="bg-surface-high p-3 rounded-xl border border-outline-variant shrink-0">
                                <div class="flex items-center justify-between mb-0.5">
                                    <label class="block text-[11px] font-bold text-on-surface-variant uppercase m-0">Tiền Khách Trả (VNĐ)</label>
                                    <button class="px-2.5 py-1 text-xs font-black bg-rose-500/15 hover:bg-rose-500 hover:text-white text-rose-600 rounded-lg transition-all cursor-pointer flex items-center gap-1 shadow-2xs border border-rose-500/30"
                                            @onclick="ClearCashReceived" title="Đặt lại tiền khách trả về 0đ">
                                        <span class="material-symbols-outlined text-sm">restart_alt</span>
                                        XÓA (0đ)
                                    </button>
                                </div>
                                <div class="text-2xl sm:text-3xl font-black text-primary tracking-tight">
                                    @_cashReceived.ToString("N0") đ
                                </div>

                                <div class="mt-2 pt-2 border-t border-outline-variant flex justify-between items-center text-xs">
                                    @if (_cashReceived >= FinalAmount)
                                    {
                                        <span class="font-bold text-on-surface-variant">Tiền thừa trả khách:</span>
                                        <span class="font-black text-lg text-emerald-600">@ChangeAmount.ToString("N0") đ</span>
                                    }
                                    else
                                    {
                                        <span class="font-bold text-on-surface-variant">Còn thiếu:</span>
                                        <span class="font-black text-lg text-rose-600">@MissingAmount.ToString("N0") đ</span>
                                    }
                                </div>
                            </div>

                            <!-- Digital Numpad (Compact, Responsive) -->
                            <div class="grid grid-cols-3 gap-1.5 my-2">
                                @foreach (var digit in new[] { "1", "2", "3", "4", "5", "6", "7", "8", "9" })
                                {
                                    <button class="py-2.5 bg-surface-high hover:bg-primary/20 text-on-surface font-extrabold text-base rounded-xl border border-outline-variant transition-all active:scale-95 cursor-pointer shadow-2xs"
                                            @onclick="() => AppendDigit(digit)">
                                        @digit
                                    </button>
                                }
                                <button class="py-2.5 bg-rose-500/15 hover:bg-rose-500 hover:text-white text-rose-600 font-black text-xs sm:text-sm rounded-xl border border-rose-500/30 transition-all active:scale-95 cursor-pointer shadow-2xs flex items-center justify-center gap-1"
                                        @onclick="ClearCashReceived" title="Xóa và đặt lại tiền khách trả về 0">
                                    <span class="material-symbols-outlined text-base">restart_alt</span>
                                    <span>XÓA (0đ)</span>
                                </button>
                                <button class="py-2.5 bg-surface-high hover:bg-primary/20 text-on-surface font-extrabold text-base rounded-xl border border-outline-variant transition-all active:scale-95 cursor-pointer shadow-2xs"
                                        @onclick='() => AppendDigit("0")'>
                                    0
                                </button>
                                <button class="py-2.5 bg-error-container/20 hover:bg-error/30 text-error font-extrabold text-base rounded-xl border border-error/30 transition-all active:scale-95 cursor-pointer flex items-center justify-center shadow-2xs"
                                        @onclick="BackspaceDigit" title="Lùi 1 số">
                                    <span class="material-symbols-outlined text-lg">backspace</span>
                                </button>
                            </div>

                            <!-- Quick Denominations -->
                            <div class="mb-2 shrink-0">
                                <span class="text-[10px] font-bold text-on-surface-variant uppercase tracking-wider block mb-1">Mệnh giá nhanh (+Cộng dồn):</span>
                                <div class="grid grid-cols-3 gap-1.5">
                                    @foreach (var denom in new[] { 10000, 20000, 50000, 100000, 200000, 500000 })
                                    {
                                        <button class="py-2 bg-surface-high hover:bg-primary/10 text-on-surface font-bold text-xs rounded-xl border border-outline-variant transition-all cursor-pointer shadow-2xs"
                                                @onclick="() => AddDenomination(denom)">
                                            +@denom.ToString("N0")đ
                                        </button>
                                    }
                                </div>
                            </div>

                            <!-- Exact Match Button -->
                            <button class="w-full py-2 bg-amber-500/15 hover:bg-amber-500 hover:text-white text-amber-800 dark:text-amber-200 border border-amber-500/40 rounded-xl font-black text-xs transition-all cursor-pointer flex items-center justify-center gap-1.5 shrink-0 shadow-2xs"
                                    @onclick="SetExactAmount">
                                <span class="material-symbols-outlined text-base">fact_check</span>
                                KHỚP VỪA ĐỦ SỐ TIỀN (@FinalAmount.ToString("N0")đ)
                            </button>
                        </div>
                    }
                    else if (_activeTab == "VietQR")
                    {
                        <div class="flex flex-col items-center justify-between h-full py-1 text-center min-h-0 space-y-2">
                            @if (_isLoadingQr)
                            {
                                <div class="flex flex-col items-center justify-center h-full gap-3">
                                    <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-primary"></div>
                                    <span class="text-xs text-on-surface-variant font-medium">Đang tạo mã VietQR...</span>
                                </div>
                            }
                            else if (_isPaymentSuccess)
                            {
                                <div class="flex flex-col items-center justify-center h-full bg-emerald-500/10 p-6 rounded-2xl border border-emerald-500/30 text-emerald-700 dark:text-emerald-300 animate-fade-in w-full">
                                    <span class="material-symbols-outlined text-6xl text-emerald-600 mb-2">check_circle</span>
                                    <span class="font-black text-lg">Thanh toán thành công!</span>
                                    <span class="text-xs opacity-90 mt-1">Đơn hàng đã được xác nhận thanh toán.</span>
                                </div>
                            }
                            else if (_qrData != null)
                            {
                                <!-- Mode Selector: Static QR vs Dynamic Order QR -->
                                <div class="inline-flex p-1 bg-surface-high rounded-xl border border-outline-variant text-xs font-bold shrink-0">
                                    <button type="button"
                                            class="px-3 py-1 rounded-lg transition-all cursor-pointer @(_qrViewMode == "Static" ? "bg-primary text-on-primary shadow-xs" : "text-on-surface hover:text-primary")"
                                            @onclick='() => _qrViewMode = "Static"'>
                                        <span class="material-symbols-outlined text-sm align-middle mr-1">qr_code_2</span>
                                        Mã QR Tĩnh (Tài Khoản)
                                    </button>
                                    <button type="button"
                                            class="px-3 py-1 rounded-lg transition-all cursor-pointer @(_qrViewMode == "Order" ? "bg-primary text-on-primary shadow-xs" : "text-on-surface hover:text-primary")"
                                            @onclick='() => _qrViewMode = "Order"'>
                                        <span class="material-symbols-outlined text-sm align-middle mr-1">receipt</span>
                                        Mã QR Đơn (@FinalAmount.ToString("N0")đ)
                                    </button>
                                </div>

                                <!-- QR Image Display -->
                                <div class="bg-white p-2.5 rounded-2xl border-2 border-primary/20 shadow-md flex items-center justify-center shrink-0">
                                    <img src="@DisplayQrUrl" alt="VietQR TPBank" class="w-44 h-44 sm:w-48 sm:h-48 object-contain rounded-lg" />
                                </div>

                                <!-- Account details card with 1-click copy -->
                                <div class="space-y-1.5 my-0.5 w-full max-w-sm text-xs bg-surface-high/60 p-2.5 rounded-xl border border-outline-variant text-left">
                                    <div class="flex items-center justify-between">
                                        <span class="text-on-surface-variant font-medium">Ngân hàng:</span>
                                        <span class="font-black text-primary">TPBank (Tiên Phong)</span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-on-surface-variant font-medium">Số tài khoản:</span>
                                        <div class="flex items-center gap-1.5">
                                            <span class="font-mono font-black text-on-surface select-all text-sm">@_qrData.BankAccountNo</span>
                                            <button type="button" class="p-1 hover:bg-primary/10 rounded text-primary transition-colors cursor-pointer flex items-center"
                                                    @onclick='() => CopyToClipboardAsync(_qrData.BankAccountNo, "stk")' title="Sao chép STK">
                                                <span class="material-symbols-outlined text-base">@(_copiedField == "stk" ? "done" : "content_copy")</span>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-on-surface-variant font-medium">Chủ tài khoản:</span>
                                        <span class="font-extrabold uppercase text-on-surface">@_qrData.AccountHolder</span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-on-surface-variant font-medium">Số tiền:</span>
                                        <div class="flex items-center gap-1.5">
                                            <span class="font-black text-primary text-sm select-all">@FinalAmount.ToString("N0") đ</span>
                                            <button type="button" class="p-1 hover:bg-primary/10 rounded text-primary transition-colors cursor-pointer flex items-center"
                                                    @onclick='() => CopyToClipboardAsync(FinalAmount.ToString("0"), "amount")' title="Sao chép số tiền">
                                                <span class="material-symbols-outlined text-base">@(_copiedField == "amount" ? "done" : "content_copy")</span>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-on-surface-variant font-medium">Nội dung CK:</span>
                                        <div class="flex items-center gap-1.5">
                                            <span class="font-mono bg-surface px-1.5 py-0.5 rounded text-primary font-black border border-primary/30 select-all">@_qrData.SepayContent</span>
                                            <button type="button" class="p-1 hover:bg-primary/10 rounded text-primary transition-colors cursor-pointer flex items-center"
                                                    @onclick='() => CopyToClipboardAsync(_qrData.SepayContent, "memo")' title="Sao chép nội dung">
                                                <span class="material-symbols-outlined text-base">@(_copiedField == "memo" ? "done" : "content_copy")</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Testing instructions banner -->
                                <div class="bg-amber-500/10 border border-amber-500/30 rounded-xl p-2 text-[11px] text-amber-900 dark:text-amber-100 text-left space-y-0.5 w-full max-w-sm">
                                    <div class="font-bold flex items-center gap-1 text-amber-800 dark:text-amber-200">
                                        <span class="material-symbols-outlined text-sm">verified_user</span>
                                        <span>Chế độ kiểm thử mã QR tĩnh</span>
                                    </div>
                                    <p class="m-0 text-[10.5px] opacity-90 leading-tight">
                                        Quét mã chuyển khoản để test. Khi test xong, bấm <strong>"XÁC NHẬN ĐÃ NHẬN CHUYỂN KHOẢN"</strong> để hoàn tất đơn hàng.
                                    </p>
                                </div>
                            }
                            else
                            {
                                <div class="flex flex-col items-center justify-center h-full gap-3">
                                    <button class="px-6 py-3 bg-primary text-on-primary rounded-xl font-bold hover:bg-primary/90 flex items-center gap-2 cursor-pointer shadow-md text-sm"
                                            @onclick="GenerateQrCodeAsync">
                                        <span class="material-symbols-outlined">qr_code_2</span>
                                        Tạo Mã VietQR
                                    </button>
                                </div>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="p-2 bg-error-container text-error rounded-xl text-xs font-bold mt-2 shrink-0">
                            @_errorMessage
                        </div>
                    }
                </div>
            </div>

            <!-- Footer: HUỶ (Red) & IN TẠM TÍNH & XÁC NHẬN (Green) -->
            <div class="px-6 py-3.5 bg-surface border-t border-outline-variant flex justify-between items-center shrink-0">
                <!-- Nút HUỶ (Đỏ) -->
                <button class="px-5 py-2.5 bg-rose-600 text-white hover:bg-rose-700 rounded-xl font-extrabold text-xs sm:text-sm transition-all cursor-pointer shadow-sm flex items-center gap-2"
                        @onclick="CloseAsync">
                    <span class="material-symbols-outlined text-lg">cancel</span>
                    HUỶ THANH TOÁN
                </button>

                <!-- Nút In Tạm Tính -->
                <button class="px-4 py-2.5 bg-surface-high text-on-surface hover:bg-surface-high/80 rounded-xl font-bold text-xs sm:text-sm flex items-center gap-1.5 border border-outline-variant cursor-pointer"
                        @onclick="PrintTempBillAsync">
                    <span class="material-symbols-outlined text-base">print</span>
                    In Tạm Tính
                </button>

                <!-- Nút XÁC NHẬN (Xanh lá - Active when CashReceived >= FinalAmount or in VietQR tab) -->
                <button class="px-7 py-2.5 bg-emerald-600 text-white hover:bg-emerald-700 disabled:bg-gray-300 disabled:text-gray-500 disabled:cursor-not-allowed rounded-xl font-extrabold text-xs sm:text-base transition-all cursor-pointer shadow-md flex items-center gap-2"
                        disabled="@((_activeTab == "Cash" && _cashReceived < FinalAmount) || _isProcessing)"
                        @onclick="ConfirmPaymentAsync">
                    <span class="material-symbols-outlined text-xl">@(_activeTab == "VietQR" ? "task_alt" : "check_circle")</span>
                    @(_activeTab == "VietQR" ? "XÁC NHẬN ĐÃ NHẬN CHUYỂN KHOẢN" : "XÁC NHẬN THANH TOÁN")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public int OrderId { get; set; }
    [Parameter] public string OrderCode { get; set; } = string.Empty;
    [Parameter] public string TableName { get; set; } = string.Empty;
    [Parameter] public decimal SubTotal { get; set; }
    [Parameter] public decimal AppliedDiscount { get; set; } = 0m;
    [Parameter] public int? CustomerId { get; set; }
    [Parameter] public string? CustomerPhone { get; set; }
    [Parameter] public EventCallback<bool> OnPaymentCompleted { get; set; }

    private string _activeTab = "Cash";
    private string _qrViewMode = "Static"; // "Static" (mã tĩnh quầy) vs "Order" (mã theo đơn hàng)
    private string _copiedField = string.Empty;
    private decimal _cashReceived = 0; // Mặc định = 0 theo yêu cầu
    private string _voucherCode = string.Empty;
    private decimal _discountAmount;
    private string _customerPhone = string.Empty;
    private CustomerDto? _foundCustomer;
    private VietQrResponse? _qrData;
    private bool _isLoadingQr;
    private bool _isLoadingItems;
    private bool _isProcessing;
    private string _errorMessage = string.Empty;
    private bool _isPaymentSuccess = false;
    private HubConnection? _hubConnection;
    private List<TakeawayOrderItemDto> _orderItems = new();

    private decimal _memberDiscountAmount
    {
        get
        {
            if (_foundCustomer == null || _foundCustomer.DiscountPercent <= 0) return 0m;
            decimal eligible = _orderItems.Where(i => !i.ParentItemId.HasValue && !i.ComboGroupId.HasValue && i.UnitPrice > 0).Sum(i => i.UnitPrice * i.Quantity);
            if (eligible == 0 && SubTotal > 0 && !_orderItems.Any())
            {
                eligible = SubTotal;
            }
            return Math.Round(eligible * (_foundCustomer.DiscountPercent / 100m));
        }
    }
    private decimal _totalDiscount => _discountAmount + AppliedDiscount + _memberDiscountAmount;
    private decimal FinalAmount => Math.Max(0, SubTotal - _totalDiscount);
    private decimal TaxAmount => Math.Round(FinalAmount - (FinalAmount / 1.08m), 0);
    private decimal ChangeAmount => Math.Max(0, _cashReceived - FinalAmount);
    private decimal MissingAmount => Math.Max(0, FinalAmount - _cashReceived);

    private string DisplayQrUrl
    {
        get
        {
            if (_qrData == null) return string.Empty;
            return _qrViewMode == "Static"
                ? (!string.IsNullOrEmpty(_qrData.StaticQrUrl) ? _qrData.StaticQrUrl : _qrData.QrImageUrl)
                : (!string.IsNullOrEmpty(_qrData.SepayQrUrl) ? _qrData.SepayQrUrl : _qrData.QrImageUrl);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _hubConnection = new HubConnectionBuilder()
            .WithUrl("http://localhost:5011/hubs/restaurant")
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<int>("OrderPaid", async (orderId) =>
        {
            if (orderId == OrderId)
            {
                _isPaymentSuccess = true;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(1500);
                await CloseAsync();
                await OnPaymentCompleted.InvokeAsync(true);
            }
        });

        try
        {
            await _hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SignalR error in PosPaymentModal: {ex.Message}");
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && OrderId > 0 && !_orderItems.Any())
        {
            _cashReceived = 0; // Default = 0
            _customerPhone = CustomerPhone ?? string.Empty;
            await LoadOrderDetailsAsync();
            if (!string.IsNullOrEmpty(_customerPhone))
            {
                await SearchCustomerAsync();
            }
        }
    }

    private async Task LoadOrderDetailsAsync()
    {
        _isLoadingItems = true;
        try
        {
            var resp = await Http.GetFromJsonAsync<ApiResponseWrapper<TakeawayOrderDto>>($"api/v1/pos/takeaway/orders/{OrderId}");
            if (resp?.Data != null)
            {
                _orderItems = resp.Data.Items ?? new();
                if (SubTotal == 0) SubTotal = resp.Data.SubTotal;
                if (_foundCustomer == null && !string.IsNullOrEmpty(resp.Data.CustomerPhone))
                {
                    _customerPhone = resp.Data.CustomerPhone;
                    await SearchCustomerAsync();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading order items: {ex.Message}");
        }
        finally
        {
            _isLoadingItems = false;
        }
    }

    private async Task SetTab(string tab)
    {
        _activeTab = tab;
        _errorMessage = string.Empty;
        if (tab == "VietQR" && _qrData == null)
        {
            await GenerateQrCodeAsync();
        }
    }

    private void ClearCashReceived()
    {
        _cashReceived = 0;
    }

    private void AppendDigit(string digit)
    {
        var currentStr = _cashReceived.ToString("F0");
        if (currentStr == "0") currentStr = "";
        currentStr += digit;
        if (decimal.TryParse(currentStr, out decimal parsed))
        {
            _cashReceived = parsed;
        }
    }

    private void BackspaceDigit()
    {
        var currentStr = _cashReceived.ToString("F0");
        if (currentStr.Length <= 1)
        {
            _cashReceived = 0;
        }
        else
        {
            currentStr = currentStr.Substring(0, currentStr.Length - 1);
            if (decimal.TryParse(currentStr, out decimal parsed))
            {
                _cashReceived = parsed;
            }
        }
    }

    private void AddDenomination(decimal amount)
    {
        _cashReceived += amount;
    }

    private void SetExactAmount()
    {
        _cashReceived = FinalAmount;
    }

    private async Task CopyToClipboardAsync(string text, string fieldName)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            _copiedField = fieldName;
            StateHasChanged();
            await Task.Delay(2000);
            if (_copiedField == fieldName)
            {
                _copiedField = string.Empty;
                StateHasChanged();
            }
        }
        catch { }
    }

    private async Task GenerateQrCodeAsync()
    {
        _isLoadingQr = true;
        _errorMessage = string.Empty;
        try
        {
            var req = new GenerateVietQrRequest
            {
                OrderId = OrderId,
                BankName = "TPBank",
                BankAccountNo = "11102042003"
            };
            var response = await Http.PostAsJsonAsync("api/v1/payments/vietqr", req);
            if (response.IsSuccessStatusCode)
            {
                var wrapper = await response.Content.ReadFromJsonAsync<ApiResponseWrapper<VietQrResponse>>();
                if (wrapper?.Success == true && wrapper.Data != null)
                {
                    _qrData = wrapper.Data;
                }
                else
                {
                    _qrData = await response.Content.ReadFromJsonAsync<VietQrResponse>();
                }
            }
            else
            {
                _errorMessage = "Không thể tạo mã VietQR.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Lỗi: {ex.Message}";
        }
        finally
        {
            _isLoadingQr = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SearchCustomerAsync()
    {
        if (string.IsNullOrWhiteSpace(_customerPhone)) return;
        try
        {
            var resp = await Http.GetFromJsonAsync<CustomerDto>($"api/v1/customers/by-phone/{_customerPhone}");
            _foundCustomer = resp;
        }
        catch
        {
            _foundCustomer = null;
        }
    }

    private void ApplyVoucher()
    {
        if (string.IsNullOrWhiteSpace(_voucherCode)) return;
        if (_voucherCode.Equals("GIAM10", StringComparison.OrdinalIgnoreCase))
        {
            _discountAmount = SubTotal * 0.10m;
        }
        else if (_voucherCode.Equals("GIAM20", StringComparison.OrdinalIgnoreCase))
        {
            _discountAmount = SubTotal * 0.20m;
        }
        else
        {
            _discountAmount = 20000;
        }
    }

    private async Task ConfirmPaymentAsync()
    {
        if (_activeTab == "Cash" && _cashReceived < FinalAmount) return;

        _isProcessing = true;
        _errorMessage = string.Empty;

        try
        {
            var req = new ProcessCashPaymentRequest
            {
                OrderId = OrderId,
                CashReceived = _activeTab == "Cash" ? _cashReceived : FinalAmount,
                CustomerId = _foundCustomer?.Id ?? CustomerId,
                VoucherCode = string.IsNullOrEmpty(_voucherCode) ? null : _voucherCode,
                PaymentMethod = _activeTab == "VietQR" ? 1 : 0
            };

            var res = await Http.PostAsJsonAsync("api/v1/payments/cash", req);
            if (res.IsSuccessStatusCode)
            {
                await CloseAsync();
                await OnPaymentCompleted.InvokeAsync(true);
            }
            else
            {
                var body = await res.Content.ReadAsStringAsync();
                _errorMessage = $"Lỗi xử lý thanh toán: {body}";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Lỗi ngoại lệ: {ex.Message}";
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task PrintTempBillAsync()
    {
        try
        {
            var url = $"api/v1/bills/{OrderId}/k80";
            // Call print bill or trigger print
            await Http.GetAsync(url);
        }
        catch { }
    }

    private async Task CloseAsync()
    {
        IsOpen = false;
        _cashReceived = 0;
        _orderItems.Clear();
        _qrData = null;
        _errorMessage = string.Empty;
        await IsOpenChanged.InvokeAsync(false);
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection != null)
        {
            await _hubConnection.DisposeAsync();
        }
    }

    private string GetShortTierName(string? tierName)
    {
        if (string.IsNullOrWhiteSpace(tierName)) return "Thành viên";
        var name = tierName.Replace("Thành viên", "", StringComparison.OrdinalIgnoreCase).Trim();
        var parenIndex = name.IndexOf('(');
        if (parenIndex > 0)
        {
            name = name.Substring(0, parenIndex).Trim();
        }
        return string.IsNullOrWhiteSpace(name) ? tierName : name;
    }

    private class ApiResponseWrapper<T>
    {
        public bool Success { get; set; }
        public T? Data { get; set; }
    }
}

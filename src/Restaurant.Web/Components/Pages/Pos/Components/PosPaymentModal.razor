@using System.Net.Http.Json
@using Restaurant.Application.DTOs
@using Microsoft.AspNetCore.SignalR.Client
@inject HttpClient Http

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4 animate-fade-in">
        <div class="bg-surface dark:bg-inverse-surface rounded-2xl shadow-2xl w-full max-w-2xl overflow-hidden border border-outline-variant flex flex-col max-h-[90vh]">
            <!-- Header -->
            <div class="px-6 py-4 bg-primary text-on-primary flex justify-between items-center shrink-0">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-2xl">payments</span>
                    <div>
                        <h2 class="font-bold text-lg m-0">Thanh Toán Đơn Hàng @OrderCode</h2>
                        <span class="text-xs opacity-80">Bàn: @TableName</span>
                    </div>
                </div>
                <button class="hover:bg-white/20 p-1 rounded-full transition-colors" @onclick="CloseAsync">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <!-- Body -->
            <div class="p-6 overflow-y-auto space-y-6 flex-1">
                <!-- Summary Card -->
                <div class="bg-surface-low dark:bg-surface-high p-4 rounded-xl border border-outline-variant grid grid-cols-2 gap-4">
                    <div>
                        <span class="text-xs text-on-surface-variant block">TẠM TÍNH MÓN</span>
                        <span class="font-bold text-lg text-on-surface">@SubTotal.ToString("N0") đ</span>
                    </div>
                    <div>
                        <span class="text-xs text-on-surface-variant block">GIẢM GIÁ</span>
                        <span class="font-bold text-lg text-on-surface">@_totalDiscount.ToString("N0") đ</span>
                    </div>
                    <div>
                        <span class="text-xs text-on-surface-variant block">THUẾ VAT (8%)</span>
                        <span class="font-bold text-lg text-on-surface">@TaxAmount.ToString("N0") đ</span>
                    </div>
                    <div>
                        <span class="text-xs text-on-surface-variant block">TỔNG TIỀN CẦN THU</span>
                        <span class="font-bold text-2xl text-primary">@FinalAmount.ToString("N0") đ</span>
                    </div>
                </div>

                <!-- Customer & Voucher Search -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Customer search -->
                    <div>
                        <label class="block text-xs font-bold text-on-surface-variant uppercase mb-1">Khách Hàng Thành Viên</label>
                        <div class="flex gap-2">
                            <input type="text" class="w-full px-3 py-2 text-sm border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary"
                                   placeholder="Số điện thoại..." @bind="_customerPhone" />
                            <button class="px-3 py-2 bg-secondary text-on-secondary rounded-lg font-bold text-xs shrink-0 hover:opacity-90"
                                    @onclick="SearchCustomerAsync">
                                Tìm
                            </button>
                        </div>
                        @if (_foundCustomer != null)
                        {
                            <div class="mt-2 text-xs bg-success-container/20 text-success p-2 rounded-lg flex justify-between items-center">
                                <div>
                                    <span class="font-bold">@_foundCustomer.FullName</span> (@_foundCustomer.TierName)
                                </div>
                                <span>Điểm: @_foundCustomer.AvailablePoints</span>
                            </div>
                        }
                    </div>

                    <!-- Voucher code -->
                    <div>
                        <label class="block text-xs font-bold text-on-surface-variant uppercase mb-1">Mã Giảm Giá (Voucher)</label>
                        <div class="flex gap-2">
                            <input type="text" class="w-full px-3 py-2 text-sm border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary uppercase"
                                   placeholder="Nhập mã voucher..." @bind="_voucherCode" />
                            <button class="px-3 py-2 bg-secondary text-on-secondary rounded-lg font-bold text-xs shrink-0 hover:opacity-90"
                                    @onclick="ApplyVoucher">
                                Áp dụng
                            </button>
                        </div>
                        @if (_discountAmount > 0)
                        {
                            <div class="mt-2 text-xs text-primary font-bold">
                                Đã giảm: -@_discountAmount.ToString("N0") đ
                            </div>
                        }
                    </div>
                </div>

                <!-- Tabs Payment Method -->
                <div>
                    <div class="flex border-b border-outline-variant mb-4">
                        <button class="px-4 py-2 font-bold text-sm border-b-2 transition-colors flex items-center gap-2 @(_activeTab == "Cash" ? "border-primary text-primary" : "border-transparent text-on-surface-variant")"
                                @onclick='() => SetTab("Cash")'>
                            <span class="material-symbols-outlined text-[18px]">local_atm</span>
                            Tiền Mặt
                        </button>
                        <button class="px-4 py-2 font-bold text-sm border-b-2 transition-colors flex items-center gap-2 @(_activeTab == "VietQR" ? "border-primary text-primary" : "border-transparent text-on-surface-variant")"
                                @onclick='() => SetTab("VietQR")'>
                            <span class="material-symbols-outlined text-[18px]">qr_code_2</span>
                            Chuyển Khoản VietQR
                        </button>
                    </div>

                    @if (_activeTab == "Cash")
                    {
                        <div class="space-y-4">
                            <div>
                                <label class="block text-xs font-bold text-on-surface-variant uppercase mb-1">Tiền Khách Đưa</label>
                                <input type="number" class="w-full text-xl font-bold px-4 py-3 border-2 border-primary rounded-xl text-primary focus:outline-none"
                                       @bind="_cashReceived" @bind:event="oninput" />
                            </div>

                            <!-- Quick Cash Presets -->
                            <div class="flex flex-wrap gap-2">
                                <button class="px-3 py-2 bg-surface-high hover:bg-primary/10 text-on-surface text-xs font-bold rounded-lg border border-outline-variant"
                                        @onclick="() => _cashReceived = FinalAmount">
                                    Vừa đủ (@FinalAmount.ToString("N0")đ)
                                </button>
                                <button class="px-3 py-2 bg-surface-high hover:bg-primary/10 text-on-surface text-xs font-bold rounded-lg border border-outline-variant"
                                        @onclick="() => _cashReceived = RoundUp(FinalAmount, 50000)">
                                    +50k (@RoundUp(FinalAmount, 50000).ToString("N0")đ)
                                </button>
                                <button class="px-3 py-2 bg-surface-high hover:bg-primary/10 text-on-surface text-xs font-bold rounded-lg border border-outline-variant"
                                        @onclick="() => _cashReceived = RoundUp(FinalAmount, 100000)">
                                    +100k (@RoundUp(FinalAmount, 100000).ToString("N0")đ)
                                </button>
                                <button class="px-3 py-2 bg-surface-high hover:bg-primary/10 text-on-surface text-xs font-bold rounded-lg border border-outline-variant"
                                        @onclick="() => _cashReceived = RoundUp(FinalAmount, 500000)">
                                    +500k (@RoundUp(FinalAmount, 500000).ToString("N0")đ)
                                </button>
                            </div>

                            <!-- Change Calculation -->
                            <div class="bg-surface-low p-4 rounded-xl flex justify-between items-center border">
                                <span class="font-bold text-sm text-on-surface-variant">Tiền thừa trả khách:</span>
                                <span class="font-bold text-xl @(ChangeAmount >= 0 ? "text-success" : "text-error")">
                                    @ChangeAmount.ToString("N0") đ
                                </span>
                            </div>
                        </div>
                    }
                    else if (_activeTab == "VietQR")
                    {
                        <div class="flex flex-col items-center justify-center space-y-4 py-2">
                            @if (_isLoadingQr)
                            {
                                <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-primary"></div>
                                <span class="text-sm text-on-surface-variant font-medium">Đang tạo mã VietQR...</span>
                            }
                            else if (_isPaymentSuccess)
                            {
                                <div class="bg-white p-6 rounded-xl border shadow-md flex flex-col items-center">
                                    <span class="material-symbols-outlined text-6xl text-success mb-2">check_circle</span>
                                    <span class="font-bold text-lg text-success">Thanh toán thành công!</span>
                                </div>
                            }
                            else if (_qrData != null)
                            {
                                <div class="bg-white p-3 rounded-xl border shadow-md">
                                    <img src="@_qrData.QrImageUrl" alt="VietQR Code" class="w-56 h-56 object-contain" />
                                </div>
                                <div class="text-center space-y-1">
                                    <p class="font-bold text-sm text-on-surface">Số tiền: <span class="text-primary text-lg">@_qrData.Amount.ToString("N0") đ</span></p>
                                    <p class="text-xs text-on-surface-variant">Nội dung chuyển khoản: <span class="font-mono bg-surface-high px-2 py-1 rounded text-primary font-bold">@_qrData.SepayContent</span></p>
                                    <p class="text-xs text-gray-500 italic mt-1">Hệ thống sẽ tự động xác nhận sau khi quét QR thành công.</p>
                                </div>
                            }
                            else
                            {
                                <button class="px-6 py-3 bg-primary text-on-primary rounded-xl font-bold hover:bg-primary-container"
                                        @onclick="GenerateQrCodeAsync">
                                    Tạo Mã VietQR
                                </button>
                            }
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="bg-error-container text-error p-3 rounded-lg text-sm font-medium">
                        @_errorMessage
                    </div>
                }
            </div>

            <!-- Footer -->
            <div class="px-6 py-4 bg-surface-low dark:bg-surface-high border-t border-outline-variant flex justify-between items-center shrink-0">
                <button class="px-4 py-2 bg-secondary/10 text-secondary hover:bg-secondary/20 rounded-xl font-bold text-sm flex items-center gap-2"
                        @onclick="PrintTempBillAsync">
                    <span class="material-symbols-outlined text-[18px]">print</span>
                    In Tạm Tính
                </button>

                <div class="flex gap-3">
                    <button class="px-4 py-2 border border-outline-variant text-on-surface rounded-xl font-bold text-sm hover:bg-surface-high"
                            @onclick="CloseAsync">
                        Hủy
                    </button>
                    <button class="px-6 py-2 bg-primary text-on-primary rounded-xl font-bold text-sm hover:bg-primary-container shadow-md flex items-center gap-2"
                            disabled="@(_activeTab == "Cash" && _cashReceived < FinalAmount)"
                            @onclick="ConfirmPaymentAsync">
                        <span class="material-symbols-outlined text-[18px]">check_circle</span>
                        Hoàn Tất Thanh Toán
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public int OrderId { get; set; }
    [Parameter] public string OrderCode { get; set; } = string.Empty;
    [Parameter] public string TableName { get; set; } = string.Empty;
    [Parameter] public decimal SubTotal { get; set; }
    [Parameter] public decimal AppliedDiscount { get; set; } = 0m;
    [Parameter] public int? CustomerId { get; set; }
    [Parameter] public string? CustomerPhone { get; set; }
    [Parameter] public EventCallback<bool> OnPaymentCompleted { get; set; }

    private string _activeTab = "Cash";
    private decimal _cashReceived;
    private string _voucherCode = string.Empty;
    private decimal _discountAmount;
    private string _customerPhone = string.Empty;
    private CustomerDto? _foundCustomer;
    private VietQrResponse? _qrData;
    private bool _isLoadingQr;
    private string _errorMessage = string.Empty;
    private bool _isPaymentSuccess = false;
    private HubConnection? _hubConnection;

    private decimal _totalDiscount => _discountAmount + AppliedDiscount;
    private decimal TaxAmount => Math.Round(Math.Max(0, SubTotal - _totalDiscount) * 0.08m, 0);
    private decimal FinalAmount => Math.Max(0, SubTotal - _totalDiscount + TaxAmount);
    private decimal ChangeAmount => _cashReceived - FinalAmount;

    protected override async Task OnInitializedAsync()
    {
        _customerPhone = CustomerPhone ?? string.Empty;
        if (!string.IsNullOrEmpty(_customerPhone))
        {
            await SearchCustomerAsync();
        }

        _hubConnection = new HubConnectionBuilder()
            .WithUrl("http://localhost:5011/hubs/restaurant")
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<int>("OrderPaid", async (orderId) =>
        {
            if (orderId == OrderId)
            {
                _isPaymentSuccess = true;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(1500);
                await CloseAsync();
                await OnPaymentCompleted.InvokeAsync(true);
            }
        });

        try
        {
            await _hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SignalR error: {ex.Message}");
        }
    }

    protected override void OnParametersSet()
    {
        if (IsOpen && _cashReceived == 0)
        {
            _cashReceived = SubTotal;
        }
    }

    private void SetTab(string tab)
    {
        _activeTab = tab;
        if (tab == "VietQR" && _qrData == null)
        {
            _ = GenerateQrCodeAsync();
        }
    }

    private async Task SearchCustomerAsync()
    {
        if (string.IsNullOrWhiteSpace(_customerPhone)) return;
        try
        {
            var result = await Http.GetFromJsonAsync<CustomerDto>($"api/v1/crm/customers/phone/{_customerPhone}");
            _foundCustomer = result;
        }
        catch
        {
            _foundCustomer = null;
        }
    }

    private async Task ApplyVoucher()
    {
        if (string.IsNullOrWhiteSpace(_voucherCode)) return;
        _errorMessage = string.Empty;
        try
        {
            var res = await Http.GetAsync($"api/v1/vouchers/validate?code={Uri.EscapeDataString(_voucherCode.Trim())}&orderAmount={SubTotal}");
            if (res.IsSuccessStatusCode)
            {
                var valResult = await res.Content.ReadFromJsonAsync<VoucherValidationResponseDto>();
                if (valResult != null && valResult.IsValid)
                {
                    _discountAmount = valResult.DiscountAmount;
                }
                else
                {
                    _discountAmount = 0;
                    _errorMessage = valResult?.Message ?? "Mã giảm giá không hợp lệ.";
                }
            }
            else
            {
                _errorMessage = "Không thể kiểm tra mã giảm giá.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task GenerateQrCodeAsync()
    {
        if (OrderId <= 0) return;
        _isLoadingQr = true;
        _errorMessage = string.Empty;
        try
        {
            var req = new GenerateVietQrRequest { OrderId = OrderId };
            var res = await Http.PostAsJsonAsync("api/v1/payments/generate-vietqr", req);
            if (res.IsSuccessStatusCode)
            {
                var body = await res.Content.ReadFromJsonAsync<ApiResponseWrapper<VietQrResponse>>();
                _qrData = body?.Data;
            }
            else
            {
                _errorMessage = "Không thể sinh mã VietQR.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoadingQr = false;
        }
    }

    private async Task PrintTempBillAsync()
    {
        if (OrderId <= 0) return;
        try
        {
            var res = await Http.PostAsync($"api/v1/pos/orders/{OrderId}/print-temp-bill", null);
            if (res.IsSuccessStatusCode)
            {
                await CloseAsync();
                await OnPaymentCompleted.InvokeAsync(false);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task ConfirmPaymentAsync()
    {
        if (OrderId <= 0) return;
        _errorMessage = string.Empty;
        try
        {
            if (_activeTab == "Cash")
            {
                var request = new ProcessCashPaymentRequest
                {
                    OrderId = OrderId,
                    CashReceived = _cashReceived,
                    CustomerId = _foundCustomer?.Id ?? CustomerId,
                    VoucherCode = _voucherCode
                };

                var res = await Http.PostAsJsonAsync("api/v1/payments/cash", request);
                if (res.IsSuccessStatusCode)
                {
                    await CloseAsync();
                    await OnPaymentCompleted.InvokeAsync(true);
                }
                else
                {
                    var err = await res.Content.ReadAsStringAsync();
                    _errorMessage = $"Thanh toán thất bại: {err}";
                }
            }
            else if (_activeTab == "VietQR")
            {
                _errorMessage = "Vui lòng chờ khách hàng quét mã VietQR và hệ thống xác nhận tự động.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private decimal RoundUp(decimal amount, decimal step)
    {
        if (step <= 0) return amount;
        return Math.Ceiling(amount / step) * step;
    }

    private async Task CloseAsync()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }

    private class ApiResponseWrapper<T>
    {
        public bool Success { get; set; }
        public T? Data { get; set; }
    }
}

@using Restaurant.Web.Components.UI.Buttons
@inject NavigationManager Navigation

<div class="pos-cart">
    <!-- Header -->
    <div class="pos-cart__header">
        <div class="pos-cart__info">
            <h4 class="pos-cart__title">Bàn: @TableName</h4>
            <span class="pos-cart__code">@OrderCode</span>
        </div>
        <div class="pos-cart__user">
            <span>👤 Thu Ngân</span>
        </div>
    </div>
    
    <!-- Item List -->
    <div class="pos-cart__items">
        @if (Items == null || !Items.Any())
        {
            <div class="pos-cart__empty">
                <p>Chưa có món nào được chọn</p>
            </div>
        }
        else
        {
            @foreach (var item in Items)
            {
                <div class="pos-cart-item">
                    <div class="pos-cart-item__main">
                        <div class="pos-cart-item__name">@item.Name</div>
                        <div class="pos-cart-item__price">@((item.Price * item.Quantity).ToString("N0"))đ</div>
                    </div>
                    
                    <div class="pos-cart-item__actions">
                        <div class="pos-cart-item__qty-control">
                            <button class="pos-cart-item__qty-btn" disabled="@_isProcessing" @onclick="() => HandleUpdateQuantityAsync(item, item.Quantity - 1)">-</button>
                            <span class="pos-cart-item__qty-val">@item.Quantity</span>
                            <button class="pos-cart-item__qty-btn" disabled="@_isProcessing" @onclick="() => HandleUpdateQuantityAsync(item, item.Quantity + 1)">+</button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
    
    <!-- Summary -->
    <div class="pos-cart__summary">
        <div class="pos-cart__summary-row">
            <span>Subtotal:</span>
            <span>@Subtotal.ToString("N0")đ</span>
        </div>
        <div class="pos-cart__summary-row pos-cart__summary-row--discount">
            <span>Giảm giá:</span>
            <span>-@Discount.ToString("N0")đ</span>
        </div>
        <div class="pos-cart__summary-row">
            <span>Thuế (VAT 8%):</span>
            <span>@Tax.ToString("N0")đ</span>
        </div>
        
        <div class="pos-cart__summary-total">
            <span>Tổng thanh toán:</span>
            <span class="pos-cart__total-val">@Total.ToString("N0")đ</span>
        </div>
    </div>
    
    <!-- Actions -->
    <div class="pos-cart__actions">
        <div class="pos-cart__actions-top">
            <AppButton Variant="Secondary" Disabled="Items == null || !Items.Any() || _isProcessing" OnClick="HandleSendToKitchenAsync">
                Gửi Bếp
            </AppButton>
            <AppButton Variant="Outline" Disabled="@_isProcessing" OnClick='() => Navigation.NavigateTo("/pos")'>
                Chuyển Bàn
            </AppButton>
            <AppButton Variant="Outline" Disabled="@_isProcessing" OnClick='() => Navigation.NavigateTo("/pos")'>
                Gộp Bàn
            </AppButton>
        </div>
        <div class="pos-cart__actions-main">
            <button class="pos-cart__pay-btn" disabled="@(Items == null || !Items.Any() || _isProcessing)" @onclick="HandlePayAsync">
                Thanh Toán (@Total.ToString("N0")đ)
            </button>
        </div>
    </div>
</div>

@using System.Net.Http.Json
@using Restaurant.Application.DTOs
@using Restaurant.Web.Services
@inject HttpClient Http

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-sm p-4 animate-fade-in select-none">
        <div class="bg-surface rounded-2xl shadow-2xl w-full max-w-xl overflow-hidden border border-error/40 p-6 space-y-4">
            
            <div class="flex items-center gap-3 text-error border-b border-outline-variant pb-3">
                <span class="material-symbols-outlined text-3xl">remove_shopping_cart</span>
                <div>
                    <h3 class="font-black text-lg text-on-surface m-0 tracking-wide">HỦY MÓN (VOID ITEM)</h3>
                    <span class="text-xs text-on-surface-variant font-medium">Bắt buộc gửi yêu cầu đến Trung tâm phê duyệt để Quản lý xét duyệt</span>
                </div>
            </div>

            <!-- Details Card -->
            <div class="bg-surface-high p-4 rounded-xl border border-outline-variant space-y-2 text-xs">
                <div class="flex justify-between font-bold text-on-surface">
                    <span>Món cần hủy:</span>
                    <span class="text-primary font-black">@ItemName</span>
                </div>
                @if (ItemAmount > 0)
                {
                    <div class="flex justify-between text-on-surface-variant">
                        <span>Giá trị món:</span>
                        <span class="font-bold text-on-surface font-mono">@ItemAmount.ToString("N0")đ</span>
                    </div>
                }
            </div>

            <!-- Void Reason -->
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-on-surface-variant mb-1">Lý do hủy (*)</label>
                <select class="w-full p-2.5 rounded-xl border border-outline-variant text-sm bg-surface-high mb-2"
                        @bind="VoidReason">
                    <option value="">-- Chọn lý do --</option>
                    <option value="Khách đổi ý">Khách đổi ý</option>
                    <option value="Khách đợi lâu">Khách đợi lâu</option>
                    <option value="Hết nguyên liệu">Hết nguyên liệu (Báo sai)</option>
                    <option value="Nhân viên order nhầm">Nhân viên order nhầm</option>
                    <option value="Khác">Lý do khác...</option>
                </select>
                @if (VoidReason == "Khác")
                {
                    <input type="text" class="w-full p-2.5 rounded-xl border border-outline-variant text-sm bg-surface-high"
                           placeholder="Nhập lý do khác..." @bind="CustomVoidReason" />
                }
            </div>

            <!-- Notice Box -->
            <div class="p-3 bg-amber-500/10 border border-amber-500/20 rounded-xl text-amber-800 dark:text-amber-300 text-xs font-medium flex items-center gap-2">
                <span class="material-symbols-outlined text-lg text-amber-600">info</span>
                <span>Món đã gửi bếp bắt buộc phải gửi duyệt. Món sẽ được hủy sau khi Quản lý phê duyệt tại Trung tâm phê duyệt.</span>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="p-2.5 bg-error-container text-error rounded-xl font-bold text-xs">
                    @ErrorMessage
                </div>
            }

            <!-- Action Buttons -->
            <div class="flex justify-end gap-3 pt-2 border-t border-outline-variant">
                <button class="px-5 py-2.5 text-xs font-bold border border-outline-variant rounded-xl hover:bg-surface-high cursor-pointer"
                        @onclick="CloseAsync" disabled="@IsProcessing">
                    HỦY BỎ
                </button>
                <button class="px-6 py-2.5 text-xs font-black bg-primary hover:bg-primary/90 text-on-primary rounded-xl shadow-md transition-all cursor-pointer flex items-center gap-1.5 disabled:opacity-50 disabled:cursor-not-allowed"
                        disabled="@(IsProcessing || string.IsNullOrWhiteSpace(FinalReason))" @onclick="SubmitVoidApprovalAsync">
                    @if (IsProcessing)
                    {
                        <span class="animate-spin rounded-full h-4 w-4 border-b-2 border-white"></span>
                        <span>ĐANG GỬI...</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-lg">send</span>
                        <span>GỬI YÊU CẦU DUYỆT</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public int OrderId { get; set; }
    [Parameter] public int OrderItemId { get; set; }
    [Parameter] public string ItemId { get; set; } = string.Empty;
    [Parameter] public string ItemName { get; set; } = string.Empty;
    [Parameter] public decimal ItemAmount { get; set; } = 0;
    [Parameter] public EventCallback<(bool Success, string Reason, string ManagerPin)> OnVoidCompleted { get; set; }

    protected string VoidReason { get; set; } = string.Empty;
    protected string CustomVoidReason { get; set; } = string.Empty;
    protected bool IsProcessing { get; set; } = false;
    protected string ErrorMessage { get; set; } = string.Empty;

    private string FinalReason => VoidReason == "Khác" ? CustomVoidReason : VoidReason;

    private async Task SubmitVoidApprovalAsync()
    {
        if (string.IsNullOrWhiteSpace(FinalReason))
        {
            ErrorMessage = "Vui lòng cung cấp lý do hủy món.";
            return;
        }

        IsProcessing = true;
        ErrorMessage = string.Empty;

        try
        {
            var req = new CreateApprovalRequestDto
            {
                Type = 1, // ApprovalType.Void
                ReferenceId = OrderItemId,
                Amount = ItemAmount,
                Reason = FinalReason.Trim(),
                Note = $"Yêu cầu hủy món '{ItemName}' (ID #{OrderItemId}) thuộc đơn #{OrderId} từ POS"
            };

            var res = await Http.PostAsJsonAsync("api/v1/approvals/create", req);
            if (res.IsSuccessStatusCode)
            {
                await OnVoidCompleted.InvokeAsync((true, FinalReason, string.Empty));
                await CloseAsync();
            }
            else
            {
                var body = await res.Content.ReadAsStringAsync();
                ErrorMessage = $"Lỗi gửi yêu cầu duyệt: {res.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Lỗi gửi duyệt: {ex.Message}";
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task CloseAsync()
    {
        IsOpen = false;
        VoidReason = string.Empty;
        CustomVoidReason = string.Empty;
        ErrorMessage = string.Empty;
        await IsOpenChanged.InvokeAsync(false);
    }
}

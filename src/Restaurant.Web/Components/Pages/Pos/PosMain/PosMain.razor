@page "/pos/order"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.PosLayout
@using Restaurant.Web.Components.Pages.Pos.Components.OrderCart
@using Restaurant.Web.Components.Pages.Pos.Components.CategoryTabs
@using Restaurant.Web.Components.Pages.Pos.Components.MenuGrid
@using Restaurant.Web.Components.Pages.Pos.Components
@using Restaurant.Application.DTOs
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable

<div class="flex flex-col h-full bg-background overflow-hidden">
    <!-- Dedicated Action Menu Toolbar for Order Placement (No Top Nav) -->
    <header class="h-14 bg-surface border-b border-outline-variant px-4 flex items-center justify-between shrink-0 shadow-xs z-30 select-none">
        <!-- Left: Table / Order Info -->
        <div class="flex items-center gap-3">
            <button class="p-2 hover:bg-surface-high rounded-xl text-on-surface-variant hover:text-on-surface transition-colors cursor-pointer flex items-center gap-1 text-xs font-bold"
                    @onclick="HandleHeaderBackNav">
                <span class="material-symbols-outlined text-lg">arrow_back</span>
                <span>@(IsTakeaway ? "Takeaway" : "Sơ đồ bàn")</span>
            </button>
            <div class="h-5 w-[1px] bg-outline-variant"></div>
            <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 bg-primary/10 text-primary font-bold text-xs rounded-lg">
                    @CurrentTableName
                </span>
                <span class="text-xs text-on-surface-variant font-mono">@CurrentOrderCode</span>
                @if (SelectedMember != null)
                {
                    <span class="px-2 py-0.5 bg-amber-500/10 text-amber-700 dark:text-amber-400 font-bold text-[11px] rounded-full border border-amber-500/30 flex items-center gap-1">
                        ⭐ @SelectedMember.FullName (@SelectedMember.TierName)
                    </span>
                }
            </div>
        </div>

        <!-- Right: 5 Action Toolbar Buttons -->
        <div class="flex items-center gap-3">
            <!-- 1. Thành viên -->
            <button class="px-4 py-2 bg-surface-high hover:bg-primary/10 text-on-surface hover:text-primary border border-outline-variant rounded-xl font-bold text-sm flex items-center gap-2 transition-colors cursor-pointer shadow-sm"
                    @onclick="() => ShowMemberModal = true">
                <span class="material-symbols-outlined text-[20px] text-primary">badge</span>
                <span>Thành Viên</span>
            </button>

            <!-- 2. Giảm giá -->
            <button class="px-4 py-2 bg-surface-high hover:bg-primary/10 text-on-surface hover:text-primary border border-outline-variant rounded-xl font-bold text-sm flex items-center gap-2 transition-colors cursor-pointer shadow-sm"
                    @onclick="() => ShowDiscountModal = true">
                <span class="material-symbols-outlined text-[20px] text-primary">percent</span>
                <span>Giảm Giá</span>
            </button>

            <!-- 3. In hóa đơn -->
            <button class="px-4 py-2 bg-amber-500/10 hover:bg-amber-500/20 text-amber-700 dark:text-amber-400 border border-amber-500/30 rounded-xl font-bold text-sm flex items-center gap-2 transition-colors cursor-pointer shadow-sm disabled:opacity-50 disabled:cursor-not-allowed"
                    disabled="@(CartItems == null || !CartItems.Any())"
                    @onclick="HandlePrintPreBill">
                <span class="material-symbols-outlined text-[20px] text-amber-600 dark:text-amber-400">print</span>
                <span>In Hóa Đơn</span>
            </button>

            <!-- 4. Hủy đơn -->
            <button class="px-4 py-2 bg-error/10 hover:bg-error text-error hover:text-on-error border border-error/30 rounded-xl font-bold text-sm flex items-center gap-2 transition-colors cursor-pointer shadow-sm disabled:opacity-50 disabled:cursor-not-allowed"
                    disabled="@(ActiveOrderId <= 0)"
                    @onclick="() => ShowCancelOrderModal = true">
                <span class="material-symbols-outlined text-[20px]">cancel</span>
                <span>Hủy Đơn</span>
            </button>

            <!-- 5. Xong (Done & Send to Kitchen) -->
            <button class="px-6 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-black text-sm flex items-center gap-2 shadow-md transition-all cursor-pointer"
                    @onclick="HandleDoneAsync" disabled="@IsProcessing">
                @if (IsProcessing)
                {
                    <span class="animate-spin rounded-full h-4 w-4 border-b-2 border-white"></span>
                }
                else
                {
                    <span class="material-symbols-outlined text-[20px]">send</span>
                }
                <span>Xác Nhận & Gửi Bếp</span>
            </button>
        </div>
    </header>

    <!-- Main Workspace -->
    <div class="flex flex-1 overflow-hidden">
        <!-- Cart Left Section -->
        <div class="w-[380px] lg:w-[420px] bg-surface border-r border-outline-variant flex flex-col shrink-0">
            <OrderCart 
                Items="CartItems" 
                TableName="@CurrentTableName"
                OrderCode="@CurrentOrderCode"
                IsTakeaway="IsTakeaway"
                AppliedDiscount="AppliedDiscountAmount"
                OnQuantityChanged="HandleCartQuantityChanged"
                OnItemRemoved="HandleCartItemRemoved"
                OnItemVoidRequested="HandleItemVoidRequested"
                OnSendToKitchen="HandleSendToKitchenAsync"
                OnPrintPreBill="HandlePrintPreBill"
                OnTransferTable="HandleTransferTable"
                OnMergeTable="HandleMergeTable" />
        </div>

        <!-- Menu Right Section -->
        <div class="flex-1 bg-surface-low p-4 flex flex-col overflow-hidden">
            @if (!string.IsNullOrEmpty(ToastMessage))
            {
                <div class="bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/30 px-4 py-2.5 mb-3 rounded-xl font-bold text-xs flex items-center justify-between shadow-2xs">
                    <span>@ToastMessage</span>
                    <button class="text-xs border border-emerald-500/40 px-2 py-0.5 rounded-lg hover:bg-emerald-500/10 cursor-pointer"
                            @onclick="() => ToastMessage = string.Empty">Đóng</button>
                </div>
            }

            @if (ShowAlert)
            {
                <div class="bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/30 px-4 py-2.5 mb-3 rounded-xl font-bold text-xs flex items-center justify-between shadow-2xs">
                    <span>CÓ ĐƠN HÀNG MỚI TỪ QR! BÀN @NewOrderTableName</span>
                    <button class="text-xs border border-amber-500/40 px-2 py-0.5 rounded-lg hover:bg-amber-500/10 cursor-pointer"
                            @onclick="() => ShowAlert = false">Đóng</button>
                </div>
            }
            
            <CategoryTabs 
                Categories="Categories"
                ActiveCategoryId="ActiveCategoryId"
                ShowImages="ShowImages"
                SearchQuery="@SearchQuery"
                SearchQueryChanged="HandleSearchQueryChanged"
                OnSearchEnterPressed="HandleSearchEnterPressed"
                OnCategoryChanged="HandleCategoryChanged"
                OnImageToggleChanged="HandleImageToggle" />
                
            <div class="flex-1 overflow-y-auto pt-2">
                <MenuGrid 
                    Items="FilteredMenuItems"
                    ShowImage="ShowImages"
                    OnItemClicked="HandleMenuItemClicked" />
            </div>
        </div>
    </div>
</div>

<!-- Modals -->
<ComboBuilderModal 
    @bind-IsOpen="ShowModifierModal"
    MenuItem="SelectedItemDetail"
    ModifierGroups="SelectedModifierGroups"
    OnConfirm="HandleConfirmModifier" />

<PosComboModal
    @bind-IsOpen="ShowComboModal"
    ComboDetail="SelectedComboDetail"
    IsLoading="IsComboLoading"
    OnConfirm="HandleConfirmCombo" />



<!-- 1. Thành viên Modal -->
<PosMemberModal
    @bind-IsOpen="ShowMemberModal"
    OnMemberConfirmed="HandleMemberConfirmed" />

<!-- 2. Giảm giá Modal -->
<PosDiscountModal
    @bind-IsOpen="ShowDiscountModal"
    CartItems="CartItems"
    OnDiscountConfirmed="HandleDiscountConfirmed" />

<!-- 4. Hủy đơn Modal -->
<PosCancelOrderModal
    @bind-IsOpen="ShowCancelOrderModal"
    TableName="@CurrentTableName"
    OrderId="ActiveOrderId"
    OnOrderCancelled="HandleOrderCancelledAsync" />

<!-- K80 Receipt Modal -->
<K80ReceiptModal 
    IsOpen="ShowK80Modal" 
    IsOpenChanged="val => ShowK80Modal = val" 
    OrderData="ReceiptData" />

<PosVoidItemModal
    @bind-IsOpen="ShowVoidItemModal"
    ItemId="@VoidingItem?.Id"
    ItemName="@VoidingItem?.Name"
    OnVoidCompleted="HandleVoidCompleted" />

<PosTableActionModal
    @bind-IsOpen="ShowTableActionModal"
    ActionType="@TableActionType"
    SourceTableId="@(int.TryParse(TableId, out int t) ? t : 0)"
    OnActionCompleted="HandleTableActionCompleted" />

<!-- Toast Notification -->
@if (!string.IsNullOrEmpty(ToastMessage))
{
    <div class="fixed bottom-6 left-1/2 -translate-x-1/2 z-[100] bg-gray-900/95 backdrop-blur-sm text-white px-6 py-3 rounded-2xl shadow-2xl flex items-center gap-3 animate-fade-in-up border border-gray-800"
         @onclick="() => ToastMessage = string.Empty">
        <span class="material-symbols-outlined text-emerald-400 text-2xl">check_circle</span>
        <span class="font-bold text-sm tracking-wide">@ToastMessage</span>
        <button class="ml-2 text-gray-400 hover:text-white transition-colors" @onclick:stopPropagation="true" @onclick="() => ToastMessage = string.Empty">
            <span class="material-symbols-outlined text-sm">close</span>
        </button>
    </div>
}

@page "/pos"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.PosLayout
@using Restaurant.Web.Components.Layout
@using Restaurant.Application.DTOs

<div class="flex flex-col h-full bg-background overflow-hidden">
    <!-- Top Nav Bar -->
    <PosHeader />

    <!-- Main Workspace: 70% / 30% Layout -->
    <div class="flex flex-1 overflow-hidden p-6 gap-6 bg-surface-low">
        
        <!-- Left Section (~70% width) -->
        <section class="w-full lg:w-[70%] flex flex-col justify-between bg-surface rounded-2xl border border-outline-variant p-8 shadow-sm relative overflow-hidden">
            <div>
                <!-- Welcome Title -->
                <div class="mb-8 border-b border-outline-variant/60 pb-6">
                    <h1 class="text-2xl font-extrabold text-primary flex items-center gap-3">
                        <span class="material-symbols-outlined text-3xl">storefront</span>
                        Màn Hình Chức Năng Thu Ngân (POS)
                    </h1>
                    <p class="text-sm text-on-surface-variant mt-1">
                        Chọn tác vụ làm việc bên dưới hoặc truy cập nhanh sơ đồ bàn để phục vụ khách hàng.
                    </p>
                </div>

                <!-- 3 Primary Action Buttons/Cards -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- Button 1: Bàn (Floor Map) -->
                    <button class="group flex flex-col items-center justify-center p-8 bg-surface-high hover:bg-primary hover:text-on-primary border border-outline-variant rounded-2xl shadow-sm hover:shadow-xl transition-all duration-200 cursor-pointer transform hover:-translate-y-1 text-center"
                            @onclick='() => Navigation.NavigateTo("/pos/tables")'>
                        <div class="w-16 h-16 rounded-2xl bg-primary/10 group-hover:bg-on-primary/20 flex items-center justify-center text-primary group-hover:text-on-primary mb-4 transition-colors">
                            <span class="material-symbols-outlined text-3xl">table_restaurant</span>
                        </div>
                        <h2 class="text-lg font-bold group-hover:text-on-primary">Sơ Đồ Bàn</h2>
                        <span class="text-xs text-on-surface-variant group-hover:text-on-primary/80 mt-1 font-medium">Quản lý bàn & Phục vụ tại chỗ</span>
                    </button>

                    <!-- Button 2: Mang đi (Takeaway) -->
                    <button class="group flex flex-col items-center justify-center p-8 bg-surface-high hover:bg-primary hover:text-on-primary border border-outline-variant rounded-2xl shadow-sm hover:shadow-xl transition-all duration-200 cursor-pointer transform hover:-translate-y-1 text-center"
                            @onclick='() => Navigation.NavigateTo("/pos/takeaway")'>
                        <div class="w-16 h-16 rounded-2xl bg-primary/10 group-hover:bg-on-primary/20 flex items-center justify-center text-primary group-hover:text-on-primary mb-4 transition-colors">
                            <span class="material-symbols-outlined text-3xl">takeout_dining</span>
                        </div>
                        <h2 class="text-lg font-bold group-hover:text-on-primary">Đơn Mang Về</h2>
                        <span class="text-xs text-on-surface-variant group-hover:text-on-primary/80 mt-1 font-medium">Quản lý & tạo order mang đi</span>
                    </button>

                    <!-- Button 3: Công cụ thu ngân (Cashier Tools) -->
                    <button class="group flex flex-col items-center justify-center p-8 bg-surface-high hover:bg-primary hover:text-on-primary border border-outline-variant rounded-2xl shadow-sm hover:shadow-xl transition-all duration-200 cursor-pointer transform hover:-translate-y-1 text-center"
                            @onclick="OpenCashierToolsModal">
                        <div class="w-16 h-16 rounded-2xl bg-primary/10 group-hover:bg-on-primary/20 flex items-center justify-center text-primary group-hover:text-on-primary mb-4 transition-colors">
                            <span class="material-symbols-outlined text-3xl">point_of_sale</span>
                        </div>
                        <h2 class="text-lg font-bold group-hover:text-on-primary">Công Cụ Thu Ngân</h2>
                        <span class="text-xs text-on-surface-variant group-hover:text-on-primary/80 mt-1 font-medium">Quản lý ca, két tiền & doanh thu</span>
                    </button>
                </div>
            </div>

            <!-- Bottom-Right Logout Button inside 70% Area -->
            <div class="flex justify-end pt-6 border-t border-outline-variant/60 mt-8">
                <button class="px-6 py-3 bg-error/10 hover:bg-error text-error hover:text-on-error border border-error/30 rounded-xl font-bold text-sm flex items-center gap-2 transition-all duration-200 cursor-pointer shadow-xs"
                        @onclick="HandleLogout">
                    <span class="material-symbols-outlined text-[20px]">logout</span>
                    Đăng Xuất Thu Ngân
                </button>
            </div>
        </section>

        <!-- Right Section (~30% width): 10 Latest Notifications Panel -->
        <aside class="w-full lg:w-[30%] bg-surface rounded-2xl border border-outline-variant p-6 shadow-sm flex flex-col overflow-hidden">
            <div class="flex items-center justify-between pb-4 mb-3 border-b border-outline-variant">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary text-xl">notifications_active</span>
                    <h2 class="font-bold text-base text-on-surface">10 Thông Báo Mới Nhất</h2>
                </div>
                <span class="px-2 py-0.5 bg-primary/10 text-primary text-xs font-bold rounded-full">
                    @PosHeader.GlobalNotifications.Count
                </span>
            </div>

            <!-- Notifications List -->
            <div class="flex-1 overflow-y-auto space-y-3 pr-1">
                @if (!PosHeader.GlobalNotifications.Any())
                {
                    <div class="flex flex-col items-center justify-center h-48 text-on-surface-variant text-xs gap-2">
                        <span class="material-symbols-outlined text-4xl opacity-30">notifications_none</span>
                        <span>Hiện chưa có thông báo nào mới</span>
                    </div>
                }
                else
                {
                    @foreach (var notif in PosHeader.GlobalNotifications.Take(10))
                    {
                        <div class="p-3.5 bg-surface-high rounded-xl border border-outline-variant/60 hover:border-primary/40 transition-all flex items-start gap-3">
                            <div class="p-2 rounded-lg bg-primary/10 text-primary shrink-0">
                                <span class="material-symbols-outlined text-[18px]">@notif.Icon</span>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center justify-between gap-1">
                                    <h3 class="text-xs font-bold text-on-surface truncate">@notif.Title</h3>
                                    <span class="text-[10px] font-medium text-outline shrink-0">@notif.Timestamp.ToString("HH:mm")</span>
                                </div>
                                <p class="text-xs text-on-surface-variant mt-1 leading-relaxed">@notif.Message</p>
                            </div>
                        </div>
                    }
                }
            </div>
        </aside>
    </div>
</div>

@if (_showCashierToolsModal)
{
    <Restaurant.Web.Components.Pages.Pos.Components.PosCashierToolsModal 
        IsOpen="_showCashierToolsModal" 
        IsOpenChanged="val => _showCashierToolsModal = val" />
}

@code {
    private bool _showCashierToolsModal = false;

    private void OpenCashierToolsModal()
    {
        _showCashierToolsModal = true;
    }

    private void HandleLogout()
    {
        Navigation.NavigateTo("/pos/login", forceLoad: true);
    }
}

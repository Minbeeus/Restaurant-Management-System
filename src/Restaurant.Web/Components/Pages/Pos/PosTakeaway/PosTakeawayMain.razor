@page "/pos/takeaway"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.PosLayout
@using Restaurant.Web.Components.Layout
@using Restaurant.Application.DTOs
@using Restaurant.Web.Components.Pages.Pos.Components
@using Microsoft.AspNetCore.SignalR.Client
@inject NavigationManager Navigation
@inject HttpClient Http
@implements IAsyncDisposable

<div class="flex flex-col h-full bg-background overflow-hidden select-none">
    <!-- Top Nav Bar (PosHeader) -->
    <PosHeader />

    <!-- Main Workspace: Strict 85% / 15% Layout (Requirements 1 & 5) -->
    <div class="flex flex-1 overflow-hidden bg-surface-low p-4 gap-4">
        
        <!-- SECTION LEFT (Strict 85% Width): Takeaway Orders List OR Detail View -->
        <main class="w-[85%] flex flex-col bg-surface rounded-2xl border border-outline-variant p-5 shadow-sm overflow-hidden">
            
            @if (IsDetailMode && SelectedOrder != null)
            {
                <!-- DETAIL VIEW (Requirement 7.1): 85% Left area for Order Info -->
                <div class="flex flex-col h-full overflow-hidden">
                    <div class="flex justify-between items-center pb-4 border-b border-outline-variant shrink-0">
                        <div>
                            <div class="flex items-center gap-3">
                                <h2 class="text-xl font-extrabold text-primary">CHI TIẾT ĐƠN MANG VỀ @SelectedOrder.OrderCode</h2>
                                <span class="px-3 py-1 rounded-full text-xs font-black shadow-2xs @GetStatusBadgeClass(SelectedOrder)">
                                    @SelectedOrder.DisplayStatus
                                </span>
                            </div>
                            <p class="text-xs text-on-surface-variant mt-1">Đặt lúc: @SelectedOrder.CreatedAt.ToString("HH:mm - dd/MM/yyyy") | Kênh: @SelectedOrder.OrderChannel</p>
                        </div>
                        <button class="px-3 py-1.5 bg-surface-high hover:bg-surface-variant text-xs font-bold rounded-xl border border-outline-variant flex items-center gap-1 cursor-pointer"
                                @onclick="ExitDetailMode">
                            <span class="material-symbols-outlined text-base">arrow_back</span>
                            Trở về danh sách
                        </button>
                    </div>

                    <!-- Details Body -->
                    <div class="flex-1 overflow-y-auto py-4 space-y-4">
                        <!-- Customer Info Card -->
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 bg-surface-high/40 p-4 rounded-xl border border-outline-variant/60">
                            <div>
                                <span class="text-[11px] font-bold uppercase text-on-surface-variant block">Khách hàng</span>
                                <span class="font-extrabold text-sm text-on-surface">@SelectedOrder.CustomerName</span>
                            </div>
                            <div>
                                <span class="text-[11px] font-bold uppercase text-on-surface-variant block">Số điện thoại</span>
                                <span class="font-extrabold text-sm text-on-surface">@(string.IsNullOrEmpty(SelectedOrder.CustomerPhone) ? "N/A" : SelectedOrder.CustomerPhone)</span>
                            </div>
                            <div>
                                <span class="text-[11px] font-bold uppercase text-on-surface-variant block">Trạng thái thanh toán</span>
                                <span class="font-extrabold text-sm @(SelectedOrder.IsPaid ? "text-emerald-600" : "text-amber-600")">
                                    @(SelectedOrder.IsPaid ? "Đã thanh toán ($)" : "Chưa thanh toán")
                                </span>
                            </div>
                        </div>

                        <!-- Items Table -->
                        <div class="border border-outline-variant rounded-xl overflow-hidden shadow-2xs">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="bg-surface-high text-on-surface-variant text-xs font-extrabold uppercase border-b border-outline-variant">
                                        <th class="p-3">Món ăn / Đồ uống</th>
                                        <th class="p-3 text-center">Số lượng</th>
                                        <th class="p-3 text-right">Đơn giá</th>
                                        <th class="p-3 text-right">Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-outline-variant/60 text-sm">
                                    @foreach (var item in SelectedOrder.Items)
                                    {
                                        <tr class="hover:bg-surface-high/30">
                                            <td class="p-3">
                                                <div class="font-bold text-on-surface">@item.MenuItemName</div>
                                                @if (item.Modifiers != null && item.Modifiers.Any())
                                                {
                                                    <div class="text-xs text-on-surface-variant mt-0.5">+ @string.Join(", ", item.Modifiers)</div>
                                                }
                                                @if (!string.IsNullOrEmpty(item.Note))
                                                {
                                                    <div class="text-xs italic text-amber-600">Ghi chú: @item.Note</div>
                                                }
                                            </td>
                                            <td class="p-3 text-center font-extrabold text-primary">@item.Quantity</td>
                                            <td class="p-3 text-right font-medium">@item.UnitPrice.ToString("N0")đ</td>
                                            <td class="p-3 text-right font-extrabold text-on-surface">@item.TotalPrice.ToString("N0")đ</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Summary -->
                        <div class="flex justify-end pt-2">
                            <div class="w-full max-w-sm bg-surface-high/50 p-4 rounded-xl border border-outline-variant space-y-2">
                                <div class="flex justify-between text-xs text-on-surface-variant">
                                    <span>Tạm tính:</span>
                                    <span class="font-bold">@SelectedOrder.SubTotal.ToString("N0") đ</span>
                                </div>
                                @if (SelectedOrder.DiscountAmount > 0)
                                {
                                    <div class="flex justify-between text-xs text-primary font-bold">
                                        <span>Giảm giá:</span>
                                        <span>-@SelectedOrder.DiscountAmount.ToString("N0") đ</span>
                                    </div>
                                }
                                <div class="flex justify-between text-base font-black text-on-surface pt-2 border-t border-outline-variant">
                                    <span>TỔNG CẦN THU:</span>
                                    <span class="text-primary text-xl">@SelectedOrder.TotalAmount.ToString("N0") đ</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- MAIN ORDERS LIST VIEW (Requirement 2): 85% Left area -->
                <div class="flex flex-col h-full overflow-hidden">
                    <!-- Top Filters & Search -->
                    <div class="flex items-center justify-between pb-3 mb-3 border-b border-outline-variant shrink-0 overflow-x-auto gap-2">
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-bold uppercase tracking-wider text-on-surface-variant mr-1 shrink-0 flex items-center gap-1">
                                <span class="material-symbols-outlined text-base">takeout_dining</span>
                                Đơn Mang Về:
                            </span>
                            <button class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer shrink-0 @(SelectedStatusFilter == -1 ? "bg-primary text-on-primary shadow-xs" : "bg-surface-high text-on-surface hover:bg-surface-high/80")"
                                    @onclick="() => SelectedStatusFilter = -1">
                                Tất cả (@TakeawayOrders.Count)
                            </button>
                            <button class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer shrink-0 @(SelectedStatusFilter == 0 ? "bg-amber-500 text-white shadow-xs" : "bg-surface-high text-on-surface hover:bg-surface-high/80")"
                                    @onclick="() => SelectedStatusFilter = 0">
                                Chờ xác nhận (@TakeawayOrders.Count(o => o.Status == 0))
                            </button>
                            <button class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer shrink-0 @(SelectedStatusFilter == 1 ? "bg-blue-600 text-white shadow-xs" : "bg-surface-high text-on-surface hover:bg-surface-high/80")"
                                    @onclick="() => SelectedStatusFilter = 1">
                                Đang chuẩn bị (@TakeawayOrders.Count(o => o.Status == 1))
                            </button>
                            <button class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer shrink-0 @(SelectedStatusFilter == 2 ? "bg-emerald-600 text-white shadow-xs" : "bg-surface-high text-on-surface hover:bg-surface-high/80")"
                                    @onclick="() => SelectedStatusFilter = 2">
                                Đã xong (@TakeawayOrders.Count(o => o.Status == 2))
                            </button>
                            <button class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer shrink-0 @(SelectedStatusFilter == 4 ? "bg-rose-600 text-white shadow-xs" : "bg-surface-high text-on-surface hover:bg-surface-high/80")"
                                    @onclick="() => SelectedStatusFilter = 4">
                                Đã huỷ (@TakeawayOrders.Count(o => o.Status == 4))
                            </button>
                        </div>
                        
                        <div class="text-xs text-on-surface-variant font-medium shrink-0">
                            Tự động đồng bộ Realtime 🟢
                        </div>
                    </div>

                    <!-- Orders Table List -->
                    <div class="flex-1 overflow-auto pr-1">
                        @if (IsLoading)
                        {
                            <div class="flex items-center justify-center h-full gap-3 text-on-surface-variant">
                                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
                                <span class="font-medium text-sm">Đang tải danh sách đơn mang về...</span>
                            </div>
                        }
                        else if (!FilteredOrders.Any())
                        {
                            <div class="flex flex-col items-center justify-center h-full text-on-surface-variant py-12">
                                <span class="material-symbols-outlined text-4xl mb-2 opacity-40">takeout_dining</span>
                                <p class="text-sm font-medium">Chưa có đơn hàng mang về nào trong danh sách.</p>
                            </div>
                        }
                        else
                        {
                            <div class="border border-outline-variant rounded-2xl overflow-hidden shadow-2xs">
                                <table class="w-full text-left border-collapse">
                                    <thead>
                                        <tr class="bg-surface-high text-on-surface-variant text-xs font-extrabold uppercase border-b border-outline-variant">
                                            <th class="p-3.5">Mã đơn</th>
                                            <th class="p-3.5">Trạng thái (Rule 2.1 & 17)</th>
                                            <th class="p-3.5">Khách hàng</th>
                                            <th class="p-3.5">Số điện thoại</th>
                                            <th class="p-3.5">Thời gian</th>
                                            <th class="p-3.5 text-right">Tổng tiền</th>
                                            <th class="p-3.5 text-center">Kênh (Rule 4)</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-outline-variant/60 text-sm">
                                        @foreach (var order in FilteredOrders)
                                        {
                                            var isSelected = SelectedOrder?.OrderId == order.OrderId;
                                            <tr class="cursor-pointer transition-all duration-150 @(isSelected ? "bg-primary/10 font-bold border-l-4 border-l-primary" : "hover:bg-surface-high/50")"
                                                @onclick="() => SelectOrder(order)"
                                                @ondblclick="() => OpenDetailView(order)">
                                                <td class="p-3.5 font-extrabold text-primary">@order.OrderCode</td>
                                                <td class="p-3.5">
                                                    <!-- Combined Status Display (Rule 2.1 & 17: Status + $ if paid) -->
                                                    <span class="px-3 py-1 rounded-full text-xs font-black shadow-2xs inline-flex items-center gap-1 @GetStatusBadgeClass(order)">
                                                        @order.DisplayStatus
                                                    </span>
                                                </td>
                                                <td class="p-3.5 font-medium text-on-surface">@order.CustomerName</td>
                                                <td class="p-3.5 font-medium text-on-surface-variant">@(string.IsNullOrEmpty(order.CustomerPhone) ? "N/A" : order.CustomerPhone)</td>
                                                <td class="p-3.5 text-xs text-on-surface-variant">@order.CreatedAt.ToString("HH:mm dd/MM")</td>
                                                <td class="p-3.5 text-right font-black text-primary text-base">@order.TotalAmount.ToString("N0")đ</td>
                                                <td class="p-3.5 text-center">
                                                    <!-- Channel Display (Rule 4: QR vs Cashier Name) -->
                                                    @if (order.IsQrOrder)
                                                    {
                                                        <span class="inline-flex items-center gap-1 bg-purple-500/10 text-purple-700 dark:text-purple-300 px-2.5 py-1 rounded-lg text-xs font-extrabold border border-purple-500/30">
                                                            <span class="material-symbols-outlined text-sm">qr_code_scanner</span>
                                                            QR
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="inline-flex items-center gap-1 bg-surface-high text-on-surface px-2.5 py-1 rounded-lg text-xs font-bold border border-outline-variant">
                                                            <span class="material-symbols-outlined text-sm">badge</span>
                                                            @order.OrderChannel
                                                        </span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }
        </main>

        <!-- SECTION RIGHT (Strict 15% Width): Strict Toolbar (Requirement 5) -->
        <aside class="w-[15%] min-w-[140px] bg-surface rounded-2xl border border-outline-variant p-3 shadow-sm flex flex-col justify-between shrink-0">
            
            <!-- Requirement 5: Vertical Toolbar Buttons in Order -->
            <div class="flex flex-col gap-3">
                
                @if (IsDetailMode)
                {
                    <!-- Toolbar for Detail View Mode -->
                    <button class="flex flex-col items-center justify-center p-3 bg-surface-high hover:bg-primary hover:text-on-primary border border-outline-variant rounded-xl transition-all cursor-pointer text-center group shadow-2xs"
                            @onclick="PrintInvoiceAsync">
                        <span class="material-symbols-outlined text-2xl text-primary group-hover:text-on-primary mb-1">print</span>
                        <span class="text-xs font-bold">In Hoá Đơn</span>
                    </button>

                    <button class="flex flex-col items-center justify-center p-3 bg-rose-500/10 hover:bg-rose-600 hover:text-white border border-rose-500/30 text-rose-700 dark:text-rose-400 rounded-xl transition-all cursor-pointer text-center group shadow-2xs @(SelectedOrder?.Status == 4 ? "opacity-50 cursor-not-allowed" : "")"
                            disabled="@(SelectedOrder?.Status == 4)"
                            @onclick="CancelOrRefundOrderAsync">
                        <span class="material-symbols-outlined text-2xl text-rose-600 group-hover:text-white mb-1">cancel</span>
                        <span class="text-xs font-bold">@(SelectedOrder?.IsPaid == true ? "Hoàn Tiền ($)" : "Huỷ Đơn")</span>
                    </button>
                }
                else
                {
                    <!-- Requirement 5: Main Toolbar Buttons (1 to 5) -->

                    <!-- 1. Nút Tạo đơn (Requirement 6) -->
                    <button class="flex flex-col items-center justify-center p-3.5 bg-primary text-on-primary hover:bg-primary/90 border border-primary/20 rounded-xl transition-all cursor-pointer text-center group shadow-xs"
                            @onclick="CreateNewTakeawayOrder">
                        <span class="material-symbols-outlined text-2xl mb-1">add_shopping_cart</span>
                        <span class="text-xs font-extrabold">Tạo Đơn</span>
                    </button>

                    <!-- 2. Nút Xem chi tiết (Requirement 7) -->
                    <button class="flex flex-col items-center justify-center p-3 bg-surface-high hover:bg-primary hover:text-on-primary border border-outline-variant rounded-xl transition-all cursor-pointer text-center group shadow-2xs @(SelectedOrder == null ? "opacity-50 cursor-not-allowed" : "")"
                            disabled="@(SelectedOrder == null)"
                            @onclick="() => OpenDetailView(SelectedOrder)">
                        <span class="material-symbols-outlined text-2xl text-primary group-hover:text-on-primary mb-1">visibility</span>
                        <span class="text-xs font-bold">Xem Chi Tiết</span>
                    </button>

                    <!-- 3. Nút In hoá đơn (Requirement 8) -->
                    <button class="flex flex-col items-center justify-center p-3 bg-surface-high hover:bg-primary hover:text-on-primary border border-outline-variant rounded-xl transition-all cursor-pointer text-center group shadow-2xs @(SelectedOrder == null ? "opacity-50 cursor-not-allowed" : "")"
                            disabled="@(SelectedOrder == null)"
                            @onclick="PrintInvoiceAsync">
                        <span class="material-symbols-outlined text-2xl text-primary group-hover:text-on-primary mb-1">print</span>
                        <span class="text-xs font-bold">In Hoá Đơn</span>
                    </button>

                    <!-- 4. Nút Sửa hoá đơn (Requirement 9: Only allowed when Status = Chờ xác nhận & Unpaid) -->
                    <button class="flex flex-col items-center justify-center p-3 bg-blue-500/10 hover:bg-blue-600 hover:text-white border border-blue-500/30 text-blue-700 dark:text-blue-400 rounded-xl transition-all cursor-pointer text-center group shadow-2xs @(CanEditSelectedOrder ? "" : "opacity-40 cursor-not-allowed")"
                            disabled="@(!CanEditSelectedOrder)"
                            @onclick="EditInvoice">
                        <span class="material-symbols-outlined text-2xl text-blue-600 group-hover:text-white mb-1">edit</span>
                        <span class="text-xs font-bold">Sửa Hoá Đơn</span>
                    </button>

                    <!-- 5. Nút Thanh toán (Requirement 10) -->
                    <button class="flex flex-col items-center justify-center p-3.5 bg-emerald-500/10 hover:bg-emerald-600 hover:text-white border border-emerald-500/30 text-emerald-700 dark:text-emerald-400 rounded-xl transition-all cursor-pointer text-center group shadow-2xs @(CanPaySelectedOrder ? "" : "opacity-40 cursor-not-allowed")"
                            disabled="@(!CanPaySelectedOrder)"
                            @onclick="OpenPaymentModal">
                        <span class="material-symbols-outlined text-2xl text-emerald-600 group-hover:text-white mb-1">payments</span>
                        <span class="text-xs font-extrabold">Thanh Toán</span>
                    </button>
                }
            </div>

            <!-- 6. Bottom Nút "Quay lại" (Requirement 16) -->
            <div class="pt-3 border-t border-outline-variant">
                <button class="w-full flex flex-col items-center justify-center p-3 bg-surface-high hover:bg-error hover:text-on-error border border-outline-variant rounded-xl transition-all cursor-pointer text-center group"
                        @onclick="HandleBackAction">
                    <span class="material-symbols-outlined text-2xl text-on-surface-variant group-hover:text-on-error mb-1">arrow_back</span>
                    <span class="text-xs font-bold">Quay Lại</span>
                </button>
            </div>
        </aside>
    </div>
</div>

<!-- POS Takeaway Payment Modal (Requirements 10 - 15) -->
@if (ShowPaymentModalState && SelectedOrder != null)
{
    <PosTakeawayPaymentModal 
        Order="@SelectedOrder" 
        OnClose="() => ShowPaymentModalState = false" 
        OnPaymentSuccess="HandlePaymentCompletedAsync" />
}

@code {
    protected List<TakeawayOrderDto> TakeawayOrders { get; set; } = new();
    protected TakeawayOrderDto? SelectedOrder { get; set; }
    protected int SelectedStatusFilter { get; set; } = -1; // -1: All
    protected bool IsLoading { get; set; } = true;
    protected bool IsDetailMode { get; set; } = false;
    protected bool ShowPaymentModalState { get; set; } = false;

    private HubConnection? _hubConnection;

    protected List<TakeawayOrderDto> FilteredOrders =>
        SelectedStatusFilter == -1
            ? TakeawayOrders
            : TakeawayOrders.Where(o => o.Status == SelectedStatusFilter).ToList();

    // Requirement 9 rule: Sửa hoá đơn CHỈ ĐƯỢC PHÉP khi Trạng thái = Chờ xác nhận (Status == 0) và Chưa thanh toán (!IsPaid)
    protected bool CanEditSelectedOrder =>
        SelectedOrder != null && SelectedOrder.Status == 0 && !SelectedOrder.IsPaid;

    protected bool CanPaySelectedOrder =>
        SelectedOrder != null && SelectedOrder.Status != 4 && !SelectedOrder.IsPaid;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrdersAsync();

        _hubConnection = new HubConnectionBuilder()
            .WithUrl("http://localhost:5011/hubs/restaurant")
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<string, string>("TableStatusChanged", (id, status) =>
        {
            _ = InvokeAsync(async () =>
            {
                await LoadOrdersAsync();
                StateHasChanged();
            });
        });

        try { await _hubConnection.StartAsync(); } catch { }
    }

    private async Task LoadOrdersAsync()
    {
        IsLoading = true;
        try
        {
            var response = await Http.GetAsync("api/v1/pos/takeaway/orders");
            if (response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadFromJsonAsync<ApiResponseWrapper<List<TakeawayOrderDto>>>();
                TakeawayOrders = body?.Data ?? new List<TakeawayOrderDto>();
                if (SelectedOrder != null)
                {
                    SelectedOrder = TakeawayOrders.FirstOrDefault(o => o.OrderId == SelectedOrder.OrderId);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading takeaway orders: {ex.Message}");
        }
        finally { IsLoading = false; }
    }

    private void SelectOrder(TakeawayOrderDto order)
    {
        SelectedOrder = order;
    }

    private void CreateNewTakeawayOrder()
    {
        Navigation.NavigateTo("/pos/order?isTakeaway=true");
    }

    private void OpenDetailView(TakeawayOrderDto? order)
    {
        if (order == null) return;
        SelectedOrder = order;
        IsDetailMode = true;
    }

    private void ExitDetailMode()
    {
        IsDetailMode = false;
    }

    private async Task PrintInvoiceAsync()
    {
        if (SelectedOrder == null) return;
        try
        {
            await Http.PostAsync($"api/v1/pos/orders/{SelectedOrder.OrderId}/print-temp-bill", null);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error printing invoice: {ex.Message}");
        }
    }

    private void EditInvoice()
    {
        if (SelectedOrder == null || !CanEditSelectedOrder) return;
        Navigation.NavigateTo($"/pos/order?orderId={SelectedOrder.OrderId}&isTakeaway=true");
    }

    private void OpenPaymentModal()
    {
        if (SelectedOrder == null || !CanPaySelectedOrder) return;
        ShowPaymentModalState = true;
    }

    private async Task HandlePaymentCompletedAsync(bool isPaid)
    {
        ShowPaymentModalState = false;
        await LoadOrdersAsync();
        IsDetailMode = false;
    }

    private async Task CancelOrRefundOrderAsync()
    {
        if (SelectedOrder == null) return;

        try
        {
            var req = new CancelOrderRequest
            {
                OrderId = SelectedOrder.OrderId,
                Reason = SelectedOrder.IsPaid ? "Hoàn tiền đơn mang về" : "Hủy đơn mang về"
            };
            var res = await Http.PostAsJsonAsync("api/v1/pos/orders/cancel", req);
            if (res.IsSuccessStatusCode)
            {
                await LoadOrdersAsync();
                IsDetailMode = false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cancelling order: {ex.Message}");
        }
    }

    private void HandleBackAction()
    {
        if (IsDetailMode)
        {
            IsDetailMode = false;
        }
        else
        {
            Navigation.NavigateTo("/pos");
        }
    }

    // Rules 2.1 & 17: Status Badges mapping
    private string GetStatusBadgeClass(TakeawayOrderDto order) => order.Status switch
    {
        0 => "bg-amber-500/15 border border-amber-500 text-amber-900 dark:text-amber-200", // Chờ xác nhận
        1 => "bg-blue-500/15 border border-blue-500 text-blue-900 dark:text-blue-200", // Đang chuẩn bị
        2 => "bg-emerald-500/15 border border-emerald-500 text-emerald-900 dark:text-emerald-200", // Đã xong
        4 => "bg-rose-500/15 border border-rose-500 text-rose-900 dark:text-rose-200", // Đã huỷ
        _ => "bg-surface-high text-on-surface"
    };

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection != null)
        {
            await _hubConnection.DisposeAsync();
        }
    }

    private class ApiResponseWrapper<T>
    {
        public bool Success { get; set; }
        public T? Data { get; set; }
    }
}

                                    <div class="flex items-center justify-between text-xs text-purple-800 dark:text-purple-300 font-bold mb-1.5">
                                        <span class="text-[11px] uppercase tracking-wider">GIẢM TẶNG MÓN</span>
                                        <span class="material-symbols-outlined text-purple-600 text-lg">featured_seasonal_and_gifts</span>
                                    </div>
                                    <div class="text-xl font-black text-purple-700 dark:text-purple-400">-@DailyReport.ComplimentaryDiscount.ToString("N0")đ</div>
                                    <div class="text-[10px] text-purple-700/80 dark:text-purple-400/80 mt-1">Tặng món & đổi điểm tích lũy</div>
                                </div>

                                <!-- 4. Net Sales -->
                                <div class="p-4 bg-surface rounded-2xl border-2 border-emerald-500/50 bg-emerald-500/10 shadow-xs">
                                    <div class="flex items-center justify-between text-xs text-emerald-800 dark:text-emerald-300 font-bold mb-1.5">
                                        <span class="text-[11px] uppercase tracking-wider font-black">DOANH THU THUẦN</span>

                                        <div class="text-lg font-black @(DailyReport.CancelledOrdersCount > 0 ? "text-rose-600" : "text-on-surface") mt-0.5">@DailyReport.CancelledOrdersCount <span class="text-xs font-normal">đơn</span></div>

                <button class="w-full flex flex-col items-center justify-center py-2.5 px-2 bg-surface-high hover:bg-error hover:text-on-error border border-outline-variant rounded-xl transition-all cursor-pointer text-center group shadow-2xs"
                        @onclick='() => Navigation.NavigateTo("/pos")'>
                    <span class="material-symbols-outlined text-xl text-on-surface-variant group-hover:text-on-error mb-0.5">arrow_back</span>
                    <span class="text-xs font-bold">Quay Lại</span>
                </button>
            </div>
        </aside>
    </div>
</div>

<!-- Print Thermal K80 Modal -->
@if (SelectedBillK80 != null)
{
    <K80ReceiptModal IsOpen="true" IsOpenChanged="() => SelectedBillK80 = null" OrderData="SelectedBillK80" />
}

<!-- End of Day K80 Report Modal -->
@if (ShowEndOfDayModal && EndOfDayReportData != null)
{
    <K80EndOfDayModal IsOpen="true" IsOpenChanged="val => ShowEndOfDayModal = val" ReportData="EndOfDayReportData" />
}

@code {
    protected string ActiveTab { get; set; } = "Shift";
    protected ShiftReportDto? CurrentShift { get; set; }
    protected CashMovementSummaryDto? CashSummary { get; set; }

    protected bool IsManagerOrAdmin { get; set; } = false;
    protected bool IsCashierOnly => !IsManagerOrAdmin;

    protected decimal OpenInitialCash { get; set; } = 2000000;
    protected string OpenNote { get; set; } = string.Empty;
    protected string OpenCustodianPin { get; set; } = string.Empty;
    protected string OpenManagerPin { get; set; } = string.Empty;

    protected decimal ActualCashCounted { get; set; } = 0;
    protected string CloseNote { get; set; } = string.Empty;

    protected string CashActionType { get; set; } = "TillIn";
    protected decimal CashAmount { get; set; } = 100000;
    protected string CashReason { get; set; } = string.Empty;

    // Till Out PIN check
    protected string TillOutManagerPin { get; set; } = string.Empty;
    protected TillOutBalanceCheckDto? TillOutBalanceCheck { get; set; }
    protected bool IsCheckingBalance { get; set; } = false;
    protected string TillOutPinError { get; set; } = string.Empty;

    // Tab 4: Daily Sales Report
    protected DateTime SelectedReportDate { get; set; } = DateTime.Today;
    protected DailySalesReportDto? DailyReport { get; set; }
    protected bool IsLoadingDailyReport { get; set; } = false;
    protected string DailyReportError { get; set; } = string.Empty;

    protected string SearchBillKeyword { get; set; } = string.Empty;
    protected List<BillDetailDto> BillList { get; set; } = new();
    protected K80ReceiptDto? SelectedBillK80 { get; set; }

    protected bool ShowEndOfDayModal { get; set; } = false;
    protected ShiftReportDto? EndOfDayReportData { get; set; }

    protected bool IsProcessing { get; set; } = false;
    protected string ErrorMessage { get; set; } = string.Empty;
    protected string SuccessMessage { get; set; } = string.Empty;

    protected decimal Variance => CurrentShift == null ? 0 : ActualCashCounted - CurrentShift.ExpectedCash;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        ErrorMessage = string.Empty;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState?.User;
            IsManagerOrAdmin = user?.IsInRole("Admin") == true || user?.IsInRole("Manager") == true;

            if (IsCashierOnly && ActiveTab != "Bills")
            {
                ActiveTab = "Bills";
            }

            var shiftResp = await Http.GetAsync("api/v1/shifts/current");
            if (shiftResp.IsSuccessStatusCode)
            {
                var wrapper = await shiftResp.Content.ReadFromJsonAsync<ApiResponseWrapper<ShiftReportDto>>();
                CurrentShift = wrapper?.Data;
                if (CurrentShift != null)
                {
                    ActualCashCounted = CurrentShift.ExpectedCash;
                    await LoadCashSummaryAsync(CurrentShift.ShiftId);
                }
            }
            else
            {
                CurrentShift = null;
            }

            if (ActiveTab == "Bills")
            {
                await SearchBillsAsync();
            }
            else if (ActiveTab == "DailyReport" && IsManagerOrAdmin)
            {
                await LoadDailySalesReportAsync();
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private async Task LoadCashSummaryAsync(int shiftId)
    {
        try
        {
            var summaryResp = await Http.GetFromJsonAsync<ApiResponseWrapper<CashMovementSummaryDto>>($"api/v1/cashier/cash-movements/{shiftId}");
            CashSummary = summaryResp?.Data;
        }
        catch { }
    }

    private void SetTab(string tab)
    {
        if (IsCashierOnly && tab != "Bills")
        {
            return;
        }

        ActiveTab = tab;
        ErrorMessage = string.Empty;
        SuccessMessage = string.Empty;
        if (tab == "Bills")
        {
            _ = SearchBillsAsync();
        }
        else if (tab == "DailyReport" && IsManagerOrAdmin)
        {
            _ = LoadDailySalesReportAsync();
        }
    }

    private async Task HandleTillOutPinKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (TillOutManagerPin.Length == 6)
        {
            await CheckTillOutBalanceAsync();
        }
    }

    private async Task CheckTillOutBalanceAsync()
    {
        if (string.IsNullOrWhiteSpace(TillOutManagerPin))
        {
            TillOutPinError = "Vui lòng nhập mã PIN Quản lý.";
            return;
        }

        IsCheckingBalance = true;
        TillOutPinError = string.Empty;
        try
        {
            var req = new CheckTillOutBalanceRequest
            {
                ManagerPin = TillOutManagerPin.Trim(),
                ShiftId = CurrentShift?.ShiftId
            };
            var res = await Http.PostAsJsonAsync("api/v1/cashier/till-out/check-balance", req);
            if (res.IsSuccessStatusCode)
            {
                var wrapper = await res.Content.ReadFromJsonAsync<ApiResponseWrapper<TillOutBalanceCheckDto>>();
                TillOutBalanceCheck = wrapper?.Data;
                if (TillOutBalanceCheck != null)
                {
                    CashAmount = TillOutBalanceCheck.CurrentCashInDrawer;
                }
            }
            else
            {
                try
                {
                    var errObj = await res.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                    if (errObj.TryGetProperty("message", out var msgProp))
                    {
                        TillOutPinError = msgProp.GetString() ?? "Mã PIN Quản lý không đúng.";
                    }
                    else
                    {
                        TillOutPinError = "Mã PIN Quản lý không đúng.";
                    }
                }
                catch
                {
                    TillOutPinError = "Mã PIN Quản lý không đúng.";
                }
                TillOutBalanceCheck = null;
            }
        }
        catch (Exception ex)
        {
            TillOutPinError = ex.Message;
            TillOutBalanceCheck = null;
        }
        finally
        {
            IsCheckingBalance = false;
        }
    }

    private async Task SetReportDate(DateTime date)
    {
        SelectedReportDate = date;
        await LoadDailySalesReportAsync();
    }

    private async Task OnReportDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var parsed))
        {
            SelectedReportDate = parsed;
            await LoadDailySalesReportAsync();
        }
    }

    private async Task LoadDailySalesReportAsync()
    {
        IsLoadingDailyReport = true;
        DailyReportError = string.Empty;
        try
        {
            var dateStr = SelectedReportDate.ToString("yyyy-MM-dd");
            var res = await Http.GetAsync($"api/v1/reports/daily-sales?date={dateStr}");
            if (res.IsSuccessStatusCode)
            {
                var wrapper = await res.Content.ReadFromJsonAsync<ApiResponseWrapper<DailySalesReportDto>>();
                DailyReport = wrapper?.Data;
            }
            else
            {
                DailyReportError = "Không thể tải báo cáo doanh số ngày.";
            }
        }
        catch (Exception ex)
        {
            DailyReportError = ex.Message;
        }
        finally
        {
            IsLoadingDailyReport = false;
        }
    }


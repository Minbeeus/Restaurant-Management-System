                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Detailed Tables: Shifts & Orders -->
                            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                                <!-- Shifts in Day -->
                                <div class="lg:col-span-4 bg-surface rounded-3xl border border-outline-variant p-5 shadow-2xs space-y-3">
                                    <h4 class="font-black text-sm text-primary flex items-center justify-between pb-2 border-b border-outline-variant">
                                        <span class="flex items-center gap-1.5">
                                            <span class="material-symbols-outlined text-lg">badge</span>
                                            CÁC CA LÀM VIỆC TRONG NGÀY (@DailyReport.Shifts.Count)
                                        </span>
                                    </h4>

                                    <div class="overflow-y-auto max-h-[350px] space-y-2 pr-1">
                                        @if (!DailyReport.Shifts.Any())
                                        {
                                            <div class="text-center py-8 text-xs text-on-surface-variant">Không có ca làm việc nào mở trong ngày này.</div>
                                        }
                                        else
                                        {
                                            @foreach (var s in DailyReport.Shifts)
                                            {
                                                <div class="p-3 bg-surface-high/60 rounded-2xl border border-outline-variant/60 text-xs space-y-1">
                                                    <div class="flex justify-between items-center font-black">
                                                        <span class="text-on-surface">@s.ShiftCode</span>
                                                        <span class="px-2 py-0.5 rounded-full text-[10px] @(s.Status == 1 ? "bg-emerald-500/15 text-emerald-600" : "bg-slate-500/15 text-slate-500")">
                                                            @s.StatusName
                                                        </span>
                                                    </div>
                                                    <div class="text-[11px] text-on-surface-variant flex justify-between">
                                                        <span>Quản lý: @s.OpenedByName</span>
                                                        <span>@s.OpenedAt.ToString("HH:mm") - @(s.ClosedAt?.ToString("HH:mm") ?? "Đang chạy")</span>
                                                    </div>
                                                    <div class="flex justify-between text-[11px] pt-1 border-t border-outline-variant/40 font-bold">
                                                        <span>Tiền đầu ca: @s.OpeningBalance.ToString("N0")đ</span>
                                                        <span class="text-emerald-600">TM: @s.TotalCashAmount.ToString("N0")đ | QR: @s.TotalTransferAmount.ToString("N0")đ</span>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>

                                <!-- Orders in Day -->
                                <div class="lg:col-span-8 bg-surface rounded-3xl border border-outline-variant p-5 shadow-2xs space-y-3">
                                    <h4 class="font-black text-sm text-primary flex items-center justify-between pb-2 border-b border-outline-variant">
                                        <span class="flex items-center gap-1.5">
                                            <span class="material-symbols-outlined text-lg">receipt</span>
                                            DANH SÁCH ĐƠN HÀNG ĐÃ THANH TOÁN (@DailyReport.Orders.Count)
                                        </span>
                                    </h4>

                                    <div class="overflow-y-auto max-h-[350px] space-y-2 pr-1">
                                        @if (!DailyReport.Orders.Any())
                                        {
                                            <div class="text-center py-8 text-xs text-on-surface-variant">Không có đơn hàng nào đã thanh toán trong ngày này.</div>
                                        }
                                        else
                                        {
                                            <div class="overflow-x-auto">
                                                <table class="w-full text-left text-xs">
                                                    <thead>
                                                        <tr class="bg-surface-high border-b border-outline-variant text-on-surface-variant uppercase font-black text-[10px]">
                                                            <th class="p-2">Mã Đơn</th>
                                                            <th class="p-2">Bàn / Kênh</th>
                                                            <th class="p-2 text-right">Doanh Thu Gộp</th>
                                                            <th class="p-2 text-right">Giảm Giá</th>
                                                            <th class="p-2 text-right">Thực Thu (Net)</th>
                                                            <th class="p-2">Thanh Toán</th>
                                                            <th class="p-2">Thu Ngân</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody class="divide-y divide-outline-variant/40">
                                                        @foreach (var ord in DailyReport.Orders)
                                                        {
                                                            <tr class="hover:bg-surface-high/30">
                                                                <td class="p-2 font-black text-primary">@ord.OrderCode</td>
                                                                <td class="p-2">
                                                                    <span class="font-bold">@ord.TableName</span>
                                                                    <span class="text-[10px] text-on-surface-variant block">@ord.OrderType • @ord.CreatedAt.ToString("HH:mm:ss")</span>
                                                                </td>
                                                                <td class="p-2 text-right font-semibold text-on-surface">@ord.SubTotal.ToString("N0")đ</td>
                                                                <td class="p-2 text-right font-semibold @(ord.DiscountAmount > 0 ? "text-amber-600" : "text-on-surface-variant")">
                                                                    @(ord.DiscountAmount > 0 ? $"-{ord.DiscountAmount:N0}đ" : "0đ")
                                                                </td>
                                                                <td class="p-2 text-right font-black text-emerald-600 text-sm">@ord.TotalAmount.ToString("N0")đ</td>
                                                                <td class="p-2">
                                                                    <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-surface-high border border-outline-variant/50">
                                                                        @ord.PaymentMethodName
                                                                    </span>
                                                                </td>
                                                                <td class="p-2 text-on-surface-variant text-[11px]">@ord.CashierName</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

            </div>

            <!-- Bottom Status Footer inside 85% area -->
            <div class="px-6 py-3 bg-surface border-t border-outline-variant flex justify-between items-center shrink-0">
                <div class="flex items-center gap-2 text-xs text-on-surface-variant font-medium">
                    <span>Trạng thái ca:</span>
                    <strong class="text-on-surface">@(CurrentShift?.StatusName ?? "Không có ca mở")</strong>
                    @if (CurrentShift != null)
                    {
                        <span class="text-outline">|</span>
                        <span>Mở lúc: @CurrentShift.StartTime.ToString("HH:mm dd/MM")</span>
                    }
                </div>
                @if (CurrentShift != null && IsManagerOrAdmin)
                {
                    <button class="px-4 py-1.5 bg-surface-high hover:bg-outline-variant/40 border border-outline-variant rounded-xl font-bold text-xs cursor-pointer flex items-center gap-1.5 transition-colors"
                            @onclick="ViewCurrentK80Report">
                        <span class="material-symbols-outlined text-[16px] text-primary">receipt</span>

@page "/pos/cashier-tools"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.PosLayout
@using System.Net.Http.Json
@using Restaurant.Application.DTOs
@using Restaurant.Web.Components.Layout
@using Restaurant.Web.Components.Pages.Pos.Components
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider

<div class="flex flex-col h-full bg-background overflow-hidden select-none">
    <!-- Top Nav Bar (PosHeader) -->
    <PosHeader />

    <!-- Main Workspace: Strict 85% / 15% Layout -->
    <div class="flex flex-1 overflow-hidden bg-surface-low p-4 gap-4">
        
        <!-- SECTION LEFT (Strict 85% Width): Cashier Tools Workspace -->
        <main class="w-[85%] flex flex-col bg-surface rounded-2xl border border-outline-variant shadow-sm overflow-hidden">
            
            <!-- Sleek Modern Header -->
            <div class="px-6 py-4 bg-slate-900 text-white flex justify-between items-center shrink-0 border-b border-slate-800">
                <div class="flex items-center gap-3.5">
                    <div class="w-11 h-11 rounded-2xl bg-primary/20 border border-primary/30 flex items-center justify-center text-primary-fixed shadow-inner">
                        <span class="material-symbols-outlined text-2xl">point_of_sale</span>
                    </div>
                    <div>
                        <div class="flex items-center gap-2.5">
                            <h1 class="font-black text-lg tracking-wide text-white m-0">CÔNG CỤ THU NGÂN</h1>
                            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 bg-slate-800 px-2 py-0.5 rounded-md">Cashier Tools</span>
                        </div>
                        <p class="text-xs text-slate-400 m-0 mt-0.5 font-medium">Két Tiền Chung • Quản lý Ca • Nộp/Rút két tiền • Đối soát ca 4 điều kiện</p>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <!-- Live Shift Status Pill -->
                    @if (CurrentShift != null)
                    {
                        <span class="px-3 py-1.5 rounded-full text-xs font-black bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 flex items-center gap-1.5 shadow-2xs">
                            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                            <span>Đang Mở Ca: @CurrentShift.ShiftCode</span>
                        </span>
                    }
                    else
                    {
                        <span class="px-3 py-1.5 rounded-full text-xs font-black bg-rose-500/15 text-rose-400 border border-rose-500/30 flex items-center gap-1.5 shadow-2xs">
                            <span class="w-2 h-2 rounded-full bg-rose-400"></span>
                            <span>Chưa Mở Ca</span>
                        </span>
                    }
                </div>
            </div>

            <!-- Navigation Tabs -->
            <div class="flex border-b border-outline-variant bg-surface-high/50 px-6 pt-2 shrink-0 gap-3">
                @if (IsManagerOrAdmin)
                {
                    <button class="px-5 py-3 text-xs font-extrabold transition-all cursor-pointer flex items-center gap-2 rounded-t-xl border-b-2 @(ActiveTab == "Shift" ? "border-primary text-primary bg-surface shadow-2xs" : "border-transparent text-on-surface-variant hover:text-on-surface hover:bg-surface/50")"
                            @onclick='() => SetTab("Shift")'>
                        <span class="material-symbols-outlined text-lg">badge</span>
                        <span>1. CA LÀM VIỆC & ĐỐI SOÁT</span>
                    </button>

                    <button class="px-5 py-3 text-xs font-extrabold transition-all cursor-pointer flex items-center gap-2 rounded-t-xl border-b-2 @(ActiveTab == "Cash" ? "border-primary text-primary bg-surface shadow-2xs" : "border-transparent text-on-surface-variant hover:text-on-surface hover:bg-surface/50")"
                            @onclick='() => SetTab("Cash")'>
                        <span class="material-symbols-outlined text-lg">payments</span>
                        <span>2. TIỀN MẶT & RÚT KÉT</span>
                    </button>
                }

                <button class="px-5 py-3 text-xs font-extrabold transition-all cursor-pointer flex items-center gap-2 rounded-t-xl border-b-2 @(ActiveTab == "Bills" ? "border-primary text-primary bg-surface shadow-2xs" : "border-transparent text-on-surface-variant hover:text-on-surface hover:bg-surface/50")"
                        @onclick='() => SetTab("Bills")'>
                    <span class="material-symbols-outlined text-lg">receipt_long</span>
                    <span>@(IsCashierOnly ? "TRA CỨU & IN HÓA ĐƠN" : "3. TRA CỨU HÓA ĐƠN")</span>
                </button>

                @if (IsManagerOrAdmin)
                {
                    <button class="px-5 py-3 text-xs font-extrabold transition-all cursor-pointer flex items-center gap-2 rounded-t-xl border-b-2 @(ActiveTab == "DailyReport" ? "border-primary text-primary bg-surface shadow-2xs" : "border-transparent text-on-surface-variant hover:text-on-surface hover:bg-surface/50")"
                            @onclick='() => SetTab("DailyReport")'>
                        <span class="material-symbols-outlined text-lg">monitoring</span>
                        <span>4. BÁO CÁO DOANH SỐ NGÀY</span>
                    </button>
                }
            </div>

            <!-- Tab Content (Scrollable) -->
            <div class="flex-1 overflow-y-auto p-6 bg-surface-low space-y-4">

                <!-- Alert Messages -->
                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="p-3.5 bg-rose-500/10 border border-rose-500/30 text-rose-700 dark:text-rose-300 rounded-2xl font-bold text-xs flex items-center gap-2">
                        <span class="material-symbols-outlined text-base text-rose-600">error</span>
                        <span>@ErrorMessage</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(SuccessMessage))
                {
                    <div class="p-3.5 bg-emerald-500/15 text-emerald-800 dark:text-emerald-200 border border-emerald-500/30 rounded-2xl font-bold text-xs flex items-center gap-2">
                        <span class="material-symbols-outlined text-base text-emerald-600">check_circle</span>
                        <span>@SuccessMessage</span>
                    </div>
                }

                <!-- TAB 1: SHIFT MANAGEMENT -->
                @if (ActiveTab == "Shift")
                {
                    @if (CurrentShift == null)
                    {
                        <!-- State: NO ACTIVE SHIFT -> OPEN SHIFT FORM (SHARED DRAWER MODEL) -->
                        <div class="bg-surface rounded-3xl border border-outline-variant p-8 max-w-xl mx-auto shadow-sm space-y-6">
                            <div class="text-center space-y-2">
                                <div class="w-14 h-14 rounded-2xl bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex items-center justify-center mx-auto shadow-2xs">
                                    <span class="material-symbols-outlined text-3xl">play_circle</span>
                                </div>
                                <h3 class="font-black text-xl text-on-surface m-0 tracking-tight">MỞ CA & BÀN GIAO KÉT TIỀN CHUNG</h3>
                                <p class="text-xs text-on-surface-variant max-w-sm mx-auto">
                                    Mô hình Két tiền chung (Shared Cash Drawer). Quản lý mở ca và bàn giao két tiền mặt cho Nhân viên thu ngân chịu trách nhiệm giữ két bằng mã PIN 6 số.
                                </p>
                            </div>

                            <div class="space-y-4">
                                <div>
                                    <div class="flex justify-between items-center mb-1.5">
                                        <label class="text-xs font-black uppercase tracking-wider text-on-surface-variant">Tiền Đầu Ca (Opening Cash)</label>
                                        <span class="text-sm font-black text-primary">@OpenInitialCash.ToString("N0") đ</span>
                                    </div>

                                    <!-- Quick Amount Chips -->
                                    <div class="grid grid-cols-4 gap-2 mb-2">
                                        <button type="button" class="py-1.5 px-2 rounded-xl text-xs font-bold border transition-all cursor-pointer @(OpenInitialCash == 1000000 ? "bg-primary text-on-primary border-primary shadow-xs" : "bg-surface-high border-outline-variant text-on-surface hover:border-primary/50")"
                                                @onclick="() => OpenInitialCash = 1000000">1.000.000đ</button>
                                        <button type="button" class="py-1.5 px-2 rounded-xl text-xs font-bold border transition-all cursor-pointer @(OpenInitialCash == 2000000 ? "bg-primary text-on-primary border-primary shadow-xs" : "bg-surface-high border-outline-variant text-on-surface hover:border-primary/50")"
                                                @onclick="() => OpenInitialCash = 2000000">2.000.000đ</button>
                                        <button type="button" class="py-1.5 px-2 rounded-xl text-xs font-bold border transition-all cursor-pointer @(OpenInitialCash == 3000000 ? "bg-primary text-on-primary border-primary shadow-xs" : "bg-surface-high border-outline-variant text-on-surface hover:border-primary/50")"
                                                @onclick="() => OpenInitialCash = 3000000">3.000.000đ</button>
                                        <button type="button" class="py-1.5 px-2 rounded-xl text-xs font-bold border transition-all cursor-pointer @(OpenInitialCash == 5000000 ? "bg-primary text-on-primary border-primary shadow-xs" : "bg-surface-high border-outline-variant text-on-surface hover:border-primary/50")"
                                                @onclick="() => OpenInitialCash = 5000000">5.000.000đ</button>
                                    </div>

                                    <div class="relative">
                                        <span class="material-symbols-outlined absolute left-3.5 top-3.5 text-on-surface-variant text-xl">payments</span>
                                        <input type="number" class="w-full pl-11 pr-4 py-3 rounded-2xl border border-outline-variant font-black text-2xl text-primary bg-surface-high focus:ring-2 focus:ring-primary focus:outline-hidden"
                                                @bind="OpenInitialCash" step="50000" min="0" />
                                    </div>
                                </div>

                                <!-- Cash Custodian PIN (Cashier) -->
                                <div class="p-4 rounded-2xl bg-primary/10 border border-primary/30 space-y-3">
                                    <div class="flex justify-between items-center">
                                        <label class="text-xs font-black uppercase tracking-wider text-primary flex items-center gap-1.5">
                                            <span class="material-symbols-outlined text-lg">badge</span>
                                            Mã PIN Thu Ngân Giữ Két (Cash Custodian) (*)
                                        </label>
                                        <span class="text-[11px] font-bold text-primary">6 số</span>
                                    </div>
                                    <div class="relative">
                                        <span class="material-symbols-outlined absolute left-3.5 top-3 text-primary text-xl">key</span>
                                        <input type="password" maxlength="6" inputmode="numeric"
                                                class="w-full pl-11 pr-4 py-2.5 rounded-xl border border-primary/40 font-black text-xl tracking-[0.35em] bg-surface text-on-surface focus:ring-2 focus:ring-primary focus:outline-hidden"
                                                placeholder="••••••" @bind="OpenCustodianPin" @bind:event="oninput" />
                                    </div>
                                    <p class="text-[11px] text-on-surface-variant m-0">
                                        Thu ngân chịu trách nhiệm giữ két nhập mã PIN (quy tắc: mã NV thêm số 0 ở đầu cho đủ 6 số, ví dụ mã 2007 là PIN 002007).
                                    </p>
                                </div>

                                <!-- Manager PIN Verification -->
                                <div class="p-4 rounded-2xl bg-amber-500/10 border border-amber-500/30 space-y-3">
                                    <div class="flex justify-between items-center">
                                        <label class="text-xs font-black uppercase tracking-wider text-amber-800 dark:text-amber-300 flex items-center gap-1.5">
                                            <span class="material-symbols-outlined text-lg text-amber-600">lock_person</span>
                                            Mã PIN Quản Lý Mở Ca (Shift Manager)
                                        </label>
                                        <span class="text-[11px] font-bold text-amber-700 dark:text-amber-400">Xác nhận</span>
                                    </div>
                                    <div class="relative">
                                        <span class="material-symbols-outlined absolute left-3.5 top-3 text-amber-600 text-xl">password</span>
                                        <input type="password" maxlength="6" inputmode="numeric"
                                                class="w-full pl-11 pr-4 py-2.5 rounded-xl border border-amber-500/40 font-black text-xl tracking-[0.35em] bg-surface text-on-surface focus:ring-2 focus:ring-amber-500 focus:outline-hidden"
                                                placeholder="••••••" @bind="OpenManagerPin" @bind:event="oninput" @onkeyup="HandleOpenPinKeyUp" />
                                    </div>
                                </div>

                                <div>
                                    <label class="block text-xs font-black uppercase tracking-wider text-on-surface-variant mb-1.5">Ghi Chú Mở Ca (Tùy chọn)</label>
                                    <input type="text" class="w-full px-4 py-3 rounded-2xl border border-outline-variant text-sm bg-surface-high focus:ring-2 focus:ring-primary focus:outline-hidden"
                                            placeholder="Ghi chú bàn giao ca..." @bind="OpenNote" />
                                </div>

                                <button class="w-full py-3.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-2xl font-black text-sm shadow-md hover:shadow-lg transition-all cursor-pointer flex items-center justify-center gap-2 disabled:opacity-50"
                                        disabled="@IsProcessing" @onclick="OpenShiftAsync">
                                    @if (IsProcessing)
                                    {
                                        <span class="animate-spin rounded-full h-4 w-4 border-b-2 border-white"></span>
                                        <span>Đang mở ca...</span>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined text-xl">key</span>
                                        <span>XÁC NHẬN MỞ CA & BÀN GIAO KÉT</span>
                                    }
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- State: ACTIVE SHIFT IS OPEN -> 4 SECTIONS AUDIT & CLOSE -->
                        <div class="space-y-6">
                            
                            <!-- Header Bar of Active Shift -->
                            <div class="bg-surface rounded-2xl border border-outline-variant p-4 flex flex-wrap items-center justify-between gap-4">
                                <div class="flex items-center gap-4">
                                    <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-black">
                                        <span class="material-symbols-outlined text-xl">storefront</span>
                                    </div>
                                    <div>
                                        <div class="flex items-center gap-2">
                                            <h4 class="font-black text-sm m-0 text-on-surface">CA LÀM VIỆC: @CurrentShift.ShiftCode</h4>
                                            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-black bg-emerald-500/10 text-emerald-600 border border-emerald-500/20">
                                                @CurrentShift.StatusName
                                            </span>
                                        </div>
                                        <p class="text-xs text-on-surface-variant m-0 mt-0.5">
                                            Quản lý mở: <strong>@CurrentShift.OpenedByStaffName</strong> • Người giữ két: <strong>@CurrentShift.CashCustodianStaffName (#@CurrentShift.CashCustodianEmployeeCode)</strong> • Mở lúc: <strong>@CurrentShift.StartTime.ToString("dd/MM/yyyy HH:mm")</strong>
                                        </p>
                                    </div>
                                </div>

                                <div class="flex items-center gap-2">
                                    <button type="button" class="px-3.5 py-2 bg-surface-high hover:bg-outline-variant/30 text-on-surface border border-outline-variant rounded-xl font-bold text-xs cursor-pointer flex items-center gap-1.5 transition-colors"
                                            @onclick="ViewCurrentK80Report">
                                        <span class="material-symbols-outlined text-base text-primary">print</span>
                                        <span>Xem Báo Cáo K80</span>
                                    </button>
                                </div>
                            </div>

                            <!-- 2 Columns: Left = Sections A & B, Right = Sections C & D -->
                            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

                                <!-- LEFT COLUMN -->
                                <div class="space-y-6">

                                    <!-- SECTION A: KIỂM SOÁT ĐƠN HÀNG -->
                                    <div class="bg-surface rounded-3xl border border-outline-variant p-6 shadow-sm space-y-4">
                                        <div class="flex justify-between items-center pb-2 border-b border-outline-variant">
                                            <span class="font-black text-sm text-primary flex items-center gap-2">
                                                <span class="material-symbols-outlined text-lg">receipt_long</span>
                                                PHẦN A: KIỂM SOÁT ĐƠN HÀNG
                                            </span>
                                            @if (CurrentShift.OutstandingOrdersCount == 0)
                                            {
                                                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-black bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 flex items-center gap-1">
                                                    <span class="material-symbols-outlined text-xs">check</span>
                                                    Đạt 100%
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-black bg-rose-500/10 text-rose-600 border border-rose-500/20 flex items-center gap-1">
                                                    <span class="material-symbols-outlined text-xs">warning</span>
                                                    Còn @CurrentShift.OutstandingOrdersCount đơn dở dang
                                                </span>
                                            }
                                        </div>

                                        <!-- Summary grid -->
                                        <div class="grid grid-cols-4 gap-2 text-center text-xs">
                                            <div class="p-2.5 rounded-2xl bg-surface-high border border-outline-variant">
                                                <div class="text-[10px] text-on-surface-variant font-bold">TỔNG ĐƠN</div>
                                                <div class="text-base font-black text-on-surface">@CurrentShift.TotalOrders</div>
                                            </div>
                                            <div class="p-2.5 rounded-2xl bg-emerald-500/10 border border-emerald-500/20">
                                                <div class="text-[10px] text-emerald-700 font-bold">HOÀN TẤT</div>
                                                <div class="text-base font-black text-emerald-600">@CurrentShift.CompletedOrdersCount</div>
                                            </div>
                                            <div class="p-2.5 rounded-2xl bg-slate-500/10 border border-slate-500/20">
                                                <div class="text-[10px] text-slate-700 font-bold">HỦY</div>
                                                <div class="text-base font-black text-slate-600">@CurrentShift.CancelledOrdersCount</div>
                                            </div>
                                            <div class="p-2.5 rounded-2xl @(CurrentShift.OutstandingOrdersCount > 0 ? "bg-rose-500/10 border-rose-500/20" : "bg-surface-high border-outline-variant")">
                                                <div class="text-[10px] @(CurrentShift.OutstandingOrdersCount > 0 ? "text-rose-700" : "text-on-surface-variant") font-bold">TỒN ĐỌNG</div>
                                                <div class="text-base font-black @(CurrentShift.OutstandingOrdersCount > 0 ? "text-rose-600" : "text-on-surface")">@CurrentShift.OutstandingOrdersCount</div>
                                            </div>
                                        </div>

                                        <!-- Outstanding Orders List if any -->
                                        @if (CurrentShift.OutstandingOrders != null && CurrentShift.OutstandingOrders.Any())
                                        {
                                            <div class="p-3 bg-rose-500/10 border border-rose-500/30 rounded-2xl space-y-2">
                                                <div class="text-xs font-black text-rose-800 dark:text-rose-300 flex items-center gap-1.5">
                                                    <span class="material-symbols-outlined text-base text-rose-600">error</span>
                                                    Bắt buộc thanh toán / hoàn tất các đơn còn tồn đọng:
                                                </div>
                                                <div class="max-h-36 overflow-y-auto space-y-1.5 pr-1">
                                                    @foreach (var o in CurrentShift.OutstandingOrders)
                                                    {
                                                        <div class="flex justify-between items-center p-2 rounded-xl bg-surface text-xs border border-rose-500/20">
                                                            <div class="flex items-center gap-2">
                                                                <span class="font-black text-rose-700">@o.OrderCode</span>
                                                                <span class="text-on-surface-variant text-[11px]">(@o.TableName)</span>
                                                            </div>
                                                            <span class="font-black text-primary">@o.TotalAmount.ToString("N0")đ</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    <!-- SECTION B: ĐỐI SOÁT KÉT TIỀN MẶT CHUNG -->
                                    <div class="bg-surface rounded-3xl border border-outline-variant p-6 shadow-sm space-y-4">
                                        <div class="flex justify-between items-center pb-2 border-b border-outline-variant">
                                            <span class="font-black text-sm text-primary flex items-center gap-2">
                                                <span class="material-symbols-outlined text-lg">point_of_sale</span>
                                                PHẦN B: ĐỐI SOÁT KÉT TIỀN MẶT CHUNG
                                            </span>
                                            <span class="text-xs font-bold text-on-surface-variant">Shared Drawer</span>
                                        </div>

                                        <div class="space-y-2 text-xs">
                                            <div class="flex justify-between text-on-surface-variant">
                                                <span>1. Tiền đầu ca (Opening Cash):</span>
                                                <span class="font-extrabold text-on-surface">@CurrentShift.InitialCash.ToString("N0") đ</span>
                                            </div>
                                            <div class="flex justify-between text-on-surface-variant">
                                                <span>2. Tiền mặt thu được (+ Cash Collected):</span>
                                                <span class="font-extrabold text-emerald-600">+@CurrentShift.CashRevenue.ToString("N0") đ</span>
                                            </div>
                                            <div class="flex justify-between text-on-surface-variant">
                                                <span>3. Nộp thêm vào két (+ Till In):</span>
                                                <span class="font-extrabold text-emerald-600">+@CurrentShift.TotalTillIn.ToString("N0") đ</span>
                                            </div>
                                            <div class="flex justify-between text-on-surface-variant">
                                                <span>4. Hoàn tiền mặt khách (- Refunds):</span>
                                                <span class="font-extrabold text-rose-600">-@CurrentShift.TotalCashRefunds.ToString("N0") đ</span>
                                            </div>
                                            <div class="flex justify-between text-on-surface-variant">
                                                <span>5. Điều chỉnh tiền mặt (Adjustments):</span>
                                                <span class="font-extrabold text-on-surface">@CurrentShift.TotalCashAdjustments.ToString("N0") đ</span>
                                            </div>
                                            <div class="pt-2 border-t border-outline-variant/60 flex justify-between font-black text-sm">
                                                <span>6. Tiền mặt kỳ vọng trong két (Expected Cash):</span>
                                                <span class="text-primary">@CurrentShift.ExpectedCash.ToString("N0") đ</span>
                                            </div>
                                            <div class="flex justify-between text-on-surface-variant">
                                                <span>7. Đã rút khỏi két (- Total Till Out):</span>
                                                <span class="font-extrabold text-rose-600">-@CurrentShift.TotalTillOut.ToString("N0") đ</span>
                                            </div>
                                            <div class="pt-2 border-t border-outline-variant/60 flex justify-between font-black text-xs">
                                                <span>8. Còn lại trong két cần rút (Remaining to Till Out):</span>
                                                <span class="@(CurrentShift.RemainingCashToTillOut == 0 ? "text-emerald-600" : "text-amber-600 font-black text-sm")">
                                                    @CurrentShift.RemainingCashToTillOut.ToString("N0") đ
                                                </span>
                                            </div>
                                            <div class="flex justify-between items-center p-3 rounded-2xl @(CurrentShift.Difference == 0 ? "bg-emerald-500/10 border border-emerald-500/20 text-emerald-700" : "bg-rose-500/10 border border-rose-500/20 text-rose-700") font-black">
                                                <span>9. Chênh lệch tiền mặt (Cash Difference):</span>
                                                <span class="text-sm">@(CurrentShift.Difference == 0 ? "0 đ (Khớp tuyệt đối ✓)" : $"{CurrentShift.Difference:+N0;-N0;0} đ (Lệch)")</span>
                                            </div>
                                        </div>

                                        <!-- Quick Till Out Action for Manager -->
                                        @if (CurrentShift.RemainingCashToTillOut > 0)
                                        {
                                            <button type="button" class="w-full py-2.5 bg-rose-600 hover:bg-rose-700 text-white rounded-xl font-black text-xs shadow-sm flex items-center justify-center gap-2 cursor-pointer transition-colors"
                                                    disabled="@IsProcessing" @onclick="QuickTillOutAllAsync">
                                                <span class="material-symbols-outlined text-base">outbox</span>
                                                <span>RÚT TOÀN BỘ TIỀN KÉT (@CurrentShift.RemainingCashToTillOut.ToString("N0")đ)</span>
                                            </button>
                                        }
                                    </div>
                                </div>

                                <!-- RIGHT COLUMN -->
                                <div class="space-y-6">

                                    <!-- SECTION C: DOANH THU THEO NHÂN VIÊN -->
                                    <div class="bg-surface rounded-3xl border border-outline-variant p-6 shadow-sm space-y-4">
                                        <div class="flex justify-between items-center pb-2 border-b border-outline-variant">
                                            <span class="font-black text-sm text-primary flex items-center gap-2">
                                                <span class="material-symbols-outlined text-lg">group</span>
                                                PHẦN C: THỐNG KÊ DOANH THU THEO NHÂN VIÊN
                                            </span>
                                            <span class="text-[11px] text-on-surface-variant font-bold">Sales Breakdown</span>
                                        </div>

                                        <div class="overflow-x-auto border border-outline-variant/60 rounded-2xl max-h-56 overflow-y-auto">
                                            <table class="w-full text-left text-xs">
                                                <thead>
                                                    <tr class="bg-surface-high border-b border-outline-variant text-on-surface-variant uppercase font-black text-[10px]">
                                                        <th class="p-2.5">Nhân Viên</th>
                                                        <th class="p-2.5 text-center">Đơn TM</th>
                                                        <th class="p-2.5 text-right">Tiền Mặt</th>
                                                        <th class="p-2.5 text-center">Đơn CK</th>
                                                        <th class="p-2.5 text-right">Tổng Thu</th>
                                                    </tr>
                                                </thead>
                                                <tbody class="divide-y divide-outline-variant/40">
                                                    @if (CurrentShift.EmployeeSummaries != null && CurrentShift.EmployeeSummaries.Any())
                                                    {
                                                        @foreach (var emp in CurrentShift.EmployeeSummaries)
                                                        {
                                                            <tr class="hover:bg-surface-high/30">
                                                                <td class="p-2.5">
                                                                    <div class="font-bold text-on-surface">@emp.StaffName</div>
                                                                    <div class="text-[10px] text-on-surface-variant">#@emp.EmployeeCode • @emp.RoleName</div>
                                                                </td>
                                                                <td class="p-2.5 text-center font-bold">@emp.CashOrdersCount</td>
                                                                <td class="p-2.5 text-right font-black text-emerald-600">@emp.CashCollected.ToString("N0")đ</td>
                                                                <td class="p-2.5 text-center font-bold">@emp.NonCashOrdersCount</td>
                                                                <td class="p-2.5 text-right font-black text-primary">@emp.TotalRevenue.ToString("N0")đ</td>
                                                            </tr>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <tr>
                                                            <td colspan="5" class="p-4 text-center text-on-surface-variant">Chưa có giao dịch thanh toán trong ca.</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>

                                    <!-- SECTION D: CHECKLIST ĐIỀU KIỆN ĐÓNG CA -->
                                    <div class="bg-surface rounded-3xl border border-outline-variant p-6 shadow-sm space-y-4">
                                        <div class="flex justify-between items-center pb-2 border-b border-outline-variant">
                                            <span class="font-black text-sm text-amber-700 dark:text-amber-400 flex items-center gap-2">
                                                <span class="material-symbols-outlined text-lg">checklist</span>
                                                PHẦN D: KIỂM TRA ĐIỀU KIỆN ĐÓNG CA (4 ĐIỀU KIỆN)
                                            </span>
                                        </div>

                                        <div class="space-y-2 text-xs">
                                            <!-- Condition 1 -->
                                            <div class="p-2.5 rounded-xl border flex items-center justify-between @(CurrentShift.OutstandingOrdersCount == 0 ? "bg-emerald-500/10 border-emerald-500/20 text-emerald-800" : "bg-rose-500/10 border-rose-500/20 text-rose-800")">
                                                <div class="flex items-center gap-2">
                                                    <span class="material-symbols-outlined text-base @(CurrentShift.OutstandingOrdersCount == 0 ? "text-emerald-600" : "text-rose-600")">
                                                        @(CurrentShift.OutstandingOrdersCount == 0 ? "check_circle" : "cancel")
                                                    </span>
                                                    <span>1. 100% đơn hàng đã hoàn tất & thanh toán</span>
                                                </div>
                                                <span class="font-black">@(CurrentShift.OutstandingOrdersCount == 0 ? "ĐẠT" : "CHƯA ĐẠT")</span>
                                            </div>

                                            <!-- Condition 2 -->
                                            <div class="p-2.5 rounded-xl border flex items-center justify-between @(CurrentShift.RemainingCashToTillOut == 0 && (CurrentShift.ExpectedCash == 0 || CurrentShift.TotalTillOut > 0) ? "bg-emerald-500/10 border-emerald-500/20 text-emerald-800" : "bg-rose-500/10 border-rose-500/20 text-rose-800")">
                                                <div class="flex items-center gap-2">
                                                    <span class="material-symbols-outlined text-base @(CurrentShift.RemainingCashToTillOut == 0 && (CurrentShift.ExpectedCash == 0 || CurrentShift.TotalTillOut > 0) ? "text-emerald-600" : "text-rose-600")">
                                                        @(CurrentShift.RemainingCashToTillOut == 0 && (CurrentShift.ExpectedCash == 0 || CurrentShift.TotalTillOut > 0) ? "check_circle" : "cancel")
                                                    </span>
                                                    <span>2. Đã rút toàn bộ tiền mặt khỏi két (Till Out)</span>
                                                </div>
                                                <span class="font-black">@(CurrentShift.RemainingCashToTillOut == 0 && (CurrentShift.ExpectedCash == 0 || CurrentShift.TotalTillOut > 0) ? "ĐẠT" : "CHƯA ĐẠT")</span>
                                            </div>

                                            <!-- Condition 3 -->
                                            <div class="p-2.5 rounded-xl border flex items-center justify-between @(CurrentShift.Difference == 0 ? "bg-emerald-500/10 border-emerald-500/20 text-emerald-800" : "bg-rose-500/10 border-rose-500/20 text-rose-800")">
                                                <div class="flex items-center gap-2">
                                                    <span class="material-symbols-outlined text-base @(CurrentShift.Difference == 0 ? "text-emerald-600" : "text-rose-600")">
                                                        @(CurrentShift.Difference == 0 ? "check_circle" : "cancel")
                                                    </span>
                                                    <span>3. Khớp tiền tuyệt đối (Cash Difference == 0)</span>
                                                </div>
                                                <span class="font-black">@(CurrentShift.Difference == 0 ? "ĐẠT" : "CHƯA ĐẠT")</span>
                                            </div>

                                            <!-- Condition 4 -->
                                            <div class="p-2.5 rounded-xl border flex items-center justify-between bg-emerald-500/10 border-emerald-500/20 text-emerald-800">
                                                <div class="flex items-center gap-2">
                                                    <span class="material-symbols-outlined text-base text-emerald-600">check_circle</span>
                                                    <span>4. Quản lý ca xác nhận đóng ca (Role Manager/Admin)</span>
                                                </div>
                                                <span class="font-black">ĐẠT</span>
                                            </div>
                                        </div>

                                        <div>
                                            <label class="block text-xs font-black uppercase tracking-wider text-on-surface-variant mb-1">Ghi Chú Đóng Ca (Tùy chọn)</label>
                                            <input type="text" class="w-full px-4 py-2.5 rounded-xl border border-outline-variant text-xs bg-surface-high focus:ring-2 focus:ring-primary focus:outline-hidden"
                                                    placeholder="Ghi chú đóng ca cuối ngày..." @bind="CloseNote" />
                                        </div>

                                        <button class="w-full py-3.5 bg-amber-600 hover:bg-amber-700 disabled:bg-slate-400 text-white rounded-2xl font-black text-sm shadow-md transition-all cursor-pointer flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
                                                disabled="@(IsProcessing || !CurrentShift.CanCloseShift)" @onclick="CloseShiftAsync">
                                            @if (IsProcessing)
                                            {
                                                <span class="animate-spin rounded-full h-4 w-4 border-b-2 border-white"></span>
                                                <span>Đang xử lý đóng ca...</span>
                                            }
                                            else
                                            {
                                                <span class="material-symbols-outlined text-xl">lock_clock</span>
                                                <span>XÁC NHẬN ĐÓNG CA LÀM VIỆC</span>
                                            }
                                        </button>
                                        @if (!CurrentShift.CanCloseShift)
                                        {
                                            <p class="text-[11px] text-rose-600 text-center m-0 font-bold">
                                                * Nút Đóng ca bị khóa cho đến khi thỏa mãn đủ 4 điều kiện trên.
                                            </p>
                                        }
                                    </div>

                                </div>
                            </div>
                        </div>
                    }
                }

                <!-- TAB 2: TILL IN & TILL OUT -->
                @if (ActiveTab == "Cash")
                {
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                        
                        <!-- Left Form: Till In / Till Out -->
                        <div class="lg:col-span-5 bg-surface rounded-3xl border border-outline-variant p-6 shadow-sm space-y-4">
                            <div class="flex items-center justify-between pb-3 border-b border-outline-variant">
                                <span class="font-black text-sm text-primary flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-lg">swap_horiz</span>
                                    THAO TÁC TIỀN KÉT (TILL)
                                </span>
                            </div>

                            <!-- Operation Selector -->
                            <div class="grid grid-cols-2 gap-2 p-1 bg-surface-high rounded-2xl border border-outline-variant text-xs font-black">
                                <button class="py-2.5 rounded-xl transition-all cursor-pointer flex items-center justify-center gap-1.5 @(CashActionType == "TillIn" ? "bg-emerald-600 text-white shadow-xs" : "text-on-surface-variant hover:text-on-surface")"
                                        @onclick='() => CashActionType = "TillIn"'>
                                    <span class="material-symbols-outlined text-base">move_to_inbox</span>
                                    <span>Nộp Tiền (Till In)</span>
                                </button>
                                <button class="py-2.5 rounded-xl transition-all cursor-pointer flex items-center justify-center gap-1.5 @(CashActionType == "TillOut" ? "bg-rose-600 text-white shadow-xs" : "text-on-surface-variant hover:text-on-surface")"
                                        @onclick='() => CashActionType = "TillOut"'>
                                    <span class="material-symbols-outlined text-base">outbox</span>
                                    <span>Rút Tiền (Till Out)</span>
                                </button>
                            </div>

                            <div>
                                <label class="block text-xs font-black uppercase tracking-wider text-on-surface-variant mb-1.5">Số Tiền (VNĐ)</label>
                                
                                <!-- Quick chips -->
                                <div class="grid grid-cols-4 gap-1.5 mb-2">
                                    <button type="button" class="py-1 px-1.5 rounded-xl text-[11px] font-bold border transition-all cursor-pointer bg-surface-high border-outline-variant hover:border-primary/50"
                                            @onclick="() => CashAmount = 100000">100k</button>
                                    <button type="button" class="py-1 px-1.5 rounded-xl text-[11px] font-bold border transition-all cursor-pointer bg-surface-high border-outline-variant hover:border-primary/50"
                                            @onclick="() => CashAmount = 200000">200k</button>
                                    <button type="button" class="py-1 px-1.5 rounded-xl text-[11px] font-bold border transition-all cursor-pointer bg-surface-high border-outline-variant hover:border-primary/50"
                                            @onclick="() => CashAmount = 500000">500k</button>
                                    <button type="button" class="py-1 px-1.5 rounded-xl text-[11px] font-bold border transition-all cursor-pointer bg-surface-high border-outline-variant hover:border-primary/50"
                                            @onclick="() => CashAmount = 1000000">1.000k</button>
                                </div>

                                <div class="relative">
                                    <span class="material-symbols-outlined absolute left-3.5 top-3.5 text-on-surface-variant text-xl">payments</span>
                                    <input type="number" class="w-full pl-11 pr-4 py-3 rounded-2xl border border-outline-variant font-black text-2xl text-primary bg-surface-high focus:ring-2 focus:ring-primary focus:outline-hidden"
                                            @bind="CashAmount" step="50000" min="0" />
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-black uppercase tracking-wider text-on-surface-variant mb-1.5">Lý Do / Mục Đích</label>
                                <input type="text" class="w-full px-4 py-3 rounded-2xl border border-outline-variant text-sm bg-surface-high focus:ring-2 focus:ring-primary focus:outline-hidden"
                                        placeholder="@(CashActionType == "TillIn" ? "Ví dụ: Bổ sung tiền thối 500k..." : "Ví dụ: Rút nộp ngân hàng 3 triệu...")"
                                        @bind="CashReason" />
                            </div>

                            @if (CashActionType == "TillOut")
                            {
                                <div class="p-4 rounded-2xl bg-amber-500/10 border border-amber-500/30 space-y-3">
                                    <div class="flex items-center justify-between">
                                        <span class="text-xs font-black uppercase text-amber-800 dark:text-amber-300 flex items-center gap-1.5">
                                            <span class="material-symbols-outlined text-base">pin</span>
                                            MÃ PIN QUẢN LÝ (BẮT BUỘC)
                                        </span>
                                        @if (TillOutBalanceCheck != null)
                                        {
                                            <span class="text-[11px] font-bold text-emerald-600 bg-emerald-500/15 px-2 py-0.5 rounded-full flex items-center gap-1">
                                                <span class="material-symbols-outlined text-sm">verified</span>
                                                Đã xác thực
                                            </span>
                                        }
                                    </div>

                                    <div class="flex gap-2">
                                        <input type="password" maxlength="6"
                                               class="flex-1 px-4 py-2.5 rounded-xl border border-outline-variant font-mono font-black text-center tracking-[0.3em] text-lg bg-surface-high focus:ring-2 focus:ring-primary focus:outline-hidden"
                                               placeholder="••••••"
                                               @bind="TillOutManagerPin"
                                               @onkeyup="HandleTillOutPinKeyUp" />
                                        <button type="button"
                                                class="px-4 py-2.5 bg-primary hover:bg-primary-hover text-on-primary rounded-xl font-bold text-xs flex items-center gap-1.5 transition-all cursor-pointer disabled:opacity-50"
                                                disabled="@(IsCheckingBalance || string.IsNullOrWhiteSpace(TillOutManagerPin))"
                                                @onclick="CheckTillOutBalanceAsync">
                                            @if (IsCheckingBalance)
                                            {
                                                <span class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                                            }
                                            else
                                            {
                                                <span class="material-symbols-outlined text-base">search_check</span>
                                            }
                                            <span>Kiểm tra</span>
                                        </button>
                                    </div>

                                    @if (!string.IsNullOrEmpty(TillOutPinError))
                                    {
                                        <div class="text-[11px] text-rose-600 font-bold flex items-center gap-1">
                                            <span class="material-symbols-outlined text-sm">error</span>
                                            <span>@TillOutPinError</span>
                                        </div>
                                    }

                                    @if (TillOutBalanceCheck != null)
                                    {
                                        <div class="p-3 bg-surface rounded-xl border border-emerald-500/30 text-xs space-y-1.5 shadow-2xs">
                                            <div class="flex justify-between items-center text-slate-500 text-[11px]">
                                                <span>Quản lý xác thực:</span>
                                                <span class="font-bold text-on-surface">@TillOutBalanceCheck.ManagerName (@TillOutBalanceCheck.ManagerRole)</span>
                                            </div>
                                            <div class="flex justify-between items-center text-slate-500 text-[11px]">
                                                <span>Tiền đầu ca:</span>
                                                <span class="font-bold text-on-surface">@TillOutBalanceCheck.OpeningBalance.ToString("N0")đ</span>
                                            </div>
                                            <div class="flex justify-between items-center text-slate-500 text-[11px]">
                                                <span>Thu tiền mặt trong ca:</span>
                                                <span class="font-bold text-emerald-600">+@TillOutBalanceCheck.CashSales.ToString("N0")đ</span>
                                            </div>
                                            @if (TillOutBalanceCheck.TotalTillOut > 0)
                                            {
                                                <div class="flex justify-between items-center text-slate-500 text-[11px]">
                                                    <span>Đã rút trước đó:</span>
                                                    <span class="font-bold text-rose-600">-@TillOutBalanceCheck.TotalTillOut.ToString("N0")đ</span>
                                                </div>
                                            }
                                            <div class="pt-1.5 border-t border-outline-variant flex justify-between items-center font-black">
                                                <span class="text-primary text-xs uppercase">TIỀN MẶT HIỆN CÓ TRONG KÉT:</span>
                                                <span class="text-sm text-emerald-600">@TillOutBalanceCheck.CurrentCashInDrawer.ToString("N0")đ</span>
                                            </div>
                                            <button type="button" 
                                                    class="w-full mt-1 py-1.5 px-2 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 rounded-lg text-[11px] font-bold border border-emerald-500/30 transition-all cursor-pointer flex items-center justify-center gap-1"
                                                    @onclick="() => CashAmount = TillOutBalanceCheck.CurrentCashInDrawer">
                                                <span class="material-symbols-outlined text-sm">payments</span>
                                                <span>Rút toàn bộ số tiền này (@TillOutBalanceCheck.CurrentCashInDrawer.ToString("N0")đ)</span>
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-[11px] text-amber-700 dark:text-amber-400 font-medium">
                                            ⚠️ Nhập mã PIN Quản lý để hệ thống kiểm tra số dư tiền mặt hiện tại trong két trước khi rút tiền.
                                        </div>
                                    }
                                </div>
                            }

                            <button class="w-full py-3.5 rounded-2xl font-black text-sm shadow-md transition-all cursor-pointer flex items-center justify-center gap-2 @(CashActionType == "TillIn" ? "bg-emerald-600 hover:bg-emerald-700 text-white" : "bg-rose-600 hover:bg-rose-700 text-white") disabled:opacity-50"
                                    disabled="@(IsProcessing || (CashActionType == "TillOut" && TillOutBalanceCheck == null))" @onclick="SubmitCashActionAsync">
                                <span class="material-symbols-outlined text-lg">send</span>
                                <span>XÁC NHẬN @(CashActionType == "TillIn" ? "NỘP TIỀN" : "RÚT TIỀN")</span>
                            </button>
                        </div>

                        <!-- Right List: Cash Movements History -->
                        <div class="lg:col-span-7 bg-surface rounded-3xl border border-outline-variant p-6 shadow-sm flex flex-col justify-between">
                            <div>
                                <h3 class="font-black text-sm text-primary pb-3 border-b border-outline-variant flex items-center justify-between">
                                    <span class="flex items-center gap-2">
                                        <span class="material-symbols-outlined text-lg">history</span>
                                        LỊCH SỬ BIẾN ĐỘNG TIỀN KÉT (CASH MOVEMENTS)
                                    </span>
                                    <span class="text-xs text-on-surface-variant font-medium">Ca hiện tại</span>
                                </h3>

                                <div class="overflow-y-auto max-h-[350px] space-y-2.5 mt-3 pr-1">
                                    @if (CashSummary == null || !CashSummary.Movements.Any())
                                    {
                                        <div class="text-center text-xs text-on-surface-variant py-12 flex flex-col items-center gap-2">
                                            <span class="material-symbols-outlined text-3xl opacity-30">receipt</span>
                                            <span>Chưa có giao dịch biến động tiền két nào trong ca này.</span>
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (var move in CashSummary.Movements)
                                        {
                                            <div class="p-3.5 bg-surface-high/60 rounded-2xl border border-outline-variant/60 flex justify-between items-center text-xs hover:border-primary/40 transition-colors">
                                                <div>
                                                    <div class="font-black text-on-surface">@move.TypeName</div>
                                                    <div class="text-[11px] text-on-surface-variant mt-0.5">@move.Reason (@move.CreatedAt.ToString("HH:mm:ss"))</div>
                                                </div>
                                                <div class="font-black text-sm text-right @(move.Amount >= 0 ? "text-emerald-600" : "text-rose-600")">
                                                    @(move.Amount >= 0 ? $"+{move.Amount:N0}đ" : $"{move.Amount:N0}đ")
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>

                    </div>
                }

                <!-- TAB 3: BILL VIEWER -->
                @if (ActiveTab == "Bills")
                {
                    <div class="bg-surface rounded-3xl border border-outline-variant p-6 shadow-sm space-y-4">
                        @if (CurrentShift == null)
                        {
                            <div class="p-3.5 bg-amber-500/10 border border-amber-500/25 text-amber-800 dark:text-amber-300 text-xs rounded-2xl font-bold flex items-center gap-2">
                                <span class="material-symbols-outlined text-base">info</span>
                                <span>@(IsCashierOnly ? "Cửa hàng hiện chưa mở ca. Mở ca làm việc bắt buộc được thực hiện từ cấp Quản lý trở lên. Thu ngân chỉ có quyền tra cứu và in lại hóa đơn." : "Cửa hàng hiện chưa mở ca. Bạn đang tra cứu danh sách hóa đơn toàn hệ thống.")</span>
                            </div>
                        }

                        <div class="flex items-center gap-3">
                            <div class="relative flex-1">
                                <span class="material-symbols-outlined absolute left-3.5 top-3 text-on-surface-variant text-xl">search</span>
                                <input type="text" class="w-full pl-11 pr-4 py-2.5 rounded-2xl border border-outline-variant bg-surface-high text-sm font-medium focus:ring-2 focus:ring-primary focus:outline-hidden"
                                       placeholder="Tìm kiếm mã hóa đơn, tên khách hàng, số điện thoại..." @bind="SearchBillKeyword" @onkeyup="HandleSearchKeyUp" />
                            </div>
                            <button class="px-6 py-2.5 bg-primary text-on-primary font-black text-xs rounded-2xl shadow-xs hover:bg-primary/90 cursor-pointer"
                                    @onclick="SearchBillsAsync">
                                TÌM KIẾM
                            </button>
                        </div>

                        <!-- Bill List Table -->
                        <div class="overflow-x-auto border border-outline-variant/60 rounded-2xl">
                            <table class="w-full text-left text-xs">
                                <thead>
                                    <tr class="bg-surface-high border-b border-outline-variant text-on-surface-variant uppercase font-black text-[11px]">
                                        <th class="p-3.5">Mã Đơn</th>
                                        <th class="p-3.5">Bàn / Kênh</th>
                                        <th class="p-3.5">Khách Hàng</th>
                                        <th class="p-3.5">Thời Gian</th>
                                        <th class="p-3.5">Tổng Tiền</th>
                                        <th class="p-3.5">Phương Thức</th>
                                        <th class="p-3.5 text-right">Thao Tác</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-outline-variant/60">
                                    @if (!BillList.Any())
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center p-8 text-on-surface-variant">Không tìm thấy hóa đơn nào phù hợp.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var bill in BillList)
                                        {
                                            <tr class="hover:bg-surface-high/40 transition-colors">
                                                <td class="p-3.5 font-black text-primary">@bill.OrderCode</td>
                                                <td class="p-3.5 font-bold">@bill.TableName</td>
                                                <td class="p-3.5">@bill.CustomerName (@(string.IsNullOrEmpty(bill.CustomerPhone) ? "Khách lẻ" : bill.CustomerPhone))</td>
                                                <td class="p-3.5 text-on-surface-variant">@bill.CreatedAt.ToString("dd/MM HH:mm")</td>
                                                <td class="p-3.5 font-black text-emerald-600">@bill.TotalAmount.ToString("N0")đ</td>
                                                <td class="p-3.5 font-semibold">@bill.PaymentMethodName</td>
                                                <td class="p-3.5 text-right">
                                                    <button class="px-3.5 py-1.5 bg-surface-high hover:bg-primary hover:text-white border border-outline-variant rounded-xl font-bold text-[11px] transition-all cursor-pointer shadow-2xs"
                                                            @onclick="() => OpenBillDetail(bill.OrderId)">
                                                        Xem & In Bill
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                <!-- TAB 4: DAILY SALES REPORT (MANAGER / ADMIN ONLY) -->
                @if (ActiveTab == "DailyReport" && IsManagerOrAdmin)
                {
                    <div class="space-y-4">
                        <!-- Date Bar & Controls -->
                        <div class="p-4 bg-surface rounded-3xl border border-outline-variant flex flex-wrap items-center justify-between gap-4 shadow-2xs">
                            <div class="flex flex-wrap items-center gap-3">
                                <span class="text-xs font-black uppercase text-on-surface-variant flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-lg text-primary">calendar_month</span>
                                    CHỌN NGÀY BÁO CÁO:
                                </span>
                                <input type="date"
                                       class="px-4 py-2 rounded-xl border border-outline-variant text-sm font-bold bg-surface-high focus:ring-2 focus:ring-primary focus:outline-hidden"
                                       value="@SelectedReportDate.ToString("yyyy-MM-dd")"
                                       max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       @onchange="OnReportDateChanged" />
                                <button type="button" 
                                        class="px-3 py-1.5 rounded-lg text-xs font-bold border border-outline-variant hover:border-primary/50 bg-surface-high transition-colors cursor-pointer"
                                        @onclick='() => SetReportDate(DateTime.Today)'>Hôm nay</button>
                                <button type="button" 
                                        class="px-3 py-1.5 rounded-lg text-xs font-bold border border-outline-variant hover:border-primary/50 bg-surface-high transition-colors cursor-pointer"
                                        @onclick='() => SetReportDate(DateTime.Today.AddDays(-1))'>Hôm qua</button>
                            </div>

                            <div class="flex items-center gap-2">
                                <button type="button" 
                                        class="px-4 py-2 bg-surface-high hover:bg-surface border border-outline-variant rounded-xl text-xs font-bold flex items-center gap-1.5 cursor-pointer transition-all"
                                        @onclick="LoadDailySalesReportAsync">
                                    <span class="material-symbols-outlined text-base @(IsLoadingDailyReport ? "animate-spin" : "")">sync</span>
                                    <span>Làm mới</span>
                                </button>
                                <button type="button" 
                                        class="px-4 py-2 bg-primary hover:bg-primary-hover text-on-primary rounded-xl text-xs font-bold flex items-center gap-1.5 cursor-pointer shadow-xs transition-all"
                                        @onclick="PrintDailyReport">
                                    <span class="material-symbols-outlined text-base">print</span>
                                    <span>In Báo Cáo Ngày</span>
                                </button>
                            </div>
                        </div>

                        @if (IsLoadingDailyReport)
                        {
                            <div class="text-center py-16 flex flex-col items-center justify-center gap-3">
                                <div class="w-10 h-10 border-4 border-primary border-t-transparent rounded-full animate-spin"></div>
                                <span class="text-xs text-on-surface-variant font-bold">Đang tổng hợp dữ liệu doanh số ngày @SelectedReportDate.ToString("dd/MM/yyyy")...</span>
                            </div>
                        }
                        else if (DailyReport != null)
                        {
                            <!-- Financial Overview Cards (Gross, Promo Discount, Complimentary Discount, Net Sales, VAT) -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5">
                                <!-- 1. Gross Sales -->
                                <div class="p-4 bg-surface rounded-2xl border border-outline-variant shadow-2xs">
                                    <div class="flex items-center justify-between text-xs text-on-surface-variant font-bold mb-1.5">
                                        <span class="text-[11px] uppercase tracking-wider">DOANH THU GỘP</span>
                                        <span class="material-symbols-outlined text-blue-600 text-lg">point_of_sale</span>
                                    </div>
                                    <div class="text-xl font-black text-blue-700 dark:text-blue-400">@DailyReport.GrossSales.ToString("N0")đ</div>
                                    <div class="text-[10px] text-on-surface-variant mt-1">Gross Sales (trước giảm giá)</div>
                                </div>

                                <!-- 2. Promotion Discount -->
                                <div class="p-4 bg-surface rounded-2xl border border-amber-500/30 bg-amber-500/5 shadow-2xs">
                                    <div class="flex items-center justify-between text-xs text-amber-800 dark:text-amber-300 font-bold mb-1.5">
                                        <span class="text-[11px] uppercase tracking-wider">GIẢM KHUYẾN MÃI</span>
                                        <span class="material-symbols-outlined text-amber-600 text-lg">sell</span>
                                    </div>
                                    <div class="text-xl font-black text-amber-700 dark:text-amber-400">-@DailyReport.PromotionDiscount.ToString("N0")đ</div>
                                    <div class="text-[10px] text-amber-700/80 dark:text-amber-400/80 mt-1">Voucher & chiết khấu đơn</div>

                                        <div class="text-[10px] text-on-surface-variant font-bold uppercase">AOV (TB/Đơn)</div>
                                        <div class="text-lg font-black text-emerald-600 mt-0.5">@DailyReport.AverageOrderValue.ToString("N0")đ</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Payment Methods Breakdown Cards -->
                            <div class="p-4 bg-surface rounded-2xl border border-outline-variant shadow-2xs space-y-3">
                                <h4 class="font-black text-xs uppercase text-primary flex items-center justify-between pb-2 border-b border-outline-variant">
                                    <span class="flex items-center gap-1.5">
                                        <span class="material-symbols-outlined text-base">account_balance_wallet</span>
                                        CƠ CẤU HÌNH THỨC THANH TOÁN
                                    </span>
                                    <span class="text-[11px] font-bold text-on-surface-variant">Tổng thu: @DailyReport.NetSales.ToString("N0")đ</span>
                                </h4>

                                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-4">
                                    @foreach (var pm in DailyReport.PaymentMethods)
                                    {
                                        <div class="p-4 rounded-xl bg-surface-high/60 border border-outline-variant/60 flex flex-col justify-between space-y-2">
                                            <div class="flex items-center justify-between">
                                                <div class="flex items-center gap-2">
                                                    <span class="material-symbols-outlined text-primary text-xl">@pm.Icon</span>
                                                    <span class="font-extrabold text-sm text-on-surface">@pm.MethodName</span>
                                                </div>
                                                <span class="text-xs font-black text-primary bg-primary/10 px-2.5 py-0.5 rounded-full">@pm.Percentage%</span>
                                            </div>
                                            <div class="flex items-baseline justify-between pt-1">
                                                <span class="text-2xl font-black text-on-surface">@pm.TotalAmount.ToString("N0")đ</span>
                                                <span class="text-xs font-bold text-on-surface-variant">@pm.TransactionCount lượt thanh toán</span>
                                            </div>
                                            <!-- Progress bar -->
                                            <div class="w-full bg-outline-variant/30 h-2 rounded-full overflow-hidden">

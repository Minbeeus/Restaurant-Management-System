        </main>

        <!-- SECTION RIGHT (Strict 15% Width): Standardized Action Toolbar -->
        <!-- User instruction: "chỉ có nút quay lại, không có các công cụ kia" -->
        <aside class="w-[15%] min-w-[150px] max-w-[200px] h-full bg-surface rounded-2xl border border-outline-variant p-2.5 shadow-sm flex flex-col justify-end shrink-0 overflow-hidden">
            <!-- Center placeholder brand/icon -->
            <div class="flex-1 flex flex-col items-center justify-center text-center p-4 text-on-surface-variant/40 select-none">
                <span class="material-symbols-outlined text-4xl mb-2 text-primary/40">point_of_sale</span>
                <span class="text-xs font-bold uppercase tracking-wider text-on-surface-variant/60">Thu Ngân POS</span>

@page "/qr"
@page "/order"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.EmptyLayout
@using Restaurant.Web.Components.Pages.Qr.Components
@using Restaurant.Application.DTOs
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="h-screen bg-surface-low overflow-hidden flex flex-col relative font-body-md text-on-background">

    <!-- Header -->
    <header class="bg-surface shadow-sm sticky top-0 z-10 px-4 py-3 border-b border-outline-variant">
        <div class="flex justify-between items-center">
            <div>
                <h1 class="font-bold text-lg text-primary leading-tight">@TableName</h1>
                <p class="text-xs text-on-surface-variant">@AreaName — Xin chào quý khách!</p>
            </div>
            <button class="px-3 py-1.5 bg-primary/10 text-primary rounded-full text-xs font-bold flex items-center gap-1"
                    @onclick="GoToOrderStatus">
                <span class="material-symbols-outlined text-[16px]">receipt_long</span>
                Đơn của tôi
            </button>
        </div>

        <!-- Search bar -->
        <div class="mt-3 relative">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px]">search</span>
            <input type="text" placeholder="Tìm kiếm món ăn..."
                   class="w-full bg-surface-low border border-outline-variant rounded-full py-2 pl-10 pr-4 focus:outline-none focus:border-primary text-sm"
                   @bind="SearchText" @bind:event="oninput" />
        </div>
    </header>

    @if (IsLoading)
    {
        <div class="flex-1 flex flex-col items-center justify-center gap-3 text-on-surface-variant">
            <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-primary"></div>
            <span class="text-sm font-medium">Đang tải thực đơn...</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="flex-1 flex flex-col items-center justify-center p-6 text-center text-error">
            <span class="material-symbols-outlined text-5xl mb-2">error_outline</span>
            <p class="font-bold text-base">@ErrorMessage</p>
            <p class="text-xs text-on-surface-variant mt-1">Vui lòng quét lại mã QR tại bàn để sử dụng.</p>
        </div>
    }
    else
    {
        <!-- Category Tabs -->
        <div class="bg-surface border-b border-outline-variant sticky top-[108px] z-10 px-4 py-2 flex overflow-x-auto gap-2 hide-scrollbar">
            <button class="whitespace-nowrap px-4 py-1.5 rounded-full text-xs font-bold transition-all @(ActiveCategoryId == 0 ? "bg-primary text-on-primary shadow-xs" : "bg-surface-low text-on-surface-variant")"
                    @onclick="() => ActiveCategoryId = 0">
                Tất cả
            </button>
            @foreach (var cat in Categories)
            {
                <button class="whitespace-nowrap px-4 py-1.5 rounded-full text-xs font-bold transition-all @(ActiveCategoryId == cat.Id ? "bg-primary text-on-primary shadow-xs" : "bg-surface-low text-on-surface-variant")"
                        @onclick="() => ActiveCategoryId = cat.Id">
                    @cat.DisplayName
                </button>
            }
        </div>

        <!-- Menu Items -->
        <main class="flex-1 overflow-y-auto p-4 pb-28">
            <div class="flex flex-col gap-3">
                @foreach (var item in DisplayedMenuItems)
                {
                    <div class="bg-surface rounded-2xl p-4 flex gap-3 shadow-xs border border-outline-variant/50 active:scale-[0.98] transition-transform cursor-pointer"
                         @onclick="() => OpenItemDetail(item)">
                        <div class="flex-1 flex flex-col justify-between py-0.5">
                            <div>
                                <h3 class="font-bold text-on-surface text-base leading-tight">@item.DisplayName</h3>
                                <p class="text-xs text-on-surface-variant mt-1 line-clamp-2">@item.DisplayDescription</p>
                            </div>
                            <div class="flex justify-between items-end mt-2">
                                <span class="font-bold text-primary text-base font-mono tabular-nums">@item.Price.ToString("N0") đ</span>
                                <button class="w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center shadow-xs active:scale-90 transition-transform"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => OpenItemDetail(item)">
                                    <span class="material-symbols-outlined text-[18px]">add</span>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </main>
    }

    <!-- Floating Cart Button (FAB) — bottom-right, visible when cart has items -->
    @if (CartItems.Any())
    {
        <button class="fixed bottom-6 right-5 z-30 bg-primary text-on-primary rounded-full shadow-2xl flex items-center gap-2.5 px-5 py-3.5 font-bold text-sm active:scale-95 transition-all"
                style="animation: popIn 0.3s cubic-bezier(0.34,1.56,0.64,1);"
                @onclick="() => IsCartModalOpen = true">
            <div class="relative">
                <span class="material-symbols-outlined text-[22px]">shopping_cart</span>
                <!-- Badge -->
                <span class="absolute -top-2 -right-2 bg-error text-white text-[10px] font-extrabold rounded-full w-5 h-5 flex items-center justify-center shadow">
                    @(CartItems.Sum(x => x.Quantity) > 99 ? "99+" : CartItems.Sum(x => x.Quantity).ToString())
                </span>
            </div>
            <div class="flex flex-col items-start leading-none">
                <span class="text-[10px] opacity-80">Giỏ hàng</span>
                <span class="font-extrabold font-mono tabular-nums">@CartItems.Sum(x => x.Price * x.Quantity).ToString("N0") đ</span>
            </div>
        </button>
    }

    <!-- Item Modifier Drawer -->
    <QrBottomDrawer
        @bind-IsOpen="IsDrawerOpen"
        Item="SelectedItem"
        ModifierGroups="SelectedItemModifiers"
        OnAddToCart="HandleAddToCart" />

    <!-- Full-screen Cart Page -->
    <QrCartModal
        @ref="CartModalRef"
        @bind-IsOpen="IsCartModalOpen"
        CartItems="CartItems"
        OnProceedToCustomerInfo="HandleOpenCustomerInfoModal" />

    <!-- Loyalty / Phone Dialog -->
    <QrCustomerInfoModal
        @bind-IsOpen="IsCustomerInfoModalOpen"
        IsSubmitting="IsSubmitting"
        OnConfirm="HandleConfirmAndSubmit"
        OnSkip="HandleSkipAndSubmit" />

</div>

<style>
    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    .pb-safe { padding-bottom: env(safe-area-inset-bottom, 1rem); }
    @@keyframes popIn {
        from { transform: scale(0.7) translateY(20px); opacity: 0; }
        to   { transform: scale(1)   translateY(0);    opacity: 1; }
    }
</style>

@code {
    [SupplyParameterFromQuery] public string TableId { get; set; } = default!;
    [SupplyParameterFromQuery] public string Token { get; set; } = default!;

    private string TableName = "Bàn ăn";
    private string AreaName = "";
    private bool IsLoading = true;
    private string ErrorMessage = string.Empty;

    private int ActiveCategoryId = 0;
    private string SearchText = string.Empty;

    private List<PublicCategoryDto> Categories = new();
    private List<PublicMenuItemDto> AllMenuItems = new();
    private List<QrBottomDrawer.QrCartItemLocal> CartItems = new();

    private bool IsDrawerOpen = false;
    private bool IsCartModalOpen = false;
    private bool IsCustomerInfoModalOpen = false;
    private PublicMenuItemDto? SelectedItem;
    private List<ModifierGroupDto>? SelectedItemModifiers;
    private bool IsSubmitting = false;

    // Cart ref to get applied voucher
    private QrCartModal? CartModalRef;

    private List<PublicMenuItemDto> DisplayedMenuItems
    {
        get
        {
            var items = ActiveCategoryId == 0
                ? AllMenuItems
                : AllMenuItems.Where(i => i.CategoryId == ActiveCategoryId).ToList();
            if (!string.IsNullOrWhiteSpace(SearchText))
                items = items.Where(i => i.Name.Contains(SearchText, StringComparison.OrdinalIgnoreCase)).ToList();
            return items;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(TableId) || string.IsNullOrEmpty(Token))
        {
            ErrorMessage = "Mã QR không hợp lệ hoặc thiếu thông tin bàn.";
            IsLoading = false;
            return;
        }

        try
        {
            int parsedTableId = int.Parse(TableId);
            var res = await Http.GetFromJsonAsync<ApiResponseWrapper<PublicMenuResponse>>(
                $"api/v1/qr/menu?tableId={parsedTableId}&token={Token}");

            if (res?.Success == true && res.Data != null)
            {
                TableName = res.Data.TableName;
                AreaName = res.Data.AreaName;
                Categories = res.Data.Categories;
                AllMenuItems = res.Data.Categories.SelectMany(c => c.MenuItems).ToList();
            }
            else
            {
                ErrorMessage = "Không thể tải thực đơn. Vui lòng thử lại.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task OpenItemDetail(PublicMenuItemDto item)
    {
        SelectedItem = item;
        SelectedItemModifiers = null;

        if (int.TryParse(TableId, out int parsedTableId))
        {
            try
            {
                var res = await Http.GetFromJsonAsync<ApiResponseWrapper<MenuItemDetailDto>>(
                    $"api/v1/qr/menu-items/{item.Id}?tableId={parsedTableId}&token={Token}");
                if (res?.Success == true && res.Data != null)
                    SelectedItemModifiers = res.Data.ModifierGroups;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading modifiers: {ex.Message}");
            }
        }

        IsDrawerOpen = true;
    }

    private void HandleAddToCart(QrBottomDrawer.QrCartItemLocal item)
    {
        var existing = CartItems.FirstOrDefault(x =>
            x.MenuItemId == item.MenuItemId &&
            (x.SelectedModifiers?.SequenceEqual(item.SelectedModifiers) == true));

        if (existing != null)
            existing.Quantity += item.Quantity;
        else
            CartItems.Add(item);

        StateHasChanged();
    }

    private void HandleOpenCustomerInfoModal()
    {
        if (CartItems.Any())
            IsCustomerInfoModalOpen = true;
    }

    // Submit WITH customer phone
    private async Task HandleConfirmAndSubmit((string CustomerName, string PhoneNumber) info)
        => await DoSubmit(info.CustomerName, info.PhoneNumber);

    // Submit WITHOUT customer phone (skip loyalty)
    private async Task HandleSkipAndSubmit()
        => await DoSubmit(null, null);

    private async Task DoSubmit(string? customerName, string? customerPhone)
    {
        if (!CartItems.Any() || IsSubmitting) return;
        IsSubmitting = true;
        IsCustomerInfoModalOpen = false;

        try
        {
            int parsedTableId = int.Parse(TableId);
            var req = new SubmitQrOrderRequest
            {
                TableId = parsedTableId,
                QrToken = Token,
                CustomerName = customerName,
                CustomerPhone = customerPhone,
                CustomerNote = "Gọi từ điện thoại khách hàng",
                VoucherCode = CartModalRef?.AppliedVoucherCode,
                Items = CartItems.Select(i => new CartItemValidateRequest
                {
                    MenuItemId = i.MenuItemId,
                    Quantity = i.Quantity,
                    Note = i.Note,
                    SelectedModifiers = i.SelectedModifiers
                }).ToList()
            };

            var res = await Http.PostAsJsonAsync("api/v1/qr/orders/submit", req);
            if (res.IsSuccessStatusCode)
            {
                CartItems.Clear();
                GoToOrderStatus();
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                ErrorMessage = $"Gửi đơn không thành công: {err}";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private void GoToOrderStatus()
    {
        Navigation.NavigateTo($"/qr/status?tableId={TableId}&token={Token}");
    }

    private class ApiResponseWrapper<T>
    {
        public bool Success { get; set; }
        public T? Data { get; set; }
    }
}

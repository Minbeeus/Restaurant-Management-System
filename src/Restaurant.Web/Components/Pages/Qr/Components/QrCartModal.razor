@using Restaurant.Web.Components.Pages.Qr.Components

@if (IsOpen)
{
    <!-- Full-screen slide-in cart page -->
    <div class="fixed inset-0 z-40 bg-surface-low flex flex-col"
         style="animation: slideInRight 0.25s cubic-bezier(0.34,1.1,0.64,1);">

        <!-- Header -->
        <header class="bg-surface px-4 py-3.5 flex items-center gap-3 border-b border-outline-variant shrink-0 shadow-sm">
            <button @onclick="Close" class="w-9 h-9 flex items-center justify-center rounded-full hover:bg-surface-low text-on-surface-variant">
                <span class="material-symbols-outlined">arrow_back</span>
            </button>
            <div class="flex-1">
                <h2 class="font-bold text-base text-on-surface">Giỏ hàng của bạn</h2>
                <p class="text-xs text-on-surface-variant">@CartItems.Sum(x => x.Quantity) món</p>
            </div>
            @if (CartItems.Any())
            {
                <button @onclick="ClearAll" class="text-xs text-error font-medium px-3 py-1.5 rounded-full hover:bg-error/10 transition-colors">
                    Xóa tất cả
                </button>
            }
        </header>

        <!-- Body -->
        <div class="flex-1 overflow-y-auto px-4 py-3 space-y-3">
            @if (!CartItems.Any())
            {
                <div class="flex flex-col items-center justify-center py-24 text-center text-on-surface-variant gap-3">
                    <span class="material-symbols-outlined text-6xl text-outline/50">shopping_bag</span>
                    <p class="font-bold text-base text-on-surface">Giỏ hàng trống</p>
                    <p class="text-xs">Thêm món ăn yêu thích vào giỏ hàng nhé!</p>
                    <button @onclick="Close"
                            class="mt-2 px-6 py-2.5 bg-primary text-on-primary rounded-full font-bold text-sm shadow-sm">
                        Tiếp tục chọn món
                    </button>
                </div>
            }
            else
            {
                @for (int i = 0; i < CartItems.Count; i++)
                {
                    var idx = i;
                    var item = CartItems[idx];
                    <div class="bg-surface rounded-2xl p-4 shadow-xs border border-outline-variant/50">
                        <div class="flex items-start justify-between gap-3">
                            <!-- Name & price -->
                            <div class="flex-1 min-w-0">
                                <div class="font-bold text-base text-on-surface leading-tight">@item.Name</div>
                                <div class="text-primary font-bold text-sm mt-0.5">@((item.Price).ToString("N0"))đ / phần</div>
                            </div>
                            <!-- Qty controls -->
                            <div class="flex items-center gap-2 shrink-0">
                                <button class="w-8 h-8 rounded-full border border-outline-variant flex items-center justify-center text-on-surface active:scale-90 transition-transform bg-surface-low"
                                        @onclick="() => DecreaseQty(idx)">
                                    @if (item.Quantity == 1)
                                    {
                                        <span class="material-symbols-outlined text-[16px] text-error">delete</span>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined text-[16px]">remove</span>
                                    }
                                </button>
                                <span class="w-6 text-center font-bold text-sm select-none">@item.Quantity</span>
                                <button class="w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center active:scale-90 transition-transform"
                                        @onclick="() => IncreaseQty(idx)">
                                    <span class="material-symbols-outlined text-[16px]">add</span>
                                </button>
                            </div>
                        </div>

                        <!-- Subtotal -->
                        <div class="mt-2 flex justify-between items-center text-xs text-on-surface-variant border-t border-outline-variant/40 pt-2">
                            <span>@item.Quantity × @item.Price.ToString("N0")đ</span>
                            <span class="font-bold text-on-surface">= @((item.Price * item.Quantity).ToString("N0"))đ</span>
                        </div>

                        <!-- Note input for this item -->
                        <div class="mt-3">
                            <label class="block text-xs font-semibold text-on-surface-variant mb-1 flex items-center gap-1">
                                <span class="material-symbols-outlined text-[14px]">edit_note</span>
                                Ghi chú cho bếp
                            </label>
                            <input type="text"
                                   placeholder="Ví dụ: Ít cay, không hành, thêm sốt..."
                                   class="w-full bg-surface-low border border-outline-variant rounded-xl px-3 py-2 text-sm focus:outline-none focus:border-primary text-on-surface"
                                   @bind="item.Note" />
                        </div>
                    </div>
                }

                <!-- Voucher code section -->
                <div class="bg-surface rounded-2xl p-4 shadow-xs border border-outline-variant/50">
                    <label class="block text-sm font-bold text-on-surface mb-2 flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[18px] text-primary">local_offer</span>
                        Mã giảm giá
                    </label>
                    <div class="flex gap-2">
                        <input type="text"
                               placeholder="Nhập mã giảm giá..."
                               class="flex-1 bg-surface-low border @(string.IsNullOrEmpty(VoucherError) ? "border-outline-variant" : "border-error") rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-primary uppercase tracking-wider"
                               @bind="VoucherCode" />
                        <button class="px-4 py-2.5 bg-primary/10 text-primary rounded-xl text-sm font-bold active:scale-95 transition-transform"
                                @onclick="ApplyVoucher">
                            Áp dụng
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(VoucherError))
                    {
                        <p class="text-xs text-error mt-1.5 flex items-center gap-1">
                            <span class="material-symbols-outlined text-[14px]">error</span>
                            @VoucherError
                        </p>
                    }
                    @if (!string.IsNullOrEmpty(VoucherSuccess))
                    {
                        <p class="text-xs text-tertiary mt-1.5 flex items-center gap-1 font-bold">
                            <span class="material-symbols-outlined text-[14px]">check_circle</span>
                            @VoucherSuccess
                        </p>
                    }
                </div>
            }
        </div>

        <!-- Footer Summary + Submit -->
        @if (CartItems.Any())
        {
            <div class="bg-surface border-t border-outline-variant px-4 pt-4 pb-6 shrink-0 space-y-3 shadow-lg">
                <!-- Price summary -->
                <div class="space-y-1.5">
                    <div class="flex justify-between text-sm text-on-surface-variant">
                        <span>Tạm tính (@CartItems.Sum(x => x.Quantity) món)</span>
                        <span>@CartItems.Sum(x => x.Price * x.Quantity).ToString("N0")đ</span>
                    </div>
                    @if (DiscountAmount > 0)
                    {
                        <div class="flex justify-between text-sm text-tertiary font-bold">
                            <span class="flex items-center gap-1">
                                <span class="material-symbols-outlined text-[14px]">local_offer</span>
                                Giảm giá
                            </span>
                            <span>-@DiscountAmount.ToString("N0")đ</span>
                        </div>
                    }
                    <div class="flex justify-between font-extrabold text-lg text-on-surface pt-1 border-t border-outline-variant/50">
                        <span>Tổng cộng</span>
                        <span class="text-primary">@FinalTotal.ToString("N0")đ</span>
                    </div>
                </div>

                <!-- Submit button -->
                <button class="w-full bg-primary text-on-primary py-4 rounded-2xl font-bold text-base shadow-lg flex items-center justify-center gap-2 active:scale-98 transition-transform"
                        @onclick="ProceedToSubmit">
                    <span class="material-symbols-outlined text-[22px]">send</span>
                    <span>Hoàn thành và gửi bếp</span>
                </button>
            </div>
        }
    </div>
}

<style>
    @@keyframes slideInRight {
        from { transform: translateX(100%); opacity: 0.5; }
        to   { transform: translateX(0);    opacity: 1; }
    }
</style>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public List<QrBottomDrawer.QrCartItemLocal> CartItems { get; set; } = new();
    [Parameter] public EventCallback OnProceedToCustomerInfo { get; set; }

    private string VoucherCode { get; set; } = string.Empty;
    private string VoucherError { get; set; } = string.Empty;
    private string VoucherSuccess { get; set; } = string.Empty;
    private decimal DiscountAmount { get; set; } = 0;

    // Expose applied voucher to parent
    public string AppliedVoucherCode => VoucherSuccess.Length > 0 ? VoucherCode : string.Empty;

    private decimal FinalTotal => Math.Max(0, CartItems.Sum(x => x.Price * x.Quantity) - DiscountAmount);

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private void ClearAll()
    {
        CartItems.Clear();
        VoucherCode = string.Empty;
        VoucherError = string.Empty;
        VoucherSuccess = string.Empty;
        DiscountAmount = 0;
        _ = Close();
    }

    private void IncreaseQty(int index)
    {
        if (index >= 0 && index < CartItems.Count)
            CartItems[index].Quantity++;
    }

    private void DecreaseQty(int index)
    {
        if (index < 0 || index >= CartItems.Count) return;
        if (CartItems[index].Quantity > 1)
        {
            CartItems[index].Quantity--;
        }
        else
        {
            CartItems.RemoveAt(index);
            if (!CartItems.Any())
            {
                VoucherCode = VoucherError = VoucherSuccess = string.Empty;
                DiscountAmount = 0;
                _ = Close();
            }
        }
    }

    private void ApplyVoucher()
    {
        VoucherError = string.Empty;
        VoucherSuccess = string.Empty;
        DiscountAmount = 0;

        var code = VoucherCode.Trim().ToUpperInvariant();
        if (string.IsNullOrWhiteSpace(code))
        {
            VoucherError = "Vui lòng nhập mã giảm giá.";
            return;
        }

        // Demo: hardcode a few sample codes — replace with real API call if needed
        if (code == "PIZZA10")
        {
            DiscountAmount = CartItems.Sum(x => x.Price * x.Quantity) * 0.10m;
            VoucherSuccess = $"Áp dụng thành công! Giảm 10% ({DiscountAmount:N0}đ)";
        }
        else if (code == "WELCOME50K")
        {
            DiscountAmount = 50000;
            VoucherSuccess = "Áp dụng thành công! Giảm 50,000đ";
        }
        else
        {
            VoucherError = "Mã giảm giá không hợp lệ hoặc đã hết hạn.";
        }
    }

    private async Task ProceedToSubmit()
    {
        await Close();
        await OnProceedToCustomerInfo.InvokeAsync();
    }
}

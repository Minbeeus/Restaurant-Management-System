@using Restaurant.Application.DTOs

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex flex-col justify-end">
        <!-- Backdrop -->
        <div class="absolute inset-0 bg-black/60 backdrop-blur-xs transition-opacity" @onclick="Close"></div>
        
        <!-- Drawer Content -->
        <div class="relative w-full bg-surface dark:bg-inverse-surface rounded-t-3xl shadow-2xl flex flex-col max-h-[85vh] transition-transform transform translate-y-0 overflow-hidden border-t border-outline-variant">
            
            <!-- Header -->
            <div class="flex items-center justify-between p-4 border-b border-outline-variant shrink-0 bg-surface-low dark:bg-background">
                <h3 class="font-bold text-lg text-on-surface">Tùy chỉnh món ăn</h3>
                <button @onclick="Close" class="p-2 text-on-surface-variant hover:bg-surface-high rounded-full">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <!-- Body / Options -->
            <div class="flex-1 overflow-y-auto p-4 space-y-6 custom-scrollbar">
                @if (Item != null)
                {
                    <div class="flex items-center gap-4 bg-surface-low p-3 rounded-2xl border border-outline-variant">
                        <img src="@(string.IsNullOrEmpty(Item.ImageUrl) ? "/placeholder.png" : Item.ImageUrl)" class="w-20 h-20 rounded-xl object-cover bg-surface-high shrink-0" />
                        <div>
                            <div class="font-bold text-lg text-on-surface leading-tight">@Item.Name</div>
                            <div class="text-sm text-on-surface-variant line-clamp-1 mt-0.5">@Item.Description</div>
                            <div class="text-primary font-bold text-base mt-1">@Item.Price.ToString("N0")đ</div>
                        </div>
                    </div>

                    <!-- Note input -->
                    <div>
                        <label class="block text-xs font-bold uppercase text-on-surface-variant mb-1">Ghi chú cho Bếp</label>
                        <input type="text" placeholder="Ví dụ: Ít cay, không hành..." class="w-full px-4 py-2 text-sm border border-outline-variant rounded-xl focus:outline-none focus:border-primary"
                               @bind="CustomerNote" />
                    </div>

                    <!-- Modifier Groups -->
                    @if (ModifierGroups != null && ModifierGroups.Any())
                    {
                        @foreach (var group in ModifierGroups)
                        {
                            <div class="space-y-2">
                                <div class="font-bold text-sm text-on-surface flex justify-between items-center">
                                    <span>@group.Name</span>
                                    @if (group.MinSelections > 0)
                                    {
                                        <span class="text-xs text-error font-normal bg-error-container/20 px-2 py-0.5 rounded">Bắt buộc</span>
                                    }
                                </div>
                                <div class="space-y-2">
                                    @foreach (var opt in group.ModifierOptions)
                                    {
                                        var isSelected = SelectedModifierIds.Contains(opt.Id);
                                        <div class="flex items-center justify-between p-3 border rounded-xl cursor-pointer select-none transition-colors @(isSelected ? "border-primary bg-primary/5" : "border-outline-variant hover:bg-surface-low")"
                                             @onclick="() => ToggleOption(group, opt)">
                                            <div class="flex items-center gap-3">
                                                <div class="w-5 h-5 rounded-full border-2 flex items-center justify-center @(isSelected ? "border-primary bg-primary" : "border-outline-variant")">
                                                    @if (isSelected)
                                                    {
                                                        <span class="material-symbols-outlined text-[14px] text-white">check</span>
                                                    }
                                                </div>
                                                <span class="text-sm font-medium text-on-surface">@opt.Name</span>
                                            </div>
                                            @if (opt.ExtraPrice > 0)
                                            {
                                                <span class="text-xs font-bold text-primary">+@opt.ExtraPrice.ToString("N0")đ</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                }
            </div>

            <!-- Footer / Sticky Add to Cart -->
            <div class="p-4 border-t border-outline-variant bg-surface shrink-0 pb-safe">
                <div class="flex items-center gap-4">
                    <div class="flex items-center border border-outline-variant rounded-xl bg-surface-low">
                        <button class="w-10 h-10 flex items-center justify-center text-primary hover:bg-surface-high rounded-l-xl" @onclick="DecreaseQuantity">
                            <span class="material-symbols-outlined text-[20px]">remove</span>
                        </button>
                        <span class="w-10 text-center font-bold text-sm">@Quantity</span>
                        <button class="w-10 h-10 flex items-center justify-center text-primary hover:bg-surface-high rounded-r-xl" @onclick="IncreaseQuantity">
                            <span class="material-symbols-outlined text-[20px]">add</span>
                        </button>
                    </div>
                    <button class="flex-1 bg-primary text-on-primary py-3 rounded-xl font-bold shadow-md active:scale-95 transition-transform flex items-center justify-center gap-2" @onclick="ConfirmAddToCart">
                        <span class="material-symbols-outlined text-[20px]">add_shopping_cart</span>
                        Thêm - @(TotalPrice.ToString("N0"))đ
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public PublicMenuItemDto? Item { get; set; }
    [Parameter] public List<ModifierGroupDto>? ModifierGroups { get; set; }
    [Parameter] public EventCallback<QrCartItemLocal> OnAddToCart { get; set; }

    private int Quantity { get; set; } = 1;
    private string CustomerNote { get; set; } = string.Empty;
    private HashSet<int> SelectedModifierIds { get; set; } = new();

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            Quantity = 1;
            CustomerNote = string.Empty;
            SelectedModifierIds.Clear();
            
            // Auto select single option groups if required
            if (ModifierGroups != null)
            {
                foreach (var group in ModifierGroups)
                {
                    if (group.MaxSelections == 1 && group.ModifierOptions.Any())
                    {
                        SelectedModifierIds.Add(group.ModifierOptions.First().Id);
                    }
                }
            }
        }
    }

    private decimal ModifiersExtraPrice
    {
        get
        {
            if (ModifierGroups == null) return 0;
            decimal total = 0;
            foreach (var group in ModifierGroups)
            {
                foreach (var opt in group.ModifierOptions)
                {
                    if (SelectedModifierIds.Contains(opt.Id))
                    {
                        total += opt.ExtraPrice;
                    }
                }
            }
            return total;
        }
    }

    private decimal TotalPrice => ((Item?.Price ?? 0) + ModifiersExtraPrice) * Quantity;

    private void ToggleOption(ModifierGroupDto group, ModifierOptionDto opt)
    {
        if (group.MaxSelections == 1)
        {
            // Radio style: remove all options of this group, add selected
            foreach (var o in group.ModifierOptions)
            {
                SelectedModifierIds.Remove(o.Id);
            }
            SelectedModifierIds.Add(opt.Id);
        }
        else
        {
            // Checkbox style
            if (SelectedModifierIds.Contains(opt.Id))
            {
                SelectedModifierIds.Remove(opt.Id);
            }
            else
            {
                SelectedModifierIds.Add(opt.Id);
            }
        }
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }

    private void IncreaseQuantity() => Quantity++;
    private void DecreaseQuantity()
    {
        if (Quantity > 1) Quantity--;
    }

    private async Task ConfirmAddToCart()
    {
        if (Item != null)
        {
            var cartItem = new QrCartItemLocal
            {
                MenuItemId = Item.Id,
                Name = Item.Name,
                Quantity = Quantity,
                Price = Item.Price + ModifiersExtraPrice,
                Note = CustomerNote,
                SelectedModifiers = SelectedModifierIds.ToList()
            };
            await OnAddToCart.InvokeAsync(cartItem);
            await Close();
        }
    }

    public class QrCartItemLocal
    {
        public int MenuItemId { get; set; }
        public string Name { get; set; } = string.Empty;
        public int Quantity { get; set; }
        public decimal Price { get; set; }
        public string? Note { get; set; }
        public List<int> SelectedModifiers { get; set; } = new();
    }
}

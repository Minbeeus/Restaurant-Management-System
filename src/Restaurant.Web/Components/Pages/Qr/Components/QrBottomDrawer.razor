<div class="@(IsOpen ? "fixed inset-0 z-50 flex flex-col justify-end" : "hidden")">
    <!-- Backdrop -->
    <div class="absolute inset-0 bg-black/50 transition-opacity" @onclick="Close"></div>
    
    <!-- Drawer Content -->
    <div class="relative w-full bg-surface dark:bg-background rounded-t-2xl shadow-xl flex flex-col max-h-[85vh] transition-transform transform @(IsOpen ? "translate-y-0" : "translate-y-full")">
        
        <!-- Header -->
        <div class="flex items-center justify-between p-4 border-b border-outline-variant shrink-0">
            <h3 class="font-bold text-lg text-on-surface">Tùy chỉnh món</h3>
            <button @onclick="Close" class="p-2 text-on-surface-variant hover:bg-surface-low rounded-full">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <!-- Body / Options -->
        <div class="flex-1 overflow-y-auto p-4 custom-scrollbar">
            @if (Item != null)
            {
                <div class="flex items-center gap-4 mb-6">
                    <img src="@(Item.ImageUrl ?? "/placeholder.png")" class="w-16 h-16 rounded-lg object-cover bg-surface-low" />
                    <div>
                        <div class="font-bold text-lg">@Item.Name</div>
                        <div class="text-primary font-bold">@Item.Price.ToString("N0")đ</div>
                    </div>
                </div>

                <!-- Modifiers mock -->
                <div class="mb-6">
                    <div class="font-bold mb-2 flex justify-between">
                        <span>Chọn Size</span>
                        <span class="text-error text-sm font-normal">Bắt buộc</span>
                    </div>
                    <div class="flex flex-col gap-2">
                        <label class="flex items-center justify-between p-3 border border-outline-variant rounded-lg bg-surface-low/50">
                            <div class="flex items-center gap-3">
                                <input type="radio" name="size" class="w-5 h-5 text-primary" checked />
                                <span>Size M</span>
                            </div>
                            <span class="text-sm font-bold text-on-surface-variant">+0đ</span>
                        </label>
                        <label class="flex items-center justify-between p-3 border border-outline-variant rounded-lg hover:bg-surface-low/50">
                            <div class="flex items-center gap-3">
                                <input type="radio" name="size" class="w-5 h-5 text-primary" />
                                <span>Size L</span>
                            </div>
                            <span class="text-sm font-bold text-on-surface-variant">+30,000đ</span>
                        </label>
                    </div>
                </div>
            }
        </div>

        <!-- Footer / Sticky Add to Cart -->
        <div class="p-4 border-t border-outline-variant bg-surface shrink-0 pb-safe">
            <div class="flex items-center gap-4">
                <div class="flex items-center border border-outline-variant rounded-lg bg-surface-low">
                    <button class="w-10 h-10 flex items-center justify-center text-primary" @onclick="DecreaseQuantity">
                        <span class="material-symbols-outlined text-[20px]">remove</span>
                    </button>
                    <span class="w-10 text-center font-bold">@Quantity</span>
                    <button class="w-10 h-10 flex items-center justify-center text-primary" @onclick="IncreaseQuantity">
                        <span class="material-symbols-outlined text-[20px]">add</span>
                    </button>
                </div>
                <button class="flex-1 bg-primary text-white py-3 rounded-lg font-bold shadow-md active:scale-95 transition-transform" @onclick="ConfirmAddToCart">
                    Thêm - @(TotalPrice.ToString("N0"))đ
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public MenuItem Item { get; set; }
    [Parameter] public EventCallback<CartItem> OnAddToCart { get; set; }

    private int Quantity { get; set; } = 1;

    private decimal TotalPrice => (Item?.Price ?? 0) * Quantity; // Mock logic

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }

    private void IncreaseQuantity() => Quantity++;
    private void DecreaseQuantity()
    {
        if (Quantity > 1) Quantity--;
    }

    private async Task ConfirmAddToCart()
    {
        if (Item != null)
        {
            var cartItem = new CartItem
            {
                MenuItemId = Item.Id,
                Name = Item.Name,
                Quantity = Quantity,
                Price = Item.Price // Mock
            };
            await OnAddToCart.InvokeAsync(cartItem);
            await Close();
        }
    }

    public class MenuItem
    {
        public Guid Id { get; set; }
        public string Name { get; set; }
        public decimal Price { get; set; }
        public string ImageUrl { get; set; }
        public string Description { get; set; }
    }

    public class CartItem
    {
        public Guid MenuItemId { get; set; }
        public string Name { get; set; }
        public int Quantity { get; set; }
        public decimal Price { get; set; }
    }
}

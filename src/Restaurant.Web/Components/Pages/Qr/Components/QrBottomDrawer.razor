@using Restaurant.Application.DTOs

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex flex-col justify-end">
        <!-- Backdrop -->
        <div class="absolute inset-0 bg-black/60 backdrop-blur-sm transition-opacity" @onclick="Close"></div>

        <!-- Drawer Content -->
        <div class="relative w-full bg-surface rounded-t-3xl shadow-2xl flex flex-col max-h-[88vh] overflow-hidden border-t border-outline-variant"
             style="animation: slideUp 0.25s cubic-bezier(0.34,1.3,0.64,1);">

            <!-- Handle bar -->
            <div class="flex justify-center pt-3 pb-1 shrink-0">
                <div class="w-10 h-1 bg-outline-variant rounded-full"></div>
            </div>

            <!-- Header -->
            <div class="flex items-center justify-between px-5 pb-3 pt-1 shrink-0">
                <div>
                    <h3 class="font-bold text-lg text-on-surface">@(Item?.DisplayName ?? "Chi tiết món")</h3>
                    <p class="text-primary font-bold text-sm mt-0.5">@((((Item?.Price ?? 0) + ModifiersExtraPrice)).ToString("N0"))đ / phần</p>
                </div>
                <button @onclick="Close" class="w-9 h-9 flex items-center justify-center text-on-surface-variant hover:bg-surface-low rounded-full">
                    <span class="material-symbols-outlined text-[22px]">close</span>
                </button>
            </div>

            <!-- Body / Modifiers -->
            <div class="flex-1 overflow-y-auto px-5 space-y-5 custom-scrollbar">
                @if (Item != null)
                {
                    <!-- Item preview -->
                    @if (!string.IsNullOrEmpty(Item.DisplayDescription))
                    {
                        <div class="bg-surface-low p-3.5 rounded-2xl border border-outline-variant">
                            <div class="text-sm text-on-surface-variant line-clamp-3 font-medium">@Item.DisplayDescription</div>
                        </div>
                    }

                    <!-- Modifier Groups -->
                    @if (ModifierGroups != null && ModifierGroups.Any())
                    {
                        @foreach (var group in ModifierGroups)
                        {
                            <div class="space-y-2 pb-1">
                                <div class="font-bold text-sm text-on-surface flex justify-between items-center">
                                    <span>@group.DisplayName</span>
                                    @if (group.MinSelections > 0)
                                    {
                                        <span class="text-xs text-error font-normal bg-error/10 px-2 py-0.5 rounded-full">Bắt buộc</span>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-on-surface-variant font-normal">Tùy chọn</span>
                                    }
                                </div>
                                <div class="space-y-2">
                                    @foreach (var opt in group.ModifierOptions)
                                    {
                                        var isSelected = SelectedModifierIds.Contains(opt.Id);
                                        <div class="flex items-center justify-between p-3 border rounded-2xl cursor-pointer select-none transition-all @(isSelected ? "border-primary bg-primary/8 shadow-sm" : "border-outline-variant hover:bg-surface-low")"
                                             @onclick="() => ToggleOption(group, opt)">
                                            <div class="flex items-center gap-3">
                                                <div class="w-5 h-5 rounded-full border-2 flex items-center justify-center shrink-0 transition-colors @(isSelected ? "border-primary bg-primary" : "border-outline-variant")">
                                                    @if (isSelected)
                                                    {
                                                        <span class="material-symbols-outlined text-[13px] text-white">check</span>
                                                    }
                                                </div>
                                                <span class="text-sm font-medium text-on-surface">@opt.DisplayName</span>
                                            </div>
                                            @if (opt.ExtraPrice > 0)
                                            {
                                                <span class="text-xs font-bold text-primary">+@opt.ExtraPrice.ToString("N0")đ</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-xs text-on-surface-variant text-center py-2">Không có tuỳ chọn thêm.</div>
                    }

                    <div class="h-2"></div>
                }
            </div>

            <!-- Footer / Add to Cart -->
            <div class="px-5 pt-3 pb-6 border-t border-outline-variant bg-surface-low shrink-0">
                <div class="flex items-center gap-3">
                    <!-- Quantity -->
                    <div class="flex items-center border border-outline-variant rounded-2xl bg-surface overflow-hidden">
                        <button class="w-10 h-10 flex items-center justify-center text-primary" @onclick="DecreaseQuantity">
                            <span class="material-symbols-outlined text-[20px]">remove</span>
                        </button>
                        <span class="w-9 text-center font-bold text-sm select-none">@Quantity</span>
                        <button class="w-10 h-10 flex items-center justify-center text-primary" @onclick="IncreaseQuantity">
                            <span class="material-symbols-outlined text-[20px]">add</span>
                        </button>
                    </div>
                    <!-- Add button -->
                    <button class="flex-1 bg-primary text-on-primary py-3 rounded-2xl font-bold shadow-md active:scale-95 transition-transform flex items-center justify-center gap-2"
                            @onclick="ConfirmAddToCart">
                        <span class="material-symbols-outlined text-[20px]">add_shopping_cart</span>
                        <span>Thêm vào giỏ — @TotalPrice.ToString("N0")đ</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    @@keyframes slideUp {
        from { transform: translateY(100%); }
        to   { transform: translateY(0); }
    }
</style>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public PublicMenuItemDto? Item { get; set; }
    [Parameter] public List<ModifierGroupDto>? ModifierGroups { get; set; }
    [Parameter] public EventCallback<QrCartItemLocal> OnAddToCart { get; set; }

    private int Quantity { get; set; } = 1;
    private HashSet<int> SelectedModifierIds { get; set; } = new();

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            Quantity = 1;
            SelectedModifierIds.Clear();

            // Auto-select single-option required groups
            if (ModifierGroups != null)
            {
                foreach (var group in ModifierGroups)
                {
                    if (group.MaxSelections == 1 && group.ModifierOptions.Any())
                    {
                        SelectedModifierIds.Add(group.ModifierOptions.First().Id);
                    }
                }
            }
        }
    }

    private decimal ModifiersExtraPrice
    {
        get
        {
            if (ModifierGroups == null) return 0;
            decimal total = 0;
            foreach (var group in ModifierGroups)
                foreach (var opt in group.ModifierOptions)
                    if (SelectedModifierIds.Contains(opt.Id))
                        total += opt.ExtraPrice;
            return total;
        }
    }

    private decimal TotalPrice => ((Item?.Price ?? 0) + ModifiersExtraPrice) * Quantity;

    private void ToggleOption(ModifierGroupDto group, ModifierOptionDto opt)
    {
        if (group.MaxSelections == 1)
        {
            foreach (var o in group.ModifierOptions)
                SelectedModifierIds.Remove(o.Id);
            SelectedModifierIds.Add(opt.Id);
        }
        else
        {
            if (!SelectedModifierIds.Add(opt.Id))
                SelectedModifierIds.Remove(opt.Id);
        }
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private void IncreaseQuantity() => Quantity++;
    private void DecreaseQuantity() { if (Quantity > 1) Quantity--; }

    private async Task ConfirmAddToCart()
    {
        if (Item == null) return;
        var cartItem = new QrCartItemLocal
        {
            MenuItemId = Item.Id,
            Name = Item.DisplayName,
            Quantity = Quantity,
            Price = Item.Price + ModifiersExtraPrice,
            SelectedModifiers = SelectedModifierIds.ToList()
        };
        await OnAddToCart.InvokeAsync(cartItem);
        await Close();
    }

    public class QrCartItemLocal
    {
        public int MenuItemId { get; set; }
        public string Name { get; set; } = string.Empty;
        public int Quantity { get; set; }
        public decimal Price { get; set; }
        public string? Note { get; set; }
        public List<int> SelectedModifiers { get; set; } = new();
    }
}

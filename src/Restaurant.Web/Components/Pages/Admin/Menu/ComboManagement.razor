@page "/admin/menu/combos"
@layout Restaurant.Web.Components.Layout.AdminLayout
@using Microsoft.AspNetCore.Authorization
@using Restaurant.Application.DTOs
@using Restaurant.Web.Services
@inject MenuApiClient ApiClient
@inject IJSRuntime JSRuntime
@attribute [Authorize(Roles = "Admin,Manager")]
@rendermode InteractiveServer

<!-- Page Header -->
<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
    <div class="flex items-center gap-3">
        <a href="/admin/menu-items" class="text-on-surface-variant hover:text-primary transition-colors flex items-center p-1.5 rounded-lg hover:bg-surface-container" title="Quay lại Danh sách món ăn">
            <span class="material-symbols-outlined text-2xl" data-icon="arrow_back">arrow_back</span>
        </a>
        <div>
            <div class="flex items-center gap-2">
                <h2 class="text-2xl font-headline-sm text-primary m-0 font-bold">Quản lý Combo</h2>
                <span class="px-2.5 py-0.5 text-xs font-bold rounded-full bg-primary/10 text-primary border border-primary/20">BOH Menu</span>
            </div>
            <p class="text-xs text-on-surface-variant m-0 mt-0.5">Thiết lập các gói Combo thực đơn, món cố định và nhóm lựa chọn thay thế</p>
        </div>
    </div>
    <div class="flex items-center gap-2">
        <a href="/admin/menu-items" class="px-3.5 py-2 rounded-lg font-label-bold text-sm text-on-surface-variant hover:bg-surface-container transition-colors border border-outline-variant/50 flex items-center gap-1.5 shadow-xs">
            <span class="material-symbols-outlined text-sm" data-icon="restaurant_menu">restaurant_menu</span>
            Danh sách Món ăn
        </a>
        <button class="bg-primary text-on-primary px-4 py-2 rounded-lg font-label-bold text-sm shadow-sm hover:bg-primary/90 transition-colors whitespace-nowrap flex items-center gap-1.5 cursor-pointer" @onclick="OpenAddModal">
            <span class="material-symbols-outlined align-middle text-sm" data-icon="add">add</span> Thêm Combo
        </button>
    </div>
</div>

<!-- Success Banner Notification -->
@if (!string.IsNullOrEmpty(_successMessage))
{
    <div class="mb-4 p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-800 dark:text-emerald-300 flex items-center justify-between text-sm animate-in fade-in slide-in-from-top-2 duration-200">
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-emerald-600 dark:text-emerald-400 text-lg" data-icon="check_circle">check_circle</span>
            <span class="font-medium">@_successMessage</span>
        </div>
        <button type="button" class="text-emerald-700 dark:text-emerald-400 hover:text-emerald-950 p-1 rounded-full cursor-pointer" @onclick="() => _successMessage = null">
            <span class="material-symbols-outlined text-sm" data-icon="close">close</span>
        </button>
    </div>
}

<!-- Toolbar Lọc & Tìm Kiếm -->
<div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-4 mb-6 flex flex-col md:flex-row gap-4 items-stretch md:items-center">
    <div class="flex-1 relative">
        <span class="material-symbols-outlined absolute left-3 top-2.5 text-on-surface-variant text-[20px]" data-icon="search">search</span>
        <InputText @bind-Value="_searchKeyword" @bind-Value:event="oninput" class="w-full pl-10 pr-4 py-2 text-sm border border-outline rounded-lg bg-surface focus:outline-none focus:border-primary transition-colors" placeholder="Tìm kiếm theo tên Combo hoặc tên tiếng Anh..." />
    </div>
    <div class="w-full md:w-64 shrink-0">
        <select @bind="_filterCategoryId" class="w-full px-3 py-2 text-sm border border-outline rounded-lg bg-surface focus:outline-none focus:border-primary transition-colors cursor-pointer">
            <option value="0">Tất cả danh mục</option>
            @foreach (var cat in _categories)
            {
                <option value="@cat.Id">@cat.DisplayName</option>
            }
        </select>
    </div>
    <div class="w-full md:w-48 shrink-0">
        <select @bind="_filterStatus" class="w-full px-3 py-2 text-sm border border-outline rounded-lg bg-surface focus:outline-none focus:border-primary transition-colors cursor-pointer">
            <option value="">Tất cả trạng thái</option>
            <option value="true">Đang bán</option>
            <option value="false">Ngừng bán / Hết hàng</option>
        </select>
    </div>
    @if (IsAnyFilterActive)
    {
        <button type="button" class="px-3 py-2 text-xs font-bold text-on-surface-variant hover:text-error hover:bg-error-container/20 border border-outline-variant/40 rounded-lg transition-colors flex items-center gap-1 shrink-0 justify-center cursor-pointer" @onclick="ResetFilters" title="Xóa toàn bộ bộ lọc">
            <span class="material-symbols-outlined text-sm" data-icon="filter_alt_off">filter_alt_off</span>
            Xóa lọc
        </button>
    }
</div>

<!-- Main Content Area -->
@if (_isLoading)
{
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-12 flex flex-col items-center justify-center">
        <span class="material-symbols-outlined animate-spin text-4xl text-primary mb-3" data-icon="progress_activity">progress_activity</span>
        <p class="text-sm font-medium text-on-surface-variant">Đang nạp danh sách Combo thực đơn...</p>
    </div>
}
else if (_hasLoadError)
{
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-error/30 p-12 text-center">
        <div class="w-16 h-16 rounded-full bg-error-container text-error mx-auto flex items-center justify-center mb-4">
            <span class="material-symbols-outlined text-3xl" data-icon="error">error</span>
        </div>
        <h3 class="text-lg font-bold text-on-background mb-1">Không thể tải danh sách Combo</h3>
        <p class="text-on-surface-variant text-sm mb-6 max-w-md mx-auto">Đã xảy ra sự cố khi kết nối tới hệ thống máy chủ. Vui lòng thử lại sau.</p>
        <button class="px-5 py-2.5 bg-primary text-on-primary rounded-lg font-label-bold shadow-sm hover:bg-primary/90 transition-colors inline-flex items-center gap-2 cursor-pointer text-sm" @onclick="LoadData">
            <span class="material-symbols-outlined text-base" data-icon="refresh">refresh</span> Thử lại
        </button>
    </div>
}
else
{
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[850px]">
            <thead class="bg-surface-container-low border-b border-outline-variant/30 text-on-surface-variant font-label-bold text-xs uppercase tracking-wider">
                <tr>
                    <th class="p-4 font-semibold text-center w-16">Hình ảnh</th>
                    <th class="p-4 font-semibold">Tên Combo</th>
                    <th class="p-4 font-semibold w-40">Danh mục</th>
                    <th class="p-4 font-semibold text-right w-36">Giá bán</th>
                    <th class="p-4 font-semibold text-center w-48">Cấu trúc</th>
                    <th class="p-4 font-semibold text-center w-36">Trạng thái</th>
                    <th class="p-4 font-semibold text-center w-28">Thao tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant/20 text-sm">
                @if (!_combos.Any())
                {
                    <!-- Empty State: No combos created yet -->
                    <tr>
                        <td colspan="7" class="p-12 text-center">
                            <div class="w-16 h-16 rounded-full bg-surface-container text-on-surface-variant mx-auto flex items-center justify-center mb-3">
                                <span class="material-symbols-outlined text-3xl opacity-60" data-icon="lunch_dining">lunch_dining</span>
                            </div>
                            <h4 class="font-bold text-base text-on-background mb-1">Chưa có Combo nào</h4>
                            <p class="text-xs text-on-surface-variant mb-4 max-w-sm mx-auto">Tạo Combo đầu tiên để bắt đầu bán các gói sản phẩm kết hợp nhiều món ăn và thức uống.</p>
                            <button class="bg-primary text-on-primary px-4 py-2 rounded-lg font-label-bold text-sm shadow-sm hover:bg-primary/90 transition-colors inline-flex items-center gap-1.5 cursor-pointer" @onclick="OpenAddModal">
                                <span class="material-symbols-outlined text-sm" data-icon="add">add</span> + Thêm Combo
                            </button>
                        </td>
                    </tr>
                }
                else if (!FilteredCombos.Any())
                {
                    <!-- Empty State: Filters returned 0 items -->
                    <tr>
                        <td colspan="7" class="p-12 text-center">
                            <div class="w-14 h-14 rounded-full bg-surface-container text-on-surface-variant mx-auto flex items-center justify-center mb-3">
                                <span class="material-symbols-outlined text-2xl opacity-60" data-icon="search_off">search_off</span>
                            </div>
                            <h4 class="font-bold text-base text-on-background mb-1">Không tìm thấy Combo phù hợp</h4>
                            <p class="text-xs text-on-surface-variant mb-4">Thử thay đổi từ khóa tìm kiếm hoặc bỏ bớt các bộ lọc đang chọn.</p>
                            <button class="px-4 py-1.5 border border-outline text-on-surface rounded-lg font-label-bold text-xs hover:bg-surface-low transition-colors cursor-pointer inline-flex items-center gap-1" @onclick="ResetFilters">
                                <span class="material-symbols-outlined text-sm" data-icon="filter_alt_off">filter_alt_off</span> Xóa bộ lọc
                            </button>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in FilteredCombos)
                    {
                        <tr class="hover:bg-surface-low/50 transition-colors">
                            <td class="p-4 text-center">
                                <div class="w-12 h-12 bg-surface-low rounded-lg flex items-center justify-center text-on-surface-variant overflow-hidden mx-auto border border-outline-variant/30 shadow-2xs">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" class="w-full h-full object-cover" onerror="this.style.display='none'" alt="@item.Name" />
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined text-xl opacity-50" data-icon="lunch_dining">lunch_dining</span>
                                    }
                                </div>
                            </td>
                            <td class="p-4">
                                <div class="font-bold text-on-background text-base">@item.DisplayName</div>
                                @if (!string.IsNullOrEmpty(item.NameEn) && !item.NameEn.Equals(item.Name, StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="text-xs text-on-surface-variant/70 italic mt-0.5">EN: @item.NameEn</div>
                                }
                                @if (!string.IsNullOrEmpty(item.DisplayDescription))
                                {
                                    <div class="text-xs text-on-surface-variant line-clamp-1 mt-0.5" title="@item.DisplayDescription">@item.DisplayDescription</div>
                                }
                            </td>
                            <td class="p-4 text-on-surface-variant">
                                <span class="px-2.5 py-1 bg-surface-container rounded-md text-xs font-semibold border border-outline-variant/30 inline-block">
                                    @(_categories.FirstOrDefault(c => c.Id == item.CategoryId)?.DisplayName ?? item.CategoryName)
                                </span>
                            </td>
                            <td class="p-4 text-right font-bold text-primary text-base">
                                @item.Price.ToString("N0") đ
                            </td>
                            <td class="p-4 text-center text-on-surface-variant text-xs">
                                <div class="inline-flex flex-col gap-1 items-center">
                                    @if (item.FixedAndAddOnItems.Any())
                                    {
                                        <span class="px-2 py-0.5 rounded bg-primary/10 text-primary font-bold border border-primary/20">
                                            @item.FixedAndAddOnItems.Count món cố định
                                        </span>
                                    }
                                    @if (item.Groups.Any())
                                    {
                                        <span class="px-2 py-0.5 rounded bg-secondary-container/40 text-secondary font-bold border border-secondary/20">
                                            @item.Groups.Count nhóm (@item.Groups.Sum(g => g.Items.Count) lựa chọn)
                                        </span>
                                    }
                                    @if (!item.FixedAndAddOnItems.Any() && !item.Groups.Any())
                                    {
                                        <span class="text-xs text-error font-bold">Chưa cấu hình món</span>
                                    }
                                </div>
                            </td>
                            <td class="p-4 text-center">
                                @if (!item.IsActive)
                                {
                                    <div class="px-2.5 py-1 bg-on-surface-variant/10 text-on-surface-variant rounded-full text-xs font-bold border border-on-surface-variant/20 inline-block">
                                        Đã ẩn
                                    </div>
                                }
                                else
                                {
                                    <button type="button" class="relative inline-flex items-center justify-center px-3 py-1 rounded-full text-xs font-bold transition-all cursor-pointer disabled:opacity-50 @(item.IsSoldOut ? "bg-surface-variant/50 text-on-surface-variant border border-outline-variant/50 hover:bg-surface-variant" : "bg-primary text-on-primary shadow-2xs hover:bg-primary/90")"
                                            disabled="@_togglingItemIds.Contains(item.Id)"
                                            @onclick="() => ToggleQuickSoldOut(item)"
                                            title="Bấm để chuyển đổi trạng thái phục vụ">
                                        @if (_togglingItemIds.Contains(item.Id))
                                        {
                                            <span class="material-symbols-outlined animate-spin text-xs mr-1" data-icon="progress_activity">progress_activity</span>
                                            <span>Đang xử lý...</span>
                                        }
                                        else
                                        {
                                            <span class="material-symbols-outlined text-xs mr-1" data-icon="@(item.IsSoldOut ? "block" : "check_circle")">@(item.IsSoldOut ? "block" : "check_circle")</span>
                                            <span>@(item.IsSoldOut ? "Hết hàng" : "Đang bán")</span>
                                        }
                                    </button>
                                }
                            </td>
                            <td class="p-4 text-center">
                                <div class="flex items-center justify-center gap-1">
                                    <button type="button" class="text-primary hover:bg-primary-container p-2 rounded-full transition-colors cursor-pointer" title="Chỉnh sửa Combo" @onclick="() => OpenEditModal(item.Id)">
                                        <span class="material-symbols-outlined text-base" data-icon="edit">edit</span>
                                    </button>
                                    <button type="button" class="text-error hover:bg-error-container p-2 rounded-full transition-colors cursor-pointer" title="Xóa Combo" @onclick="() => ConfirmDelete(item)">
                                        <span class="material-symbols-outlined text-base" data-icon="delete">delete</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

<!-- Modal Add / Edit Combo -->
@if (_showModal)
{
    <div class="fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-3 sm:p-4 md:p-6 backdrop-blur-sm animate-in fade-in duration-150">
        <div class="bg-surface-container-lowest rounded-2xl shadow-2xl w-full max-w-5xl max-h-[92vh] flex flex-col overflow-hidden border border-outline-variant/30">
            <!-- Modal Header -->
            <div class="px-6 py-4 border-b border-outline-variant/30 flex justify-between items-center bg-surface-container-low shrink-0">
                <div class="flex items-center gap-2.5">
                    <span class="material-symbols-outlined text-primary text-2xl" data-icon="lunch_dining">lunch_dining</span>
                    <div>
                        <h3 class="font-headline-sm text-base sm:text-lg font-bold text-on-background m-0">
                            @(_isEditing ? $"Cập nhật Combo: {_model.Name}" : "Thêm Combo Mới")
                        </h3>
                        <p class="text-[11px] text-on-surface-variant m-0">Cấu hình danh mục, định giá bán, món cố định và các nhóm tùy chọn</p>
                    </div>
                </div>
                <button type="button" class="text-on-surface-variant hover:text-error transition-colors p-1 rounded-full cursor-pointer" @onclick="CloseModal">
                    <span class="material-symbols-outlined text-xl" data-icon="close">close</span>
                </button>
            </div>
            
            <!-- Modal Body (Two-column layout) -->
            <div class="flex-1 overflow-hidden flex flex-col md:flex-row divide-y md:divide-y-0 md:divide-x divide-outline-variant/30">
                <!-- Cột Trái: Thông Tin Cơ Bản -->
                <div class="w-full md:w-5/12 lg:w-4/12 p-5 sm:p-6 overflow-y-auto bg-surface-container-low/20 custom-scrollbar space-y-4">
                    <div class="flex items-center justify-between border-b border-outline-variant/30 pb-2 mb-3">
                        <h4 class="font-bold text-sm text-primary flex items-center gap-1.5 m-0">
                            <span class="material-symbols-outlined text-lg" data-icon="info">info</span> Thông Tin Cơ Bản
                        </h4>
                        <span class="text-[11px] text-on-surface-variant italic">* Bắt buộc</span>
                    </div>

                    <!-- Tên Combo (Tiếng Việt) -->
                    <div>
                        <label class="block text-xs font-label-bold text-on-surface mb-1">Tên Combo <span class="text-error">*</span></label>
                        <InputText @bind-Value="_model.Name" class="w-full px-3 py-2 text-sm border border-outline rounded-lg bg-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-shadow" placeholder="Vd: Combo Gà Rán Gia Đình" />
                    </div>

                    <!-- Tên tiếng Anh -->
                    <div>
                        <label class="block text-xs font-label-bold text-on-surface mb-1">Tên tiếng Anh (EN)</label>
                        <InputText @bind-Value="_model.NameEn" class="w-full px-3 py-2 text-sm border border-outline rounded-lg bg-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-shadow" placeholder="Vd: Family Chicken Combo" />
                    </div>

                    <!-- Danh mục hiển thị -->
                    <div>
                        <label class="block text-xs font-label-bold text-on-surface mb-1">Danh mục hiển thị <span class="text-error">*</span></label>
                        <select @bind="_model.CategoryId" class="w-full px-3 py-2 text-sm border border-outline rounded-lg bg-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-shadow cursor-pointer">
                            <option value="0">-- Chọn danh mục --</option>
                            @foreach (var cat in _categories)
                            {
                                <option value="@cat.Id">@cat.DisplayName</option>
                            }
                        </select>
                    </div>

                    <!-- Giá bán & So sánh giá -->
                    <div>
                        <label class="block text-xs font-label-bold text-on-surface mb-1">Giá bán Combo <span class="text-error">*</span></label>
                        <div class="relative">
                            <InputNumber @bind-Value="_model.Price" class="w-full pl-3 pr-8 py-2 text-base font-bold border border-outline rounded-lg bg-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-shadow text-primary" placeholder="0" />
                            <span class="absolute right-3 top-2.5 text-xs text-on-surface-variant font-bold">đ</span>
                        </div>
                        @if (EstimatedOriginalPrice > 0)
                        {
                            <div class="mt-2 text-xs p-2.5 bg-surface-container rounded-lg border border-outline-variant/30 space-y-1">
                                <div class="flex justify-between text-on-surface-variant">
                                    <span>Tổng giá bán lẻ ước tính:</span>
                                    <span class="font-bold line-through">@EstimatedOriginalPrice.ToString("N0")đ</span>
                                </div>
                                @if (_model.Price > 0 && EstimatedOriginalPrice > _model.Price)
                                {
                                    var savedAmount = EstimatedOriginalPrice - _model.Price;
                                    var savedPercent = Math.Round((savedAmount / EstimatedOriginalPrice) * 100);
                                    <div class="flex justify-between text-primary font-bold">
                                        <span>Tiết kiệm cho khách:</span>
                                        <span>@savedAmount.ToString("N0")đ (@savedPercent%)</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Mô tả -->
                    <div>
                        <label class="block text-xs font-label-bold text-on-surface mb-1">Mô tả món ăn</label>
                        <InputTextArea @bind-Value="_model.Description" class="w-full px-3 py-2 text-xs border border-outline rounded-lg bg-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-shadow resize-none" rows="2" placeholder="Gồm 2 gà giòn, 1 khoai tây chiên, 2 nước ngọt..." />
                    </div>

                    <!-- Hình ảnh đại diện -->
                    <div>
                        <label class="block text-xs font-label-bold text-on-surface mb-1">Hình ảnh đại diện (URL)</label>
                        <InputText @bind-Value="_model.ImageUrl" class="w-full px-3 py-2 text-xs border border-outline rounded-lg bg-surface focus:outline-none focus:border-primary transition-shadow" placeholder="https://..." />
                        @if (!string.IsNullOrEmpty(_model.ImageUrl))
                        {
                            <div class="mt-2 text-center h-24 bg-surface-container rounded-lg border border-outline-variant/30 p-1 overflow-hidden flex items-center justify-center">
                                <img src="@_model.ImageUrl" class="h-full object-contain mx-auto" onerror="this.style.display='none'" alt="Preview" />
                            </div>
                        }
                    </div>

                    <!-- Trạng thái bán -->
                    <div class="bg-surface-container p-3.5 rounded-xl border border-outline-variant/30 space-y-2 mt-4">
                        <label class="block text-xs font-label-bold text-on-surface mb-1">Trạng thái kinh doanh</label>
                        <div class="flex flex-col gap-2">
                            <label class="flex items-center cursor-pointer">
                                <InputCheckbox @bind-Value="_model.IsActive" class="w-4 h-4 text-primary bg-surface border-outline rounded cursor-pointer" />
                                <span class="ml-2 text-xs font-medium text-on-surface">Hiển thị trong Thực đơn & POS</span>
                            </label>
                            @if (_isEditing)
                            {
                                <label class="flex items-center cursor-pointer">
                                    <InputCheckbox @bind-Value="_model.IsSoldOut" class="w-4 h-4 text-error bg-surface border-outline rounded cursor-pointer" />
                                    <span class="ml-2 text-xs font-bold text-error">Báo hết hàng (Tạm ngưng phục vụ)</span>
                                </label>
                            }
                        </div>
                    </div>
                </div>

                <!-- Cột Phải: Cấu Trúc Combo (Fixed Items & Groups) -->
                <div class="w-full md:w-7/12 lg:w-8/12 p-5 sm:p-6 overflow-y-auto space-y-6 custom-scrollbar">
                    <!-- SECTION 1: Fixed Items -->
                    <div class="bg-surface-container-lowest border border-outline-variant/50 rounded-xl shadow-xs p-4">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3 pb-2 border-b border-outline-variant/30">
                            <div>
                                <h4 class="font-bold text-sm text-primary flex items-center gap-1.5 m-0">
                                    <span class="material-symbols-outlined text-base" data-icon="lock">lock</span> 1. Món Cố Định (Fixed Items)
                                </h4>
                                <p class="text-xs text-on-surface-variant m-0 mt-0.5">Các món luôn có sẵn trong Combo khi khách đặt</p>
                            </div>
                            <button type="button" class="bg-primary/10 text-primary hover:bg-primary hover:text-on-primary px-3 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1 shrink-0 cursor-pointer shadow-2xs" @onclick="() => OpenItemSearchModal(-1)">
                                <span class="material-symbols-outlined text-sm" data-icon="add_circle">add_circle</span> Thêm món cố định
                            </button>
                        </div>

                        @if (!_model.FixedItems.Any())
                        {
                            <div class="text-center py-6 border border-dashed border-outline-variant/60 rounded-xl text-on-surface-variant text-xs bg-surface-container-low/20">
                                <span class="material-symbols-outlined text-2xl opacity-40 mb-1" data-icon="fastfood">fastfood</span>
                                <p class="m-0 font-medium">Chưa có món cố định nào.</p>
                                <p class="text-[11px] text-on-surface-variant/70 m-0 mt-0.5">Bấm "Thêm món cố định" nếu Combo có món mặc định đi kèm (Vd: 1 Pizza Hải Sản lớn).</p>
                            </div>
                        }
                        else
                        {
                            <div class="space-y-2">
                                @for (int fIdx = 0; fIdx < _model.FixedItems.Count; fIdx++)
                                {
                                    var fItem = _model.FixedItems[fIdx];
                                    var capturedFIdx = fIdx;
                                    var originalItem = _allMenuItems.FirstOrDefault(m => m.Id == fItem.MenuItemId);
                                    <div class="flex items-center justify-between p-2.5 bg-surface-container-low rounded-lg border border-outline-variant/30 text-sm hover:border-outline-variant/60 transition-colors">
                                        <div class="flex items-center gap-2.5 flex-1 min-w-0">
                                            <span class="material-symbols-outlined text-primary text-base" data-icon="check_circle">check_circle</span>
                                            <div class="truncate">
                                                <span class="font-bold text-on-surface text-sm">@fItem.MenuItemName</span>
                                                @if (originalItem != null)
                                                {
                                                    <span class="text-xs text-on-surface-variant ml-1.5">(Giá lẻ: @originalItem.Price.ToString("N0")đ)</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="flex items-center gap-3 shrink-0">
                                            <!-- Quantity Stepper -->
                                            <div class="flex items-center gap-1">
                                                <label class="text-xs text-on-surface-variant">SL:</label>
                                                <div class="flex items-center border border-outline rounded bg-surface overflow-hidden">
                                                    <button type="button" class="px-2 py-0.5 text-on-surface-variant hover:bg-surface-container text-xs font-bold cursor-pointer" @onclick="() => ChangeFixedItemQuantity(fItem, -1)">-</button>
                                                    <span class="w-8 text-center text-xs font-bold text-on-surface">@fItem.DefaultQuantity</span>
                                                    <button type="button" class="px-2 py-0.5 text-on-surface-variant hover:bg-surface-container text-xs font-bold cursor-pointer" @onclick="() => ChangeFixedItemQuantity(fItem, 1)">+</button>
                                                </div>
                                            </div>
                                            <!-- Phụ thu -->
                                            <div class="flex items-center gap-1">
                                                <label class="text-xs text-on-surface-variant">Phụ thu:</label>
                                                <div class="relative">
                                                    <input type="number" min="0" @bind="fItem.AdditionalPrice" class="w-20 text-right pr-4 py-1 text-xs border border-outline rounded bg-surface focus:outline-none focus:border-primary" />
                                                    <span class="absolute right-1 top-1 text-[10px] text-on-surface-variant">đ</span>
                                                </div>
                                            </div>
                                            <button type="button" class="text-on-surface-variant hover:text-error p-1 rounded-full transition-colors cursor-pointer" title="Xóa món này" @onclick="() => RemoveFixedItem(capturedFIdx)">
                                                <span class="material-symbols-outlined text-sm" data-icon="close">close</span>
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- SECTION 2: Choice Groups -->
                    <div class="bg-surface-container-lowest border border-outline-variant/50 rounded-xl shadow-xs p-4">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3 pb-2 border-b border-outline-variant/30">
                            <div>
                                <h4 class="font-bold text-sm text-primary flex items-center gap-1.5 m-0">
                                    <span class="material-symbols-outlined text-base" data-icon="tune">tune</span> 2. Nhóm Lựa Chọn (Choice Groups)
                                </h4>
                                <p class="text-xs text-on-surface-variant m-0 mt-0.5">Cho phép khách đổi hoặc chọn món theo số lượng Min / Max quy định</p>
                            </div>
                            <div class="flex items-center gap-1.5 shrink-0 flex-wrap">
                                <button type="button" class="bg-secondary text-on-secondary px-3 py-1.5 rounded-lg text-xs font-bold shadow-2xs hover:bg-secondary/90 transition-colors flex items-center gap-1 cursor-pointer" @onclick="AddGroup">
                                    <span class="material-symbols-outlined text-sm" data-icon="add">add</span> Thêm Nhóm Mới
                                </button>
                            </div>
                        </div>

                        <!-- Quick Presets -->
                        <div class="flex items-center gap-2 mb-4 flex-wrap">
                            <span class="text-xs text-on-surface-variant font-medium">Mẫu tạo nhanh:</span>
                            <button type="button" class="text-xs px-2.5 py-1 rounded-lg bg-surface-container border border-outline-variant/50 hover:bg-primary-container hover:text-primary transition-colors cursor-pointer font-medium" @onclick='() => AddGroupPreset("single")'>
                                + Chọn 1 Món (Min 1, Max 1 - Bắt buộc)
                            </button>
                            <button type="button" class="text-xs px-2.5 py-1 rounded-lg bg-surface-container border border-outline-variant/50 hover:bg-primary-container hover:text-primary transition-colors cursor-pointer font-medium" @onclick='() => AddGroupPreset("optional")'>
                                + Món Tùy Chọn Thêm (Min 0, Max 2)
                            </button>
                        </div>

                        @if (!_model.Groups.Any())
                        {
                            <div class="text-center py-6 border border-dashed border-outline-variant/60 rounded-xl text-on-surface-variant text-xs bg-surface-container-low/20">
                                <span class="material-symbols-outlined text-2xl opacity-40 mb-1" data-icon="widgets">widgets</span>
                                <p class="m-0 font-medium">Chưa có nhóm lựa chọn nào.</p>
                                <p class="text-[11px] text-on-surface-variant/70 m-0 mt-0.5">Bấm "Thêm Nhóm Mới" hoặc chọn mẫu tạo nhanh ở trên (Vd: Chọn 1 Thức Uống hoặc Món tráng miệng).</p>
                            </div>
                        }
                        else
                        {
                            <div class="space-y-4">
                                @for (int i = 0; i < _model.Groups.Count; i++)
                                {
                                    var group = _model.Groups[i];
                                    var groupIndex = i;
                                    
                                    <div class="bg-surface border border-outline-variant/40 rounded-xl overflow-hidden shadow-xs">
                                        <!-- Group Header -->
                                        <div class="bg-surface-container-low p-3 border-b border-outline-variant/40 flex flex-wrap justify-between items-center gap-2.5">
                                            <div class="flex-1 min-w-[180px]">
                                                <input type="text" @bind="group.Name" @bind:event="oninput" class="w-full bg-surface px-2.5 py-1 rounded-md font-bold text-sm text-on-surface border border-outline focus:border-primary focus:outline-none" placeholder="Tên nhóm (Vd: Chọn 1 Thức Uống) *" />
                                            </div>
                                            <div class="flex items-center gap-2 bg-surface-container-lowest px-2 py-1 rounded-lg border border-outline-variant/30 flex-wrap">
                                                <div class="flex items-center gap-1">
                                                    <label class="text-[11px] font-bold text-on-surface-variant" title="Số lượng tối thiểu">Min:</label>
                                                    <input type="number" @bind="group.MinSelections" min="0" class="w-12 text-center text-xs font-bold border border-outline rounded bg-surface py-0.5" />
                                                </div>
                                                <div class="flex items-center gap-1">
                                                    <label class="text-[11px] font-bold text-on-surface-variant" title="Số lượng tối đa">Max:</label>
                                                    <input type="number" @bind="group.MaxSelections" min="1" class="w-12 text-center text-xs font-bold border border-outline rounded bg-surface py-0.5" />
                                                </div>
                                                <label class="flex items-center cursor-pointer ml-1 border-l border-outline-variant/40 pl-2">
                                                    <input type="checkbox" @bind="group.IsRequired" class="w-3.5 h-3.5 text-primary rounded cursor-pointer" />
                                                    <span class="ml-1 text-[11px] font-medium text-on-surface">Bắt buộc</span>
                                                </label>
                                                <span class="text-[10px] px-1.5 py-0.5 rounded bg-primary/10 text-primary font-bold">
                                                    @GetGroupRuleSummary(group)
                                                </span>
                                                <button type="button" class="text-error hover:bg-error-container ml-1 p-1 rounded-full transition-colors cursor-pointer" title="Xóa nhóm này" @onclick="() => RemoveGroup(groupIndex)">
                                                    <span class="material-symbols-outlined text-sm" data-icon="delete">delete</span>
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Group Items -->
                                        <div class="p-3">
                                            @if (!group.Items.Any())
                                            {
                                                <p class="text-xs text-on-surface-variant italic mb-2">Nhóm này chưa có món nào. Bấm nút dưới để thêm món.</p>
                                            }
                                            else
                                            {
                                                <div class="space-y-1.5 mb-3">
                                                    @for (int j = 0; j < group.Items.Count; j++)
                                                    {
                                                        var item = group.Items[j];
                                                        var itemIndex = j;
                                                        var orig = _allMenuItems.FirstOrDefault(m => m.Id == item.MenuItemId);
                                                        <div class="flex items-center justify-between p-2 hover:bg-surface-low rounded-lg border border-outline-variant/20 transition-colors text-sm">
                                                            <div class="flex items-center gap-2 flex-1 min-w-0">
                                                                <span class="material-symbols-outlined text-on-surface-variant/40 text-xs" data-icon="radio_button_unchecked">radio_button_unchecked</span>
                                                                <span class="font-medium text-xs text-on-surface truncate">@item.MenuItemName</span>
                                                                @if (orig != null)
                                                                {
                                                                    <span class="text-[11px] text-on-surface-variant">(Giá lẻ: @orig.Price.ToString("N0")đ)</span>
                                                                }
                                                            </div>
                                                            <div class="flex items-center gap-2 shrink-0">
                                                                <div class="flex items-center gap-1">
                                                                    <span class="text-[11px] text-on-surface-variant">Phụ thu (+):</span>
                                                                    <div class="relative">
                                                                        <input type="number" min="0" @bind="item.AdditionalPrice" class="w-20 text-right pr-4 py-0.5 text-xs border border-outline rounded bg-surface focus:outline-none focus:border-primary" />
                                                                        <span class="absolute right-1 top-0.5 text-[10px] text-on-surface-variant">đ</span>
                                                                    </div>
                                                                </div>
                                                                <button type="button" class="text-on-surface-variant hover:text-error p-0.5 rounded-full transition-colors cursor-pointer" title="Xóa món" @onclick="() => RemoveItemFromGroup(groupIndex, itemIndex)">
                                                                    <span class="material-symbols-outlined text-xs" data-icon="close">close</span>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }

                                            <!-- Add Item Button -->
                                            <button type="button" class="text-xs text-primary font-bold hover:bg-primary/10 px-3 py-1.5 rounded-lg transition-colors flex items-center gap-1 border border-primary/20 bg-primary/5 cursor-pointer" @onclick="() => OpenItemSearchModal(groupIndex)">
                                                <span class="material-symbols-outlined text-sm" data-icon="add_circle">add_circle</span> Thêm món vào nhóm
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="px-6 py-4 border-t border-outline-variant/30 bg-surface-container-low flex flex-col sm:flex-row justify-between items-center gap-3 shrink-0">
                <div class="text-sm">
                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="text-error font-bold flex items-center gap-1.5 animate-pulse text-xs sm:text-sm">
                            <span class="material-symbols-outlined text-base" data-icon="error">error</span>
                            <span>@_errorMessage</span>
                        </div>
                    }
                    else
                    {
                        <div class="text-xs text-on-surface-variant flex items-center gap-2 flex-wrap">
                            <span>Món cố định: <strong class="text-on-surface">@_model.FixedItems.Count</strong></span>
                            <span>•</span>
                            <span>Nhóm tùy chọn: <strong class="text-on-surface">@_model.Groups.Count</strong></span>
                            @if (EstimatedOriginalPrice > 0)
                            {
                                <span>•</span>
                                <span>Giá lẻ ước tính: <strong class="text-on-surface">@EstimatedOriginalPrice.ToString("N0")đ</strong></span>
                                @if (_model.Price > 0 && EstimatedOriginalPrice > _model.Price)
                                {
                                    <span class="text-primary font-bold">(Tiết kiệm: @((EstimatedOriginalPrice - _model.Price).ToString("N0"))đ)</span>
                                }
                            }
                        </div>
                    }
                </div>
                <div class="flex gap-3 shrink-0">
                    <button type="button" class="px-4 py-2 text-on-surface-variant hover:bg-surface-container rounded-lg transition-colors font-label-bold cursor-pointer text-sm" @onclick="CloseModal">Hủy</button>
                    <button type="button" class="px-6 py-2 bg-primary text-on-primary rounded-lg shadow-sm hover:bg-primary/90 transition-colors font-label-bold flex items-center gap-1.5 cursor-pointer text-sm disabled:opacity-50" disabled="@_isSaving" @onclick="SaveCombo">
                        @if (_isSaving)
                        {
                            <span class="material-symbols-outlined animate-spin text-sm" data-icon="progress_activity">progress_activity</span>
                            <span>Đang lưu...</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined text-sm" data-icon="save">save</span>
                            <span>@(_isEditing ? "Cập nhật Combo" : "Lưu Combo")</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Search MenuItem Modal -->
@if (_showItemSearch)
{
    <div class="fixed inset-0 bg-black/60 z-[60] flex items-center justify-center p-4 backdrop-blur-sm animate-in fade-in duration-150">
        <div class="bg-surface-container-lowest rounded-2xl shadow-2xl w-full max-w-xl max-h-[85vh] flex flex-col overflow-hidden border border-outline-variant/30">
            <div class="p-4 border-b border-outline-variant/30 flex justify-between items-center bg-surface-container-low shrink-0">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary text-xl" data-icon="restaurant">restaurant</span>
                    <h3 class="font-bold text-sm sm:text-base text-on-surface m-0">
                        @(_targetGroupIndex == -1 ? "Chọn Món Cố Định" : $"Chọn Món Cho Nhóm: {(_targetGroupIndex >= 0 && _targetGroupIndex < _model.Groups.Count ? _model.Groups[_targetGroupIndex].Name : "")}")
                    </h3>
                </div>
                <button type="button" class="text-on-surface-variant hover:text-error transition-colors p-1 rounded-full cursor-pointer" @onclick="() => _showItemSearch = false">
                    <span class="material-symbols-outlined text-lg" data-icon="close">close</span>
                </button>
            </div>

            <!-- Filters inside Item Search Picker -->
            <div class="p-3 border-b border-outline-variant/30 bg-surface-container-lowest flex flex-col sm:flex-row gap-2 shrink-0">
                <div class="relative flex-1">
                    <span class="material-symbols-outlined absolute left-3 top-2.5 text-on-surface-variant text-[18px]" data-icon="search">search</span>
                    <InputText @bind-Value="_itemSearchKeyword" @bind-Value:event="oninput" class="w-full pl-9 pr-3 py-1.5 text-sm border border-outline rounded-lg bg-surface focus:outline-none focus:border-primary" placeholder="Tìm tên món ăn..." />
                </div>
                <div class="sm:w-44 shrink-0">
                    <select @bind="_itemSearchCategoryId" class="w-full px-2.5 py-1.5 text-sm border border-outline rounded-lg bg-surface focus:outline-none focus:border-primary cursor-pointer">
                        <option value="0">Tất cả danh mục</option>
                        @foreach (var cat in _categories)
                        {
                            <option value="@cat.Id">@cat.DisplayName</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Items List -->
            <div class="flex-1 overflow-y-auto p-3 space-y-1.5 custom-scrollbar">
                @if (!AvailableMenuItemsForSearch.Any())
                {
                    <div class="text-center py-10 text-on-surface-variant text-sm">
                        <span class="material-symbols-outlined text-3xl opacity-40 mb-1" data-icon="search_off">search_off</span>
                        <p class="m-0 font-medium">Không tìm thấy món ăn nào phù hợp.</p>
                    </div>
                }
                @foreach (var item in AvailableMenuItemsForSearch)
                {
                    var isAlreadyAdded = IsItemAlreadySelected(item.Id);
                    <div class="flex items-center justify-between p-2.5 hover:bg-surface-low rounded-lg border border-outline-variant/20 hover:border-primary/40 transition-all cursor-pointer @(isAlreadyAdded ? "bg-surface-container-low/50 opacity-75" : "")" @onclick="() => SelectItemForGroup(item)">
                        <div class="flex items-center gap-3 min-w-0">
                            <div class="w-11 h-11 bg-surface-container rounded-lg overflow-hidden shrink-0 border border-outline-variant/30 flex items-center justify-center">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" class="w-full h-full object-cover" onerror="this.style.display='none'" alt="@item.Name" />
                                }
                                else
                                {
                                    <span class="material-symbols-outlined text-on-surface-variant/40 text-xl" data-icon="fastfood">fastfood</span>
                                }
                            </div>
                            <div class="truncate">
                                <div class="font-bold text-sm text-on-surface truncate">@item.DisplayName</div>
                                <div class="flex items-center gap-2 mt-0.5">
                                    <span class="text-xs text-primary font-bold">@item.Price.ToString("N0")đ</span>
                                    <span class="text-[11px] text-on-surface-variant bg-surface-container px-1.5 py-0.5 rounded border border-outline-variant/20">
                                        @(_categories.FirstOrDefault(c => c.Id == item.CategoryId)?.DisplayName ?? item.CategoryName)
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="shrink-0 ml-2">
                            @if (isAlreadyAdded)
                            {
                                <span class="px-2.5 py-1 text-xs font-bold rounded bg-on-surface-variant/10 text-on-surface-variant border border-outline-variant/40 flex items-center gap-1">
                                    <span class="material-symbols-outlined text-sm" data-icon="check">check</span> Đã chọn
                                </span>
                            }
                            else
                            {
                                <button type="button" class="px-3 py-1 bg-primary text-on-primary font-bold text-xs rounded-md shadow-2xs hover:bg-primary/90 transition-colors flex items-center gap-1 cursor-pointer">
                                    <span class="material-symbols-outlined text-xs" data-icon="add">add</span> Chọn món
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
            
            <div class="p-3 border-t border-outline-variant/30 bg-surface-container-low flex justify-between items-center text-xs text-on-surface-variant shrink-0">
                <span>Hiển thị @AvailableMenuItemsForSearch.Count() món ăn</span>
                <button type="button" class="px-3 py-1 text-on-surface-variant hover:bg-surface-container rounded-md cursor-pointer" @onclick="() => _showItemSearch = false">Đóng</button>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Dialog -->
@if (_showDeleteConfirm)
{
    <div class="fixed inset-0 bg-black/60 z-[70] flex items-center justify-center p-4 backdrop-blur-sm animate-in fade-in duration-150">
        <div class="bg-surface-container-lowest rounded-2xl shadow-2xl w-full max-w-sm overflow-hidden border border-outline-variant/30">
            <div class="p-6 text-center">
                <div class="w-16 h-16 rounded-full bg-error-container text-error mx-auto flex items-center justify-center mb-4">
                    <span class="material-symbols-outlined text-3xl" data-icon="warning">warning</span>
                </div>
                <h3 class="text-lg font-bold text-on-background mb-2">Xác nhận xóa Combo?</h3>
                <p class="text-on-surface-variant text-sm mb-6">Bạn có chắc chắn muốn xóa Combo <b class="text-on-background">@_itemToDelete?.Name</b>? Hành động này không thể hoàn tác.</p>
                
                <div class="flex justify-center gap-3">
                    <button type="button" class="px-4 py-2 border border-outline text-on-surface rounded-lg hover:bg-surface-low transition-colors font-label-bold flex-1 cursor-pointer text-sm" @onclick="() => _showDeleteConfirm = false">Hủy</button>
                    <button type="button" class="px-4 py-2 bg-error text-white rounded-lg hover:bg-error/90 transition-colors font-label-bold flex-1 cursor-pointer text-sm" @onclick="ExecuteDelete">Xóa ngay</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ComboDetailDto> _combos = new();
    private List<MenuItemDto> _allMenuItems = new();
    private List<CategoryDto> _categories = new();
    private bool _isLoading = true;
    private bool _hasLoadError = false;
    private string? _successMessage;

    // Filter & Search
    private string _searchKeyword = "";
    private int _filterCategoryId = 0;
    private bool? _filterStatus = null;
    private readonly HashSet<int> _togglingItemIds = new();

    private bool IsAnyFilterActive => !string.IsNullOrWhiteSpace(_searchKeyword) || _filterCategoryId != 0 || _filterStatus != null;

    private IEnumerable<ComboDetailDto> FilteredCombos => _combos
        .Where(c => string.IsNullOrWhiteSpace(_searchKeyword) 
                 || c.Name.Contains(_searchKeyword, StringComparison.OrdinalIgnoreCase)
                 || (!string.IsNullOrEmpty(c.NameEn) && c.NameEn.Contains(_searchKeyword, StringComparison.OrdinalIgnoreCase)))
        .Where(c => _filterCategoryId == 0 || c.CategoryId == _filterCategoryId)
        .Where(c => _filterStatus == null || (_filterStatus == true ? !c.IsSoldOut : c.IsSoldOut));

    // Modal State
    private bool _showModal = false;
    private bool _isEditing = false;
    private bool _isSaving = false;
    private string? _errorMessage;
    private int _editingId;

    // Form Model
    private ComboFormModel _model = new();

    // Item Search Modal State
    private bool _showItemSearch = false;
    private string _itemSearchKeyword = "";
    private int _itemSearchCategoryId = 0;
    private int _targetGroupIndex = -1;

    private IEnumerable<MenuItemDto> AvailableMenuItemsForSearch => _allMenuItems
        .Where(m => !m.IsCombo && m.IsActive) // Không chọn combo lồng combo
        .Where(m => _itemSearchCategoryId == 0 || m.CategoryId == _itemSearchCategoryId)
        .Where(m => string.IsNullOrWhiteSpace(_itemSearchKeyword) 
                 || m.Name.Contains(_itemSearchKeyword, StringComparison.OrdinalIgnoreCase)
                 || (!string.IsNullOrEmpty(m.NameEn) && m.NameEn.Contains(_itemSearchKeyword, StringComparison.OrdinalIgnoreCase)));

    private bool IsItemAlreadySelected(int menuItemId)
    {
        if (_targetGroupIndex == -1)
        {
            return _model.FixedItems.Any(i => i.MenuItemId == menuItemId);
        }
        else if (_targetGroupIndex >= 0 && _targetGroupIndex < _model.Groups.Count)
        {
            return _model.Groups[_targetGroupIndex].Items.Any(i => i.MenuItemId == menuItemId);
        }
        return false;
    }

    private decimal EstimatedOriginalPrice
    {
        get
        {
            decimal total = 0;
            // Fixed items retail price * quantity
            foreach (var fixedItem in _model.FixedItems)
            {
                var originalItem = _allMenuItems.FirstOrDefault(m => m.Id == fixedItem.MenuItemId);
                if (originalItem != null)
                {
                    total += originalItem.Price * fixedItem.DefaultQuantity;
                }
            }

            // Choice groups: take minimum price of items in each group multiplied by min selections
            foreach (var group in _model.Groups)
            {
                if (group.Items.Any() && group.MinSelections > 0)
                {
                    var groupItemPrices = group.Items
                        .Select(i => _allMenuItems.FirstOrDefault(m => m.Id == i.MenuItemId)?.Price ?? 0)
                        .Where(p => p > 0)
                        .OrderBy(p => p)
                        .Take(group.MinSelections);

                    total += groupItemPrices.Sum();
                }
            }

            return total;
        }
    }

    // Delete State
    private bool _showDeleteConfirm = false;
    private ComboDetailDto? _itemToDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        _hasLoadError = false;
        try
        {
            var taskCombos = ApiClient.GetCombosAsync();
            var taskItems = ApiClient.GetMenuItemsAsync();
            var taskCategories = ApiClient.GetCategoriesAsync();

            try { _combos = (await taskCombos).OrderByDescending(c => c.Id).ToList(); } catch (Exception ex) { Console.WriteLine($"Combos error: {ex.Message}"); }
            try { _allMenuItems = await taskItems; } catch (Exception ex) { Console.WriteLine($"Menu items error: {ex.Message}"); }
            try { _categories = (await taskCategories).Where(c => c.IsActive).OrderBy(c => c.SortOrder).ToList(); } catch (Exception ex) { Console.WriteLine($"Categories error: {ex.Message}"); }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading combos: {ex.Message}");
            _hasLoadError = true;
        }
        finally
        {
            _isLoading = false;
        }
    }


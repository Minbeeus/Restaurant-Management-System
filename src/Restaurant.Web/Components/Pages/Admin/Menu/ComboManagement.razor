@page "/admin/menu/combos"
@using Microsoft.AspNetCore.Authorization
@using Restaurant.Application.DTOs
@using Restaurant.Web.Services
@inject MenuApiClient ApiClient
@inject IJSRuntime JSRuntime
@attribute [Authorize(Roles = "Admin,Manager")]
@rendermode InteractiveServer

<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
    <h2 class="text-2xl font-headline-sm text-primary">Quản lý Combo</h2>
    <button class="bg-primary text-on-primary px-4 py-2 rounded font-label-bold shadow-sm hover:bg-primary/90 transition-colors whitespace-nowrap" @onclick="OpenAddModal">
        <span class="material-symbols-outlined align-middle text-sm mr-1" data-icon="add">add</span> Thêm Combo
    </button>
</div>

<!-- Toolbar Lọc & Tìm Kiếm -->
<div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-4 mb-6 flex flex-col md:flex-row gap-4">
    <div class="flex-1 relative">
        <span class="material-symbols-outlined absolute left-3 top-2.5 text-on-surface-variant text-[20px]" data-icon="search">search</span>
        <InputText @bind-Value="_searchKeyword" @bind-Value:event="oninput" class="w-full pl-10 pr-4 py-2 border border-outline rounded bg-surface focus:outline-none focus:border-primary transition-colors" placeholder="Tìm kiếm Combo..." />
    </div>
    <div class="w-full md:w-48 shrink-0">
        <select @bind="_filterStatus" class="w-full px-4 py-2 border border-outline rounded bg-surface focus:outline-none focus:border-primary transition-colors cursor-pointer">
            <option value="">Tất cả trạng thái</option>
            <option value="true">Đang bán</option>
            <option value="false">Ngừng bán</option>
        </select>
    </div>
</div>

@if (_isLoading)
{
    <div class="flex justify-center p-12">
        <span class="material-symbols-outlined animate-spin text-4xl text-primary" data-icon="progress_activity">progress_activity</span>
    </div>
}
else
{
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead class="bg-surface-container-low border-b border-outline-variant/30 text-on-surface-variant font-label-bold">
                <tr>
                    <th class="p-4 font-semibold text-center w-16">Hình ảnh</th>
                    <th class="p-4 font-semibold">Tên Combo</th>
                    <th class="p-4 font-semibold text-right">Giá bán</th>
                    <th class="p-4 font-semibold text-center w-28">Cấu trúc</th>
                    <th class="p-4 font-semibold text-center w-28">Trạng thái</th>
                    <th class="p-4 font-semibold text-center w-32">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!FilteredCombos.Any())
                {
                    <tr>
                        <td colspan="6" class="p-8 text-center text-on-surface-variant">Không tìm thấy Combo nào.</td>
                    </tr>
                }
                @foreach (var item in FilteredCombos)
                {
                    <tr class="border-b border-outline-variant/20 last:border-0 hover:bg-surface-low/50 transition-colors">
                        <td class="p-4">
                            <div class="w-12 h-12 bg-surface-low rounded flex items-center justify-center text-on-surface-variant overflow-hidden mx-auto border border-outline-variant/30">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" class="w-full h-full object-cover" onerror="this.style.display='none'" />
                                }
                                else
                                {
                                    <span class="material-symbols-outlined" data-icon="fastfood">fastfood</span>
                                }
                            </div>
                        </td>
                        <td class="p-4">
                            <div class="font-label-bold text-on-background text-base">@item.DisplayName</div>
                            @if (!string.IsNullOrEmpty(item.DisplayDescription))
                            {
                                <div class="text-sm text-on-surface-variant line-clamp-1" title="@item.DisplayDescription">@item.DisplayDescription</div>
                            }
                        </td>
                        <td class="p-4 text-right font-label-bold text-primary">@item.Price.ToString("N0") đ</td>
                        <td class="p-4 text-center text-on-surface-variant text-sm">
                            @item.Groups.Count nhóm<br />
                            @item.Groups.Sum(g => g.Items.Count) lựa chọn
                        </td>
                        <td class="p-4 text-center">
                            @if (!item.IsActive)
                            {
                                <div class="px-2 py-0.5 bg-on-surface-variant/10 text-on-surface-variant rounded text-[10px] font-bold border border-on-surface-variant/20 inline-block">Đã ẩn</div>
                            }
                            else
                            {
                                <div class="px-2 py-0.5 @(item.IsSoldOut ? "bg-error/10 text-error border-error/20" : "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border-emerald-500/20") rounded text-[10px] font-bold border inline-block">
                                    @(item.IsSoldOut ? "Hết hàng" : "Đang bán")
                                </div>
                            }
                        </td>
                        <td class="p-4 text-center space-x-1 flex justify-center">
                            <button class="text-primary hover:bg-primary-container p-2 rounded-full transition-colors" title="Sửa" @onclick="() => OpenEditModal(item.Id)">
                                <span class="material-symbols-outlined text-sm" data-icon="edit">edit</span>
                            </button>
                            <button class="text-error hover:bg-error-container p-2 rounded-full transition-colors" title="Xóa" @onclick="() => ConfirmDelete(item)">
                                <span class="material-symbols-outlined text-sm" data-icon="delete">delete</span>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Modal Add/Edit Combo -->
@if (_showModal)
{
    <div class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-surface-container-lowest rounded-xl shadow-lg w-full max-w-5xl max-h-[95vh] flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-200">
            <div class="px-6 py-4 border-b border-outline-variant/30 flex justify-between items-center bg-surface-container-low shrink-0">
                <h3 class="font-headline-sm text-on-background m-0">@(_isEditing ? "Cập nhật Combo" : "Thêm Combo")</h3>
                <button class="text-on-surface-variant hover:text-error transition-colors" @onclick="CloseModal">
                    <span class="material-symbols-outlined" data-icon="close">close</span>
                </button>
            </div>
            
            <div class="flex-1 overflow-hidden flex flex-col md:flex-row">
                <!-- Left: Basic Info -->
                <div class="w-full md:w-1/3 p-6 border-r border-outline-variant/30 overflow-y-auto bg-surface-container-low/30">
                    <h4 class="font-bold text-lg mb-4 text-primary border-b border-outline-variant/30 pb-2">Thông Tin Cơ Bản</h4>
                    <EditForm Model="@_model" id="comboForm">
                        <DataAnnotationsValidator />
                        <div class="space-y-4">
                            <div>
                                <label class="block text-sm font-label-bold text-on-surface mb-1">Tên Combo <span class="text-error">*</span></label>
                                <InputText @bind-Value="_model.Name" class="w-full px-3 py-2 border border-outline rounded bg-surface-container-lowest focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-shadow" placeholder="Vd: Combo Gà Rán Gia Đình" />
                            </div>

                            <div>
                                <label class="block text-sm font-label-bold text-on-surface mb-1">Giá bán <span class="text-error">*</span></label>
                                <InputNumber @bind-Value="_model.Price" class="w-full px-3 py-2 border border-outline rounded bg-surface-container-lowest focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-shadow" />
                            </div>

                            <div>
                                <label class="block text-sm font-label-bold text-on-surface mb-1">Mô tả</label>
                                <InputTextArea @bind-Value="_model.Description" class="w-full px-3 py-2 border border-outline rounded bg-surface-container-lowest focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-shadow resize-none" rows="3" />
                            </div>

                            <div>
                                <label class="block text-sm font-label-bold text-on-surface mb-1">Hình ảnh (URL)</label>
                                <InputText @bind-Value="_model.ImageUrl" class="w-full px-3 py-2 border border-outline rounded bg-surface-container-lowest focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-shadow" placeholder="https://..." />
                                @if (!string.IsNullOrEmpty(_model.ImageUrl))
                                {
                                    <div class="mt-2 text-center h-24 bg-surface-low rounded border border-outline-variant/30 p-1">
                                        <img src="@_model.ImageUrl" class="h-full object-contain mx-auto" onerror="this.style.display='none'" />
                                    </div>
                                }
                            </div>
                            
                            @if (_isEditing)
                            {
                                <div class="bg-surface-container p-4 rounded-lg border border-outline-variant/30 space-y-3 mt-4">
                                    <label class="block text-sm font-label-bold text-on-surface mb-2">Trạng thái</label>
                                    <div class="flex flex-col gap-2">
                                        <label class="flex items-center cursor-pointer">
                                            <InputCheckbox @bind-Value="_model.IsSoldOut" class="w-4 h-4 text-error bg-surface-container border-outline rounded" />
                                            <span class="ml-2 text-sm text-error font-bold">Hết hàng (Ngừng bán tạm thời)</span>
                                        </label>
                                        <label class="flex items-center cursor-pointer">
                                            <InputCheckbox @bind-Value="_model.IsActive" class="w-4 h-4 text-primary bg-surface-container border-outline rounded" />
                                            <span class="ml-2 text-sm">Hiển thị trên POS (IsActive)</span>
                                        </label>
                                    </div>
                                </div>
                            }
                            
                            @if (!string.IsNullOrEmpty(_errorMessage))
                            {
                                <div class="p-3 bg-error-container text-on-error-container rounded text-sm border border-error/20 mt-4">
                                    @_errorMessage
                                </div>
                            }
                        </div>
                    </EditForm>
                </div>

                <!-- Right: Combo Structure (Groups & Items) -->
                <div class="w-full md:w-2/3 p-6 overflow-y-auto">
                    <div class="flex justify-between items-center mb-4 border-b border-outline-variant/30 pb-2">
                        <h4 class="font-bold text-lg text-primary">Cấu Trúc Lựa Chọn</h4>
                        <button class="bg-secondary text-on-secondary px-3 py-1.5 rounded text-sm font-bold shadow-sm hover:bg-secondary/90 transition-colors flex items-center" @onclick="AddGroup">
                            <span class="material-symbols-outlined text-sm mr-1" data-icon="add">add</span> Thêm Nhóm
                        </button>
                    </div>

                    @if (!_model.Groups.Any())
                    {
                        <div class="text-center py-10 bg-surface-container-lowest border border-dashed border-outline rounded-lg text-on-surface-variant">
                            <span class="material-symbols-outlined text-4xl mb-2 opacity-50" data-icon="account_tree">account_tree</span>
                            <p>Chưa có nhóm lựa chọn nào.</p>
                            <p class="text-sm mt-1">Bấm "Thêm Nhóm" để tạo nhóm đầu tiên (Vd: Chọn 2 Miếng Gà).</p>
                        </div>
                    }

                    <div class="space-y-6">
                        @for (int i = 0; i < _model.Groups.Count; i++)
                        {
                            var group = _model.Groups[i];
                            var groupIndex = i; // capture loop variable
                            
                            <div class="bg-surface-container-lowest border border-outline-variant/50 rounded-xl shadow-sm overflow-hidden">
                                <!-- Group Header -->
                                <div class="bg-surface-container-low p-4 border-b border-outline-variant/50 flex flex-wrap justify-between items-center gap-4">
                                    <div class="flex-1 min-w-[200px]">
                                        <input type="text" @bind="group.Name" @bind:event="oninput" class="w-full bg-transparent font-bold text-lg text-on-background focus:outline-none border-b border-transparent focus:border-primary" placeholder="Tên nhóm (Vd: Chọn Thức Uống) *" />
                                    </div>
                                    <div class="flex items-center gap-3 bg-surface p-1.5 rounded-lg border border-outline-variant/30">
                                        <div class="flex items-center gap-1">
                                            <label class="text-xs text-on-surface-variant">Min:</label>
                                            <input type="number" @bind="group.MinSelections" min="0" class="w-12 text-center text-sm border-b border-outline bg-transparent focus:outline-none" />
                                        </div>
                                        <div class="flex items-center gap-1">
                                            <label class="text-xs text-on-surface-variant">Max:</label>
                                            <input type="number" @bind="group.MaxSelections" min="1" class="w-12 text-center text-sm border-b border-outline bg-transparent focus:outline-none" />
                                        </div>
                                        <label class="flex items-center cursor-pointer ml-2 border-l border-outline-variant/30 pl-3">
                                            <input type="checkbox" @bind="group.IsRequired" class="w-3.5 h-3.5 text-primary" />
                                            <span class="ml-1 text-xs text-on-surface-variant">Bắt buộc</span>
                                        </label>
                                        <button class="text-error hover:bg-error-container ml-2 p-1 rounded transition-colors" title="Xóa nhóm" @onclick="() => RemoveGroup(groupIndex)">
                                            <span class="material-symbols-outlined text-sm" data-icon="delete">delete</span>
                                        </button>
                                    </div>
                                </div>

                                <!-- Group Items -->
                                <div class="p-4">
                                    @if (!group.Items.Any())
                                    {
                                        <p class="text-sm text-on-surface-variant italic mb-3">Chưa có món nào trong nhóm này.</p>
                                    }
                                    else
                                    {
                                        <div class="space-y-2 mb-4">
                                            @for (int j = 0; j < group.Items.Count; j++)
                                            {
                                                var item = group.Items[j];
                                                var itemIndex = j;
                                                <div class="flex items-center justify-between p-2 hover:bg-surface-low rounded border border-transparent hover:border-outline-variant/30 transition-colors">
                                                    <div class="flex items-center gap-2 flex-1">
                                                        <span class="material-symbols-outlined text-on-surface-variant/50 text-sm" data-icon="drag_indicator">drag_indicator</span>
                                                        <span class="font-bold text-sm">@item.MenuItemName</span>
                                                    </div>
                                                    <div class="flex items-center gap-3">
                                                        <div class="flex items-center gap-1">
                                                            <span class="text-xs text-on-surface-variant">Phụ thu (+):</span>
                                                            <div class="relative">
                                                                <input type="number" @bind="item.AdditionalPrice" class="w-24 text-right pr-6 py-1 text-sm border border-outline rounded bg-surface focus:outline-none focus:border-primary" />
                                                                <span class="absolute right-2 top-1.5 text-xs text-on-surface-variant font-bold">đ</span>
                                                            </div>
                                                        </div>
                                                        <button class="text-on-surface-variant hover:text-error p-1 rounded-full transition-colors" title="Xóa món" @onclick="() => RemoveItemFromGroup(groupIndex, itemIndex)">
                                                            <span class="material-symbols-outlined text-sm" data-icon="close">close</span>
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }

                                    <!-- Add Item Button -->
                                    <button class="text-sm text-primary font-bold hover:bg-primary-container px-3 py-1.5 rounded transition-colors flex items-center border border-primary/20 bg-primary/5" @onclick="() => OpenItemSearchModal(groupIndex)">
                                        <span class="material-symbols-outlined text-[16px] mr-1" data-icon="add_circle">add_circle</span> Thêm món vào nhóm
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="px-6 py-4 border-t border-outline-variant/30 bg-surface-container-low flex justify-between items-center shrink-0">
                <div class="text-sm text-on-surface-variant italic">
                    Lưu ý: Combo yêu cầu xử lý phía Backend để lưu cấu trúc phân cấp.
                </div>
                <div class="flex gap-3">
                    <button type="button" class="px-4 py-2 text-on-surface-variant hover:bg-surface-low rounded transition-colors font-label-bold" @onclick="CloseModal">Hủy</button>
                    <button type="button" class="px-6 py-2 bg-primary text-on-primary rounded shadow-sm hover:bg-primary/90 transition-colors font-label-bold flex items-center" disabled="@_isSaving" @onclick="SaveCombo">
                        @if (_isSaving)
                        {
                            <span class="material-symbols-outlined animate-spin text-sm mr-2" data-icon="progress_activity">progress_activity</span>
                            <span>Đang lưu...</span>
                        }
                        else
                        {
                            <span>Lưu Combo</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Search MenuItem Modal -->
@if (_showItemSearch)
{
    <div class="fixed inset-0 bg-black/60 z-[60] flex items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-surface-container-lowest rounded-xl shadow-2xl w-full max-w-lg max-h-[80vh] flex flex-col overflow-hidden">
            <div class="p-4 border-b border-outline-variant/30 flex justify-between items-center bg-surface-container">
                <h3 class="font-bold">Chọn món để thêm</h3>
                <button class="text-on-surface-variant hover:text-error transition-colors" @onclick="() => _showItemSearch = false">
                    <span class="material-symbols-outlined" data-icon="close">close</span>
                </button>
            </div>
            <div class="p-4 border-b border-outline-variant/30">
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-3 top-2.5 text-on-surface-variant text-[20px]" data-icon="search">search</span>
                    <InputText @bind-Value="_itemSearchKeyword" @bind-Value:event="oninput" class="w-full pl-10 pr-4 py-2 border border-outline rounded bg-surface focus:outline-none focus:border-primary" placeholder="Tìm kiếm tên món..." />
                </div>
            </div>
            <div class="flex-1 overflow-y-auto p-2">
                @if (!AvailableMenuItemsForSearch.Any())
                {
                    <div class="text-center p-6 text-on-surface-variant">Không tìm thấy món ăn nào phù hợp.</div>
                }
                @foreach (var item in AvailableMenuItemsForSearch)
                {
                    <div class="flex items-center justify-between p-3 hover:bg-surface-low border-b border-outline-variant/20 last:border-0 cursor-pointer" @onclick="() => SelectItemForGroup(item)">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-surface rounded overflow-hidden">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" class="w-full h-full object-cover" onerror="this.style.display='none'" />
                                }
                            </div>
                            <div>
                                <div class="font-bold text-sm">@item.DisplayName</div>
                                <div class="text-xs text-primary font-bold">@item.Price.ToString("N0")đ</div>
                            </div>
                        </div>
                        <button class="px-3 py-1 bg-primary/10 text-primary font-bold text-xs rounded hover:bg-primary hover:text-on-primary transition-colors">
                            Chọn
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation -->
@if (_showDeleteConfirm)
{
    <div class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-surface-container-lowest rounded-xl shadow-lg w-full max-w-sm overflow-hidden">
            <div class="p-6 text-center">
                <div class="w-16 h-16 rounded-full bg-error-container text-error mx-auto flex items-center justify-center mb-4">
                    <span class="material-symbols-outlined text-3xl" data-icon="warning">warning</span>
                </div>
                <h3 class="text-xl font-bold text-on-background mb-2">Xác nhận xóa?</h3>
                <p class="text-on-surface-variant text-sm mb-6">Bạn có chắc chắn muốn xóa Combo <b>@_itemToDelete?.Name</b>? Hành động này không thể hoàn tác.</p>
                
                <div class="flex justify-center gap-3">
                    <button class="px-4 py-2 border border-outline text-on-surface rounded hover:bg-surface-low transition-colors font-label-bold flex-1" @onclick="() => _showDeleteConfirm = false">Hủy</button>
                    <button class="px-4 py-2 bg-error text-white rounded hover:bg-error/90 transition-colors font-label-bold flex-1" @onclick="ExecuteDelete">Xóa ngay</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ComboDetailDto> _combos = new();
    private List<MenuItemDto> _allMenuItems = new();
    private bool _isLoading = true;

    // Filter & Search
    private string _searchKeyword = "";
    private bool? _filterStatus = null;

    private IEnumerable<ComboDetailDto> FilteredCombos => _combos
        .Where(c => string.IsNullOrWhiteSpace(_searchKeyword) 
                 || c.Name.Contains(_searchKeyword, StringComparison.OrdinalIgnoreCase))
        .Where(c => _filterStatus == null || (_filterStatus == true ? !c.IsSoldOut : c.IsSoldOut));

    // Modal State
    private bool _showModal = false;
    private bool _isEditing = false;
    private bool _isSaving = false;
    private string? _errorMessage;
    private int _editingId;

    // Form Model
    private ComboFormModel _model = new();

    // Item Search Modal State
    private bool _showItemSearch = false;
    private string _itemSearchKeyword = "";
    private int _targetGroupIndex = -1;

    private IEnumerable<MenuItemDto> AvailableMenuItemsForSearch => _allMenuItems
        .Where(m => !m.IsCombo && m.IsActive) // Không chọn combo lồng combo
        .Where(m => string.IsNullOrWhiteSpace(_itemSearchKeyword) || m.Name.Contains(_itemSearchKeyword, StringComparison.OrdinalIgnoreCase))
        .Take(20);

    // Delete State
    private bool _showDeleteConfirm = false;
    private ComboDetailDto? _itemToDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            var taskCombos = ApiClient.GetCombosAsync();
            var taskItems = ApiClient.GetMenuItemsAsync(); // to get all menu items for searching

            await Task.WhenAll(taskCombos, taskItems);

            _combos = taskCombos.Result.OrderByDescending(c => c.Id).ToList();
            _allMenuItems = taskItems.Result;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading combos: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenAddModal()
    {
        _isEditing = false;
        _model = new ComboFormModel 
        { 
            IsActive = true,
            Price = 0,
            Groups = new List<ComboGroupFormModel>() 
        };
        _errorMessage = null;
        _showModal = true;
    }

    private async Task OpenEditModal(int comboId)
    {
        _isLoading = true;
        try
        {
            var detail = await ApiClient.GetComboByIdAsync(comboId);
            if (detail != null)
            {
                _isEditing = true;
                _editingId = comboId;
                _model = new ComboFormModel
                {
                    Name = detail.Name,
                    Description = detail.Description,
                    Price = detail.Price,
                    ImageUrl = detail.ImageUrl,
                    IsSoldOut = detail.IsSoldOut,
                    IsActive = detail.IsActive,
                    Groups = detail.Groups.Select(g => new ComboGroupFormModel
                    {
                        Name = g.Name,
                        MinSelections = g.MinSelections,
                        MaxSelections = g.MaxSelections,
                        IsRequired = g.IsRequired,
                        Items = g.Items.Select(i => new ComboItemFormModel
                        {
                            MenuItemId = i.MenuItemId,
                            MenuItemName = i.MenuItemName,
                            AdditionalPrice = i.AdditionalPrice
                        }).ToList()
                    }).ToList()
                };
                _errorMessage = null;
                _showModal = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void CloseModal()
    {
        _showModal = false;
    }

    // --- GROUP LOGIC ---
    private void AddGroup()
    {
        _model.Groups.Add(new ComboGroupFormModel 
        { 
            Name = "", 
            MinSelections = 1, 
            MaxSelections = 1, 
            IsRequired = true,
            Items = new List<ComboItemFormModel>() 
        });
    }

    private void RemoveGroup(int index)
    {
        if (index >= 0 && index < _model.Groups.Count)
        {
            _model.Groups.RemoveAt(index);
        }
    }

    private void RemoveItemFromGroup(int groupIndex, int itemIndex)
    {
        if (groupIndex >= 0 && groupIndex < _model.Groups.Count)
        {
            var group = _model.Groups[groupIndex];
            if (itemIndex >= 0 && itemIndex < group.Items.Count)
            {
                group.Items.RemoveAt(itemIndex);
            }
        }
    }

    private void OpenItemSearchModal(int groupIndex)
    {
        _targetGroupIndex = groupIndex;
        _itemSearchKeyword = "";
        _showItemSearch = true;
    }

    private void SelectItemForGroup(MenuItemDto item)
    {
        if (_targetGroupIndex >= 0 && _targetGroupIndex < _model.Groups.Count)
        {
            var group = _model.Groups[_targetGroupIndex];
            // Check duplicate
            if (!group.Items.Any(i => i.MenuItemId == item.Id))
            {
                group.Items.Add(new ComboItemFormModel
                {
                    MenuItemId = item.Id,
                    MenuItemName = item.DisplayName,
                    AdditionalPrice = 0
                });
            }
        }
        _showItemSearch = false;
    }

    // --- SAVE LOGIC ---
    private bool ValidateForm()
    {
        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            _errorMessage = "Tên Combo không được để trống.";
            return false;
        }
        if (_model.Price < 0)
        {
            _errorMessage = "Giá bán không được âm.";
            return false;
        }
        
        // Group validation
        for (int i = 0; i < _model.Groups.Count; i++)
        {
            var g = _model.Groups[i];
            if (string.IsNullOrWhiteSpace(g.Name))
            {
                _errorMessage = $"Nhóm thứ {i+1} chưa có tên.";
                return false;
            }
            if (g.MinSelections < 0) g.MinSelections = 0;
            if (g.MaxSelections < 1) g.MaxSelections = 1;
            
            if (g.MinSelections > g.MaxSelections)
            {
                _errorMessage = $"Nhóm '{g.Name}': Min ({g.MinSelections}) không được lớn hơn Max ({g.MaxSelections}).";
                return false;
            }
            
            if (!g.Items.Any())
            {
                _errorMessage = $"Nhóm '{g.Name}' chưa có món ăn nào.";
                return false;
            }
            
            if (g.Items.Count < g.MinSelections)
            {
                _errorMessage = $"Nhóm '{g.Name}' yêu cầu chọn ít nhất {g.MinSelections} món nhưng chỉ có {g.Items.Count} lựa chọn.";
                return false;
            }
        }

        return true;
    }

    private async Task SaveCombo()
    {
        if (!ValidateForm()) return;

        _isSaving = true;
        _errorMessage = null;

        try
        {
            // Tạm thời fix CategoryId (ví dụ 1). Trong thực tế Combo có thể có Category riêng.
            // Backend đang cần CategoryId cho MenuItem base class.
            int defaultCategoryId = _allMenuItems.FirstOrDefault()?.CategoryId ?? 1;

            if (_isEditing)
            {
                var request = new UpdateComboRequest
                {
                    CategoryId = defaultCategoryId,
                    Name = _model.Name,
                    Description = _model.Description,
                    Price = _model.Price,
                    ImageUrl = _model.ImageUrl,
                    IsCombo = true,
                    IsSoldOut = _model.IsSoldOut,
                    IsActive = _model.IsActive,
                    Groups = _model.Groups.Select((g, index) => new CreateComboGroupRequest
                    {
                        Name = g.Name,
                        MinSelections = g.MinSelections,
                        MaxSelections = g.MaxSelections,
                        IsRequired = g.IsRequired,
                        SortOrder = index + 1,
                        Items = g.Items.Select((i, idx) => new CreateComboItemRequest
                        {
                            MenuItemId = i.MenuItemId,
                            ComponentType = Restaurant.Domain.Enums.ComboComponentType.Choice,
                            DefaultQuantity = 1,
                            AdditionalPrice = i.AdditionalPrice,
                            SortOrder = idx + 1
                        }).ToList()
                    }).ToList()
                };
                await ApiClient.UpdateComboAsync(_editingId, request);
            }
            else
            {
                var request = new CreateComboRequest
                {
                    CategoryId = defaultCategoryId,
                    Name = _model.Name,
                    Description = _model.Description,
                    Price = _model.Price,
                    ImageUrl = _model.ImageUrl,
                    IsCombo = true,
                    SortOrder = 1,
                    Groups = _model.Groups.Select((g, index) => new CreateComboGroupRequest
                    {
                        Name = g.Name,
                        MinSelections = g.MinSelections,
                        MaxSelections = g.MaxSelections,
                        IsRequired = g.IsRequired,
                        SortOrder = index + 1,
                        Items = g.Items.Select((i, idx) => new CreateComboItemRequest
                        {
                            MenuItemId = i.MenuItemId,
                            ComponentType = Restaurant.Domain.Enums.ComboComponentType.Choice,
                            DefaultQuantity = 1,
                            AdditionalPrice = i.AdditionalPrice,
                            SortOrder = idx + 1
                        }).ToList()
                    }).ToList()
                };
                await ApiClient.CreateComboAsync(request);
            }

            _showModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Lỗi khi lưu dữ liệu: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ConfirmDelete(ComboDetailDto item)
    {
        _itemToDelete = item;
        _showDeleteConfirm = true;
    }

    private async Task ExecuteDelete()
    {
        if (_itemToDelete != null)
        {
            await ApiClient.DeleteComboAsync(_itemToDelete.Id);
            _showDeleteConfirm = false;
            await LoadData();
        }
    }


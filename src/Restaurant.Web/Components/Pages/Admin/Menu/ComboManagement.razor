    private void SelectItemForGroup(MenuItemDto item)
    {
        if (_targetGroupIndex == -1)
        {
            // Fixed Items
            if (!_model.FixedItems.Any(i => i.MenuItemId == item.Id))
            {
                _model.FixedItems.Add(new ComboItemFormModel
                {
                    MenuItemId = item.Id,
                    MenuItemName = item.DisplayName,
                    DefaultQuantity = 1,
                    AdditionalPrice = 0
                });
            }
        }
        else if (_targetGroupIndex >= 0 && _targetGroupIndex < _model.Groups.Count)
        {
            // Choice Groups
            var group = _model.Groups[_targetGroupIndex];
            if (!group.Items.Any(i => i.MenuItemId == item.Id))
            {
                group.Items.Add(new ComboItemFormModel
                {
                    MenuItemId = item.Id,
                    MenuItemName = item.DisplayName,
                    DefaultQuantity = 1,
                    AdditionalPrice = 0
                });
            }
        }
        _showItemSearch = false;
    }

    // --- SAVE LOGIC ---
    private bool ValidateForm()
    {
        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            if (!string.IsNullOrWhiteSpace(_model.NameEn))
            {
                _model.Name = _model.NameEn;
            }
            else
            {
                _errorMessage = "Tên Combo không được để trống.";
                return false;
            }
        }
        if (_model.CategoryId <= 0)
        {
            _errorMessage = "Vui lòng chọn danh mục cho Combo.";
            return false;
        }
        if (_model.Price < 0)
        {
            _errorMessage = "Giá bán không được âm.";
            return false;
        }
        if (!_model.FixedItems.Any() && !_model.Groups.Any())
        {
            _errorMessage = "Combo phải có ít nhất một món cố định hoặc một nhóm lựa chọn.";
            return false;
        }

        // Fixed items validation
        for (int i = 0; i < _model.FixedItems.Count; i++)
        {
            var item = _model.FixedItems[i];
            if (item.DefaultQuantity <= 0)
            {
                _errorMessage = $"Món cố định '{item.MenuItemName}' phải có số lượng ít nhất là 1.";
                return false;
            }
            if (item.AdditionalPrice < 0)
            {
                _errorMessage = $"Món cố định '{item.MenuItemName}' không được có phụ thu âm.";
                return false;
            }
        }
        
        // Group validation
        for (int i = 0; i < _model.Groups.Count; i++)
        {
            var g = _model.Groups[i];
            if (string.IsNullOrWhiteSpace(g.Name))
            {
                _errorMessage = $"Nhóm thứ {i+1} chưa có tên.";
                return false;
            }
            if (g.MinSelections < 0) g.MinSelections = 0;
            if (g.MaxSelections < 1) g.MaxSelections = 1;
            
            if (g.MinSelections > g.MaxSelections)
            {
                _errorMessage = $"Nhóm '{g.Name}': Min ({g.MinSelections}) không được lớn hơn Max ({g.MaxSelections}).";
                return false;
            }
            
            if (!g.Items.Any())
            {
                _errorMessage = $"Nhóm '{g.Name}' chưa có món ăn nào. Vui lòng thêm món vào nhóm.";
                return false;
            }
            
            if (g.Items.Count < g.MinSelections)
            {
                _errorMessage = $"Nhóm '{g.Name}' yêu cầu chọn ít nhất {g.MinSelections} món nhưng chỉ có {g.Items.Count} lựa chọn.";
                return false;
            }

            foreach (var item in g.Items)
            {
                if (item.AdditionalPrice < 0)
                {
                    _errorMessage = $"Món '{item.MenuItemName}' trong nhóm '{g.Name}' không được có phụ thu âm.";
                    return false;
                }
            }
        }

        return true;
    }

    private async Task SaveCombo()
    {
        if (!ValidateForm()) return;

        _isSaving = true;
        _errorMessage = null;

        try
        {
            var fixedRequests = _model.FixedItems.Select((f, idx) => new CreateComboItemRequest
            {
                Id = f.Id,
                MenuItemId = f.MenuItemId,
                ComponentType = Restaurant.Domain.Enums.ComboComponentType.Fixed,
                DefaultQuantity = f.DefaultQuantity,
                AdditionalPrice = f.AdditionalPrice,
                SortOrder = idx + 1
            }).ToList();

            var groupRequests = _model.Groups.Select((g, index) => new CreateComboGroupRequest
            {
                Id = g.Id,
                Name = g.Name,
                MinSelections = g.MinSelections,
                MaxSelections = g.MaxSelections,
                IsRequired = g.IsRequired,
                SortOrder = index + 1,
                Items = g.Items.Select((i, idx) => new CreateComboItemRequest
                {
                    Id = i.Id,
                    MenuItemId = i.MenuItemId,
                    ComponentType = Restaurant.Domain.Enums.ComboComponentType.Choice,
                    DefaultQuantity = 1,
                    AdditionalPrice = i.AdditionalPrice,
                    SortOrder = idx + 1
                }).ToList()
            }).ToList();

            if (_isEditing)
            {
                var request = new UpdateComboRequest
                {
                    CategoryId = _model.CategoryId,
                    Name = _model.Name,
                    NameEn = _model.NameEn,
                    Description = _model.Description,
                    Price = _model.Price,
                    ImageUrl = _model.ImageUrl,
                    IsCombo = true,
                    IsSoldOut = _model.IsSoldOut,
                    IsActive = _model.IsActive,
                    FixedAndAddOnItems = fixedRequests,
                    Groups = groupRequests
                };
                await ApiClient.UpdateComboAsync(_editingId, request);
                _successMessage = $"Cập nhật Combo '{_model.Name}' thành công!";
            }
            else
            {
                var request = new CreateComboRequest
                {
                    CategoryId = _model.CategoryId,
                    Name = _model.Name,
                    NameEn = _model.NameEn,
                    Description = _model.Description,
                    Price = _model.Price,
                    ImageUrl = _model.ImageUrl,
                    IsCombo = true,
                    SortOrder = 1,
                    FixedAndAddOnItems = fixedRequests,
                    Groups = groupRequests
                };
                await ApiClient.CreateComboAsync(request);
                _successMessage = $"Thêm mới Combo '{_model.Name}' thành công!";
            }

            _showModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Lỗi khi lưu dữ liệu: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ConfirmDelete(ComboDetailDto item)
    {
        _itemToDelete = item;
        _showDeleteConfirm = true;
    }

    private async Task ExecuteDelete()
    {
        if (_itemToDelete != null)
        {
            var name = _itemToDelete.Name;
            await ApiClient.DeleteComboAsync(_itemToDelete.Id);
            _showDeleteConfirm = false;
            _successMessage = $"Đã xóa Combo '{name}' thành công!";
            await LoadData();
        }
    }


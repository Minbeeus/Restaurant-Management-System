    private async Task ToggleQuickSoldOut(ComboDetailDto combo)
    {
        if (_togglingItemIds.Contains(combo.Id)) return;
        _togglingItemIds.Add(combo.Id);
        try
        {
            var success = await ApiClient.ToggleSoldOutAsync(combo.Id);
            if (success)
            {
                combo.IsSoldOut = !combo.IsSoldOut;
                _successMessage = $"Đã cập nhật trạng thái của '{combo.Name}' thành {(combo.IsSoldOut ? "Tạm hết hàng" : "Đang bán")}.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggling sold out: {ex.Message}");
        }
        finally
        {
            _togglingItemIds.Remove(combo.Id);
        }
    }


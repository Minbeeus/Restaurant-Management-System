@page "/admin/categories"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.AdminLayout
@using Restaurant.Application.DTOs
@using Restaurant.Web.Services
@inject MenuApiClient ApiClient

<div class="flex justify-between items-center mb-6">
    <h2 class="text-2xl font-headline-sm text-primary">@L["Category_Management_Title"]</h2>
    <button class="bg-primary text-on-primary px-4 py-2 rounded font-label-bold shadow-sm hover:bg-primary/90 transition-colors" @onclick="OpenAddModal">
        <span class="material-symbols-outlined align-middle text-sm mr-1" data-icon="add">add</span> @L["Category_Add_Button"]
    </button>
</div>

@if (_isLoading)
{
    <div class="flex justify-center p-12">
        <span class="material-symbols-outlined animate-spin text-4xl text-primary" data-icon="progress_activity">progress_activity</span>
    </div>
}
else
{
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead class="bg-surface-container-low border-b border-outline-variant/30 text-on-surface-variant font-label-bold">
                <tr>
                    <th class="p-4 font-semibold text-center w-20">@L["Category_STT"]</th>
                    <th class="p-4 font-semibold text-center w-16">@L["Category_ID"]</th>
                    <th class="p-4 font-semibold">@L["Category_Name_Header"]</th>
                    <th class="p-4 font-semibold">@L["Category_Description_Header"]</th>
                    <th class="p-4 font-semibold text-center w-48">@L["Category_Status_Header"]</th>
                    <th class="p-4 font-semibold text-center w-36">@L["Category_Actions_Header"]</th>
                </tr>
            </thead>
            <tbody>
                @if (!_categories.Any())
                {
                    <tr>
                        <td colspan="6" class="p-8 text-center text-on-surface-variant">@L["Category_No_Data"]</td>
                    </tr>
                }
                @foreach (var cat in _categories)
                {
                    <tr class="border-b border-outline-variant/20 last:border-0 hover:bg-surface-low/50 transition-colors">
                        <td class="p-4 text-center font-bold text-primary">@cat.SortOrder</td>
                        <td class="p-4 text-center text-on-surface-variant">#@cat.Id</td>
                        <td class="p-4 font-label-bold text-on-background">
                            @cat.Name
                        </td>
                        <td class="p-4 text-on-surface-variant">@cat.Description</td>
                        <td class="p-4 text-center">
                            <button class="inline-flex items-center justify-center px-3 py-1.5 rounded text-xs font-bold transition-all disabled:opacity-50 cursor-pointer whitespace-nowrap @(cat.IsActive ? "bg-success-green/10 text-success-green border border-success-green/20 hover:bg-success-green/20" : "bg-error-container/20 text-error border border-error/20 hover:bg-error-container/30")"
                                    disabled="@_togglingCategoryIds.Contains(cat.Id)"
                                    title="@(cat.IsActive ? L["Category_Status_Toggle_To_Inactive"] : L["Category_Status_Toggle_To_Active"])"
                                    @onclick="() => ToggleStatusAsync(cat)">
                                @if (_togglingCategoryIds.Contains(cat.Id))
                                {
                                    <span class="material-symbols-outlined animate-spin text-[14px] mr-1" data-icon="progress_activity">progress_activity</span>
                                }
                                <span>@(cat.IsActive ? L["Category_Active"] : L["Category_Inactive"])</span>
                            </button>
                        </td>
                        <td class="p-4 text-center space-x-2">
                            <button class="text-primary hover:bg-primary-container p-2 rounded-full transition-colors" title="@L["Category_Edit_Tooltip"]" @onclick="() => OpenEditModal(cat)">
                                <span class="material-symbols-outlined text-[20px]" data-icon="edit">edit</span>
                            </button>
                            <button class="text-error hover:bg-error-container p-2 rounded-full transition-colors" title="@L["Category_Delete_Tooltip"]" @onclick="() => ConfirmDelete(cat)">
                                <span class="material-symbols-outlined text-[20px]" data-icon="delete">delete</span>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Modal Add/Edit -->
@if (_showModal)
{
    <div class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 backdrop-blur-sm transition-opacity">
        <div class="bg-surface-container-lowest rounded-xl shadow-lg w-full max-w-md flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-200">
            <div class="px-6 py-4 border-b border-outline-variant/30 flex justify-between items-center bg-surface-container-low">
                <h3 class="font-headline-sm text-on-background m-0">@(_isEditing ? L["Category_Edit_Title"] : L["Category_Add_Title"])</h3>
                <button class="text-on-surface-variant hover:text-error transition-colors" @onclick="CloseModal">
                    <span class="material-symbols-outlined" data-icon="close">close</span>
                </button>
            </div>
            
            <div class="p-6 overflow-y-auto">
                <EditForm Model="@_model" OnValidSubmit="SaveCategoryAsync">
                    <DataAnnotationsValidator />
                    
                    <div class="mb-4">
                        <label class="block text-sm font-label-bold text-on-surface mb-1">@L["Category_Name_Label"] <span class="text-error">*</span></label>
                        <InputText @bind-Value="_model.Name" class="w-full px-3 py-2 border border-outline rounded bg-surface-container-lowest focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-shadow" placeholder="@L["Category_Name_Placeholder"]" />
                        <ValidationMessage For="@(() => _model.Name)" class="text-error text-xs mt-1" />
                    </div>
                    
                    <div class="mb-4">
                        <label class="block text-sm font-label-bold text-on-surface mb-1">@L["Category_Description_Label"]</label>
                        <InputTextArea @bind-Value="_model.Description" class="w-full px-3 py-2 border border-outline rounded bg-surface-container-lowest focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-shadow resize-none" rows="3" placeholder="@L["Category_Description_Placeholder"]" />
                    </div>

                    <div class="grid grid-cols-2 gap-4 mb-6">
                        <div>
                            <label class="block text-sm font-label-bold text-on-surface mb-1">@L["Category_SortOrder_Label"]</label>
                            <InputNumber @bind-Value="_model.SortOrder" class="w-full px-3 py-2 border border-outline rounded bg-surface-container-lowest focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-shadow" />
                        </div>
                        @if (_isEditing)
                        {
                            <div class="flex items-center pt-6">
                                <label class="flex items-center cursor-pointer">
                                    <InputCheckbox @bind-Value="_model.IsActive" class="w-4 h-4 text-primary bg-surface-container border-outline rounded focus:ring-primary focus:ring-2" />
                                    <span class="ml-2 text-sm text-on-surface">@L["Category_IsActive_Label"]</span>
                                </label>
                            </div>
                        }
                    </div>
                    
                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="mb-4 p-3 bg-error-container text-on-error-container rounded text-sm border border-error/20">
                            @_errorMessage
                        </div>
                    }

                    <div class="flex justify-end gap-3 pt-4 border-t border-outline-variant/30">
                        <button type="button" class="px-4 py-2 text-on-surface-variant hover:bg-surface-low rounded transition-colors font-label-bold" @onclick="CloseModal">@L["Common_Cancel"]</button>
                        <button type="submit" class="px-4 py-2 bg-primary text-on-primary rounded shadow-sm hover:bg-primary/90 transition-colors font-label-bold flex items-center" disabled="@_isSaving">
                            @if (_isSaving)
                            {
                                <span class="material-symbols-outlined animate-spin text-sm mr-2" data-icon="progress_activity">progress_activity</span>
                                <span>@L["Common_Saving"]</span>
                            }
                            else
                            {
                                <span>@L["Common_Save_Changes"]</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation -->
@if (_showDeleteConfirm)
{
    <div class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-surface-container-lowest rounded-xl shadow-lg w-full max-w-sm overflow-hidden">
            <div class="p-6 text-center">
                <div class="w-16 h-16 rounded-full bg-error-container text-error mx-auto flex items-center justify-center mb-4">
                    <span class="material-symbols-outlined text-3xl" data-icon="warning">warning</span>
                </div>
                <h3 class="text-xl font-bold text-on-background mb-2">@L["Category_Delete_Confirm_Title"]</h3>
                <p class="text-on-surface-variant text-sm mb-6">@L["Category_Delete_Confirm_Prefix"] <strong>@_categoryToDelete?.Name</strong> @L["Category_Delete_Confirm_Suffix"]</p>
                
                <div class="flex justify-center gap-3">
                    <button class="px-4 py-2 border border-outline text-on-surface rounded hover:bg-surface-low transition-colors font-label-bold flex-1" @onclick="() => _showDeleteConfirm = false">@L["Common_Cancel"]</button>
                    <button class="px-4 py-2 bg-error text-white rounded hover:bg-error/90 transition-colors font-label-bold flex-1" @onclick="ExecuteDeleteAsync">@L["Category_Delete_Now_Btn"]</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CategoryDto> _categories = new();
    private bool _isLoading = true;
    
    // Modal state
    private bool _showModal = false;
    private bool _isEditing = false;
    private bool _isSaving = false;
    private string? _errorMessage;
    private int _editingId;

    // Delete state
    private bool _showDeleteConfirm = false;
    private CategoryDto? _categoryToDelete;

    // Form Model
    private CategoryFormModel _model = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            _categories = await ApiClient.GetCategoriesAsync();
            _categories = _categories.OrderBy(c => c.SortOrder).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading categories: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenAddModal()
    {
        _isEditing = false;
        _model = new CategoryFormModel { IsActive = true, SortOrder = (_categories.Count > 0 ? _categories.Max(c => c.SortOrder) + 1 : 1) };
        _errorMessage = null;
        _showModal = true;
    }

    private void OpenEditModal(CategoryDto category)
    {
        _isEditing = true;
        _editingId = category.Id;
        _model = new CategoryFormModel
        {
            Name = category.Name,
            Description = category.Description,
            SortOrder = category.SortOrder,
            IsActive = category.IsActive
        };
        _errorMessage = null;
        _showModal = true;
    }

    private void CloseModal()
    {
        _showModal = false;
    }

    private async Task SaveCategoryAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            _errorMessage = L["Category_Name_Required"];
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            if (_isEditing)
            {
                var request = new UpdateCategoryRequest
                {
                    Name = _model.Name,
                    Description = _model.Description,
                    ImageUrl = null,
                    SortOrder = _model.SortOrder,
                    IsActive = _model.IsActive
                };
                await ApiClient.UpdateCategoryAsync(_editingId, request);
            }
            else
            {
                var request = new CreateCategoryRequest
                {
                    Name = _model.Name,
                    Description = _model.Description,
                    ImageUrl = null,
                    SortOrder = _model.SortOrder
                };
                await ApiClient.CreateCategoryAsync(request);
            }

            _showModal = false;
            await LoadDataAsync();
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = L["Category_Save_Error"];
            Console.WriteLine(ex);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ConfirmDelete(CategoryDto category)
    {
        _categoryToDelete = category;
        _showDeleteConfirm = true;
    }

    private async Task ExecuteDeleteAsync()
    {
        if (_categoryToDelete != null)
        {
            await ApiClient.DeleteCategoryAsync(_categoryToDelete.Id);
            _showDeleteConfirm = false;
            await LoadDataAsync();
        }
    }

    private HashSet<int> _togglingCategoryIds = new();

    private async Task ToggleStatusAsync(CategoryDto category)
    {
        if (_togglingCategoryIds.Contains(category.Id)) return;

        _togglingCategoryIds.Add(category.Id);
        StateHasChanged();

        try
        {
            var request = new UpdateCategoryRequest
            {
                Name = category.Name,
                Description = category.Description,
                ImageUrl = category.ImageUrl,
                SortOrder = category.SortOrder,
                IsActive = !category.IsActive
            };
            await ApiClient.UpdateCategoryAsync(category.Id, request);
            category.IsActive = !category.IsActive;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggling category status: {ex.Message}");
        }
        finally
        {
            _togglingCategoryIds.Remove(category.Id);
            StateHasChanged();
        }
    }

    // Helper model for UI binding
    public class CategoryFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public int SortOrder { get; set; }
        public bool IsActive { get; set; } = true;
    }
}

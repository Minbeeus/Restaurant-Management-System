@page "/admin/menu-items"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.AdminLayout
@using Restaurant.Application.DTOs
@using Restaurant.Web.Services
@inject MenuApiClient ApiClient

@if (!_isFormOpen)
{
    <!-- ========================================== -->
    <!-- VIEW A: DANH SÁCH MÓN ĂN (TABLE VIEW) -->
    <!-- ========================================== -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
        <div>
            <h2 class="text-2xl font-headline-sm text-primary m-0">Quản Lý Danh Sách Món Ăn</h2>
            <p class="text-xs text-on-surface-variant m-0 mt-1">Cấu hình thực đơn nhà hàng, giá bán, nhóm tùy chọn và trạng thái phục vụ</p>
        </div>
        <div class="flex items-center gap-3">
            <a href="/admin/menu/combos" class="px-4 py-2.5 rounded-xl font-bold text-xs bg-amber-500/10 text-amber-700 hover:bg-amber-500/20 transition-all border border-amber-500/20 flex items-center gap-1.5 shadow-xs">
                <span class="material-symbols-outlined text-base" data-icon="lunch_dining">lunch_dining</span>
                <span>Quản Lý Combo</span>
            </a>
            <button class="bg-primary hover:bg-primary/90 text-on-primary px-5 py-2.5 rounded-xl font-bold text-xs shadow-sm transition-all flex items-center gap-1.5 cursor-pointer active:scale-95" @onclick="OpenAddForm">
                <span class="material-symbols-outlined text-base" data-icon="add_circle">add_circle</span>
                <span>Thêm Món Ăn Mới</span>
            </button>
        </div>
    </div>

    <!-- Thanh tìm kiếm & lọc danh mục -->
    <div class="bg-surface rounded-2xl shadow-sm border border-outline-variant/30 p-4 mb-6 flex flex-col md:flex-row gap-4 justify-between items-center">
        <div class="flex-1 w-full relative">
            <span class="material-symbols-outlined absolute left-3.5 top-2.5 text-on-surface-variant text-[20px]" data-icon="search">search</span>
            <input type="text" @bind="_searchKeyword" @bind:event="oninput"
                   class="w-full pl-10 pr-4 py-2 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary focus:outline-none text-sm transition-colors"
                   placeholder="Tìm món theo tên tiếng Việt hoặc tên tiếng Anh..." />
        </div>
        <div class="w-full md:w-64 shrink-0">
            <select @bind="_filterCategoryId" class="w-full px-3.5 py-2 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary focus:outline-none text-sm font-semibold cursor-pointer">
                <option value="0">Tất cả danh mục (@_categories.Count)</option>
                @foreach (var cat in _categories)
                {
                    <option value="@cat.Id">@cat.DisplayName</option>
                }
            </select>
        </div>
        <div class="w-full md:w-48 shrink-0">
            <select @bind="_filterStatus" class="w-full px-3.5 py-2 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary focus:outline-none text-sm font-semibold cursor-pointer">
                <option value="">Tất cả trạng thái</option>
                <option value="true">Đang phục vụ (Còn món)</option>
                <option value="false">Tạm hết món</option>
            </select>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="flex justify-center p-16">
            <span class="material-symbols-outlined animate-spin text-4xl text-primary" data-icon="progress_activity">progress_activity</span>
        </div>
    }
    else
    {
        <div class="bg-surface rounded-2xl shadow-sm border border-outline-variant/30 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-surface-container/50 border-b border-outline-variant/30 text-xs font-bold text-on-surface-variant uppercase tracking-wider">
                        <tr>
                            <th class="py-4 px-5">Tên Món Ăn</th>
                            <th class="py-4 px-5">Danh Mục</th>
                            <th class="py-4 px-5 text-right w-36">Giá Bán</th>
                            <th class="py-4 px-5 text-center w-28">Loại</th>
                            <th class="py-4 px-5 text-center w-36">Trạng Thái</th>
                            <th class="py-4 px-5 text-right w-36">Hành Động</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant/20 text-sm">
                        @if (!FilteredMenuItems.Any())
                        {
                            <tr>
                                <td colspan="6" class="py-12 text-center text-on-surface-variant">
                                    <span class="material-symbols-outlined text-4xl text-outline-variant mb-2 block" data-icon="restaurant">restaurant</span>
                                    <span>Không tìm thấy món ăn nào phù hợp với bộ lọc.</span>
                                </td>
                            </tr>
                        }
                        @foreach (var item in FilteredMenuItems)
                        {
                            <tr class="hover:bg-surface-container/20 transition-colors">
                                <!-- Tên món & Mô tả -->
                                <td class="py-4 px-5 max-w-xs">
                                    <div class="font-bold text-on-surface text-base">@item.DisplayName</div>
                                    @if (!string.IsNullOrEmpty(item.NameEn))
                                    {
                                        <div class="text-xs text-on-surface-variant/70 italic font-medium">EN: @item.NameEn</div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.DisplayDescription))
                                    {
                                        <div class="text-xs text-on-surface-variant mt-1 line-clamp-1" title="@item.DisplayDescription">
                                            @item.DisplayDescription
                                        </div>
                                    }
                                </td>

                                <!-- Danh mục -->
                                <td class="py-4 px-5 whitespace-nowrap">
                                    <span class="px-3 py-1 bg-primary/10 text-primary rounded-full text-xs font-bold border border-primary/20">
                                        @(_categories.FirstOrDefault(c => c.Id == item.CategoryId)?.DisplayName ?? item.CategoryName)
                                    </span>
                                </td>

                                <!-- Giá bán -->
                                <td class="py-4 px-5 text-right font-mono tabular-nums font-bold text-primary text-base whitespace-nowrap">
                                    @item.Price.ToString("N0") đ
                                </td>

                                <!-- Loại món (Món lẻ / Combo) -->
                                <td class="py-4 px-5 text-center whitespace-nowrap">
                                    @if (item.IsCombo)
                                    {
                                        <Restaurant.Web.Components.UI.Badges.StatusBadge Type="Warning" Text="Combo" Icon="lunch_dining" />
                                    }
                                    else
                                    {
                                        <Restaurant.Web.Components.UI.Badges.StatusBadge Type="Neutral" Text="Món đơn" />
                                    }
                                </td>

                                <!-- Trạng thái còn món / hết món -->
                                <td class="py-4 px-5 text-center whitespace-nowrap">
                                    @if (!item.IsActive)
                                    {
                                        <span class="px-2.5 py-1 bg-slate-100 text-slate-500 rounded-full text-xs font-bold">
                                            Đã ẩn
                                        </span>
                                    }
                                    else
                                    {
                                        <button class="px-3 py-1 rounded-full text-xs font-bold transition-all cursor-pointer inline-flex items-center gap-1.5 shadow-2xs @(item.IsSoldOut ? "bg-red-50 text-red-700 border border-red-200 hover:bg-red-100" : "bg-emerald-50 text-emerald-700 border border-emerald-200 hover:bg-emerald-100")"
                                                disabled="@_togglingItemIds.Contains(item.Id)"
                                                @onclick="() => ToggleQuickSoldOut(item)">
                                            @if (_togglingItemIds.Contains(item.Id))
                                            {
                                                <span class="material-symbols-outlined animate-spin text-xs" data-icon="progress_activity">progress_activity</span>
                                                <span>Đang xử lý...</span>
                                            }
                                            else
                                            {
                                                <span class="w-2 h-2 rounded-full @(item.IsSoldOut ? "bg-red-500" : "bg-emerald-500")"></span>
                                                <span>@(item.IsSoldOut ? "Hết món" : "Còn món")</span>
                                            }
                                        </button>
                                    }
                                </td>

                                <!-- Hành động -->
                                <td class="py-4 px-5 text-right whitespace-nowrap">
                                    <div class="inline-flex items-center gap-1">
                                        <a href="/admin/recipes" class="p-1.5 text-on-surface-variant hover:text-primary hover:bg-primary/10 rounded-lg transition-colors cursor-pointer" title="Cấu hình định lượng BOM">
                                            <span class="material-symbols-outlined text-base" data-icon="receipt_long">receipt_long</span>
                                        </a>
                                        <button class="p-1.5 text-primary hover:bg-primary/10 rounded-lg transition-colors cursor-pointer" title="Chỉnh sửa món" @onclick="() => OpenEditForm(item)">
                                            <span class="material-symbols-outlined text-base" data-icon="edit">edit</span>
                                        </button>
                                        <button class="p-1.5 text-red-500 hover:bg-red-50 rounded-lg transition-colors cursor-pointer" title="Xóa món" @onclick="() => ConfirmDelete(item)">
                                            <span class="material-symbols-outlined text-base" data-icon="delete">delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
else
{
    <!-- ========================================== -->
    <!-- VIEW B: GIAO DIỆN RIÊNG THÊM / SỬA MÓN ĂN -->
    <!-- (To bằng trang nội dung, giữ nguyên thanh nav) -->
    <!-- ========================================== -->
    <div class="mb-6">
        <nav class="flex items-center gap-2 text-xs text-on-surface-variant mb-2">
            <button class="hover:text-primary transition-colors cursor-pointer" @onclick="CloseForm">Danh Sách Món Ăn</button>
            <span>/</span>
            <span class="font-bold text-on-surface">@(_isEditing ? $"Chỉnh Sửa: {_model.Name}" : "Thêm Món Ăn Mới")</span>
        </nav>
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div>
                <h2 class="text-2xl font-headline-sm text-primary m-0">@(_isEditing ? "Cập Nhật Thông Tin Món Ăn" : "Thêm Món Ăn Mới Vào Thực Đơn")</h2>
                <p class="text-on-surface-variant text-sm mt-1">Cấu hình tên gọi, phân loại danh mục, giá bán và các nhóm tùy chọn (modifiers)</p>
            </div>
            <div class="flex items-center gap-3">
                <button type="button" class="px-4 py-2.5 rounded-xl border border-outline-variant/40 text-on-surface hover:bg-surface-container font-semibold text-sm transition-all cursor-pointer"
                        @onclick="CloseForm">
                    Hủy & Quay Lại
                </button>
                <button type="button" class="px-6 py-2.5 rounded-xl bg-primary hover:bg-primary/90 text-on-primary font-bold text-sm shadow-md transition-all cursor-pointer flex items-center gap-2 disabled:opacity-50"
                        disabled="@_isSaving" @onclick="SaveMenuItem">
                    @if (_isSaving)
                    {
                        <span class="material-symbols-outlined animate-spin text-base" data-icon="progress_activity">progress_activity</span>
                        <span>Đang lưu món...</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-base" data-icon="save">save</span>
                        <span>Lưu Thay Đổi</span>
                    }
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="p-4 mb-6 rounded-xl bg-red-50 text-red-700 border border-red-200 text-sm font-medium flex justify-between items-center">
            <span>@_errorMessage</span>
            <button type="button" @onclick="() => _errorMessage = null" class="font-bold">✕</button>
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Cột 1 & 2: Thông tin cơ bản & Giá bán -->
        <div class="bg-surface rounded-2xl p-6 border border-outline-variant/30 shadow-sm space-y-5 lg:col-span-2">
            <div class="flex items-center gap-3 pb-3 border-b border-outline-variant/20">
                <span class="material-symbols-outlined text-primary text-2xl" data-icon="restaurant_menu">restaurant_menu</span>
                <h3 class="font-bold text-lg text-on-surface m-0">Thông Tin Món Ăn</h3>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-on-surface-variant mb-1.5">Tên Món Ăn (Tiếng Việt) <span class="text-red-500">*</span></label>
                    <input type="text" class="w-full px-3.5 py-2.5 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary text-sm font-bold"
                           placeholder="VD: Pizza Hải Sản Pesto" @bind="_model.Name" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-on-surface-variant mb-1.5">Tên Tiếng Anh (English Name)</label>
                    <input type="text" class="w-full px-3.5 py-2.5 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary text-sm font-medium"
                           placeholder="VD: Seafood Pesto Pizza" @bind="_model.NameEn" />
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-on-surface-variant mb-1.5">Thuộc Danh Mục <span class="text-red-500">*</span></label>
                    <select class="w-full px-3.5 py-2.5 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary text-sm font-semibold cursor-pointer"
                            @bind="_model.CategoryId">
                        <option value="0">-- Vui lòng chọn Danh Mục --</option>
                        @foreach (var cat in _categories)
                        {
                            <option value="@cat.Id">@cat.DisplayName</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-on-surface-variant mb-1.5">Giá Bán Niêm Yết (VNĐ) <span class="text-red-500">*</span></label>
                    <div class="relative">
                        <input type="number" step="1000" min="0" class="w-full px-3.5 py-2.5 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary text-sm font-mono font-bold"
                               placeholder="150000" @bind="_model.Price" />
                        <span class="absolute right-3.5 top-2.5 text-xs text-on-surface-variant font-bold">VNĐ</span>
                    </div>
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-on-surface-variant mb-1.5">Mô Tả Thành Phần (Tiếng Việt)</label>
                <textarea rows="2" class="w-full px-3.5 py-2 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary text-sm"
                          placeholder="Mô tả nguyên liệu chính của món ăn..." @bind="_model.Description"></textarea>
            </div>

            <div>
                <label class="block text-xs font-bold text-on-surface-variant mb-1.5">Mô Tả Tiếng Anh (English Description)</label>
                <textarea rows="2" class="w-full px-3.5 py-2 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary text-sm"
                          placeholder="Description in English..." @bind="_model.DescriptionEn"></textarea>
            </div>

            <!-- Modifiers Groups Section -->
            <div class="pt-4 border-t border-outline-variant/20">
                <div class="flex justify-between items-center mb-3">
                    <label class="text-sm font-bold text-on-surface m-0">Nhóm Tùy Chọn Kèm Theo (Modifiers / Topping)</label>
                    <span class="text-xs text-on-surface-variant">Chọn các nhóm cho phép nhân viên order chọn cấu hình</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                    @foreach (var mod in _modifierGroups)
                    {
                        var isChecked = _model.ModifierGroupIds.Contains(mod.Id);
                        <div class="p-3 rounded-xl border transition-all cursor-pointer flex items-center justify-between @(isChecked ? "border-primary bg-primary/5 text-primary font-bold" : "border-outline-variant/30 bg-surface-container/20 text-on-surface")"
                             @onclick="() => ToggleModifier(mod.Id)">
                            <div class="text-xs">
                                <div>@mod.Name</div>
                                <div class="text-[11px] font-normal text-on-surface-variant">@mod.ModifierOptions.Count() lựa chọn</div>
                            </div>
                            <input type="checkbox" checked="@isChecked" class="rounded text-primary focus:ring-primary w-4 h-4 pointer-events-none" />
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Cột 3: Trạng thái phục vụ -->
        <div class="bg-surface rounded-2xl p-6 border border-outline-variant/30 shadow-sm space-y-5 lg:col-span-1">
            <div class="flex items-center gap-3 pb-3 border-b border-outline-variant/20">
                <span class="material-symbols-outlined text-primary text-2xl" data-icon="tune">tune</span>
                <h3 class="font-bold text-lg text-on-surface m-0">Cài Đặt Phục Vụ</h3>
            </div>

            <div class="space-y-3 pt-2">
                <div class="flex items-center gap-3 p-3 bg-surface-container/30 rounded-xl">
                    <input type="checkbox" id="chkCombo" class="rounded text-primary focus:ring-primary w-4 h-4 cursor-pointer"
                           @bind="_model.IsCombo" />
                    <label for="chkCombo" class="text-sm font-semibold text-on-surface cursor-pointer select-none">
                        Món này là Combo trọn gói
                    </label>
                </div>

                @if (_isEditing)
                {
                    <div class="flex items-center gap-3 p-3 bg-surface-container/30 rounded-xl">
                        <input type="checkbox" id="chkSoldOut" class="rounded text-red-600 focus:ring-red-500 w-4 h-4 cursor-pointer"
                               @bind="_model.IsSoldOut" />
                        <label for="chkSoldOut" class="text-sm font-semibold text-red-600 cursor-pointer select-none">
                            Đánh dấu tạm hết hàng (Sold out)
                        </label>
                    </div>

                    <div class="flex items-center gap-3 p-3 bg-surface-container/30 rounded-xl">
                        <input type="checkbox" id="chkActive" class="rounded text-primary focus:ring-primary w-4 h-4 cursor-pointer"
                               @bind="_model.IsActive" />
                        <label for="chkActive" class="text-sm font-semibold text-on-surface cursor-pointer select-none">
                            Hiển thị trên thực đơn POS & Menu
                        </label>
                    </div>
                }

                <div>
                    <label class="block text-xs font-bold text-on-surface-variant mb-1.5">Thứ Tự Sắp Xếp</label>
                    <input type="number" class="w-32 px-3 py-2 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary text-sm font-bold"
                           @bind="_model.SortOrder" />
                </div>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal (kept minimal for safety) -->
@if (_showDeleteConfirm)
{
    <div class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-surface rounded-2xl shadow-xl w-full max-w-sm p-6 text-center border border-outline-variant/30">
            <div class="w-14 h-14 rounded-full bg-red-100 text-red-600 mx-auto flex items-center justify-center mb-4">
                <span class="material-symbols-outlined text-3xl" data-icon="delete">delete</span>
            </div>
            <h3 class="text-lg font-bold text-on-surface mb-2">Xác Nhận Xóa Món Ăn</h3>
            <p class="text-on-surface-variant text-sm mb-6">Bạn có chắc chắn muốn xóa món <strong>@_itemToDelete?.Name</strong> khỏi thực đơn?</p>
            <div class="flex justify-center gap-3">
                <button type="button" class="px-4 py-2 border border-outline-variant/40 text-on-surface rounded-xl hover:bg-surface-container font-bold text-sm flex-1 cursor-pointer"
                        @onclick="() => _showDeleteConfirm = false">Hủy</button>
                <button type="button" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-xl font-bold text-sm flex-1 cursor-pointer"
                        @onclick="ExecuteDelete">Xóa Món</button>
            </div>
        </div>
    </div>
}

@code {
    private List<MenuItemDto> _menuItems = new();
    private List<CategoryDto> _categories = new();
    private List<ModifierGroupDto> _modifierGroups = new();
    
    private bool _isLoading = true;
    private string _searchKeyword = "";
    private int _filterCategoryId = 0;
    private bool? _filterStatus = null;
    private HashSet<int> _togglingItemIds = new();

    private IEnumerable<MenuItemDto> FilteredMenuItems => _menuItems
        .Where(m => string.IsNullOrWhiteSpace(_searchKeyword) 
                 || m.Name.Contains(_searchKeyword, StringComparison.OrdinalIgnoreCase)
                 || (m.NameEn != null && m.NameEn.Contains(_searchKeyword, StringComparison.OrdinalIgnoreCase)))
        .Where(m => _filterCategoryId == 0 || m.CategoryId == _filterCategoryId)
        .Where(m => _filterStatus == null || (_filterStatus == true ? !m.IsSoldOut : m.IsSoldOut));

    // Full-page form state
    private bool _isFormOpen = false;
    private bool _isEditing = false;
    private bool _isSaving = false;
    private string? _errorMessage;
    private int _editingId;

    // Delete state
    private bool _showDeleteConfirm = false;
    private MenuItemDto? _itemToDelete;

    // Form Model
    private MenuItemFormModel _model = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            var taskMenuItems = ApiClient.GetMenuItemsAsync();
            var taskCategories = ApiClient.GetCategoriesAsync();
            var taskModifiers = ApiClient.GetModifierGroupsAsync();

            await Task.WhenAll(taskMenuItems, taskCategories, taskModifiers);

            _menuItems = taskMenuItems.Result;
            _categories = taskCategories.Result.Where(c => c.IsActive).OrderBy(c => c.SortOrder).ToList();
            _modifierGroups = taskModifiers.Result;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading menu items: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenAddForm()
    {
        _isEditing = false;
        _model = new MenuItemFormModel { IsActive = true, SortOrder = _menuItems.Count + 1 };
        _errorMessage = null;
        _isFormOpen = true;
    }

    private void OpenEditForm(MenuItemDto item)
    {
        _isEditing = true;
        _editingId = item.Id;
        _model = new MenuItemFormModel
        {
            CategoryId = item.CategoryId,
            Name = item.Name,
            NameEn = item.NameEn,
            Description = item.Description,
            DescriptionEn = item.DescriptionEn,
            Price = item.Price,
            ImageUrl = item.ImageUrl,
            IsCombo = item.IsCombo,
            IsSoldOut = item.IsSoldOut,
            IsActive = item.IsActive,
            SortOrder = item.SortOrder,
            ModifierGroupIds = item.ModifierGroups.Select(m => m.Id).ToList()
        };
        _errorMessage = null;
        _isFormOpen = true;
    }

    private void CloseForm()
    {
        _isFormOpen = false;
    }

    private void ToggleModifier(int modifierGroupId)
    {
        if (_model.ModifierGroupIds.Contains(modifierGroupId))
        {
            _model.ModifierGroupIds.Remove(modifierGroupId);
        }
        else
        {
            _model.ModifierGroupIds.Add(modifierGroupId);
        }
    }

    private async Task SaveMenuItem()
    {
        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            _errorMessage = "Tên món ăn không được để trống.";
            return;
        }
        if (_model.CategoryId <= 0)
        {
            _errorMessage = "Vui lòng chọn danh mục cho món ăn.";
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            if (_isEditing)
            {
                var request = new UpdateMenuItemRequest
                {
                    CategoryId = _model.CategoryId,
                    Name = _model.Name,
                    NameEn = _model.NameEn,
                    Description = _model.Description,
                    DescriptionEn = _model.DescriptionEn,
                    Price = _model.Price,
                    ImageUrl = _model.ImageUrl,
                    IsCombo = _model.IsCombo,
                    SortOrder = _model.SortOrder,
                    ModifierGroupIds = _model.ModifierGroupIds,
                    IsSoldOut = _model.IsSoldOut,
                    IsActive = _model.IsActive
                };
                await ApiClient.UpdateMenuItemAsync(_editingId, request);
            }
            else
            {
                var request = new CreateMenuItemRequest
                {
                    CategoryId = _model.CategoryId,
                    Name = _model.Name,
                    NameEn = _model.NameEn,
                    Description = _model.Description,
                    DescriptionEn = _model.DescriptionEn,
                    Price = _model.Price,
                    ImageUrl = _model.ImageUrl,
                    IsCombo = _model.IsCombo,
                    SortOrder = _model.SortOrder,
                    ModifierGroupIds = _model.ModifierGroupIds
                };
                await ApiClient.CreateMenuItemAsync(request);
            }

            _isFormOpen = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Lỗi khi lưu món ăn: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ConfirmDelete(MenuItemDto item)
    {
        _itemToDelete = item;
        _showDeleteConfirm = true;
    }

    private async Task ExecuteDelete()
    {
        if (_itemToDelete != null)
        {
            await ApiClient.DeleteMenuItemAsync(_itemToDelete.Id);
            _showDeleteConfirm = false;
            await LoadData();
        }
    }

    private async Task ToggleQuickSoldOut(MenuItemDto item)
    {
        if (_togglingItemIds.Contains(item.Id)) return;
        
        _togglingItemIds.Add(item.Id);
        StateHasChanged();

        try
        {
            await ApiClient.ToggleSoldOutAsync(item.Id);
            item.IsSoldOut = !item.IsSoldOut;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggling sold out: {ex.Message}");
        }
        finally
        {
            _togglingItemIds.Remove(item.Id);
            StateHasChanged();
        }
    }

    public class MenuItemFormModel
    {
        public int CategoryId { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? NameEn { get; set; }
        public string? Description { get; set; }
        public string? DescriptionEn { get; set; }
        public decimal Price { get; set; }
        public string? ImageUrl { get; set; }
        public bool IsCombo { get; set; }
        public bool IsSoldOut { get; set; }
        public bool IsActive { get; set; } = true;
        public int SortOrder { get; set; }
        public List<int> ModifierGroupIds { get; set; } = new();
    }
}

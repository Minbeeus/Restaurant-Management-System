@page "/admin/menu-items"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.AdminLayout
@using Restaurant.Application.DTOs
@using Restaurant.Web.Services
@inject MenuApiClient ApiClient

<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
    <h2 class="text-2xl font-headline-sm text-primary">Danh sách Món ăn (Menu Items)</h2>
    <button class="bg-primary text-on-primary px-4 py-2 rounded font-label-bold shadow-sm hover:bg-primary/90 transition-colors whitespace-nowrap" @onclick="OpenAddModal">
        <span class="material-symbols-outlined align-middle text-sm mr-1" data-icon="add">add</span> Thêm Món ăn
    </button>
</div>

<!-- Toolbar Lọc & Tìm Kiếm -->
<div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-4 mb-6 flex flex-col md:flex-row gap-4">
    <div class="flex-1 relative">
        <span class="material-symbols-outlined absolute left-3 top-2.5 text-on-surface-variant text-[20px]" data-icon="search">search</span>
        <InputText @bind-Value="_searchKeyword" @bind-Value:event="oninput" class="w-full pl-10 pr-4 py-2 border border-outline rounded bg-surface focus:outline-none focus:border-primary transition-colors" placeholder="Tìm kiếm theo Tên món ăn..." />
    </div>
    <div class="w-full md:w-64 shrink-0">
        <select @bind="_filterCategoryId" class="w-full px-4 py-2 border border-outline rounded bg-surface focus:outline-none focus:border-primary transition-colors cursor-pointer">
            <option value="0">Tất cả danh mục</option>
            @foreach (var cat in _categories)
            {
                <option value="@cat.Id">@cat.Name</option>
            }
        </select>
    </div>
    <div class="w-full md:w-48 shrink-0">
        <select @bind="_filterStatus" class="w-full px-4 py-2 border border-outline rounded bg-surface focus:outline-none focus:border-primary transition-colors cursor-pointer">
            <option value="">Tất cả trạng thái</option>
            <option value="true">Còn hàng (Đang bán)</option>
            <option value="false">Hết hàng (Sold Out)</option>
        </select>
    </div>
</div>

@if (_isLoading)
{
    <div class="flex justify-center p-12">
        <span class="material-symbols-outlined animate-spin text-4xl text-primary" data-icon="progress_activity">progress_activity</span>
    </div>
}
else
{
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead class="bg-surface-container-low border-b border-outline-variant/30 text-on-surface-variant font-label-bold">
                <tr>
                    <th class="p-4 font-semibold text-center w-16">Hình</th>
                    <th class="p-4 font-semibold">Tên Món</th>
                    <th class="p-4 font-semibold">Danh mục</th>
                    <th class="p-4 font-semibold text-right">Giá bán</th>
                    <th class="p-4 font-semibold text-center w-28">Loại</th>
                    <th class="p-4 font-semibold text-center w-28">Trạng thái</th>
                    <th class="p-4 font-semibold text-center w-32">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (!FilteredMenuItems.Any())
                {
                    <tr>
                        <td colspan="7" class="p-8 text-center text-on-surface-variant">Không tìm thấy món ăn nào phù hợp với bộ lọc.</td>
                    </tr>
                }
                @foreach (var item in FilteredMenuItems)
                {
                    <tr class="border-b border-outline-variant/20 last:border-0 hover:bg-surface-low/50 transition-colors">
                        <td class="p-4">
                            <div class="w-12 h-12 bg-surface-low rounded flex items-center justify-center text-on-surface-variant overflow-hidden mx-auto border border-outline-variant/30">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" class="w-full h-full object-cover" onerror="this.style.display='none'" />
                                }
                                else
                                {
                                    <span class="material-symbols-outlined" data-icon="image">image</span>
                                }
                            </div>
                        </td>
                        <td class="p-4">
                            <div class="font-label-bold text-on-background text-base">@item.Name</div>
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <div class="text-sm text-on-surface-variant line-clamp-1" title="@item.Description">@item.Description</div>
                            }
                        </td>
                        <td class="p-4 text-on-surface-variant">
                            <span class="px-2 py-1 bg-surface-container rounded text-sm">@item.CategoryName</span>
                        </td>
                        <td class="p-4 text-right font-label-bold text-primary">@item.Price.ToString("N0") đ</td>
                        <td class="p-4 text-center">
                            @if (item.IsCombo)
                            {
                                <span class="px-2 py-1 bg-secondary-container/30 text-secondary rounded text-xs font-bold border border-secondary/20">Combo</span>
                            }
                            else
                            {
                                <span class="px-2 py-1 bg-surface-variant/30 text-on-surface-variant rounded text-xs font-bold border border-outline-variant/30">Đơn món</span>
                            }
                        </td>
                        <td class="p-4 text-center">
                            @if (!item.IsActive)
                            {
                                <div class="px-2 py-0.5 bg-on-surface-variant/10 text-on-surface-variant rounded text-[10px] font-bold border border-on-surface-variant/20 inline-block">Tạm ẩn</div>
                            }
                            else
                            {
                                <button class="relative inline-flex items-center justify-center px-3 py-1.5 rounded-full text-xs font-bold transition-all disabled:opacity-50 @(item.IsSoldOut ? "bg-surface-variant/50 text-on-surface-variant border border-outline-variant/50 hover:bg-surface-variant" : "bg-primary text-on-primary shadow-sm hover:bg-primary/90")" 
                                        disabled="@_togglingItemIds.Contains(item.Id)"
                                        @onclick="() => ToggleQuickSoldOut(item)">
                                    @if (_togglingItemIds.Contains(item.Id))
                                    {
                                        <span class="material-symbols-outlined animate-spin text-[14px] mr-1" data-icon="progress_activity">progress_activity</span>
                                        <span>Đang xử lý...</span>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined text-[14px] mr-1" data-icon="@(item.IsSoldOut ? "block" : "check_circle")">@(item.IsSoldOut ? "block" : "check_circle")</span>
                                        <span>@(item.IsSoldOut ? "Hết món" : "Còn món")</span>
                                    }
                                </button>
                            }
                        </td>
                        <td class="p-4 text-center space-x-1">
                            <button class="text-primary hover:bg-primary-container p-2 rounded-full transition-colors" title="Sửa" @onclick="() => OpenEditModal(item)">
                                <span class="material-symbols-outlined text-sm" data-icon="edit">edit</span>
                            </button>
                            <button class="text-error hover:bg-error-container p-2 rounded-full transition-colors" title="Xóa" @onclick="() => ConfirmDelete(item)">
                                <span class="material-symbols-outlined text-sm" data-icon="delete">delete</span>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Modal Add/Edit -->
@if (_showModal)
{
    <div class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-surface-container-lowest rounded-xl shadow-lg w-full max-w-2xl max-h-[90vh] flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-200">
            <div class="px-6 py-4 border-b border-outline-variant/30 flex justify-between items-center bg-surface-container-low shrink-0">
                <h3 class="font-headline-sm text-on-background m-0">@(_isEditing ? "Cập nhật Món ăn" : "Thêm Món ăn mới")</h3>
                <button class="text-on-surface-variant hover:text-error transition-colors" @onclick="CloseModal">
                    <span class="material-symbols-outlined" data-icon="close">close</span>
                </button>
            </div>
            
            <div class="p-6 overflow-y-auto flex-1">
                <EditForm Model="@_model" OnValidSubmit="SaveMenuItem">
                    <DataAnnotationsValidator />
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Left Column -->
                        <div class="space-y-4">
                            <div>
                                <label class="block text-sm font-label-bold text-on-surface mb-1">Tên món <span class="text-error">*</span></label>
                                <InputText @bind-Value="_model.Name" class="w-full px-3 py-2 border border-outline rounded bg-surface-container-lowest focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-shadow" placeholder="Tên món ăn" />
                            </div>

                            <div>
                                <label class="block text-sm font-label-bold text-on-surface mb-1">Danh mục <span class="text-error">*</span></label>
                                <InputSelect @bind-Value="_model.CategoryId" TValue="int" class="w-full px-3 py-2 border border-outline rounded bg-surface-container-lowest focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-shadow">
                                    <option value="0">-- Chọn danh mục --</option>
                                    @foreach (var cat in _categories)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                </InputSelect>
                            </div>

                            <div>
                                <label class="block text-sm font-label-bold text-on-surface mb-1">Giá bán (VNĐ) <span class="text-error">*</span></label>
                                <InputNumber @bind-Value="_model.Price" class="w-full px-3 py-2 border border-outline rounded bg-surface-container-lowest focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-shadow" />
                            </div>

                            <div>
                                <label class="block text-sm font-label-bold text-on-surface mb-1">Mô tả chi tiết</label>
                                <InputTextArea @bind-Value="_model.Description" class="w-full px-3 py-2 border border-outline rounded bg-surface-container-lowest focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-shadow resize-none" rows="3" />
                            </div>
                        </div>

                        <!-- Right Column -->
                        <div class="space-y-4">
                            <div>
                                <label class="block text-sm font-label-bold text-on-surface mb-1">URL Hình ảnh</label>
                                <InputText @bind-Value="_model.ImageUrl" class="w-full px-3 py-2 border border-outline rounded bg-surface-container-lowest focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-shadow" placeholder="https://..." />
                                @if (!string.IsNullOrEmpty(_model.ImageUrl))
                                {
                                    <div class="mt-2 text-center h-24 bg-surface-low rounded border border-outline-variant/30 p-1">
                                        <img src="@_model.ImageUrl" class="h-full object-contain mx-auto" onerror="this.style.display='none'" />
                                    </div>
                                }
                            </div>

                            <div class="bg-surface-container p-4 rounded-lg border border-outline-variant/30 space-y-3">
                                <div>
                                    <label class="block text-sm font-label-bold text-on-surface mb-2">Trạng thái món</label>
                                    <div class="flex gap-4">
                                        <label class="flex items-center cursor-pointer">
                                            <InputCheckbox @bind-Value="_model.IsCombo" class="w-4 h-4 text-secondary bg-surface-container border-outline rounded" />
                                            <span class="ml-2 text-sm">Đây là Combo</span>
                                        </label>
                                    </div>
                                </div>
                                
                                @if (_isEditing)
                                {
                                    <div class="flex flex-col gap-2 pt-2 border-t border-outline-variant/30">
                                        <label class="flex items-center cursor-pointer">
                                            <InputCheckbox @bind-Value="_model.IsSoldOut" class="w-4 h-4 text-error bg-surface-container border-outline rounded" />
                                            <span class="ml-2 text-sm text-error font-bold">Báo hết hàng (Sold Out)</span>
                                        </label>
                                        <label class="flex items-center cursor-pointer">
                                            <InputCheckbox @bind-Value="_model.IsActive" class="w-4 h-4 text-primary bg-surface-container border-outline rounded" />
                                            <span class="ml-2 text-sm">Đang hoạt động (Hiển thị)</span>
                                        </label>
                                    </div>
                                }
                            </div>
                            
                            <div>
                                <label class="block text-sm font-label-bold text-on-surface mb-2">Thứ tự hiển thị</label>
                                <InputNumber @bind-Value="_model.SortOrder" class="w-24 px-3 py-1.5 border border-outline rounded bg-surface-container-lowest focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-shadow" />
                            </div>
                        </div>
                    </div>

                    <!-- Modifiers Section -->
                    <div class="mt-6 pt-4 border-t border-outline-variant/30">
                        <label class="block text-sm font-label-bold text-on-surface mb-3">Tùy chọn & Topping (Modifiers)</label>
                        @if (_modifierGroups.Any())
                        {
                            <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                                @foreach (var mod in _modifierGroups)
                                {
                                    var isChecked = _model.ModifierGroupIds.Contains(mod.Id);
                                    <div class="flex items-start p-2 rounded border @(isChecked ? "border-primary bg-primary-container/10" : "border-outline-variant/30 bg-surface-container-lowest") cursor-pointer transition-colors" @onclick="() => ToggleModifier(mod.Id)">
                                        <input type="checkbox" checked="@isChecked" class="mt-1 w-4 h-4 text-primary rounded" />
                                        <div class="ml-2">
                                            <div class="text-sm font-bold text-on-surface">@mod.Name</div>
                                            <div class="text-xs text-on-surface-variant">@mod.ModifierOptions.Count() tùy chọn</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-sm text-on-surface-variant italic">Chưa có Modifier Group nào. Vui lòng tạo trong phần "Tùy chọn & Topping".</p>
                        }
                    </div>
                    
                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="mt-4 p-3 bg-error-container text-on-error-container rounded text-sm border border-error/20">
                            @_errorMessage
                        </div>
                    }

                    <div class="flex justify-end gap-3 mt-8">
                        <button type="button" class="px-4 py-2 text-on-surface-variant hover:bg-surface-low rounded transition-colors font-label-bold" @onclick="CloseModal">Hủy</button>
                        <button type="submit" class="px-4 py-2 bg-primary text-on-primary rounded shadow-sm hover:bg-primary/90 transition-colors font-label-bold flex items-center" disabled="@_isSaving">
                            @if (_isSaving)
                            {
                                <span class="material-symbols-outlined animate-spin text-sm mr-2" data-icon="progress_activity">progress_activity</span>
                                <span>Đang lưu...</span>
                            }
                            else
                            {
                                <span>Lưu thay đổi</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation -->
@if (_showDeleteConfirm)
{
    <div class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-surface-container-lowest rounded-xl shadow-lg w-full max-w-sm overflow-hidden">
            <div class="p-6 text-center">
                <div class="w-16 h-16 rounded-full bg-error-container text-error mx-auto flex items-center justify-center mb-4">
                    <span class="material-symbols-outlined text-3xl" data-icon="warning">warning</span>
                </div>
                <h3 class="text-xl font-bold text-on-background mb-2">Xác nhận xóa?</h3>
                <p class="text-on-surface-variant text-sm mb-6">Bạn có chắc chắn muốn xóa món <strong>@_itemToDelete?.Name</strong> không? Hành động này không thể hoàn tác.</p>
                
                <div class="flex justify-center gap-3">
                    <button class="px-4 py-2 border border-outline text-on-surface rounded hover:bg-surface-low transition-colors font-label-bold flex-1" @onclick="() => _showDeleteConfirm = false">Hủy</button>
                    <button class="px-4 py-2 bg-error text-white rounded hover:bg-error/90 transition-colors font-label-bold flex-1" @onclick="ExecuteDelete">Xóa ngay</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<MenuItemDto> _menuItems = new();
    private List<CategoryDto> _categories = new();
    private List<ModifierGroupDto> _modifierGroups = new();
    
    private bool _isLoading = true;
    
    // Filter & Search states
    private string _searchKeyword = "";
    private int _filterCategoryId = 0;
    private bool? _filterStatus = null;
    
    // Quick Toggle State
    private HashSet<int> _togglingItemIds = new();

    private IEnumerable<MenuItemDto> FilteredMenuItems => _menuItems
        .Where(m => string.IsNullOrWhiteSpace(_searchKeyword) 
                 || m.Name.Contains(_searchKeyword, StringComparison.OrdinalIgnoreCase))
        .Where(m => _filterCategoryId == 0 || m.CategoryId == _filterCategoryId)
        .Where(m => _filterStatus == null || (_filterStatus == true ? !m.IsSoldOut : m.IsSoldOut));
    
    // Modal state
    private bool _showModal = false;
    private bool _isEditing = false;
    private bool _isSaving = false;
    private string? _errorMessage;
    private int _editingId;

    // Delete state
    private bool _showDeleteConfirm = false;
    private MenuItemDto? _itemToDelete;

    // Form Model
    private MenuItemFormModel _model = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            var taskMenuItems = ApiClient.GetMenuItemsAsync();
            var taskCategories = ApiClient.GetCategoriesAsync();
            var taskModifiers = ApiClient.GetModifierGroupsAsync();

            await Task.WhenAll(taskMenuItems, taskCategories, taskModifiers);

            _menuItems = taskMenuItems.Result;
            _categories = taskCategories.Result.Where(c => c.IsActive).OrderBy(c => c.SortOrder).ToList();
            _modifierGroups = taskModifiers.Result;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading menu items: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenAddModal()
    {
        _isEditing = false;
        _model = new MenuItemFormModel { IsActive = true, SortOrder = 1 };
        _errorMessage = null;
        _showModal = true;
    }

    private void OpenEditModal(MenuItemDto item)
    {
        _isEditing = true;
        _editingId = item.Id;
        _model = new MenuItemFormModel
        {
            CategoryId = item.CategoryId,
            Name = item.Name,
            Description = item.Description,
            Price = item.Price,
            ImageUrl = item.ImageUrl,
            IsCombo = item.IsCombo,
            IsSoldOut = item.IsSoldOut,
            IsActive = item.IsActive,
            SortOrder = item.SortOrder,
            ModifierGroupIds = item.ModifierGroups.Select(m => m.Id).ToList()
        };
        _errorMessage = null;
        _showModal = true;
    }

    private void CloseModal()
    {
        _showModal = false;
    }

    private void ToggleModifier(int modifierGroupId)
    {
        if (_model.ModifierGroupIds.Contains(modifierGroupId))
        {
            _model.ModifierGroupIds.Remove(modifierGroupId);
        }
        else
        {
            _model.ModifierGroupIds.Add(modifierGroupId);
        }
    }

    private async Task SaveMenuItem()
    {
        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            _errorMessage = "Tên món ăn không được để trống.";
            return;
        }
        if (_model.CategoryId <= 0)
        {
            _errorMessage = "Vui lòng chọn danh mục.";
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            if (_isEditing)
            {
                var request = new UpdateMenuItemRequest
                {
                    CategoryId = _model.CategoryId,
                    Name = _model.Name,
                    Description = _model.Description,
                    Price = _model.Price,
                    ImageUrl = _model.ImageUrl,
                    IsCombo = _model.IsCombo,
                    SortOrder = _model.SortOrder,
                    ModifierGroupIds = _model.ModifierGroupIds,
                    IsSoldOut = _model.IsSoldOut,
                    IsActive = _model.IsActive
                };
                await ApiClient.UpdateMenuItemAsync(_editingId, request);
            }
            else
            {
                var request = new CreateMenuItemRequest
                {
                    CategoryId = _model.CategoryId,
                    Name = _model.Name,
                    Description = _model.Description,
                    Price = _model.Price,
                    ImageUrl = _model.ImageUrl,
                    IsCombo = _model.IsCombo,
                    SortOrder = _model.SortOrder,
                    ModifierGroupIds = _model.ModifierGroupIds
                };
                await ApiClient.CreateMenuItemAsync(request);
            }

            _showModal = false;
            await LoadData();
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = "Lỗi khi lưu dữ liệu. Vui lòng kiểm tra lại.";
            Console.WriteLine(ex);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ConfirmDelete(MenuItemDto item)
    {
        _itemToDelete = item;
        _showDeleteConfirm = true;
    }

    private async Task ExecuteDelete()
    {
        if (_itemToDelete != null)
        {
            await ApiClient.DeleteMenuItemAsync(_itemToDelete.Id);
            _showDeleteConfirm = false;
            await LoadData();
        }
    }

    private async Task ToggleQuickSoldOut(MenuItemDto item)
    {
        if (_togglingItemIds.Contains(item.Id)) return;
        
        _togglingItemIds.Add(item.Id);
        StateHasChanged();

        try
        {
            // Call the PATCH endpoint to toggle sold-out status
            await ApiClient.ToggleSoldOutAsync(item.Id);
            
            // Update UI state directly without full reload
            item.IsSoldOut = !item.IsSoldOut;
            
            // Note: In a real app we might want to trigger a Toast notification here
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggling sold out status: {ex.Message}");
        }
        finally
        {
            _togglingItemIds.Remove(item.Id);
            StateHasChanged();
        }
    }

    // Helper model for UI binding
    public class MenuItemFormModel
    {
        public int CategoryId { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public decimal Price { get; set; }
        public string? ImageUrl { get; set; }
        public bool IsCombo { get; set; }
        public bool IsSoldOut { get; set; }
        public bool IsActive { get; set; } = true;
        public int SortOrder { get; set; }
        public List<int> ModifierGroupIds { get; set; } = new();
    }
}

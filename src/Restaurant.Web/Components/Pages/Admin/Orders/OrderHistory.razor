@page "/admin/orders"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.AdminLayout
@using Restaurant.Application.DTOs
@using Restaurant.Web.Services
@inject AdminApiClient ApiClient

<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
    <div>
        <h2 class="text-2xl font-headline-sm text-primary m-0">@L["Order_History_Title"]</h2>
        <p class="text-on-surface-variant text-sm mt-1">@L["Order_Sub"]</p>
    </div>
</div>

<!-- Toolbar Lọc & Tìm kiếm Đơn hàng -->
<div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-4 mb-6 flex flex-col md:flex-row gap-4">
    <div class="flex-1 relative">
        <span class="material-symbols-outlined absolute left-3 top-2.5 text-on-surface-variant text-sm" data-icon="search">search</span>
        <input type="text" @bind="_searchKeyword" @bind:event="oninput" class="w-full pl-9 pr-4 py-2 border border-outline rounded bg-surface focus:outline-none focus:border-primary text-sm" placeholder="@L["Order_Search_Placeholder"]" />
    </div>
    
    <div class="w-full md:w-48 shrink-0">
        <select @bind="_filterStatus" class="w-full px-3 py-2 border border-outline rounded bg-surface text-sm focus:outline-none focus:border-primary cursor-pointer">
            <option value="">@L["MenuItem_Filter_All_Status"]</option>
            <option value="Paid">@L["Order_Status_Paid"]</option>
            <option value="Completed">@L["Order_Status_Completed"]</option>
            <option value="Confirmed">@L["Order_Status_Confirmed"]</option>
            <option value="Cancelled">@L["Order_Status_Cancelled"]</option>
        </select>
    </div>
</div>

@if (_isLoading)
{
    <div class="flex justify-center p-12">
        <span class="material-symbols-outlined animate-spin text-4xl text-primary" data-icon="progress_activity">progress_activity</span>
    </div>
}
else
{
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead class="bg-surface-container-low border-b border-outline-variant/30 text-on-surface-variant font-label-bold text-xs uppercase">
                <tr>
                    <th class="p-4">@L["Order_Col_Code"]</th>
                    <th class="p-4">@L["Order_Col_Location"]</th>
                    <th class="p-4 text-center">@L["Order_Col_Time"]</th>
                    <th class="p-4 text-right">@L["Order_Col_Total"]</th>
                    <th class="p-4 text-center">@L["Order_Col_Status"]</th>
                    <th class="p-4 text-center">@L["Order_Col_Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (!FilteredOrders.Any())
                {
                    <tr>
                        <td colspan="6" class="p-8 text-center text-on-surface-variant">@L["Order_No_Orders"]</td>
                    </tr>
                }
                @foreach (var order in FilteredOrders)
                {
                    <tr class="border-b border-outline-variant/20 last:border-0 hover:bg-surface-low/50 transition-colors">
                        <td class="p-4 font-mono font-bold text-primary">@order.OrderCode</td>
                        <td class="p-4">
                            <div class="font-bold text-on-surface">@order.TableName</div>
                            <div class="text-xs text-on-surface-variant">@order.TableAreaName • @(order.OrderType == "DineIn" ? L["Order_DineIn"] : L["Order_Takeaway"])</div>
                        </td>
                        <td class="p-4 text-center text-sm text-on-surface-variant font-mono">@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="p-4 text-right font-mono font-bold text-base text-primary">@order.TotalAmount.ToString("N0")đ</td>
                        <td class="p-4 text-center">
                            @if (order.Status == "Paid")
                            {
                                <span class="px-2.5 py-1 bg-success-green/10 text-success-green rounded-full text-xs font-bold border border-success-green/20">@L["Order_Status_Paid"]</span>
                            }
                            else if (order.Status == "Completed")
                            {
                                <span class="px-2.5 py-1 bg-secondary-container/40 text-secondary rounded-full text-xs font-bold border border-secondary/20">@L["Order_Badge_KitchenDone"]</span>
                            }
                            else if (order.Status == "Cancelled")
                            {
                                <span class="px-2.5 py-1 bg-error-container text-error rounded-full text-xs font-bold border border-error/20">@L["Order_Status_Cancelled"]</span>
                            }
                            else
                            {
                                <span class="px-2.5 py-1 bg-surface-variant text-on-surface-variant rounded-full text-xs font-bold">@order.Status</span>
                            }
                        </td>
                        <td class="p-4 text-center">
                            <button class="px-3 py-1.5 bg-primary-container text-on-primary-container rounded text-xs font-bold hover:bg-primary/20 transition-colors" @onclick="() => ViewOrderDetails(order)">
                                @L["Order_Details_Btn"]
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Modal Order Details -->
@if (_showDetailsModal && _selectedOrder != null)
{
    <div class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-surface-container-lowest rounded-xl shadow-lg w-full max-w-lg overflow-hidden">
            <div class="px-6 py-4 border-b border-outline-variant/30 flex justify-between items-center bg-surface-container-low">
                <div>
                    <h3 class="font-bold text-on-background m-0">@string.Format(L["Order_Details_Title"], _selectedOrder.OrderCode)</h3>
                    <p class="text-xs text-on-surface-variant mt-0.5">@_selectedOrder.TableName (@_selectedOrder.TableAreaName)</p>
                </div>
                <button class="text-on-surface-variant hover:text-error" @onclick="CloseDetailsModal">
                    <span class="material-symbols-outlined" data-icon="close">close</span>
                </button>
            </div>

            <div class="p-6 space-y-4">
                <div class="bg-surface-low p-3 rounded border border-outline-variant/30 space-y-2 text-sm">
                    <div class="flex justify-between"><span class="text-on-surface-variant">@L["Order_Subtotal_Label"]</span><span class="font-mono font-bold">@_selectedOrder.SubTotal.ToString("N0")đ</span></div>
                    <div class="flex justify-between"><span class="text-on-surface-variant">@L["Order_Discount_Label"]</span><span class="font-mono text-error">-0đ</span></div>
                    <div class="flex justify-between pt-2 border-t border-outline-variant/30 font-bold text-base"><span class="text-on-surface">@L["Order_Total_Label"]</span><span class="font-mono text-primary">@_selectedOrder.TotalAmount.ToString("N0")đ</span></div>
                </div>

                <div class="text-xs text-on-surface-variant">
                    @L["Order_Audit_Note"]
                </div>
            </div>

            <div class="px-6 py-4 border-t border-outline-variant/30 flex justify-end gap-2 bg-surface-container-low">
                <button class="px-4 py-2 border border-outline text-on-surface rounded text-sm font-bold hover:bg-surface-low" @onclick="CloseDetailsModal">@L["Common_Close"]</button>
                <button class="px-4 py-2 bg-primary text-on-primary rounded text-sm font-bold shadow-sm hover:bg-primary/90 flex items-center" @onclick="PrintInvoice">
                    <span class="material-symbols-outlined text-sm mr-1" data-icon="print">print</span> @L["Order_Print_Invoice"]
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<OrderDto> _orders = new();
    private bool _isLoading = true;
    private string _searchKeyword = "";
    private string _filterStatus = "";

    private OrderDto? _selectedOrder;
    private bool _showDetailsModal = false;

    private IEnumerable<OrderDto> FilteredOrders => _orders
        .Where(o => string.IsNullOrWhiteSpace(_searchKeyword) 
                 || o.OrderCode.Contains(_searchKeyword, StringComparison.OrdinalIgnoreCase)
                 || o.TableName.Contains(_searchKeyword, StringComparison.OrdinalIgnoreCase))
        .Where(o => string.IsNullOrWhiteSpace(_filterStatus) || o.Status == _filterStatus);

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            _orders = await ApiClient.GetOrderHistoryAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ViewOrderDetails(OrderDto order)
    {
        _selectedOrder = order;
        _showDetailsModal = true;
    }

    private void CloseDetailsModal() => _showDetailsModal = false;

    private void PrintInvoice()
    {
        // Print action handler
    }
}

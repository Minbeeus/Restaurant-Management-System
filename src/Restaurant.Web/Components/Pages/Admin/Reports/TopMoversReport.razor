@page "/admin/reports/top-movers"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.AdminLayout

<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
    <div>
        <h2 class="text-2xl font-headline-sm text-primary m-0">Báo cáo Hiệu suất Sản phẩm (Top Movers)</h2>
        <p class="text-on-surface-variant text-sm mt-1">Thống kê các món ăn bán chạy nhất và tỷ trọng đóng góp doanh thu sản phẩm.</p>
    </div>
</div>

<div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden">
    <table class="w-full text-left border-collapse">
        <thead class="bg-surface-container-low text-xs font-bold text-on-surface-variant uppercase">
            <tr>
                <th class="p-4 w-16 text-center">Xếp hạng</th>
                <th class="p-4">Tên Món ăn</th>
                <th class="p-4 text-right">Số lượng bán</th>
                <th class="p-4 text-right">Tổng Doanh thu Món</th>
                <th class="p-4 text-center">Đánh giá Hiệu suất</th>
            </tr>
        </thead>
        <tbody>
            <tr class="border-b border-outline-variant/20 hover:bg-surface-low">
                <td class="p-4 text-center font-bold text-primary text-base">#1</td>
                <td class="p-4 font-bold text-on-surface">Pizza Margherita Mozzarella</td>
                <td class="p-4 text-right font-mono font-bold text-base">214 phần</td>
                <td class="p-4 text-right font-mono font-bold text-primary">32,100,000đ</td>
                <td class="p-4 text-center">
                    <span class="px-2.5 py-1 bg-success-green/10 text-success-green rounded-full text-xs font-bold border border-success-green/20">🔥 Best Seller</span>
                </td>
            </tr>
            <tr class="border-b border-outline-variant/20 hover:bg-surface-low">
                <td class="p-4 text-center font-bold text-primary text-base">#2</td>
                <td class="p-4 font-bold text-on-surface">Mì Ý Bolognese Thịt bò Băm</td>
                <td class="p-4 text-right font-mono font-bold text-base">185 phần</td>
                <td class="p-4 text-right font-mono font-bold text-primary">24,050,000đ</td>
                <td class="p-4 text-center">
                    <span class="px-2.5 py-1 bg-success-green/10 text-success-green rounded-full text-xs font-bold border border-success-green/20">🔥 Bán chạy</span>
                </td>
            </tr>
            <tr class="border-b border-outline-variant/20 hover:bg-surface-low">
                <td class="p-4 text-center font-bold text-on-surface-variant text-base">#3</td>
                <td class="p-4 font-bold text-on-surface">Trà Vải Khiếm Thị Đào Basil</td>
                <td class="p-4 text-right font-mono font-bold text-base">142 phần</td>
                <td class="p-4 text-right font-mono font-bold text-primary">6,390,000đ</td>
                <td class="p-4 text-center">
                    <span class="px-2.5 py-1 bg-secondary-container/40 text-secondary rounded-full text-xs font-bold">Tốt</span>
                </td>
            </tr>
        </tbody>
    </table>
</div>


@page "/admin/reports/top-movers"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.AdminLayout
@using Restaurant.Application.DTOs
@using Restaurant.Web.Services
@inject AdminApiClient ApiClient

<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
    <div>
        <h2 class="text-2xl font-headline-sm text-primary m-0">@L["Report_TopMovers_Title"]</h2>
        <p class="text-on-surface-variant text-sm mt-1">@L["Report_TopMovers_Sub"]</p>
    </div>

    <!-- Filter toolbar -->
    <div class="flex flex-wrap items-center gap-2">
        <div class="inline-flex rounded-lg border border-outline-variant/40 p-1 bg-surface-container-low shadow-xs text-xs font-bold">
            <button class="px-3 py-1.5 rounded-md transition-colors @(_filterPreset == "today" ? "bg-white text-primary shadow-xs" : "text-on-surface-variant hover:text-on-surface")"
                    @onclick='() => SetPreset("today")'>
                Hôm nay
            </button>
            <button class="px-3 py-1.5 rounded-md transition-colors @(_filterPreset == "7days" ? "bg-white text-primary shadow-xs" : "text-on-surface-variant hover:text-on-surface")"
                    @onclick='() => SetPreset("7days")'>
                7 ngày qua
            </button>
            <button class="px-3 py-1.5 rounded-md transition-colors @(_filterPreset == "month" ? "bg-white text-primary shadow-xs" : "text-on-surface-variant hover:text-on-surface")"
                    @onclick='() => SetPreset("month")'>
                Tháng này
            </button>
            <button class="px-3 py-1.5 rounded-md transition-colors @(_filterPreset == "all" ? "bg-white text-primary shadow-xs" : "text-on-surface-variant hover:text-on-surface")"
                    @onclick='() => SetPreset("all")'>
                Tất cả
            </button>
        </div>

        <div class="flex items-center gap-2 bg-surface-container-lowest px-3 py-1.5 rounded-lg border border-outline-variant/40 shadow-xs text-xs">
            <input type="date" value="@_fromDate?.ToString("yyyy-MM-dd")" @onchange="OnFromDateChanged" class="border border-outline-variant/40 rounded px-1.5 py-1 text-xs" />
            <span class="text-on-surface-variant font-bold">→</span>
            <input type="date" value="@_toDate?.ToString("yyyy-MM-dd")" @onchange="OnToDateChanged" class="border border-outline-variant/40 rounded px-1.5 py-1 text-xs" />
            <button class="px-2.5 py-1 bg-primary text-white rounded font-bold hover:bg-primary/90 transition-colors" @onclick="LoadData">
                Lọc
            </button>
        </div>

        <button class="p-2 bg-surface-container text-on-surface hover:bg-surface-container-high rounded-lg border border-outline-variant/40 transition-colors shadow-xs"
                @onclick="LoadData" title="Tải lại">
            <span class="material-symbols-outlined text-[18px] @(_isLoading ? "animate-spin text-primary" : "")">refresh</span>
        </button>
    </div>
</div>

<!-- KPI Cards -->
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-5">
        <div class="text-xs font-bold text-on-surface-variant uppercase">Món Bán Chạy Nhất</div>
        <div class="font-headline-sm text-xl font-bold text-primary mt-2 truncate" title="@(_reportData?.TopItemName ?? "Chưa có")">
            @(_reportData?.TopItemName ?? "Chưa có dữ liệu")
        </div>
        <div class="text-xs text-on-surface-variant mt-1">Dẫn đầu về lượt gọi món trong kỳ</div>
    </div>
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-5">
        <div class="text-xs font-bold text-on-surface-variant uppercase">Tổng Lượng Món Tiêu Thụ</div>
        <div class="font-headline-sm text-2xl font-bold text-on-surface font-mono tabular-nums mt-2">
            @((_reportData?.TotalSoldQuantity ?? 0).ToString("N0")) <span class="text-base font-normal font-sans">phần</span>
        </div>
        <div class="text-xs text-on-surface-variant mt-1">Tổng cộng các phần món ăn & đồ uống</div>
    </div>
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-5">
        <div class="text-xs font-bold text-on-surface-variant uppercase">Tổng Doanh Thu Từ Món</div>
        <div class="font-headline-sm text-2xl font-bold text-emerald-600 font-mono tabular-nums mt-2">
            @((_reportData?.TotalRevenue ?? 0).ToString("N0")) đ
        </div>
        <div class="text-xs text-on-surface-variant mt-1">Doanh số ghi nhận từ đơn hàng hoàn tất</div>
    </div>
</div>

<!-- Table Card -->
<div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden">
    <div class="p-4 border-b border-outline-variant/30 flex justify-between items-center bg-surface-container-low">
        <h3 class="font-bold text-on-surface text-base m-0">Bảng Xếp Hạng Tiêu Thụ Món Ăn</h3>
        <span class="text-xs text-on-surface-variant font-medium">Hiển thị @(_reportData?.Items.Count ?? 0) món bán chạy</span>
    </div>

    @if (_isLoading)
    {
        <div class="flex justify-center items-center p-16">
            <span class="material-symbols-outlined animate-spin text-4xl text-primary">progress_activity</span>
            <span class="ml-3 text-sm text-on-surface-variant">Đang tải dữ liệu báo cáo...</span>
        </div>
    }
    else if (_reportData?.Items == null || !_reportData.Items.Any())
    {
        <div class="p-12 text-center text-on-surface-variant">
            <span class="material-symbols-outlined text-4xl text-outline-variant mb-2">restaurant</span>
            <div class="font-bold text-base">Không có dữ liệu tiêu thụ trong khoảng thời gian đã chọn.</div>
            <div class="text-xs text-outline mt-1">Hãy thử đổi bộ lọc sang "Tháng này" hoặc "Tất cả" để xem toàn bộ lịch sử bán hàng.</div>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="bg-surface-container-low text-xs font-bold text-on-surface-variant uppercase border-b border-outline-variant/30">
                    <tr>
                        <th class="p-4 w-16 text-center">@L["Report_TopMovers_Col_Rank"]</th>
                        <th class="p-4">@L["Report_TopMovers_Col_Name"]</th>
                        <th class="p-4">Danh Mục</th>
                        <th class="p-4 text-right">@L["Report_TopMovers_Col_Qty"]</th>
                        <th class="p-4 text-right">@L["Report_TopMovers_Col_Total"]</th>
                        <th class="p-4 text-center">@L["Report_TopMovers_Col_Eval"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var it in _reportData.Items)
                    {
                        var rankClass = it.Rank switch
                        {
                            1 => "bg-amber-100 text-amber-800 border-amber-300 font-bold",
                            2 => "bg-slate-200 text-slate-800 border-slate-400 font-bold",
                            3 => "bg-amber-700/20 text-amber-900 border-amber-600/30 font-bold",
                            _ => "bg-surface-container text-on-surface-variant border-transparent font-medium"
                        };

                        var evalBadge = it.Rank switch
                        {
                            1 => ("🔥 " + L["Report_TopMovers_BestSeller"], "bg-emerald-500/10 text-emerald-600 border border-emerald-500/30"),
                            2 or 3 => ("⚡ " + L["Report_TopMovers_HighSales"], "bg-amber-500/10 text-amber-600 border border-amber-500/30"),
                            _ => ("👍 " + L["Report_TopMovers_Good"], "bg-blue-500/10 text-blue-600 border border-blue-500/20")
                        };

                        <tr class="border-b border-outline-variant/20 hover:bg-surface-low transition-colors">
                            <td class="p-4 text-center">
                                <span class="inline-flex items-center justify-center w-7 h-7 rounded-full text-xs border @rankClass">
                                    #@it.Rank
                                </span>
                            </td>
                            <td class="p-4 font-bold text-on-surface">@it.ItemName</td>
                            <td class="p-4 text-sm text-on-surface-variant">@it.CategoryName</td>
                            <td class="p-4 text-right font-mono font-bold text-base tabular-nums">
                                @it.QuantitySold <span class="text-xs font-normal text-on-surface-variant">phần</span>
                            </td>
                            <td class="p-4 text-right font-mono font-bold text-primary text-base tabular-nums">
                                @it.TotalRevenue.ToString("N0") đ
                            </td>
                            <td class="p-4 text-center">
                                <span class="px-2.5 py-1 rounded-full text-xs font-bold @evalBadge.Item2">
                                    @evalBadge.Item1
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private TopSellingReportDto? _reportData;
    private bool _isLoading = true;
    private string _filterPreset = "month";
    private DateTime? _fromDate;
    private DateTime? _toDate;

    protected override async Task OnInitializedAsync()
    {
        SetPreset("month", triggerLoad: false);
        await LoadData();
    }

    private void SetPreset(string preset, bool triggerLoad = true)
    {
        _filterPreset = preset;
        var today = DateTime.Today;

        switch (preset)
        {
            case "today":
                _fromDate = today;
                _toDate = today;
                break;
            case "7days":
                _fromDate = today.AddDays(-6);
                _toDate = today;
                break;
            case "month":
                _fromDate = new DateTime(today.Year, today.Month, 1);
                _toDate = today;
                break;
            case "all":
                _fromDate = null;
                _toDate = null;
                break;
        }

        if (triggerLoad)
        {
            _ = LoadData();
        }
    }

    private void OnFromDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            _fromDate = dt;
            _filterPreset = "custom";
        }
    }

    private void OnToDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            _toDate = dt;
            _filterPreset = "custom";
        }
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            _reportData = await ApiClient.GetTopMoversReportAsync(_fromDate, _toDate, 50);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading top movers report: {ex.Message}");
            _reportData = new TopSellingReportDto();
        }
        finally
        {
            _isLoading = false;
        }
    }
}

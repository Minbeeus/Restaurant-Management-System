@page "/admin/reports/revenue"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.AdminLayout

<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
    <div>
        <h2 class="text-2xl font-headline-sm text-primary m-0">@L["Report_Revenue_Title"]</h2>
        <p class="text-on-surface-variant text-sm mt-1">@L["Report_Revenue_Sub"]</p>
    </div>
    <div class="flex items-center gap-2">
        <button class="px-4 py-2 bg-primary text-on-primary rounded-xl font-label-bold shadow-sm hover:bg-primary/90 transition-colors flex items-center text-sm" @onclick="ExportReport">
            <span class="material-symbols-outlined text-sm mr-1" data-icon="download">download</span> @L["Report_Revenue_Export"]
        </button>
    </div>
</div>

<!-- Card Thống kê Tổng quan -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-5">
        <div class="text-xs font-bold text-on-surface-variant uppercase">@L["Report_Revenue_Total"]</div>
        <div class="font-headline-sm text-2xl font-bold text-primary font-mono tabular-nums mt-2">128,450,000 đ</div>
        <div class="text-xs text-success-green font-bold mt-1">@L["Report_Revenue_Growth"]</div>
    </div>
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-5">
        <div class="text-xs font-bold text-on-surface-variant uppercase">@L["Report_Revenue_TotalOrders"]</div>
        <div class="font-headline-sm text-2xl font-bold text-on-background font-mono tabular-nums mt-2">482 đơn</div>
        <div class="text-xs text-on-surface-variant mt-1">@L["Report_Revenue_PaidSub"]</div>
    </div>
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-5">
        <div class="text-xs font-bold text-on-surface-variant uppercase">@L["Report_Revenue_VietQR"]</div>
        <div class="font-headline-sm text-2xl font-bold text-secondary font-mono tabular-nums mt-2">84,300,000 đ</div>
        <div class="text-xs text-on-surface-variant mt-1">@L["Report_Revenue_VietQRSub"]</div>
    </div>
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-5">
        <div class="text-xs font-bold text-on-surface-variant uppercase">@L["Report_Revenue_Cash"]</div>
        <div class="font-headline-sm text-2xl font-bold text-on-background font-mono tabular-nums mt-2">44,150,000 đ</div>
        <div class="text-xs text-on-surface-variant mt-1">@L["Report_Revenue_CashSub"]</div>
    </div>
</div>

<!-- Bảng chi tiết Doanh thu theo Ngày -->
<div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden">
    <div class="p-4 border-b border-outline-variant/30 flex justify-between items-center bg-surface-container-low">
        <h3 class="font-bold text-on-surface text-base m-0">@L["Report_Revenue_DailyTitle"]</h3>
        <span class="text-xs text-on-surface-variant">Tháng 09/2026</span>
    </div>

    <table class="w-full text-left border-collapse">
        <thead class="bg-surface-container-low text-xs font-bold text-on-surface-variant uppercase">
            <tr>
                <th class="p-4">@L["Report_Revenue_Col_Date"]</th>
                <th class="p-4 text-right">@L["Report_Revenue_Col_Orders"]</th>
                <th class="p-4 text-right">@L["Report_Revenue_Col_Cash"]</th>
                <th class="p-4 text-right">@L["Report_Revenue_Col_VietQR"]</th>
                <th class="p-4 text-right">@L["Report_Revenue_Col_Total"]</th>
            </tr>
        </thead>
        <tbody>
            <tr class="border-b border-outline-variant/20 hover:bg-surface-low font-mono tabular-nums">
                <td class="p-4 font-bold font-sans text-on-surface">18/09/2026 (@L["Dashboard_Today"])</td>
                <td class="p-4 text-right font-bold">34</td>
                <td class="p-4 text-right">3,200,000 đ</td>
                <td class="p-4 text-right text-secondary font-bold">6,850,000 đ</td>
                <td class="p-4 text-right font-bold text-primary text-base">10,050,000 đ</td>
            </tr>
            <tr class="border-b border-outline-variant/20 hover:bg-surface-low font-mono tabular-nums">
                <td class="p-4 font-bold font-sans text-on-surface">17/09/2026</td>
                <td class="p-4 text-right font-bold">42</td>
                <td class="p-4 text-right">4,500,000 đ</td>
                <td class="p-4 text-right text-secondary font-bold">8,200,000 đ</td>
                <td class="p-4 text-right font-bold text-primary text-base">12,700,000 đ</td>
            </tr>
            <tr class="border-b border-outline-variant/20 hover:bg-surface-low font-mono tabular-nums">
                <td class="p-4 font-bold font-sans text-on-surface">16/09/2026</td>
                <td class="p-4 text-right font-bold">29</td>
                <td class="p-4 text-right">2,800,000 đ</td>
                <td class="p-4 text-right text-secondary font-bold">5,400,000 đ</td>
                <td class="p-4 text-right font-bold text-primary text-base">8,200,000 đ</td>
            </tr>
        </tbody>
    </table>
</div>

@code {
    private void ExportReport()
    {
        // Excel Export action handler
    }
}

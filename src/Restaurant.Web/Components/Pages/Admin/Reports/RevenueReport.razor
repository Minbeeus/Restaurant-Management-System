@page "/admin/reports/revenue"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.AdminLayout
@using Restaurant.Application.DTOs
@using Restaurant.Web.Services
@inject AdminApiClient ApiClient
@inject IJSRuntime JS

<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
    <div>
        <h2 class="text-2xl font-headline-sm text-primary m-0">@L["Report_Revenue_Title"]</h2>
        <p class="text-on-surface-variant text-sm mt-1">@L["Report_Revenue_Sub"]</p>
    </div>

    <!-- Filter & Action toolbar -->
    <div class="flex flex-wrap items-center gap-2">
        <div class="inline-flex rounded-lg border border-outline-variant/40 p-1 bg-surface-container-low shadow-xs text-xs font-bold">
            <button class="px-3 py-1.5 rounded-md transition-colors @(_filterPreset == "today" ? "bg-white text-primary shadow-xs" : "text-on-surface-variant hover:text-on-surface")"
                    @onclick='() => SetPreset("today")'>
                Hôm nay
            </button>
            <button class="px-3 py-1.5 rounded-md transition-colors @(_filterPreset == "7days" ? "bg-white text-primary shadow-xs" : "text-on-surface-variant hover:text-on-surface")"
                    @onclick='() => SetPreset("7days")'>
                7 ngày qua
            </button>
            <button class="px-3 py-1.5 rounded-md transition-colors @(_filterPreset == "month" ? "bg-white text-primary shadow-xs" : "text-on-surface-variant hover:text-on-surface")"
                    @onclick='() => SetPreset("month")'>
                Tháng này
            </button>
            <button class="px-3 py-1.5 rounded-md transition-colors @(_filterPreset == "all" ? "bg-white text-primary shadow-xs" : "text-on-surface-variant hover:text-on-surface")"
                    @onclick='() => SetPreset("all")'>
                Tất cả
            </button>
        </div>

        <div class="flex items-center gap-2 bg-surface-container-lowest px-3 py-1.5 rounded-lg border border-outline-variant/40 shadow-xs text-xs">
            <input type="date" value="@_fromDate?.ToString("yyyy-MM-dd")" @onchange="OnFromDateChanged" class="border border-outline-variant/40 rounded px-1.5 py-1 text-xs" />
            <span class="text-on-surface-variant font-bold">→</span>
            <input type="date" value="@_toDate?.ToString("yyyy-MM-dd")" @onchange="OnToDateChanged" class="border border-outline-variant/40 rounded px-1.5 py-1 text-xs" />
            <button class="px-2.5 py-1 bg-primary text-white rounded font-bold hover:bg-primary/90 transition-colors" @onclick="LoadData">
                Lọc
            </button>
        </div>

        <button class="p-2 bg-surface-container text-on-surface hover:bg-surface-container-high rounded-lg border border-outline-variant/40 transition-colors shadow-xs"
                @onclick="LoadData" title="Tải lại">
            <span class="material-symbols-outlined text-[18px] @(_isLoading ? "animate-spin text-primary" : "")">refresh</span>
        </button>

        <button class="px-3.5 py-2 bg-emerald-600 text-white rounded-lg font-bold shadow-xs hover:bg-emerald-700 transition-colors flex items-center text-xs gap-1.5"
                @onclick="ExportReport">
            <span class="material-symbols-outlined text-sm">download</span>
            <span>Xuất Excel/CSV</span>
        </button>
    </div>
</div>

<!-- Card Thống kê Tổng quan -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-5">
        <div class="text-xs font-bold text-on-surface-variant uppercase">@L["Report_Revenue_Total"]</div>
        <div class="font-headline-sm text-2xl font-bold text-primary font-mono tabular-nums mt-2">
            @((_reportData?.TotalRevenue ?? 0).ToString("N0")) đ
        </div>
        <div class="text-xs @(_reportData?.IsGrowthPositive == true ? "text-success-green" : "text-error") font-bold mt-1">
            @(_reportData?.IsGrowthPositive == true ? "+" : "-")@((_reportData?.GrowthPercentage ?? 0).ToString("N1"))% so với kỳ trước
        </div>
    </div>
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-5">
        <div class="text-xs font-bold text-on-surface-variant uppercase">@L["Report_Revenue_TotalOrders"]</div>
        <div class="font-headline-sm text-2xl font-bold text-on-background font-mono tabular-nums mt-2">
            @((_reportData?.TotalOrders ?? 0).ToString("N0")) đơn
        </div>
        <div class="text-xs text-on-surface-variant mt-1">@L["Report_Revenue_PaidSub"]</div>
    </div>
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-5">
        <div class="text-xs font-bold text-on-surface-variant uppercase">@L["Report_Revenue_VietQR"]</div>
        <div class="font-headline-sm text-2xl font-bold text-secondary font-mono tabular-nums mt-2">
            @((_reportData?.VietQrRevenue ?? 0).ToString("N0")) đ
        </div>
        <div class="text-xs text-on-surface-variant mt-1">@L["Report_Revenue_VietQRSub"]</div>
    </div>
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-5">
        <div class="text-xs font-bold text-on-surface-variant uppercase">@L["Report_Revenue_Cash"]</div>
        <div class="font-headline-sm text-2xl font-bold text-on-background font-mono tabular-nums mt-2">
            @((_reportData?.CashRevenue ?? 0).ToString("N0")) đ
        </div>
        <div class="text-xs text-on-surface-variant mt-1">@L["Report_Revenue_CashSub"]</div>
    </div>
</div>

<!-- Bảng chi tiết Doanh thu theo Ngày -->
<div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden">
    <div class="p-4 border-b border-outline-variant/30 flex justify-between items-center bg-surface-container-low">
        <h3 class="font-bold text-on-surface text-base m-0">@L["Report_Revenue_DailyTitle"]</h3>
        <span class="text-xs text-on-surface-variant font-medium">
            @if (_fromDate.HasValue && _toDate.HasValue)
            {
                <span>Từ @_fromDate.Value.ToString("dd/MM/yyyy") đến @_toDate.Value.ToString("dd/MM/yyyy")</span>
            }
            else
            {
                <span>Toàn bộ thời gian</span>
            }
        </span>
    </div>

    @if (_isLoading)
    {
        <div class="flex justify-center items-center p-16">
            <span class="material-symbols-outlined animate-spin text-4xl text-primary">progress_activity</span>
            <span class="ml-3 text-sm text-on-surface-variant">Đang kết nối API và tổng hợp doanh thu...</span>
        </div>
    }
    else if (_reportData?.DailyBreakdown == null || !_reportData.DailyBreakdown.Any())
    {
        <div class="p-12 text-center text-on-surface-variant">
            <span class="material-symbols-outlined text-4xl text-outline-variant mb-2">calendar_today</span>
            <div class="font-bold text-base">Không có phát sinh doanh thu trong khoảng thời gian đã chọn.</div>
            <div class="text-xs text-outline mt-1">Hãy thử chọn mốc thời gian "Tháng này" hoặc "Tất cả" để kiểm tra các đơn đã hoàn tất.</div>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="bg-surface-container-low text-xs font-bold text-on-surface-variant uppercase border-b border-outline-variant/30">
                    <tr>
                        <th class="p-4">@L["Report_Revenue_Col_Date"]</th>
                        <th class="p-4 text-right">@L["Report_Revenue_Col_Orders"]</th>
                        <th class="p-4 text-right">@L["Report_Revenue_Col_Cash"]</th>
                        <th class="p-4 text-right">@L["Report_Revenue_Col_VietQR"]</th>
                        <th class="p-4 text-right">@L["Report_Revenue_Col_Total"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _reportData.DailyBreakdown)
                    {
                        <tr class="border-b border-outline-variant/20 hover:bg-surface-low font-mono tabular-nums transition-colors">
                            <td class="p-4 font-bold font-sans text-on-surface">@row.FormattedDate</td>
                            <td class="p-4 text-right font-bold font-sans text-on-surface">@row.OrderCount</td>
                            <td class="p-4 text-right">@row.CashAmount.ToString("N0") đ</td>
                            <td class="p-4 text-right text-secondary font-bold">@row.VietQrAmount.ToString("N0") đ</td>
                            <td class="p-4 text-right font-bold text-primary text-base">@row.TotalAmount.ToString("N0") đ</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="bg-surface-container-low font-bold font-mono border-t border-outline-variant/40">
                    <tr>
                        <td class="p-4 font-sans text-primary">TỔNG CỘNG</td>
                        <td class="p-4 text-right font-sans text-primary">@_reportData.TotalOrders</td>
                        <td class="p-4 text-right">@_reportData.CashRevenue.ToString("N0") đ</td>
                        <td class="p-4 text-right text-secondary">@_reportData.VietQrRevenue.ToString("N0") đ</td>
                        <td class="p-4 text-right text-primary text-base">@_reportData.TotalRevenue.ToString("N0") đ</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>

@code {
    private RevenueReportDto? _reportData;
    private bool _isLoading = true;
    private string _filterPreset = "month";
    private DateTime? _fromDate;
    private DateTime? _toDate;

    protected override async Task OnInitializedAsync()
    {
        SetPreset("month", triggerLoad: false);
        await LoadData();
    }

    private void SetPreset(string preset, bool triggerLoad = true)
    {
        _filterPreset = preset;
        var today = DateTime.Today;

        switch (preset)
        {
            case "today":
                _fromDate = today;
                _toDate = today;
                break;
            case "7days":
                _fromDate = today.AddDays(-6);
                _toDate = today;
                break;
            case "month":
                _fromDate = new DateTime(today.Year, today.Month, 1);
                _toDate = today;
                break;
            case "all":
                _fromDate = null;
                _toDate = null;
                break;
        }

        if (triggerLoad)
        {
            _ = LoadData();
        }
    }

    private void OnFromDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            _fromDate = dt;
            _filterPreset = "custom";
        }
    }

    private void OnToDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            _toDate = dt;
            _filterPreset = "custom";
        }
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            _reportData = await ApiClient.GetRevenueReportAsync(_fromDate, _toDate);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading revenue report: {ex.Message}");
            _reportData = new RevenueReportDto();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ExportReport()
    {
        if (_reportData?.DailyBreakdown == null || !_reportData.DailyBreakdown.Any()) return;

        var csv = new System.Text.StringBuilder();
        // UTF-8 BOM for Excel Vietnamese compatibility
        csv.Append('\uFEFF');
        csv.AppendLine("Ngày,Số lượng đơn,Tiền mặt (VNĐ),VietQR/Chuyển khoản (VNĐ),Tổng doanh thu (VNĐ)");

        foreach (var r in _reportData.DailyBreakdown)
        {
            csv.AppendLine($"\"{r.FormattedDate}\",{r.OrderCount},{r.CashAmount},{r.VietQrAmount},{r.TotalAmount}");
        }

        csv.AppendLine($"\"TỔNG CỘNG\",{_reportData.TotalOrders},{_reportData.CashRevenue},{_reportData.VietQrRevenue},{_reportData.TotalRevenue}");

        var bytes = System.Text.Encoding.UTF8.GetBytes(csv.ToString());
        var base64 = Convert.ToBase64String(bytes);
        var filename = $"BaoCaoDoanhThu_{DateTime.Now:yyyyMMdd_HHmm}.csv";

        await JS.InvokeVoidAsync("eval", $@"
            var link = document.createElement('a');
            link.download = '{filename}';
            link.href = 'data:text/csv;base64,{base64}';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        ");
    }
}

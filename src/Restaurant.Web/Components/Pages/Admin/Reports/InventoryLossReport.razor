@page "/admin/reports/inventory-loss"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.AdminLayout
@using Restaurant.Application.DTOs
@using Restaurant.Web.Services
@inject AdminApiClient ApiClient

<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
    <div>
        <h2 class="text-2xl font-headline-sm text-primary m-0">@L["Report_InventoryLoss_Title"]</h2>
        <p class="text-on-surface-variant text-sm mt-1">@L["Report_InventoryLoss_Sub"]</p>
    </div>

    <!-- Filter toolbar -->
    <div class="flex flex-wrap items-center gap-2">
        <div class="inline-flex rounded-lg border border-outline-variant/40 p-1 bg-surface-container-low shadow-xs text-xs font-bold">
            <button class="px-3 py-1.5 rounded-md transition-colors @(_filterPreset == "30days" ? "bg-white text-primary shadow-xs" : "text-on-surface-variant hover:text-on-surface")"
                    @onclick='() => SetPreset("30days")'>
                30 ngày qua
            </button>
            <button class="px-3 py-1.5 rounded-md transition-colors @(_filterPreset == "month" ? "bg-white text-primary shadow-xs" : "text-on-surface-variant hover:text-on-surface")"
                    @onclick='() => SetPreset("month")'>
                Tháng này
            </button>
            <button class="px-3 py-1.5 rounded-md transition-colors @(_filterPreset == "all" ? "bg-white text-primary shadow-xs" : "text-on-surface-variant hover:text-on-surface")"
                    @onclick='() => SetPreset("all")'>
                Tất cả
            </button>
        </div>

        <div class="flex items-center gap-2 bg-surface-container-lowest px-3 py-1.5 rounded-lg border border-outline-variant/40 shadow-xs text-xs">
            <input type="date" value="@_fromDate?.ToString("yyyy-MM-dd")" @onchange="OnFromDateChanged" class="border border-outline-variant/40 rounded px-1.5 py-1 text-xs" />
            <span class="text-on-surface-variant font-bold">→</span>
            <input type="date" value="@_toDate?.ToString("yyyy-MM-dd")" @onchange="OnToDateChanged" class="border border-outline-variant/40 rounded px-1.5 py-1 text-xs" />
            <button class="px-2.5 py-1 bg-primary text-white rounded font-bold hover:bg-primary/90 transition-colors" @onclick="LoadData">
                Lọc
            </button>
        </div>

        <button class="p-2 bg-surface-container text-on-surface hover:bg-surface-container-high rounded-lg border border-outline-variant/40 transition-colors shadow-xs"
                @onclick="LoadData" title="Tải lại">
            <span class="material-symbols-outlined text-[18px] @(_isLoading ? "animate-spin text-primary" : "")">refresh</span>
        </button>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-5">
        <div class="text-xs font-bold text-on-surface-variant uppercase">@L["Report_InventoryLoss_VarianceTitle"]</div>
        <div class="font-headline-sm text-2xl font-bold text-error mt-2">- @_summary.TotalVarianceAmount.ToString("N0") đ</div>
        <div class="text-xs text-on-surface-variant mt-1">Chênh lệch âm ghi nhận qua các đợt kiểm kê thực tế kho</div>
    </div>
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-5">
        <div class="text-xs font-bold text-on-surface-variant uppercase">@L["Report_InventoryLoss_WasteTitle"]</div>
        <div class="font-headline-sm text-2xl font-bold text-error mt-2">- @_summary.TotalWasteAmount.ToString("N0") đ</div>
        <div class="text-xs text-on-surface-variant mt-1">Hao hụt tự nhiên, nguyên liệu hỏng & đơn huỷ chế biến</div>
    </div>
</div>

<div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden">
    <div class="p-4 border-b border-outline-variant/30 flex justify-between items-center bg-surface-container-low">
        <h3 class="font-bold text-on-surface text-base m-0">@L["Report_InventoryLoss_DetailTitle"]</h3>
        <span class="text-xs text-on-surface-variant font-medium">Tổng số mục chênh lệch: @_summary.DiscrepancyItems.Count</span>
    </div>

    @if (_isLoading)
    {
        <div class="flex justify-center items-center p-16">
            <span class="material-symbols-outlined animate-spin text-4xl text-primary" data-icon="progress_activity">progress_activity</span>
            <span class="ml-3 text-sm text-on-surface-variant">Đang tải dữ liệu kiểm kê & hao hụt...</span>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="bg-surface-container-low text-xs font-bold text-on-surface-variant uppercase border-b border-outline-variant/30">
                    <tr>
                        <th class="p-4">Nguyên Liệu</th>
                        <th class="p-4 text-right">Lượng Hệ Thống</th>
                        <th class="p-4 text-right">Lượng Thực Tế</th>
                        <th class="p-4 text-right">Chênh Lệch</th>
                        <th class="p-4">Lý Do / Ghi Chú</th>
                        <th class="p-4 text-right">@L["Report_InventoryLoss_Col_Amount"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_summary.DiscrepancyItems.Any())
                    {
                        <tr>
                            <td colspan="6" class="p-12 text-center text-on-surface-variant">
                                <span class="material-symbols-outlined text-4xl text-outline-variant mb-2">inventory_2</span>
                                <div class="font-bold text-base">Không có phát sinh thất thoát kho nào trong kỳ kiểm kê đã chọn.</div>
                            </td>
                        </tr>
                    }
                    @foreach (var it in _summary.DiscrepancyItems)
                    {
                        <tr class="border-b border-outline-variant/20 hover:bg-surface-low transition-colors">
                            <td class="p-4 font-bold text-on-surface">@it.MaterialName</td>
                            <td class="p-4 text-right font-mono text-sm text-on-surface-variant">@it.SystemQuantity @it.UnitName</td>
                            <td class="p-4 text-right font-mono text-sm font-bold">@it.ActualQuantity @it.UnitName</td>
                            <td class="p-4 text-right font-mono font-bold text-error">@it.Difference @it.UnitName</td>
                            <td class="p-4 text-sm text-on-surface-variant italic">@(it.Note ?? "Hao hụt kiểm kê")</td>
                            <td class="p-4 text-right font-mono font-bold text-error text-base tabular-nums">- @it.DifferenceValue.ToString("N0") đ</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private InventoryLossSummaryDto _summary = new();
    private bool _isLoading = true;
    private string _filterPreset = "30days";
    private DateTime? _fromDate;
    private DateTime? _toDate;

    protected override async Task OnInitializedAsync()
    {
        SetPreset("30days", triggerLoad: false);
        await LoadData();
    }

    private void SetPreset(string preset, bool triggerLoad = true)
    {
        _filterPreset = preset;
        var today = DateTime.Today;

        switch (preset)
        {
            case "30days":
                _fromDate = today.AddDays(-30);
                _toDate = today;
                break;
            case "month":
                _fromDate = new DateTime(today.Year, today.Month, 1);
                _toDate = today;
                break;
            case "all":
                _fromDate = null;
                _toDate = null;
                break;
        }

        if (triggerLoad)
        {
            _ = LoadData();
        }
    }

    private void OnFromDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            _fromDate = dt;
            _filterPreset = "custom";
        }
    }

    private void OnToDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            _toDate = dt;
            _filterPreset = "custom";
        }
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            _summary = await ApiClient.GetInventoryLossSummaryAsync(_fromDate, _toDate);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading loss summary: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }
}

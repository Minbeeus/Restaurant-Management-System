@page "/admin/reports/inventory-loss"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.AdminLayout

<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
    <div>
        <h2 class="text-2xl font-headline-sm text-primary m-0">@L["Report_InventoryLoss_Title"]</h2>
        <p class="text-on-surface-variant text-sm mt-1">@L["Report_InventoryLoss_Sub"]</p>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-5">
        <div class="text-xs font-bold text-on-surface-variant uppercase">@L["Report_InventoryLoss_VarianceTitle"]</div>
        <div class="font-headline-sm text-2xl font-bold text-error mt-2">- 2,400,000đ</div>
        <div class="text-xs text-on-surface-variant mt-1">@L["Report_InventoryLoss_VarianceSub"]</div>
    </div>
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-5">
        <div class="text-xs font-bold text-on-surface-variant uppercase">@L["Report_InventoryLoss_WasteTitle"]</div>
        <div class="font-headline-sm text-2xl font-bold text-error mt-2">- 850,000đ</div>
        <div class="text-xs text-on-surface-variant mt-1">@L["Report_InventoryLoss_WasteSub"]</div>
    </div>
</div>

<div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden">
    <div class="p-4 border-b border-outline-variant/30 flex justify-between items-center bg-surface-container-low">
        <h3 class="font-bold text-on-surface text-base m-0">@L["Report_InventoryLoss_DetailTitle"]</h3>
    </div>

    <table class="w-full text-left border-collapse">
        <thead class="bg-surface-container-low text-xs font-bold text-on-surface-variant uppercase">
            <tr>
                <th class="p-4">@L["Report_InventoryLoss_Col_Time"]</th>
                <th class="p-4">@L["Report_InventoryLoss_Col_Type"]</th>
                <th class="p-4">@L["Report_InventoryLoss_Col_Detail"]</th>
                <th class="p-4 text-right">@L["Report_InventoryLoss_Col_Amount"]</th>
            </tr>
        </thead>
        <tbody>
            <tr class="border-b border-outline-variant/20 hover:bg-surface-low">
                <td class="p-4 font-mono text-sm text-on-surface-variant">15/09/2026 17:00</td>
                <td class="p-4 font-bold text-on-surface">@L["Stocktake_Management_Title"]</td>
                <td class="p-4 text-sm text-on-surface-variant">Thất thoát Phô mai Mozzarella (-1.2kg) &amp; Cà chua (-3kg)</td>
                <td class="p-4 text-right font-mono font-bold text-error text-base">- 2,400,000đ</td>
            </tr>
            <tr class="border-b border-outline-variant/20 hover:bg-surface-low">
                <td class="p-4 font-mono text-sm text-on-surface-variant">12/09/2026 19:45</td>
                <td class="p-4 font-bold text-on-surface">Hủy món đã chế biến</td>
                <td class="p-4 text-sm text-on-surface-variant">Khách hủy đơn #ORD-108 sau khi bếp đã hoàn tất nấu món Pizza</td>
                <td class="p-4 text-right font-mono font-bold text-error text-base">- 850,000đ</td>
            </tr>
        </tbody>
    </table>
</div>

@code {
}

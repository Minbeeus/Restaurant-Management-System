@page "/admin/customers"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.AdminLayout
@using Restaurant.Application.DTOs
@using Restaurant.Web.Services
@inject AdminApiClient ApiClient

<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
    <div>
        <h2 class="text-2xl font-headline-sm text-primary m-0">@L["Customer_Management_Title"]</h2>
        <p class="text-on-surface-variant text-sm mt-1">@L["Customer_Sub"]</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="bg-error-container text-on-error-container p-4 rounded-xl mb-6 flex items-center gap-3">
        <span class="material-symbols-outlined">error</span>
        <span class="font-bold">@_errorMessage</span>
    </div>
}

@if (_isLoading)
{
    <div class="flex justify-center p-12">
        <span class="material-symbols-outlined animate-spin text-4xl text-primary" data-icon="progress_activity">progress_activity</span>
    </div>
}
else
{
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead class="bg-surface-container-low border-b border-outline-variant/30 text-on-surface-variant font-label-bold text-xs uppercase">
                <tr>
                    <th class="p-4 w-16 text-center">@L["Area_Header_ID"]</th>
                    <th class="p-4">@L["Customer_Col_Name"]</th>
                    <th class="p-4">@L["Customer_Col_Phone"]</th>
                    <th class="p-4 text-center">@L["Customer_Col_Tier"]</th>
                    <th class="p-4 text-right">@L["Customer_Col_TotalPoints"]</th>
                    <th class="p-4 text-right">@L["Customer_Col_AvailablePoints"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cust in _customers)
                {
                    <tr class="border-b border-outline-variant/20 last:border-0 hover:bg-surface-low/50 transition-colors">
                        <td class="p-4 text-center text-on-surface-variant">#@cust.Id</td>
                        <td class="p-4 font-bold text-on-background">@cust.FullName</td>
                        <td class="p-4 font-mono text-sm text-primary">@cust.PhoneNumber</td>
                        <td class="p-4 text-center">
                            @if (cust.TierName.Contains("Kim Cương") || cust.TierName.Contains("Diamond"))
                            {
                                <span class="px-3 py-1 bg-secondary-container text-secondary rounded-full text-xs font-bold border border-secondary/30">💎 @cust.TierName</span>
                            }
                            else if (cust.TierName.Contains("Vàng") || cust.TierName.Contains("Gold"))
                            {
                                <span class="px-3 py-1 bg-amber-500/10 text-amber-600 rounded-full text-xs font-bold border border-amber-500/30">🥇 @cust.TierName</span>
                            }
                            else
                            {
                                <span class="px-3 py-1 bg-surface-variant text-on-surface-variant rounded-full text-xs font-bold">🥈 @cust.TierName</span>
                            }
                        </td>
                        <td class="p-4 text-right font-mono font-bold text-base text-on-surface">@cust.TotalPoints.ToString("N0") pt</td>
                        <td class="p-4 text-right font-mono font-bold text-base text-primary">@cust.AvailablePoints.ToString("N0") pt</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<CustomerDto> _customers = new();
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            _customers = await ApiClient.GetCustomersAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Lỗi khi tải danh sách khách hàng: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }
}

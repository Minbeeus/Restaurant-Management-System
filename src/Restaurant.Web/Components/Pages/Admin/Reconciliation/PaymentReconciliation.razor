@page "/admin/reconciliation"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.AdminLayout
@using System.Net.Http.Json
@using Restaurant.Application.DTOs
@using Microsoft.JSInterop
@inject HttpClient Http
@inject IJSRuntime JS

<div class="p-3 sm:p-4 space-y-3 bg-background min-h-screen text-on-surface select-none">
    <!-- Header with Breadcrumbs & Action Toolbar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 border-b border-outline-variant/60 pb-2.5">
        <div>
            <div class="flex items-center gap-1.5 text-[11px] text-primary font-bold mb-0.5">
                <span class="material-symbols-outlined text-[13px]">storefront</span>
                <span>QUẢN TRỊ BOH</span>
                <span>/</span>
                <span class="text-on-surface-variant font-medium">Báo cáo & Kiểm kê</span>
            </div>
            <h1 class="text-base sm:text-lg font-bold text-primary tracking-tight flex items-center gap-1.5 m-0">
                <span class="material-symbols-outlined text-lg sm:text-xl text-primary">fact_check</span>
                <span>ĐỐI SOÁT THANH TOÁN & BÁO CÁO SALES (RECONCILIATION)</span>
            </h1>
            <p class="text-[11px] text-on-surface-variant mt-0.5 m-0">
                Đối soát tiền mặt, chuyển khoản ngân hàng thực tế so với hệ thống và kiểm kê doanh thu ca làm việc.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-1.5 shrink-0">
            <!-- Shift Selector Dropdown -->
            <div class="flex items-center gap-1 bg-surface border border-outline-variant rounded-lg px-2.5 py-1 shadow-2xs">
                <span class="material-symbols-outlined text-[15px] text-primary">schedule</span>
                <span class="text-xs font-semibold text-on-surface-variant">Ca:</span>
                <select class="bg-transparent text-xs font-bold text-on-surface focus:outline-none cursor-pointer pr-1"
                        value="@_selectedShiftId"
                        @onchange="OnShiftChangedAsync">
                    @if (!_allShifts.Any())
                    {
                        <option value="1">Ca #1 (Mặc định)</option>
                    }
                    else
                    {
                        @foreach (var s in _allShifts)
                        {
                            <option value="@s.ShiftId">
                                #@s.ShiftId - @s.StaffName (@(s.Status == 0 ? "Đang mở" : "Đã đóng") • @s.StartTime.ToString("dd/MM HH:mm"))
                            </option>
                        }
                    }
                </select>
            </div>

            <!-- Print Slip Button -->
            <button class="px-2.5 py-1 bg-surface hover:bg-surface-high border border-outline-variant rounded-lg text-xs font-semibold transition-colors cursor-pointer flex items-center gap-1 shadow-2xs"
                    @onclick="OpenPrintModal"
                    title="In biên bản đối soát ca">
                <span class="material-symbols-outlined text-[15px] text-primary">print</span>
                <span>In Biên Bản</span>
            </button>

            <!-- Export CSV Button -->
            <button class="px-2.5 py-1 bg-surface hover:bg-surface-high border border-outline-variant rounded-lg text-xs font-semibold transition-colors cursor-pointer flex items-center gap-1 shadow-2xs"
                    @onclick="ExportCsvAsync"
                    title="Xuất file báo cáo đối soát dạng CSV">
                <span class="material-symbols-outlined text-[15px] text-emerald-600">download</span>
                <span>Xuất CSV</span>
            </button>

            <!-- Refresh Button -->
            <button class="px-2.5 py-1 bg-surface-high hover:bg-outline-variant/30 border border-outline-variant rounded-lg text-xs font-semibold transition-colors cursor-pointer flex items-center gap-1 shadow-2xs"
                    @onclick="LoadDataAsync"
                    title="Tải lại toàn bộ dữ liệu">
                <span class="material-symbols-outlined text-[15px]">refresh</span>
                <span>Tải Lại</span>
            </button>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="bg-rose-500/10 border border-rose-500/30 text-rose-700 px-3 py-2 rounded-lg flex items-center justify-between text-xs animate-fade-in">
            <div class="flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[16px]">error</span>
                <span class="font-medium">@ErrorMessage</span>
            </div>
            <button class="hover:bg-rose-500/20 p-0.5 rounded-full transition-colors cursor-pointer" @onclick="() => ErrorMessage = null">
                <span class="material-symbols-outlined text-xs">close</span>
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="bg-emerald-500/10 border border-emerald-500/30 text-emerald-700 px-3 py-2 rounded-lg flex items-center justify-between text-xs animate-fade-in">
            <div class="flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[16px]">check_circle</span>
                <span class="font-bold">@SuccessMessage</span>
            </div>
            <button class="hover:bg-emerald-500/20 p-0.5 rounded-full transition-colors cursor-pointer" @onclick="() => SuccessMessage = null">
                <span class="material-symbols-outlined text-xs">close</span>
            </button>
        </div>
    }

    <!-- Shift Overview Status Banner -->
    @if (_shiftDetail != null)
    {
        <div class="bg-surface rounded-xl border border-outline-variant/60 p-2.5 sm:p-3 shadow-2xs">
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5 text-xs">
                <div>
                    <span class="text-on-surface-variant font-medium text-[10px] uppercase tracking-wider block">Ca làm việc:</span>
                    <div class="flex items-center gap-1.5 mt-0.5">
                        <span class="font-bold text-on-surface text-xs">Ca #@_shiftDetail.ShiftId</span>
                        <span class="px-1.5 py-0.2 rounded-full text-[9px] font-black @(_shiftDetail.Status == 0 ? "bg-emerald-500/15 text-emerald-700 border border-emerald-500/30" : "bg-gray-500/15 text-gray-700 border border-gray-500/30")">
                            @_shiftDetail.StatusName
                        </span>
                    </div>
                </div>

                <div>
                    <span class="text-on-surface-variant font-medium text-[10px] uppercase tracking-wider block">Thu ngân phụ trách:</span>
                    <span class="font-bold text-on-surface mt-0.5 block truncate text-xs">@_shiftDetail.StaffName</span>
                </div>

                <div>
                    <span class="text-on-surface-variant font-medium text-[10px] uppercase tracking-wider block">Thời gian ca:</span>
                    <span class="font-bold text-on-surface mt-0.5 block truncate text-xs">
                        @_shiftDetail.StartTime.ToString("HH:mm dd/MM") - @(_shiftDetail.EndTime?.ToString("HH:mm dd/MM") ?? "Hiện tại")
                    </span>
                </div>

                <div>
                    <span class="text-on-surface-variant font-medium text-[10px] uppercase tracking-wider block">Tiền két đầu ca:</span>
                    <span class="font-mono font-bold text-primary mt-0.5 block text-xs">@_shiftDetail.OpeningBalance.ToString("N0") đ</span>
                </div>

                <div>
                    <span class="text-on-surface-variant font-medium text-[10px] uppercase tracking-wider block">Nộp / Rút két ca:</span>
                    <span class="font-mono font-bold mt-0.5 block text-xs">
                        +@_shiftDetail.TotalTillIn.ToString("N0")đ / -@_shiftDetail.TotalTillOut.ToString("N0")đ
                    </span>
                </div>

                <div>
                    <span class="text-on-surface-variant font-medium text-[10px] uppercase tracking-wider block">Kỳ vọng trong két:</span>
                    <span class="font-mono font-black text-emerald-600 mt-0.5 block text-xs sm:text-sm">@_shiftDetail.ExpectedCash.ToString("N0") đ</span>
                </div>
            </div>
        </div>
    }

    <!-- 4 Top KPI Metric Cards (Compact, Balanced, Elegant) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-2.5">
        <!-- 1. Gross Sales -->
        <div class="bg-surface rounded-xl border border-outline-variant/60 p-2.5 sm:p-3 shadow-2xs hover:shadow-xs transition-all flex items-center justify-between">
            <div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-on-surface-variant block mb-0.5">
                    Tổng Doanh Thu Gốc
                </span>
                <div class="text-lg sm:text-xl font-black text-amber-600 font-mono tracking-tight leading-tight">
                    @EffectiveSalesSummary.GrossSales.ToString("N0") <span class="text-xs font-bold">đ</span>
                </div>
                <span class="text-[9px] text-on-surface-variant/80 mt-0.5 block">Trước giảm giá & voucher</span>
            </div>
            <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg bg-amber-500/10 text-amber-600 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[18px]">payments</span>
            </div>
        </div>

        <!-- 2. Discounts -->
        <div class="bg-surface rounded-xl border border-outline-variant/60 p-2.5 sm:p-3 shadow-2xs hover:shadow-xs transition-all flex items-center justify-between">
            <div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-on-surface-variant block mb-0.5">
                    Tổng Giảm Giá / Voucher
                </span>
                <div class="text-lg sm:text-xl font-black text-rose-600 font-mono tracking-tight leading-tight">
                    @(EffectiveSalesSummary.TotalDiscounts > 0 ? $"-{EffectiveSalesSummary.TotalDiscounts:N0}" : "0") <span class="text-xs font-bold">đ</span>
                </div>
                <span class="text-[9px] text-on-surface-variant/80 mt-0.5 block">Khuyến mãi & chiết khấu</span>
            </div>
            <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg bg-rose-500/10 text-rose-600 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[18px]">sell</span>
            </div>
        </div>

        <!-- 3. Net Sales -->
        <div class="bg-surface rounded-xl border border-outline-variant/60 p-2.5 sm:p-3 shadow-2xs hover:shadow-xs transition-all flex items-center justify-between">
            <div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-on-surface-variant block mb-0.5">
                    Doanh Thu Thực Thu
                </span>
                <div class="text-lg sm:text-xl font-black text-emerald-600 font-mono tracking-tight leading-tight">
                    @EffectiveSalesSummary.NetSales.ToString("N0") <span class="text-xs font-bold">đ</span>
                </div>
                <span class="text-[9px] text-emerald-600 font-bold mt-0.5 block">Doanh thu chốt thực tế</span>
            </div>
            <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg bg-emerald-500/10 text-emerald-600 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[18px]">account_balance_wallet</span>
            </div>
        </div>

        <!-- 4. Total Orders & AOV -->
        <div class="bg-surface rounded-xl border border-outline-variant/60 p-2.5 sm:p-3 shadow-2xs hover:shadow-xs transition-all flex items-center justify-between">
            <div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-on-surface-variant block mb-0.5">
                    Số Đơn & Giá Trị TB
                </span>
                <div class="text-lg sm:text-xl font-black text-blue-600 font-mono tracking-tight leading-tight">
                    @EffectiveSalesSummary.TotalOrders <span class="text-xs font-bold">đơn</span>
                </div>
                <span class="text-[10px] text-blue-600 font-bold mt-0.5 block font-mono">
                    TB: @EffectiveSalesSummary.AverageOrderValue.ToString("N0") đ/đơn
                </span>
            </div>
            <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg bg-blue-500/10 text-blue-600 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[18px]">receipt_long</span>
            </div>
        </div>
    </div>

    <!-- Main Workspace: 2-Column Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-3 items-start">
        
        <!-- Column 1 (Left, 7 Cols): Bảng Đối Soát Phương Thức Thanh Toán -->
        <div class="lg:col-span-7 bg-surface rounded-xl border border-outline-variant/60 p-3 sm:p-3.5 shadow-2xs space-y-2.5">
            <div class="flex items-center justify-between pb-2 border-b border-outline-variant/60">
                <h3 class="font-bold text-xs sm:text-sm text-primary flex items-center gap-1.5 m-0">
                    <span class="material-symbols-outlined text-[17px]">balance</span>
                    <span>ĐỐI SOÁT PHƯƠNG THỨC THANH TOÁN (HỆ THỐNG VS THỰC TẾ)</span>
                </h3>
                <span class="text-[10px] text-on-surface-variant font-medium">Đơn vị: VNĐ</span>
            </div>

            <!-- Reconciliation Table -->
            <div class="overflow-x-auto rounded-lg border border-outline-variant/60">
                <table class="w-full text-left text-xs">
                    <thead>
                        <tr class="bg-surface-high border-b border-outline-variant/60 text-on-surface-variant uppercase font-bold text-[10px]">
                            <th class="p-2 sm:p-2.5">Phương Thức</th>
                            <th class="p-2 sm:p-2.5 text-right">Hệ Thống Tính</th>
                            <th class="p-2 sm:p-2.5 text-right">Thực Tế Kiểm Đếm</th>
                            <th class="p-2 sm:p-2.5 text-center">Chênh Lệch</th>
                            <th class="p-2 sm:p-2.5">Ghi Chú Giải Trình</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant/50">
                        @if (!ReconciliationItems.Any())
                        {
                            <tr>
                                <td colspan="5" class="p-4 text-center text-on-surface-variant opacity-70 text-xs">
                                    Đang tải dữ liệu đối soát ca...
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in ReconciliationItems)
                            {
                                <tr class="hover:bg-surface-high/30 transition-colors">
                                    <!-- Method Name & Icon -->
                                    <td class="p-2 sm:p-2.5 font-bold text-xs text-on-surface">
                                        <div class="flex items-center gap-1.5">
                                            @if (item.PaymentMethod == 0)
                                            {
                                                <span class="w-6 h-6 rounded-md bg-emerald-500/10 text-emerald-600 flex items-center justify-center shrink-0">
                                                    <span class="material-symbols-outlined text-sm">local_atm</span>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="w-6 h-6 rounded-md bg-blue-500/10 text-blue-600 flex items-center justify-center shrink-0">
                                                    <span class="material-symbols-outlined text-sm">qr_code_2</span>
                                                </span>
                                            }
                                            <span>@item.PaymentMethodName</span>
                                        </div>
                                    </td>

                                    <!-- System Amount -->
                                    <td class="p-2 sm:p-2.5 text-right font-black text-primary font-mono text-xs sm:text-sm">
                                        @item.SystemAmount.ToString("N0") đ
                                    </td>

                                    <!-- Actual Amount Input + Quick Match Button -->
                                    <td class="p-2 sm:p-2.5 text-right">
                                        <div class="flex items-center justify-end gap-1">
                                            <input type="number"
                                                   class="w-28 px-2 py-1 rounded-md border border-outline-variant font-mono font-bold text-xs bg-surface-high focus:bg-surface focus:outline-none focus:ring-1 focus:ring-primary text-right"
                                                   @bind="item.ActualAmount"
                                                   step="1000" />
                                            <button type="button"
                                                    class="px-1.5 py-1 bg-primary/10 hover:bg-primary/20 text-primary rounded-md text-[10px] font-bold cursor-pointer transition-colors"
                                                    @onclick="() => MatchSystemAmount(item)"
                                                    title="Gán số thực tế khớp 100% với hệ thống">
                                                Khớp
                                            </button>
                                        </div>
                                    </td>

                                    <!-- Difference Badge -->
                                    <td class="p-2 sm:p-2.5 text-center">
                                        @if (item.Difference == 0)
                                        {
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-emerald-500/15 text-emerald-700 border border-emerald-500/30 inline-flex items-center gap-0.5">
                                                <span class="material-symbols-outlined text-[11px]">check</span>
                                                0 đ
                                            </span>
                                        }
                                        else if (item.Difference > 0)
                                        {
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-amber-500/15 text-amber-800 border border-amber-500/30 inline-flex items-center gap-0.5">
                                                <span class="material-symbols-outlined text-[11px]">arrow_upward</span>
                                                +@item.Difference.ToString("N0") đ
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-rose-500/15 text-rose-700 border border-rose-500/30 inline-flex items-center gap-0.5">
                                                <span class="material-symbols-outlined text-[11px]">arrow_downward</span>
                                                @item.Difference.ToString("N0") đ
                                            </span>
                                        }
                                    </td>

                                    <!-- Note Input -->
                                    <td class="p-2 sm:p-2.5">
                                        <input type="text"
                                               class="w-full px-2 py-1 rounded-md border border-outline-variant text-xs bg-surface-high focus:bg-surface focus:outline-none focus:ring-1 focus:ring-primary"
                                               placeholder="Ghi chú (nếu có)..."
                                               @bind="item.Note" />
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    <!-- Totals Footer -->
                    <tfoot>
                        <tr class="bg-surface-high/80 font-bold text-xs border-t border-outline-variant">
                            <td class="p-2 sm:p-2.5 uppercase text-on-surface">TỔNG CỘNG:</td>
                            <td class="p-2 sm:p-2.5 text-right font-mono text-primary text-xs sm:text-sm font-black">@TotalSystemAmount.ToString("N0") đ</td>
                            <td class="p-2 sm:p-2.5 text-right font-mono text-on-surface text-xs sm:text-sm font-black">@TotalActualAmount.ToString("N0") đ</td>
                            <td class="p-2 sm:p-2.5 text-center">
                                @if (TotalDifference == 0)
                                {
                                    <span class="text-emerald-600 font-mono font-bold text-xs">0 đ (Cân khớp)</span>
                                }
                                else
                                {
                                    <span class="text-rose-600 font-mono font-bold text-xs">
                                        @(TotalDifference > 0 ? $"+{TotalDifference:N0}" : $"{TotalDifference:N0}") đ
                                    </span>
                                }
                            </td>
                            <td class="p-2 sm:p-2.5 text-right">
                                <button type="button"
                                        class="px-2 py-0.5 bg-surface border border-outline-variant hover:bg-surface-high text-primary rounded-md text-[11px] font-semibold cursor-pointer transition-colors shadow-2xs"
                                        @onclick="MatchAllSystemAmounts">
                                    Khớp Tất Cả 100%
                                </button>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Validation Status Indicator -->
            <div class="p-2 rounded-lg border text-xs flex items-center justify-between @(TotalDifference == 0 ? "bg-emerald-500/10 border-emerald-500/30 text-emerald-800" : "bg-amber-500/10 border-amber-500/30 text-amber-900")">
                <div class="flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-base">@(TotalDifference == 0 ? "verified" : "warning")</span>
                    @if (TotalDifference == 0)
                    {
                        <span class="font-semibold text-xs">Số liệu đối soát thực tế hoàn toàn trùng khớp với hệ thống.</span>
                    }
                    else
                    {
                        <span class="font-semibold text-xs">Phát hiện chênh lệch @(TotalDifference > 0 ? $"+{TotalDifference:N0}" : $"{TotalDifference:N0}") đ. Vui lòng kiểm tra và ghi chú lý do giải trình.</span>
                    }
                </div>
                <span class="font-black text-[10px] uppercase shrink-0 ml-2">
                    @(TotalDifference == 0 ? "CÂN KHỚP 100%" : "CẦN GIẢI TRÌNH")
                </span>
            </div>

            <!-- Save Action Button -->
            <div class="flex justify-end pt-1">
                <button class="px-4 py-1.5 bg-emerald-600 hover:bg-emerald-700 disabled:opacity-50 text-white font-bold text-xs rounded-lg shadow-2xs cursor-pointer flex items-center gap-1.5 transition-all active:scale-95"
                        disabled="@_isSaving"
                        @onclick="SaveReconciliationAsync">
                    @if (_isSaving)
                    {
                        <span class="animate-spin rounded-full h-3 w-3 border-b-2 border-white"></span>
                        <span>Đang lưu...</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-[15px]">save</span>
                        <span>LƯU ĐỐI SOÁT THANH TOÁN</span>
                    }
                </button>
            </div>
        </div>

        <!-- Column 2 (Right, 5 Cols): Tỷ Trọng Doanh Thu & Kiểm Quỹ Tiền Mặt -->
        <div class="lg:col-span-5 space-y-3">
            
            <!-- Card 1: Payment Method Proportion Breakdown -->
            <div class="bg-surface rounded-xl border border-outline-variant/60 p-3 shadow-2xs space-y-2.5">
                <h4 class="font-bold text-xs text-primary flex items-center gap-1.5 m-0 pb-1.5 border-b border-outline-variant/60">
                    <span class="material-symbols-outlined text-[15px]">pie_chart</span>
                    <span>TỶ TRỌNG THANH TOÁN THEO PHƯƠNG THỨC</span>
                </h4>

                <!-- Segmented Proportion Bar -->
                <div class="space-y-1">
                    <div class="w-full h-3 rounded-full bg-surface-high overflow-hidden flex shadow-inner">
                        <div class="bg-emerald-500 h-full transition-all duration-500"
                             style="width: @(CashPercentage)%"
                             title="Tiền mặt: @(CashPercentage.ToString("F1"))%"></div>
                        <div class="bg-blue-500 h-full transition-all duration-500"
                             style="width: @(TransferPercentage)%"
                             title="Chuyển khoản: @(TransferPercentage.ToString("F1"))%"></div>
                    </div>
                </div>

                <!-- Legend & Detailed Values -->
                <div class="grid grid-cols-2 gap-2 text-xs">
                    <div class="p-2 bg-emerald-500/10 rounded-lg border border-emerald-500/20">
                        <div class="flex items-center gap-1 font-bold text-emerald-700 text-[11px]">
                            <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
                            <span>Tiền Mặt: @(CashPercentage.ToString("F1"))%</span>
                        </div>
                        <div class="font-mono font-black text-on-surface text-xs sm:text-sm mt-0.5">
                            @CashSystemAmount.ToString("N0") đ
                        </div>
                    </div>

                    <div class="p-2 bg-blue-500/10 rounded-lg border border-blue-500/20">
                        <div class="flex items-center gap-1 font-bold text-blue-700 text-[11px]">
                            <span class="w-2 h-2 rounded-full bg-blue-500 shrink-0"></span>
                            <span>VietQR: @(TransferPercentage.ToString("F1"))%</span>
                        </div>
                        <div class="font-mono font-black text-on-surface text-xs sm:text-sm mt-0.5">
                            @TransferSystemAmount.ToString("N0") đ
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 2: Cash Drawer Audit Formula (Kiểm Quỹ Két Tiền) -->
            <div class="bg-surface rounded-xl border border-outline-variant/60 p-3 shadow-2xs space-y-2">
                <h4 class="font-bold text-xs text-primary flex items-center gap-1.5 m-0 pb-1.5 border-b border-outline-variant/60">
                    <span class="material-symbols-outlined text-[15px]">point_of_sale</span>
                    <span>CÔNG THỨC KIỂM QUỸ KÉT TIỀN MẶT</span>
                </h4>

                <div class="space-y-1 text-xs divide-y divide-outline-variant/40">
                    <div class="flex justify-between items-center pt-1 text-on-surface-variant text-[11px]">
                        <span>(+) Tiền mặt đầu ca (Float):</span>
                        <span class="font-mono font-bold text-on-surface">@(_shiftDetail?.OpeningBalance.ToString("N0") ?? "0") đ</span>
                    </div>
                    <div class="flex justify-between items-center pt-1 text-on-surface-variant text-[11px]">
                        <span>(+) Doanh thu tiền mặt bán hàng:</span>
                        <span class="font-mono font-bold text-emerald-600">+@CashSystemAmount.ToString("N0") đ</span>
                    </div>
                    <div class="flex justify-between items-center pt-1 text-on-surface-variant text-[11px]">
                        <span>(+) Nộp thêm tiền két (Till In):</span>
                        <span class="font-mono font-bold text-on-surface">+@(_shiftDetail?.TotalTillIn.ToString("N0") ?? "0") đ</span>
                    </div>
                    <div class="flex justify-between items-center pt-1 text-on-surface-variant text-[11px]">
                        <span>(-) Rút tiền két (Till Out):</span>
                        <span class="font-mono font-bold text-rose-600">-@(_shiftDetail?.TotalTillOut.ToString("N0") ?? "0") đ</span>
                    </div>
                    <div class="flex justify-between items-center pt-1 text-on-surface-variant text-[11px]">
                        <span>(-) Hoàn tiền mặt đơn hủy:</span>
                        <span class="font-mono font-bold text-rose-600">-@(_shiftDetail?.TotalRefunds.ToString("N0") ?? "0") đ</span>
                    </div>
                    <div class="flex justify-between items-center pt-1.5 font-bold text-xs text-on-surface">
                        <span>(=) Tiền mặt lý thuyết trong két:</span>
                        <span class="font-mono text-primary font-black text-xs sm:text-sm">@ExpectedCashAmount.ToString("N0") đ</span>
                    </div>
                    <div class="flex justify-between items-center pt-1 text-xs text-on-surface-variant">
                        <span>(vs) Tiền mặt thực tế đếm được:</span>
                        <span class="font-mono font-black text-on-surface text-xs sm:text-sm">@CashActualAmount.ToString("N0") đ</span>
                    </div>
                    <div class="flex justify-between items-center pt-1.5 font-bold text-xs">
                        <span>(=>) Chênh lệch quỹ két tiền mặt:</span>
                        <span class="font-mono text-xs sm:text-sm @(CashDrawerDifference == 0 ? "text-emerald-600 font-black" : "text-rose-600 font-black")">
                            @(CashDrawerDifference > 0 ? $"+{CashDrawerDifference:N0}" : $"{CashDrawerDifference:N0}") đ
                        </span>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Orders Audit Table in this Shift -->
    @if (_shiftDetail?.Orders != null && _shiftDetail.Orders.Any())
    {
        <div class="bg-surface rounded-xl border border-outline-variant/60 p-3 sm:p-3.5 shadow-2xs space-y-2.5">

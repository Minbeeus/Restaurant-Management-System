@page "/admin/staff"
@page "/admin/system/users"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.AdminLayout
@using Restaurant.Application.DTOs
@using Restaurant.Web.Services
@inject AdminApiClient ApiClient

<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
    <div>
        <h2 class="text-2xl font-headline-sm text-primary m-0">@L["Staff_Management_Title"]</h2>
        <p class="text-on-surface-variant text-sm mt-1">@L["Staff_Sub"]</p>
    </div>
    <button class="bg-primary text-on-primary px-4 py-2 rounded font-label-bold shadow-sm hover:bg-primary/90 transition-colors flex items-center" @onclick="OpenAddModal">
        <span class="material-symbols-outlined align-middle text-sm mr-1" data-icon="person_add">person_add</span> @L["Staff_Add_New"]
    </button>
</div>

@if (_isLoading)
{
    <div class="flex justify-center p-12">
        <span class="material-symbols-outlined animate-spin text-4xl text-primary" data-icon="progress_activity">progress_activity</span>
    </div>
}
else
{
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead class="bg-surface-container-low border-b border-outline-variant/30 text-on-surface-variant font-label-bold text-xs uppercase">
                <tr>
                    <th class="p-4 w-16 text-center">@L["Area_Header_ID"]</th>
                    <th class="p-4">@L["Staff_Col_FullName"]</th>
                    <th class="p-4">@L["Staff_Col_Username"]</th>
                    <th class="p-4 text-center">@L["Staff_Col_Role"]</th>
                    <th class="p-4">@L["Staff_Col_Phone"]</th>
                    <th class="p-4 text-center">@L["Staff_Col_Status"]</th>
                    <th class="p-4 text-center w-36">@L["Staff_Col_Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in _users)
                {
                    <tr class="border-b border-outline-variant/20 last:border-0 hover:bg-surface-low/50 transition-colors">
                        <td class="p-4 text-center text-on-surface-variant">#@user.Id</td>
                        <td class="p-4 font-bold text-on-background">@user.FullName</td>
                        <td class="p-4 font-mono text-sm text-primary">@@@user.Username</td>
                        <td class="p-4 text-center">
                            @if (user.RoleName == "Admin")
                            {
                                <span class="px-2.5 py-1 bg-primary/10 text-primary rounded-full text-xs font-bold border border-primary/20">Admin</span>
                            }
                            else if (user.RoleName == "Manager")
                            {
                                <span class="px-2.5 py-1 bg-secondary-container/40 text-secondary rounded-full text-xs font-bold border border-secondary/20">Manager</span>
                            }
                            else
                            {
                                <span class="px-2.5 py-1 bg-surface-variant text-on-surface-variant rounded-full text-xs font-bold">@user.RoleName</span>
                            }
                        </td>
                        <td class="p-4 font-mono text-sm text-on-surface-variant">@(user.PhoneNumber ?? "---")</td>
                        <td class="p-4 text-center">
                            @if (user.IsActive)
                            {
                                <span class="px-2.5 py-1 bg-success-green/10 text-success-green rounded-full text-xs font-bold border border-success-green/20">@L["Staff_Active"]</span>
                            }
                            else
                            {
                                <span class="px-2.5 py-1 bg-on-surface-variant/10 text-on-surface-variant rounded-full text-xs font-bold">@L["Staff_Inactive"]</span>
                            }
                        </td>
                        <td class="p-4 text-center space-x-1">
                            <button class="text-on-surface-variant hover:text-primary hover:bg-primary-container/20 p-2 rounded-full transition-colors" title="@(user.IsActive ? "Khóa tài khoản" : "Kích hoạt tài khoản")" @onclick="() => ToggleStatus(user.Id)">
                                <span class="material-symbols-outlined text-sm">@(user.IsActive ? "lock" : "lock_open")</span>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Modal Add Staff -->
@if (_showModal)
{
    <div class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-surface-container-lowest rounded-xl shadow-lg w-full max-w-md overflow-hidden">
            <div class="px-6 py-4 border-b border-outline-variant/30 flex justify-between items-center bg-surface-container-low">
                <h3 class="font-bold text-on-background m-0">@(_isEditing ? L["Staff_Modal_Update"] : L["Staff_Modal_Create"])</h3>
                <button class="text-on-surface-variant hover:text-error" @onclick="CloseModal">
                    <span class="material-symbols-outlined" data-icon="close">close</span>
                </button>
            </div>

            <div class="p-6 space-y-4">
                <div>
                    <label class="block text-sm font-bold text-on-surface mb-1">@L["Staff_FullName_Label"] <span class="text-error">*</span></label>
                    <input type="text" @bind="_model.FullName" class="w-full px-3 py-2 border border-outline rounded bg-surface text-sm focus:outline-none focus:border-primary" placeholder="VD: Nguyễn Văn Nam" />
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-bold text-on-surface mb-1">@L["Staff_Username_Label"] <span class="text-error">*</span></label>
                        <input type="text" @bind="_model.Username" class="w-full px-3 py-2 border border-outline rounded bg-surface text-sm focus:outline-none focus:border-primary font-mono" placeholder="namnv" />
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-on-surface mb-1">@L["Staff_Role_Label"]</label>
                        <select @bind="_model.RoleId" class="w-full px-3 py-2 border border-outline rounded bg-surface text-sm focus:outline-none focus:border-primary">
                            <option value="1">Admin</option>
                            <option value="2">Manager</option>
                            <option value="3">Thu ngân (Cashier)</option>
                            <option value="4">Đầu bếp (Chef)</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-bold text-on-surface mb-1">@L["Staff_Phone_Label"]</label>
                    <input type="text" @bind="_model.PhoneNumber" class="w-full px-3 py-2 border border-outline rounded bg-surface text-sm focus:outline-none focus:border-primary font-mono" placeholder="0912345678" />
                </div>
            </div>

            <div class="px-6 py-4 border-t border-outline-variant/30 flex justify-end gap-3 bg-surface-container-low">
                <button class="px-4 py-2 text-on-surface-variant hover:bg-surface-low rounded text-sm font-bold" @onclick="CloseModal">@L["Common_Cancel"]</button>
                <button class="px-4 py-2 bg-primary text-on-primary rounded text-sm font-bold shadow-sm hover:bg-primary/90 flex items-center" disabled="@_isSaving" @onclick="SaveUser">
                    @if (_isSaving)
                    {
                        <span class="material-symbols-outlined animate-spin text-sm mr-2" data-icon="progress_activity">progress_activity</span>
                        <span>@L["Common_Saving"]</span>
                    }
                    else
                    {
                        <span>@L["Staff_Save_Btn"]</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<UserDto> _users = new();
    private bool _isLoading = true;
    private bool _showModal = false;
    private bool _isEditing = false;
    private bool _isSaving = false;

    private StaffFormModel _model = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            _users = await ApiClient.GetUsersAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenAddModal()
    {
        _isEditing = false;
        _model = new StaffFormModel { RoleId = 3 };
        _showModal = true;
    }

    private void OpenEditModal(UserDto user)
    {
        _isEditing = true;
        _model = new StaffFormModel
        {
            FullName = user.FullName,
            Username = user.Username,
            PhoneNumber = user.PhoneNumber,
            RoleId = user.RoleName == "Admin" ? 1 : (user.RoleName == "Manager" ? 2 : 3)
        };
        _showModal = true;
    }

    private void CloseModal() => _showModal = false;

    private string? _errorMessage;

    private async Task SaveUser()
    {
        if (string.IsNullOrWhiteSpace(_model.FullName) || string.IsNullOrWhiteSpace(_model.Username))
        {
            _errorMessage = "Vui lòng nhập họ tên và tên đăng nhập.";
            return;
        }

        _isSaving = true;
        _errorMessage = null;
        try
        {
            var req = new CreateUserRequest
            {
                FullName = _model.FullName,
                Username = _model.Username,
                RoleId = _model.RoleId,
                PhoneNumber = _model.PhoneNumber,
                Password = "Password123!"
            };

            await ApiClient.CreateUserAsync(req);
            _showModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Lỗi khi lưu tài khoản: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ToggleStatus(int userId)
    {
        try
        {
            await ApiClient.ToggleUserStatusAsync(userId);
            await LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }
    }

    public class StaffFormModel
    {
        public string FullName { get; set; } = string.Empty;
        public string Username { get; set; } = string.Empty;
        public int RoleId { get; set; } = 3;
        public string? PhoneNumber { get; set; }
    }
}

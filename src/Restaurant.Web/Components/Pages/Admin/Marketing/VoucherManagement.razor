@page "/admin/vouchers"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.AdminLayout
@using Restaurant.Web.Services
@inject AdminApiClient ApiClient

<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
    <div>
        <h2 class="text-2xl font-headline-sm text-primary m-0">@L["Voucher_Management_Title"]</h2>
        <p class="text-on-surface-variant text-sm mt-1">@L["Voucher_Sub"]</p>
    </div>
    <button class="bg-primary text-on-primary px-4 py-2 rounded font-label-bold shadow-sm hover:bg-primary/90 transition-colors flex items-center" @onclick="OpenAddModal">
        <span class="material-symbols-outlined align-middle text-sm mr-1" data-icon="confirmation_number">confirmation_number</span> @L["Voucher_Add_New"]
    </button>
</div>

@if (_isLoading)
{
    <div class="flex justify-center p-12">
        <span class="material-symbols-outlined animate-spin text-4xl text-primary" data-icon="progress_activity">progress_activity</span>
    </div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        @foreach (var v in _vouchers)
        {
            <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-6 flex flex-col justify-between hover:border-primary/50 transition-colors">
                <div>
                    <div class="flex justify-between items-start mb-3">
                        <div class="flex items-center gap-2">
                            <span class="px-3 py-1 bg-primary-container text-on-primary-container rounded font-mono font-bold text-base border border-primary/20">@v.Code</span>
                        </div>
                        @if (v.IsActive)
                        {
                            <span class="px-2.5 py-1 bg-success-green/10 text-success-green rounded-full text-xs font-bold border border-success-green/20">@L["Voucher_Status_Active"]</span>
                        }
                        else
                        {
                            <span class="px-2.5 py-1 bg-on-surface-variant/10 text-on-surface-variant rounded-full text-xs font-bold">@L["Voucher_Status_Expired"]</span>
                        }
                    </div>

                    <div class="space-y-2 text-sm text-on-surface-variant mt-4">
                        <div class="text-on-surface font-bold">
                            @if (v.DiscountType == "Percentage")
                            {
                                <span>@string.Format(L["Voucher_Discount_Pct"], v.DiscountValue)</span>
                            }
                            else
                            {
                                <span>@string.Format(L["Voucher_Discount_Fixed"], v.DiscountValue.ToString("N0"))</span>
                            }
                        </div>
                        <div>@string.Format(L["Voucher_Min_Order"], (v.MinOrderAmount ?? 0).ToString("N0"))</div>
                        <div>@string.Format(L["Voucher_Usage"], v.UsedCount, v.UsageLimit)</div>
                        <div class="text-xs text-on-surface-variant">@string.Format(L["Voucher_Validity"], v.StartDate.ToString("dd/MM/yyyy"), v.EndDate.ToString("dd/MM/yyyy"))</div>
                    </div>
                </div>

                <div class="flex justify-end gap-2 pt-4 mt-6 border-t border-outline-variant/30">
                    <button class="px-3 py-1.5 text-xs bg-surface-container text-on-surface hover:bg-surface-low rounded font-bold transition-colors" @onclick="() => OpenEditModal(v)">
                        @L["Common_Edit"]
                    </button>
                </div>
            </div>
        }
    </div>
}

<!-- Modal Add/Edit Voucher -->
@if (_showModal)
{
    <div class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-surface-container-lowest rounded-xl shadow-lg w-full max-w-md overflow-hidden">
            <div class="px-6 py-4 border-b border-outline-variant/30 flex justify-between items-center bg-surface-container-low">
                <h3 class="font-bold text-on-background m-0">@(_isEditing ? L["Voucher_Modal_Update"] : L["Voucher_Modal_Create"])</h3>
                <button class="text-on-surface-variant hover:text-error" @onclick="CloseModal">
                    <span class="material-symbols-outlined" data-icon="close">close</span>
                </button>
            </div>

            <div class="p-6 space-y-4">
                <div>
                    <label class="block text-sm font-bold text-on-surface mb-1">@L["Voucher_Code_Label"] <span class="text-error">*</span></label>
                    <input type="text" @bind="_model.Code" class="w-full px-3 py-2 border border-outline rounded bg-surface text-sm focus:outline-none focus:border-primary font-mono uppercase" placeholder="VD: MOZZARELLA10" />
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-bold text-on-surface mb-1">@L["Voucher_Type_Label"]</label>
                        <select @bind="_model.DiscountType" class="w-full px-3 py-2 border border-outline rounded bg-surface text-sm focus:outline-none focus:border-primary">
                            <option value="Percentage">@L["Voucher_Type_Pct"]</option>
                            <option value="FixedAmount">@L["Voucher_Type_Fixed"]</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-on-surface mb-1">@L["Voucher_Value_Label"]</label>
                        <input type="number" @bind="_model.DiscountValue" class="w-full px-3 py-2 border border-outline rounded bg-surface text-sm focus:outline-none focus:border-primary font-mono" />
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-bold text-on-surface mb-1">@L["Voucher_Min_Order_Label"]</label>
                        <input type="number" @bind="_model.MinOrderAmount" class="w-full px-3 py-2 border border-outline rounded bg-surface text-sm focus:outline-none focus:border-primary font-mono" />
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-on-surface mb-1">@L["Voucher_Limit_Label"]</label>
                        <input type="number" @bind="_model.UsageLimit" class="w-full px-3 py-2 border border-outline rounded bg-surface text-sm focus:outline-none focus:border-primary font-mono" />
                    </div>
                </div>
            </div>

            <div class="px-6 py-4 border-t border-outline-variant/30 flex justify-end gap-3 bg-surface-container-low">
                <button class="px-4 py-2 text-on-surface-variant hover:bg-surface-low rounded text-sm font-bold" @onclick="CloseModal">@L["Common_Cancel"]</button>
                <button class="px-4 py-2 bg-primary text-on-primary rounded text-sm font-bold shadow-sm hover:bg-primary/90 flex items-center" disabled="@_isSaving" @onclick="SaveVoucher">
                    @if (_isSaving)
                    {
                        <span class="material-symbols-outlined animate-spin text-sm mr-2" data-icon="progress_activity">progress_activity</span>
                        <span>@L["Common_Saving"]</span>
                    }
                    else
                    {
                        <span>@L["Voucher_Save_Btn"]</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<VoucherDto> _vouchers = new();
    private bool _isLoading = true;
    private bool _showModal = false;
    private bool _isEditing = false;
    private bool _isSaving = false;

    private VoucherFormModel _model = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            _vouchers = await ApiClient.GetVouchersAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenAddModal()
    {
        _isEditing = false;
        _model = new VoucherFormModel { DiscountType = "Percentage", DiscountValue = 10, MinOrderAmount = 200000, UsageLimit = 100 };
        _showModal = true;
    }

    private void OpenEditModal(VoucherDto v)
    {
        _isEditing = true;
        _model = new VoucherFormModel
        {
            Code = v.Code,
            DiscountType = v.DiscountType,
            DiscountValue = v.DiscountValue,
            MinOrderAmount = v.MinOrderAmount ?? 0,
            UsageLimit = v.UsageLimit
        };
        _showModal = true;
    }

    private void CloseModal() => _showModal = false;

    private async Task SaveVoucher()
    {
        if (string.IsNullOrWhiteSpace(_model.Code)) return;

        _isSaving = true;
        await Task.Delay(300);
        _showModal = false;
        _isSaving = false;
    }

    public class VoucherFormModel
    {
        public string Code { get; set; } = string.Empty;
        public string DiscountType { get; set; } = "Percentage";
        public decimal DiscountValue { get; set; } = 10;
        public decimal MinOrderAmount { get; set; } = 200000;
        public int UsageLimit { get; set; } = 100;
    }
}

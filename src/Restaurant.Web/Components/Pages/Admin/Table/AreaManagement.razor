@page "/admin/areas"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.AdminLayout
@using Restaurant.Application.DTOs
@using Restaurant.Web.Services
@inject TableApiClient ApiClient

<div class="flex justify-between items-center mb-6">
    <h2 class="text-2xl font-headline-sm text-primary">Quản lý Khu vực (Areas)</h2>
    <button class="bg-primary text-on-primary px-4 py-2 rounded font-label-bold shadow-sm hover:bg-primary/90 transition-colors" @onclick="OpenAddModal">
        <span class="material-symbols-outlined align-middle text-sm mr-1" data-icon="add">add</span> Thêm Khu vực
    </button>
</div>

@if (_isLoading)
{
    <div class="flex justify-center p-12">
        <span class="material-symbols-outlined animate-spin text-4xl text-primary" data-icon="progress_activity">progress_activity</span>
    </div>
}
else
{
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead class="bg-surface-container-low border-b border-outline-variant/30 text-on-surface-variant font-label-bold">
                <tr>
                    <th class="p-4 font-semibold text-center w-16">ID</th>
                    <th class="p-4 font-semibold">Tên Khu vực</th>
                    <th class="p-4 font-semibold text-center w-32">Số lượng Bàn</th>
                    <th class="p-4 font-semibold text-center w-24">Sắp xếp</th>
                    <th class="p-4 font-semibold text-center w-32">Trạng thái</th>
                    <th class="p-4 font-semibold text-center w-32">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (!_areas.Any())
                {
                    <tr>
                        <td colspan="6" class="p-8 text-center text-on-surface-variant">Chưa có khu vực nào.</td>
                    </tr>
                }
                @foreach (var area in _areas)
                {
                    <tr class="border-b border-outline-variant/20 last:border-0 hover:bg-surface-low/50 transition-colors">
                        <td class="p-4 text-center text-on-surface-variant">#@area.Id</td>
                        <td class="p-4 font-label-bold text-on-background text-base">@area.Name</td>
                        <td class="p-4 text-center">
                            <span class="px-2 py-1 bg-surface-container rounded text-sm font-bold text-primary">@area.TableCount Bàn</span>
                        </td>
                        <td class="p-4 text-center">@area.SortOrder</td>
                        <td class="p-4 text-center">
                            @if (area.IsActive)
                            {
                                <span class="px-2 py-1 bg-success-green/10 text-success-green rounded text-xs font-bold border border-success-green/20">Hoạt động</span>
                            }
                            else
                            {
                                <span class="px-2 py-1 bg-on-surface-variant/10 text-on-surface-variant rounded text-xs font-bold border border-on-surface-variant/20">Tạm ẩn</span>
                            }
                        </td>
                        <td class="p-4 text-center space-x-1">
                            <button class="text-primary hover:bg-primary-container p-2 rounded-full transition-colors" title="Sửa" @onclick="() => OpenEditModal(area)">
                                <span class="material-symbols-outlined text-sm" data-icon="edit">edit</span>
                            </button>
                            <button class="text-error hover:bg-error-container p-2 rounded-full transition-colors" title="Xóa" @onclick="() => ConfirmDelete(area)">
                                <span class="material-symbols-outlined text-sm" data-icon="delete">delete</span>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Modal Add/Edit -->
@if (_showModal)
{
    <div class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-surface-container-lowest rounded-xl shadow-lg w-full max-w-md flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-200">
            <div class="px-6 py-4 border-b border-outline-variant/30 flex justify-between items-center bg-surface-container-low">
                <h3 class="font-headline-sm text-on-background m-0">@(_isEditing ? "Cập nhật Khu vực" : "Thêm Khu vực mới")</h3>
                <button class="text-on-surface-variant hover:text-error transition-colors" @onclick="CloseModal">
                    <span class="material-symbols-outlined" data-icon="close">close</span>
                </button>
            </div>
            
            <div class="p-6 overflow-y-auto">
                <EditForm Model="@_model" OnValidSubmit="SaveArea">
                    <DataAnnotationsValidator />
                    
                    <div class="mb-4">
                        <label class="block text-sm font-label-bold text-on-surface mb-1">Tên Khu vực (VD: Tầng 1, Sân Vườn) <span class="text-error">*</span></label>
                        <InputText @bind-Value="_model.Name" class="w-full px-3 py-2 border border-outline rounded bg-surface-container-lowest focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-shadow" placeholder="Tên khu vực" />
                    </div>

                    <div class="grid grid-cols-2 gap-4 mb-6">
                        <div>
                            <label class="block text-sm font-label-bold text-on-surface mb-1">Thứ tự hiển thị</label>
                            <InputNumber @bind-Value="_model.SortOrder" class="w-full px-3 py-2 border border-outline rounded bg-surface-container-lowest focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-shadow" />
                        </div>
                        @if (_isEditing)
                        {
                            <div class="flex items-center pt-6">
                                <label class="flex items-center cursor-pointer">
                                    <InputCheckbox @bind-Value="_model.IsActive" class="w-4 h-4 text-primary bg-surface-container border-outline rounded focus:ring-primary focus:ring-2" />
                                    <span class="ml-2 text-sm text-on-surface font-bold">Đang hoạt động</span>
                                </label>
                            </div>
                        }
                    </div>
                    
                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="mb-4 p-3 bg-error-container text-on-error-container rounded text-sm border border-error/20">
                            @_errorMessage
                        </div>
                    }

                    <div class="flex justify-end gap-3 pt-4 border-t border-outline-variant/30">
                        <button type="button" class="px-4 py-2 text-on-surface-variant hover:bg-surface-low rounded transition-colors font-label-bold" @onclick="CloseModal">Hủy</button>
                        <button type="submit" class="px-4 py-2 bg-primary text-on-primary rounded shadow-sm hover:bg-primary/90 transition-colors font-label-bold flex items-center" disabled="@_isSaving">
                            @if (_isSaving)
                            {
                                <span class="material-symbols-outlined animate-spin text-sm mr-2" data-icon="progress_activity">progress_activity</span>
                                <span>Đang lưu...</span>
                            }
                            else
                            {
                                <span>Lưu thay đổi</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation -->
@if (_showDeleteConfirm)
{
    <div class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-surface-container-lowest rounded-xl shadow-lg w-full max-w-sm overflow-hidden">
            <div class="p-6 text-center">
                <div class="w-16 h-16 rounded-full bg-error-container text-error mx-auto flex items-center justify-center mb-4">
                    <span class="material-symbols-outlined text-3xl" data-icon="warning">warning</span>
                </div>
                <h3 class="text-xl font-bold text-on-background mb-2">Xác nhận xóa?</h3>
                <p class="text-on-surface-variant text-sm mb-6">Bạn có chắc chắn muốn xóa khu vực <strong>@_areaToDelete?.Name</strong> không? Hành động này không thể hoàn tác.</p>
                
                @if (!string.IsNullOrEmpty(_deleteErrorMessage))
                {
                    <div class="mb-6 p-3 bg-error-container text-error rounded text-sm text-left border border-error/20">
                        @_deleteErrorMessage
                    </div>
                }

                <div class="flex justify-center gap-3">
                    <button class="px-4 py-2 border border-outline text-on-surface rounded hover:bg-surface-low transition-colors font-label-bold flex-1" @onclick="() => _showDeleteConfirm = false">Hủy</button>
                    <button class="px-4 py-2 bg-error text-white rounded hover:bg-error/90 transition-colors font-label-bold flex-1 flex items-center justify-center gap-2" @onclick="ExecuteDelete" disabled="@_isDeleting">
                        @if (_isDeleting)
                        {
                            <span class="material-symbols-outlined animate-spin text-sm" data-icon="progress_activity">progress_activity</span>
                        }
                        Xóa ngay
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<AreaDto> _areas = new();
    private bool _isLoading = true;
    
    // Modal state
    private bool _showModal = false;
    private bool _isEditing = false;
    private bool _isSaving = false;
    private string? _errorMessage;
    private int _editingId;

    // Delete state
    private bool _showDeleteConfirm = false;
    private AreaDto? _areaToDelete;
    private bool _isDeleting = false;
    private string? _deleteErrorMessage;

    // Form Model
    private AreaFormModel _model = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERROR OnInitialized Area]: {ex}");
            _areas = new List<AreaDto>();
        }
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            _areas = await ApiClient.GetAreasAsync();
            _areas = _areas.OrderBy(a => a.SortOrder).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading areas: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenAddModal()
    {
        _isEditing = false;
        _model = new AreaFormModel { IsActive = true, SortOrder = (_areas.Count > 0 ? _areas.Max(a => a.SortOrder) + 1 : 1) };
        _errorMessage = null;
        _showModal = true;
    }

    private void OpenEditModal(AreaDto area)
    {
        _isEditing = true;
        _editingId = area.Id;
        _model = new AreaFormModel
        {
            Name = area.Name,
            SortOrder = area.SortOrder,
            IsActive = area.IsActive
        };
        _errorMessage = null;
        _showModal = true;
    }

    private void CloseModal()
    {
        _showModal = false;
    }

    private async Task SaveArea()
    {
        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            _errorMessage = "Tên khu vực không được để trống.";
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            if (_isEditing)
            {
                var request = new UpdateAreaRequest
                {
                    Name = _model.Name,
                    SortOrder = _model.SortOrder,
                    IsActive = _model.IsActive
                };
                await ApiClient.UpdateAreaAsync(_editingId, request);
            }
            else
            {
                var request = new CreateAreaRequest
                {
                    Name = _model.Name,
                    SortOrder = _model.SortOrder
                };
                await ApiClient.CreateAreaAsync(request);
            }

            _showModal = false;
            await LoadData();
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = "Lỗi khi lưu dữ liệu. Vui lòng kiểm tra lại.";
            Console.WriteLine(ex);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ConfirmDelete(AreaDto area)
    {
        _areaToDelete = area;
        _deleteErrorMessage = null;
        _showDeleteConfirm = true;
    }

    private async Task ExecuteDelete()
    {
        if (_areaToDelete != null)
        {
            _isDeleting = true;
            _deleteErrorMessage = null;
            try
            {
                await ApiClient.DeleteAreaAsync(_areaToDelete.Id);
                _showDeleteConfirm = false;
                await LoadData();
            }
            catch (HttpRequestException)
            {
                _deleteErrorMessage = "Không thể xóa khu vực này. Vui lòng đảm bảo không còn bàn nào nằm trong khu vực này trước khi xóa.";
            }
            finally
            {
                _isDeleting = false;
            }
        }
    }

    // Helper model for UI binding
    public class AreaFormModel
    {
        public string Name { get; set; } = string.Empty;
        public int SortOrder { get; set; }
        public bool IsActive { get; set; } = true;
    }
}

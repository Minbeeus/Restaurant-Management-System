@page "/admin/tables"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.AdminLayout
@using Restaurant.Application.DTOs
@using Restaurant.Web.Services
@inject TableApiClient ApiClient
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="flex flex-col h-[calc(100vh-64px-48px)]">
    <!-- Header -->
    <div class="flex justify-between items-center mb-4 shrink-0">
        <h2 class="text-2xl font-headline-sm text-primary">@L["Table_Floorplan_Title"]</h2>
        
        <div class="flex items-center gap-3">
            @if (_areas.Any())
            {
                <select class="px-4 py-2 border border-outline rounded bg-surface focus:outline-none focus:border-primary font-label-bold text-on-surface" @onchange="OnAreaChanged">
                    <option value="0" selected="@(_currentAreaId == 0)">Toàn Sàn (Tất cả khu ABCD)</option>
                    @foreach (var area in _areas)
                    {
                        <option value="@area.Id" selected="@(_currentAreaId == area.Id)">@area.Name</option>
                    }
                </select>
            }
            
            <div class="w-px h-6 bg-outline-variant/50 mx-1"></div>

            <div class="flex items-center gap-1 bg-surface-container rounded-lg p-1 mr-2 border border-outline-variant/30">
                <button class="px-3 py-1.5 rounded-md text-sm font-bold transition-colors @(_viewMode == "Canvas" ? "bg-white text-primary shadow-sm" : "text-on-surface hover:bg-surface-low")" @onclick="@(() => SwitchViewMode("Canvas"))">
                    <span class="material-symbols-outlined align-middle text-[18px] mr-1" data-icon="dashboard">dashboard</span> @L["Table_View_Plan"]
                </button>
                <button class="px-3 py-1.5 rounded-md text-sm font-bold transition-colors @(_viewMode == "Grid" ? "bg-white text-primary shadow-sm" : "text-on-surface hover:bg-surface-low")" @onclick="@(() => SwitchViewMode("Grid"))">
                    <span class="material-symbols-outlined align-middle text-[18px] mr-1" data-icon="list">list</span> @L["Table_View_List"]
                </button>
            </div>

            @if (_viewMode == "Canvas")
            {
                <button class="flex items-center gap-1.5 px-3 py-1.5 rounded-md text-sm font-bold border transition-colors @(_showFloorplanBackground ? "bg-primary text-on-primary border-primary shadow-xs" : "bg-surface text-on-surface hover:bg-surface-low border-outline-variant")"
                        @onclick="() => _showFloorplanBackground = !_showFloorplanBackground" title="Bật/Tắt ảnh mặt bằng kiến trúc quán">
                    <span class="material-symbols-outlined text-[18px]">map</span>
                    <span>Mặt Bằng</span>
                </button>

                <button class="flex items-center gap-1.5 px-3 py-1.5 rounded-md text-sm font-bold border border-outline-variant bg-surface text-on-surface hover:bg-surface-low transition-colors"
                        @onclick="ResetToStandardLayoutAsync" title="Khôi phục toàn bộ bàn về các block kiến trúc chuẩn">
                    <span class="material-symbols-outlined text-[18px]">restart_alt</span>
                    <span>Khôi phục sơ đồ chuẩn</span>
                </button>

                <button class="flex items-center gap-2 px-4 py-2 rounded font-label-bold shadow-sm transition-colors @(_isEditMode ? "bg-surface-variant text-on-surface hover:bg-surface-variant/80" : "bg-primary text-on-primary hover:bg-primary/90")" @onclick="ToggleEditMode">
                    <span class="material-symbols-outlined text-[20px]" data-icon="@(_isEditMode ? "visibility" : "edit_square")">@(_isEditMode ? "visibility" : "edit_square")</span>
                    @(_isEditMode ? L["Table_Mode_View"] : L["Table_Mode_Edit"])
                </button>
            }

            @if (_isEditMode)
            {
                <button class="flex items-center gap-2 px-4 py-2 rounded font-label-bold shadow-sm transition-colors @(_hasCollision ? "bg-on-surface-variant/20 text-on-surface-variant cursor-not-allowed" : "bg-basil-container text-white hover:bg-basil-container/90")" @onclick="SaveLayoutAsync" disabled="@_hasCollision">
                    <span class="material-symbols-outlined text-[20px]" data-icon="save">save</span>
                    @L["Table_Save_Layout"]
                </button>
            }
            
            <button class="bg-surface-container-high text-on-surface px-4 py-2 rounded font-label-bold shadow-sm hover:bg-surface-container-highest transition-colors" @onclick="OpenAddModal">
                <span class="material-symbols-outlined align-middle text-sm mr-1" data-icon="add">add</span> @L["Table_Add_Table"]
            </button>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="flex-1 flex justify-center items-center">
            <span class="material-symbols-outlined animate-spin text-4xl text-primary" data-icon="progress_activity">progress_activity</span>
        </div>
    }
    else if (!_areas.Any())
    {
        <div class="p-8 text-center text-on-surface-variant bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 mt-8">
            @L["Area_No_Data"]
        </div>
    }
    else
    {
        <!-- Content Container -->
        <div class="flex-1 flex gap-4 overflow-hidden">
            
            @if (_viewMode == "Canvas")
            {
                <!-- Canvas Area -->
            <div class="flex-1 bg-surface-container-lowest rounded-xl shadow-inner border border-outline-variant/30 overflow-auto relative">
                
                @if (_isEditMode)
                {
                    <div class="sticky top-4 left-4 bg-surface/85 backdrop-blur px-3 py-1.5 rounded shadow-sm text-xs font-bold text-on-surface z-30 flex items-center gap-2 border border-outline-variant/30 w-fit">
                        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                        @L["Table_Editing_Hint"]
                        @if (_hasCollision)
                        {
                            <span class="text-error ml-2">- @L["Table_Collision_Error"]</span>
                        }
                    </div>
                }

                <div id="floorplan-canvas" class="relative touch-none @(_isEditMode ? "edit-mode bg-grid-pattern" : "bg-grid-pattern-light")" style="min-width: 1260px; min-height: 740px;">
                    @if (_showFloorplanBackground)
                    {
                        <img src="images/restaurant_floorplan.svg" 
                             alt="Sơ đồ mặt bằng quán" 
                             class="absolute left-0 top-0 pointer-events-none select-none transition-opacity duration-300"
                             style="width: 1240px; height: 720px; z-index: 1; opacity: 0.9;" />
                    }

                    @foreach (var table in _currentTables)
                    {
                        var (posX, posY, width, height) = GetTableDisplayCoordinates(table);
                        <div class="table-element absolute select-none flex flex-col items-center justify-center cursor-pointer @GetTableShapeClass(table) @GetTableStatusClass(table) @(_isEditMode ? "hover:ring-2 hover:ring-primary shadow-md active:scale-95 z-20" : "hover:shadow-lg transition-shadow z-10")"
                             data-id="@table.Id"
                             style="left: 0; top: 0; transform: translate(@(posX)px, @(posY)px); width: @(width)px; height: @(height)px;"
                             @onclick="() => OnTableClicked(table)">
                            
                            <span class="font-bold text-on-background pointer-events-none @(table.Width < 60 ? "text-xs" : "text-sm")">@table.Name</span>
                            @if (_currentAreaId == 0 && !string.IsNullOrEmpty(table.AreaName))
                            {
                                <span class="text-[9px] font-bold text-primary/80 pointer-events-none -mt-0.5">@table.AreaName</span>
                            }
                            @if (table.Width >= 60 && table.Height >= 60)
                            {
                                <span class="text-[10px] text-on-surface-variant pointer-events-none">@table.Capacity @L["Table_Capacity_Unit"]</span>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Side Panel (Visible when a table is clicked in Edit mode, or for QR download in View mode) -->
            @if (_selectedTable != null)
            {
                <div class="w-80 bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 flex flex-col shrink-0 animate-in slide-in-from-right-4 duration-200">
                    <div class="p-4 border-b border-outline-variant/30 flex justify-between items-center bg-surface-container-low">
                        <h3 class="font-bold text-on-background flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary" data-icon="table_restaurant">table_restaurant</span>
                            @_selectedTable.Name
                        </h3>
                        <button class="text-on-surface-variant hover:text-error transition-colors p-1" @onclick="() => _selectedTable = null">
                            <span class="material-symbols-outlined text-sm" data-icon="close">close</span>
                        </button>
                    </div>

                    <div class="p-4 flex-1 overflow-y-auto">
                        <div class="mb-4">
                            <div class="text-xs text-on-surface-variant mb-1 uppercase font-bold tracking-wider">@L["Table_General_Info"]</div>
                            <div class="font-label-bold">@L["Table_Capacity_Label"]: @_selectedTable.Capacity @L["Table_Capacity_Unit"]</div>
                            <div class="font-label-bold">@L["Table_Area_Label"]: @_areas.FirstOrDefault(a => a.Id == _selectedTable.AreaId)?.Name</div>
                        </div>

                        @if (_isEditMode)
                        {
                            <div class="mb-6 space-y-3">
                                <div class="text-xs text-on-surface-variant mb-1 uppercase font-bold tracking-wider">@L["Table_Tasks"]</div>
                                
                                <button class="w-full flex items-center justify-between px-3 py-2 bg-surface hover:bg-surface-low border border-outline rounded transition-colors" @onclick="RotateSelectedTable">
                                    <span class="font-bold text-sm">@L["Table_Rotate"]</span>
                                    <span class="material-symbols-outlined text-sm" data-icon="rotate_right">rotate_right</span>
                                </button>
                                
                                <div class="flex flex-col gap-1">
                                    <span class="text-sm font-bold text-on-surface">@L["Table_Change_Shape"]:</span>
                                    <div class="flex gap-2">
                                        <button class="flex-1 py-1.5 border border-outline rounded text-sm hover:bg-primary-container hover:text-primary transition-colors @(_selectedTable.Shape == 0 ? "bg-primary-container text-primary border-primary" : "bg-surface")" @onclick="() => ChangeShape(0)">@L["Table_Shape_Round"]</button>
                                        <button class="flex-1 py-1.5 border border-outline rounded text-sm hover:bg-primary-container hover:text-primary transition-colors @(_selectedTable.Shape == 1 ? "bg-primary-container text-primary border-primary" : "bg-surface")" @onclick="() => ChangeShape(1)">@L["Table_Shape_Square"]</button>
                                        <button class="flex-1 py-1.5 border border-outline rounded text-sm hover:bg-primary-container hover:text-primary transition-colors @(_selectedTable.Shape == 2 ? "bg-primary-container text-primary border-primary" : "bg-surface")" @onclick="() => ChangeShape(2)">@L["Table_Shape_Rectangle"]</button>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="mt-auto flex gap-2">
                                <button class="flex-1 flex items-center justify-center gap-1 py-2 text-primary hover:bg-primary-container border border-primary/30 rounded font-label-bold transition-colors" @onclick="() => OpenEditModal(_selectedTable)">
                                    <span class="material-symbols-outlined text-sm" data-icon="edit">edit</span> @L["Common_Edit"]
                                </button>
                                <button class="flex-1 flex items-center justify-center gap-1 py-2 text-error hover:bg-error-container border border-error/30 rounded font-label-bold transition-colors" @onclick="() => ConfirmDelete(_selectedTable)">
                                    <span class="material-symbols-outlined text-sm" data-icon="delete">delete</span> @L["Common_Delete"]
                                </button>
                            </div>
                        }
                        else
                        {
                            <!-- View mode actions -->
                            <a href="@GetQrCodeUrl(_selectedTable.Id)" target="_blank" class="w-full flex items-center justify-center gap-2 py-3 bg-primary text-on-primary rounded font-label-bold shadow-sm hover:bg-primary/90 transition-colors">
                                <span class="material-symbols-outlined" data-icon="qr_code_2">qr_code_2</span>
                                @L["Table_Download_QR"]
                            </a>
                        }
                    </div>
                </div>
            }
            
            }
            else
            {
                <!-- Grid View Area -->
                <div class="flex-1 flex flex-col gap-4">
                    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-4 flex flex-col md:flex-row gap-4 shrink-0">
                        <div class="flex-1 relative">
                            <span class="material-symbols-outlined absolute left-3 top-2.5 text-on-surface-variant text-[20px]" data-icon="search">search</span>
                            <InputText @bind-Value="_searchKeyword" @bind-Value:event="oninput" class="w-full pl-10 pr-4 py-2 border border-outline rounded bg-surface focus:outline-none focus:border-primary transition-colors" placeholder="@L["Table_Name_Placeholder"]" />
                        </div>
                        <div class="w-full md:w-48 shrink-0">
                            <select @bind="_filterStatus" class="w-full px-4 py-2 border border-outline rounded bg-surface focus:outline-none focus:border-primary transition-colors cursor-pointer">
                                <option value="">@L["MenuItem_Filter_All_Status"]</option>
                                <option value="0">@L["Table_Status_Available"]</option>
                                <option value="1">@L["Table_Status_Occupied"]</option>
                            </select>
                        </div>
                    </div>

                    <div class="flex-1 bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 overflow-auto">
                        <table class="w-full text-left border-collapse">
                            <thead class="bg-surface-container-low border-b border-outline-variant/30 text-on-surface-variant font-label-bold sticky top-0 z-10">
                                <tr>
                                    <th class="p-4 font-semibold text-center w-16">@L["Area_Header_ID"]</th>
                                    <th class="p-4 font-semibold">@L["Table_Name_Label"]</th>
                                    <th class="p-4 font-semibold">@L["Table_Header_Capacity"]</th>
                                    <th class="p-4 font-semibold text-center">@L["Area_Header_Status"]</th>
                                    <th class="p-4 font-semibold text-center w-48">@L["Area_Header_Actions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!FilteredTables.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="p-8 text-center text-on-surface-variant">@L["Table_No_Tables_Found"]</td>
                                    </tr>
                                }
                                @foreach (var table in FilteredTables)
                                {
                                    <tr class="border-b border-outline-variant/20 last:border-0 hover:bg-surface-low/50 transition-colors">
                                        <td class="p-4 text-center text-on-surface-variant">#@table.Id</td>
                                        <td class="p-4 font-label-bold text-on-background text-base">@table.Name</td>
                                        <td class="p-4 text-on-surface-variant">@table.Capacity @L["Table_Capacity_Unit"]</td>
                                        <td class="p-4 text-center">
                                            @if (table.Status == 0)
                                            {
                                                <span class="px-2 py-1 bg-success-green/10 text-success-green rounded text-xs font-bold border border-success-green/20">@L["Table_Status_Available"]</span>
                                            }
                                            else
                                            {
                                                <span class="px-2 py-1 bg-error-container/20 text-error rounded text-xs font-bold border border-error/20">@L["Table_Status_Occupied"]</span>
                                            }
                                        </td>
                                        <td class="p-4 text-center space-x-2">
                                            <a href="@GetQrCodeUrl(table.Id)" target="_blank" class="text-secondary hover:bg-secondary-container p-2 rounded-full transition-colors inline-block" title="@L["Table_Download_QR"]">
                                                <span class="material-symbols-outlined text-sm" data-icon="qr_code_2">qr_code_2</span>
                                            </a>
                                            <button class="text-primary hover:bg-primary-container p-2 rounded-full transition-colors" title="@L["Common_Edit"]" @onclick="() => OpenEditModal(table)">
                                                <span class="material-symbols-outlined text-sm" data-icon="edit">edit</span>
                                            </button>
                                            <button class="text-error hover:bg-error-container p-2 rounded-full transition-colors disabled:opacity-50" title="@L["Common_Delete"]" @onclick="() => ConfirmDelete(table)" disabled="@(table.Status == 1)">
                                                <span class="material-symbols-outlined text-sm" data-icon="delete">delete</span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Grid Pattern Styles -->
<style>
    .bg-grid-pattern {
        background-image: linear-gradient(to right, rgba(0,0,0,0.05) 1px, transparent 1px), linear-gradient(to bottom, rgba(0,0,0,0.05) 1px, transparent 1px);
        background-size: 20px 20px;
    }
    .bg-grid-pattern-light {
        background-image: linear-gradient(to right, rgba(0,0,0,0.02) 1px, transparent 1px), linear-gradient(to bottom, rgba(0,0,0,0.02) 1px, transparent 1px);
        background-size: 20px 20px;
    }
    .table-element {
        will-change: transform;
        touch-action: none;
    }
    .table-element.dragging {
        z-index: 50;
        opacity: 0.9;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.2);
    }
    .table-element.collision {
        border-color: #ef4444 !important; /* Tailwind error red */
        background-color: #fef2f2 !important;
        border-width: 2px;
        border-style: dashed;
        animation: shake 0.5s;
    }
</style>

<!-- JS Invokable Class -->
@code {
    private List<TableDto> _tables = new();
    private List<AreaDto> _areas = new();
    private List<TableDto> _currentTables = new();
    private int _currentAreaId;
    
    private bool _isLoading = true;
    private bool _isEditMode = false;
    private bool _hasCollision = false;
    private bool _showFloorplanBackground = true;
    private string _viewMode = "Canvas"; // "Canvas" or "Grid"
    
    // Filter properties for Grid View
    private string _searchKeyword = "";
    private int? _filterStatus = null;
    
    private IEnumerable<TableDto> FilteredTables => _currentTables
        .Where(t => string.IsNullOrWhiteSpace(_searchKeyword) || t.Name.Contains(_searchKeyword, StringComparison.OrdinalIgnoreCase))
        .Where(t => _filterStatus == null || t.Status == _filterStatus);
    
    private TableDto? _selectedTable;

    private DotNetObjectReference<TableManagement>? _dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERROR OnInitialized]: {ex}");
            _areas = new List<AreaDto>();
            _tables = new List<TableDto>();
        }
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            var taskTables = ApiClient.GetTablesAsync();
            var taskAreas = ApiClient.GetAreasAsync();
            
            await Task.WhenAll(taskTables, taskAreas);
            
            _areas = taskAreas.Result.Where(a => a.IsActive).OrderBy(a => a.SortOrder).ToList();
            _tables = taskTables.Result;

            // Default to Toan San (0) to view all ABCD on single floor
            UpdateCurrentTables();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tables: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void UpdateCurrentTables()
    {
        _currentTables = (_currentAreaId == 0)
            ? _tables.ToList()
            : _tables.Where(t => t.AreaId == _currentAreaId).ToList();
        _selectedTable = null; // reset selection
        _isJsInitialized = false;
    }

    private bool _isJsInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isLoading && _areas.Any() && _viewMode == "Canvas" && !_isJsInitialized)
        {
            try 
            {
                // Serialize necessary data for JS
                var tablesData = _currentTables.Select(t => new { 
                    tableId = t.Id, 
                    positionX = t.PositionX, 
                    positionY = t.PositionY, 
                    width = t.Width, 
                    height = t.Height,
                    shape = t.Shape,
                    rotation = t.Rotation
                }).ToList();

                await JS.InvokeVoidAsync("floorplan.init", _dotNetRef, tablesData);
                _isJsInitialized = true;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[JS-ERROR] Không thể khởi tạo Floorplan: {ex.Message}");
            }
        }
    }

    private void OnAreaChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int areaId))
        {
            _currentAreaId = areaId;
            UpdateCurrentTables();
        }
    }

    private void ToggleEditMode()
    {
        _isEditMode = !_isEditMode;
        _selectedTable = null;
        _isJsInitialized = false;
    }

    private void SwitchViewMode(string mode)
    {
        _viewMode = mode;
        _isEditMode = false;
        _selectedTable = null;
        _isJsInitialized = false;
    }

    private void OnTableClicked(TableDto table)
    {
        _selectedTable = table;
    }

    // Called by JS Interop when a drag ends
    [JSInvokable]
    public void OnTableMoved(int tableId, double x, double y, bool hasCollision)
    {
        var table = _currentTables.FirstOrDefault(t => t.Id == tableId);
        if (table != null)
        {
            table.PositionX = x;
            table.PositionY = y;
        }
        _hasCollision = hasCollision;
        InvokeAsync(StateHasChanged);
    }

    private void RotateSelectedTable()
    {
        if (_selectedTable != null)
        {
            _selectedTable.Rotation = (_selectedTable.Rotation + 90) % 360;
            // Swap width and height if changing from horizontal to vertical or vice versa
            var temp = _selectedTable.Width;
            _selectedTable.Width = _selectedTable.Height;
            _selectedTable.Height = temp;
            
            _isJsInitialized = false;
            StateHasChanged();
        }
    }

    private void ChangeShape(int shape)
    {
        if (_selectedTable != null)
        {
            _selectedTable.Shape = shape;
            if (shape == 0 || shape == 1) // Round or Square -> equal sides
            {
                var size = Math.Max(_selectedTable.Width, _selectedTable.Height);
                if (size < 80) size = 80;
                _selectedTable.Width = size;
                _selectedTable.Height = size;
            }
            else if (shape == 2) // Rectangle
            {
                _selectedTable.Width = 120;
                _selectedTable.Height = 80;
            }
            _isJsInitialized = false;
            StateHasChanged();
        }
    }

    private async Task SaveLayoutAsync()
    {
        if (_hasCollision) return;

        try
        {
            var layoutRequest = _currentTables.Select(t => new UpdateTableLayoutRequest
            {
                TableId = t.Id,
                PositionX = t.PositionX,
                PositionY = t.PositionY,
                Width = t.Width,
                Height = t.Height,
                Shape = t.Shape,
                Rotation = t.Rotation
            }).ToList();

            await ApiClient.UpdateBatchLayoutAsync(_currentAreaId, layoutRequest);
            // Show success toast here normally
            _isEditMode = false;
            _selectedTable = null;
            _isJsInitialized = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving layout: {ex.Message}");
        }
    }

    private static readonly Dictionary<string, (double X, double Y, double W, double H)> StandardTablePositions = new()
    {
        // === KHU A: Sảnh Chính (8 bàn đôi, capacity 2) ===
        ["A01"] = (390, 135, 65, 65),
        ["A02"] = (495, 135, 65, 65),
        ["A03"] = (600, 135, 65, 65),
        ["A04"] = (705, 135, 65, 65),
        ["A05"] = (390, 225, 65, 65),
        ["A06"] = (495, 225, 65, 65),
        ["A07"] = (600, 225, 65, 65),
        ["A08"] = (705, 225, 65, 65),

        // === KHU B: Phòng Trung Tâm (8 bàn đôi, capacity 2) ===
        ["B01"] = (410, 375, 65, 65),
        ["B02"] = (495, 375, 65, 65),
        ["B03"] = (580, 375, 65, 65),
        ["B04"] = (665, 375, 65, 65),
        ["B05"] = (410, 445, 65, 65),
        ["B06"] = (495, 445, 65, 65),
        ["B07"] = (580, 445, 65, 65),
        ["B08"] = (665, 445, 65, 65),

        // === KHU C: View Cửa Sổ (7 bàn đôi, capacity 2) ===
        ["C01"] = (930, 320, 60, 60),
        ["C02"] = (1040, 320, 60, 60),
        ["C03"] = (900, 390, 60, 60),
        ["C04"] = (985, 390, 60, 60),
        ["C05"] = (1070, 390, 60, 60),
        ["C06"] = (930, 455, 60, 60),

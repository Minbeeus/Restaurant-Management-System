@page "/admin/tables"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.AdminLayout
@using Restaurant.Application.DTOs
@using Restaurant.Web.Services
@inject TableApiClient ApiClient
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="flex flex-col h-full max-h-full overflow-hidden select-none">
    <!-- Header -->
    <div class="flex flex-wrap justify-between items-center mb-2 gap-2 shrink-0">
        <h2 class="text-base md:text-lg font-bold text-primary flex items-center gap-1.5">
            <span class="material-symbols-outlined text-lg md:text-xl">table_restaurant</span>
            <span>@L["Table_Floorplan_Title"]</span>
        </h2>
        
        <div class="flex flex-wrap items-center gap-1.5">
            @if (_areas.Any())
            {
                <select class="px-2.5 py-1 border border-outline-variant rounded-lg bg-surface focus:outline-none focus:border-primary text-xs font-semibold text-on-surface shadow-2xs cursor-pointer hover:border-outline transition-colors" @onchange="OnAreaChanged">
                    <option value="0" selected="@(_currentAreaId == 0)">Toàn Sàn (Tất cả khu ABCD)</option>
                    @foreach (var area in _areas)
                    {
                        <option value="@area.Id" selected="@(_currentAreaId == area.Id)">@area.Name</option>
                    }
                </select>
            }
            
            <div class="w-px h-5 bg-outline-variant/60 mx-0.5"></div>

            <div class="flex items-center gap-0.5 bg-surface-container rounded-lg p-0.5 border border-outline-variant/30">
                <button class="px-2 py-1 rounded text-xs font-semibold transition-colors flex items-center gap-1 @(_viewMode == "Canvas" ? "bg-white text-primary shadow-2xs" : "text-on-surface hover:bg-surface-low")" @onclick="@(() => SwitchViewMode("Canvas"))">
                    <span class="material-symbols-outlined text-[15px]" data-icon="dashboard">dashboard</span>
                    <span>@L["Table_View_Plan"]</span>
                </button>
                <button class="px-2 py-1 rounded text-xs font-semibold transition-colors flex items-center gap-1 @(_viewMode == "Grid" ? "bg-white text-primary shadow-2xs" : "text-on-surface hover:bg-surface-low")" @onclick="@(() => SwitchViewMode("Grid"))">
                    <span class="material-symbols-outlined text-[15px]" data-icon="list">list</span>
                    <span>@L["Table_View_List"]</span>
                </button>
            </div>

            @if (_viewMode == "Canvas")
            {
                <button class="flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-semibold border transition-colors shadow-2xs @(_showFloorplanBackground ? "bg-primary text-on-primary border-primary" : "bg-surface text-on-surface hover:bg-surface-low border-outline-variant")"
                        @onclick="ToggleBackgroundFloorplan" title="Bật/Tắt ảnh mặt bằng kiến trúc quán">
                    <span class="material-symbols-outlined text-[15px]">map</span>
                    <span>Mặt Bằng</span>
                </button>

                <button class="flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-semibold border border-outline-variant bg-surface text-on-surface hover:bg-surface-low transition-colors shadow-2xs"
                        @onclick="ResetToStandardLayoutAsync" title="Khôi phục toàn bộ bàn về các block kiến trúc chuẩn">
                    <span class="material-symbols-outlined text-[15px]">restart_alt</span>
                    <span>Khôi phục sơ đồ chuẩn</span>
                </button>

                <button class="flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-semibold shadow-2xs transition-colors @(_isEditMode ? "bg-surface-variant text-on-surface hover:bg-surface-variant/80 border border-outline-variant" : "bg-primary text-on-primary hover:bg-primary/90")" @onclick="ToggleEditMode">
                    <span class="material-symbols-outlined text-[15px]" data-icon="@(_isEditMode ? "visibility" : "edit_square")">@(_isEditMode ? "visibility" : "edit_square")</span>
                    <span>@(_isEditMode ? L["Table_Mode_View"] : L["Table_Mode_Edit"])</span>
                </button>
            }

            @if (_isEditMode)
            {
                <button class="flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-semibold shadow-2xs transition-colors @(_hasCollision ? "bg-on-surface-variant/20 text-on-surface-variant cursor-not-allowed" : "bg-basil-container text-white hover:bg-basil-container/90")" @onclick="SaveLayoutAsync" disabled="@_hasCollision">
                    <span class="material-symbols-outlined text-[15px]" data-icon="save">save</span>
                    <span>@L["Table_Save_Layout"]</span>
                </button>
            }
            
            <button class="bg-surface-container-high text-on-surface hover:bg-surface-container-highest px-2.5 py-1 rounded-lg text-xs font-semibold shadow-2xs transition-colors flex items-center gap-1" @onclick="OpenAddModal">
                <span class="material-symbols-outlined text-[15px]" data-icon="add">add</span>
                <span>@L["Table_Add_Table"]</span>
            </button>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="flex-1 flex justify-center items-center">
            <span class="material-symbols-outlined animate-spin text-4xl text-primary" data-icon="progress_activity">progress_activity</span>
        </div>
    }
    else if (!_areas.Any())
    {
        <div class="p-8 text-center text-on-surface-variant bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 mt-8">
            @L["Area_No_Data"]
        </div>
    }
    else
    {
        <!-- Content Container -->
        <div class="flex-1 flex gap-3 overflow-hidden min-h-0">
            
            @if (_viewMode == "Canvas")
            {
                <!-- Canvas Area with Zero Scrollbars -->
                <div id="floorplan-container" class="flex-1 bg-surface-container-lowest rounded-xl shadow-inner border border-outline-variant/30 overflow-hidden relative flex items-center justify-center p-2 min-h-0 select-none">
                    
                    @if (_isEditMode)
                    {
                        <div class="absolute top-2 left-2 bg-surface/90 backdrop-blur px-2.5 py-1 rounded shadow-xs text-[11px] font-bold text-on-surface z-30 flex items-center gap-1.5 border border-outline-variant/30">
                            <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                            <span>@L["Table_Editing_Hint"]</span>
                            @if (_hasCollision)
                            {
                                <span class="text-error ml-1">- @L["Table_Collision_Error"]</span>
                            }
                        </div>
                    }

                    <!-- Scaler element: exact 1240x720 base dimensions, scaled dynamically to 100% of container -->
                    <div id="floorplan-scaler" class="relative origin-center shrink-0 transition-transform duration-75" style="width: 1240px; height: 720px;">
                        <div id="floorplan-canvas" class="relative w-[1240px] h-[720px] touch-none @(_isEditMode ? "edit-mode bg-grid-pattern" : "bg-grid-pattern-light")">
                            @if (_showFloorplanBackground)
                            {
                                <img src="images/restaurant_floorplan.svg" 
                                     alt="Sơ đồ mặt bằng quán" 
                                     class="absolute left-0 top-0 pointer-events-none select-none transition-opacity duration-300"
                                     style="width: 1240px; height: 720px; z-index: 1; opacity: 0.9;" />
                            }

                            @foreach (var table in _currentTables)
                            {
                                var (posX, posY, width, height) = GetTableDisplayCoordinates(table);
                                <div class="table-element absolute select-none flex flex-col items-center justify-center cursor-pointer @GetTableShapeClass(table) @GetTableStatusClass(table) @(_isEditMode ? "hover:ring-2 hover:ring-primary shadow-md active:scale-95 z-20" : "hover:shadow-lg transition-shadow z-10")"
                                     data-id="@table.Id"
                                     style="left: 0; top: 0; transform: translate(@(posX)px, @(posY)px); width: @(width)px; height: @(height)px;"
                                     @onclick="() => OnTableClicked(table)">
                                    
                                    <span class="font-black text-on-background pointer-events-none @(table.Width < 60 ? "text-[11px]" : "text-xs") leading-none">@table.Name</span>
                                    @if (_currentAreaId == 0 && !string.IsNullOrEmpty(table.AreaName))
                                    {
                                        <span class="text-[8px] font-bold text-primary/80 pointer-events-none mt-0.5 leading-none">@table.AreaName</span>
                                    }
                                    @if (table.Width >= 55 && table.Height >= 55)
                                    {
                                        <span class="text-[9px] font-medium text-on-surface-variant pointer-events-none mt-0.5 leading-none">@table.Capacity @L["Table_Capacity_Unit"]</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Side Panel (Visible when a table is clicked in Edit mode, or for QR download in View mode) -->
                @if (_selectedTable != null)
                {
                    <div class="w-72 bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 flex flex-col shrink-0 animate-in slide-in-from-right-4 duration-200">
                        <div class="p-3 border-b border-outline-variant/30 flex justify-between items-center bg-surface-container-low">
                            <h3 class="font-bold text-sm text-on-background flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-primary text-[18px]" data-icon="table_restaurant">table_restaurant</span>
                                @_selectedTable.Name
                            </h3>
                            <button class="text-on-surface-variant hover:text-error transition-colors p-1" @onclick="CloseSelectedTable">
                                <span class="material-symbols-outlined text-sm" data-icon="close">close</span>
                            </button>
                        </div>

                        <div class="p-3 flex-1 overflow-y-auto">
                            <div class="mb-3">
                                <div class="text-[10px] text-on-surface-variant mb-1 uppercase font-bold tracking-wider">@L["Table_General_Info"]</div>
                                <div class="text-xs font-semibold">@L["Table_Capacity_Label"]: @_selectedTable.Capacity @L["Table_Capacity_Unit"]</div>
                                <div class="text-xs font-semibold">@L["Table_Area_Label"]: @_areas.FirstOrDefault(a => a.Id == _selectedTable.AreaId)?.Name</div>
                            </div>

                            @if (_isEditMode)
                            {
                                <div class="mb-4 space-y-2.5">
                                    <div class="text-[10px] text-on-surface-variant mb-1 uppercase font-bold tracking-wider">@L["Table_Tasks"]</div>
                                    
                                    <button class="w-full flex items-center justify-between px-2.5 py-1.5 bg-surface hover:bg-surface-low border border-outline-variant rounded-lg text-xs font-semibold transition-colors" @onclick="RotateSelectedTable">
                                        <span>@L["Table_Rotate"]</span>
                                        <span class="material-symbols-outlined text-sm" data-icon="rotate_right">rotate_right</span>
                                    </button>
                                    
                                    <div class="flex flex-col gap-1">
                                        <span class="text-xs font-semibold text-on-surface">@L["Table_Change_Shape"]:</span>
                                        <div class="flex gap-1.5">
                                            <button class="flex-1 py-1 border border-outline-variant rounded-md text-xs font-semibold hover:bg-primary-container hover:text-primary transition-colors @(_selectedTable.Shape == 0 ? "bg-primary-container text-primary border-primary" : "bg-surface")" @onclick="() => ChangeShape(0)">@L["Table_Shape_Round"]</button>
                                            <button class="flex-1 py-1 border border-outline-variant rounded-md text-xs font-semibold hover:bg-primary-container hover:text-primary transition-colors @(_selectedTable.Shape == 1 ? "bg-primary-container text-primary border-primary" : "bg-surface")" @onclick="() => ChangeShape(1)">@L["Table_Shape_Square"]</button>
                                            <button class="flex-1 py-1 border border-outline-variant rounded-md text-xs font-semibold hover:bg-primary-container hover:text-primary transition-colors @(_selectedTable.Shape == 2 ? "bg-primary-container text-primary border-primary" : "bg-surface")" @onclick="() => ChangeShape(2)">@L["Table_Shape_Rectangle"]</button>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="mt-auto flex gap-2">
                                    <button class="flex-1 flex items-center justify-center gap-1 py-1.5 text-xs text-primary hover:bg-primary-container border border-primary/30 rounded-lg font-semibold transition-colors" @onclick="() => OpenEditModal(_selectedTable)">
                                        <span class="material-symbols-outlined text-sm" data-icon="edit">edit</span>
                                        <span>@L["Common_Edit"]</span>
                                    </button>
                                    <button class="flex-1 flex items-center justify-center gap-1 py-1.5 text-xs text-error hover:bg-error-container border border-error/30 rounded-lg font-semibold transition-colors" @onclick="() => ConfirmDelete(_selectedTable)">
                                        <span class="material-symbols-outlined text-sm" data-icon="delete">delete</span>
                                        <span>@L["Common_Delete"]</span>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <!-- View mode actions -->
                                <a href="@GetQrCodeUrl(_selectedTable.Id)" target="_blank" class="w-full flex items-center justify-center gap-1.5 py-2 bg-primary text-on-primary rounded-lg text-xs font-semibold shadow-xs hover:bg-primary/90 transition-colors">
                                    <span class="material-symbols-outlined text-base" data-icon="qr_code_2">qr_code_2</span>
                                    <span>@L["Table_Download_QR"]</span>
                                </a>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <!-- Grid View Area -->
                <div class="flex-1 flex flex-col gap-3 min-h-0">
                    <div class="bg-surface-container-lowest rounded-xl shadow-xs border border-outline-variant/30 p-3 flex flex-col md:flex-row gap-3 shrink-0">
                        <div class="flex-1 relative">
                            <span class="material-symbols-outlined absolute left-3 top-2 text-on-surface-variant text-[18px]" data-icon="search">search</span>
                            <InputText @bind-Value="_searchKeyword" @bind-Value:event="oninput" class="w-full pl-9 pr-3 py-1.5 text-xs border border-outline-variant rounded-lg bg-surface focus:outline-none focus:border-primary transition-colors" placeholder="@L["Table_Name_Placeholder"]" />
                        </div>
                        <div class="w-full md:w-48 shrink-0">
                            <select @bind="_filterStatus" class="w-full px-3 py-1.5 text-xs border border-outline-variant rounded-lg bg-surface focus:outline-none focus:border-primary transition-colors cursor-pointer">
                                <option value="">@L["MenuItem_Filter_All_Status"]</option>
                                <option value="0">@L["Table_Status_Available"]</option>
                                <option value="1">@L["Table_Status_Occupied"]</option>
                            </select>
                        </div>
                    </div>

                    <div class="flex-1 bg-surface-container-lowest rounded-xl shadow-xs border border-outline-variant/30 overflow-auto min-h-0">
                        <table class="w-full text-left border-collapse text-xs">
                            <thead class="bg-surface-container-low border-b border-outline-variant/30 text-on-surface-variant font-semibold sticky top-0 z-10">
                                <tr>
                                    <th class="p-3 text-center w-16">@L["Area_Header_ID"]</th>
                                    <th class="p-3 font-semibold">@L["Table_Name_Label"]</th>
                                    <th class="p-3 font-semibold">@L["Table_Header_Capacity"]</th>
                                    <th class="p-3 font-semibold text-center">@L["Area_Header_Status"]</th>
                                    <th class="p-3 font-semibold text-center w-40">@L["Area_Header_Actions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!FilteredTables.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="p-8 text-center text-on-surface-variant">@L["Table_No_Tables_Found"]</td>
                                    </tr>
                                }
                                @foreach (var table in FilteredTables)
                                {
                                    <tr class="border-b border-outline-variant/20 last:border-0 hover:bg-surface-low/50 transition-colors">
                                        <td class="p-3 text-center text-on-surface-variant">#@table.Id</td>
                                        <td class="p-3 font-bold text-on-background">@table.Name</td>
                                        <td class="p-3 text-on-surface-variant">@table.Capacity @L["Table_Capacity_Unit"]</td>
                                        <td class="p-3 text-center">
                                            @if (table.Status == 0)
                                            {
                                                <span class="px-2 py-0.5 bg-success-green/10 text-success-green rounded text-[11px] font-bold border border-success-green/20">@L["Table_Status_Available"]</span>
                                            }
                                            else
                                            {
                                                <span class="px-2 py-0.5 bg-error-container/20 text-error rounded text-[11px] font-bold border border-error/20">@L["Table_Status_Occupied"]</span>
                                            }
                                        </td>
                                        <td class="p-3 text-center space-x-1">
                                            <a href="@GetQrCodeUrl(table.Id)" target="_blank" class="text-secondary hover:bg-secondary-container p-1.5 rounded-full transition-colors inline-block" title="@L["Table_Download_QR"]">
                                                <span class="material-symbols-outlined text-sm" data-icon="qr_code_2">qr_code_2</span>
                                            </a>
                                            <button class="text-primary hover:bg-primary-container p-1.5 rounded-full transition-colors" title="@L["Common_Edit"]" @onclick="() => OpenEditModal(table)">
                                                <span class="material-symbols-outlined text-sm" data-icon="edit">edit</span>
                                            </button>
                                            <button class="text-error hover:bg-error-container p-1.5 rounded-full transition-colors disabled:opacity-50" title="@L["Common_Delete"]" @onclick="() => ConfirmDelete(table)" disabled="@(table.Status == 1)">
                                                <span class="material-symbols-outlined text-sm" data-icon="delete">delete</span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Styles & Zero Scrollbar Enforcer -->
<style>
    main:has(#floorplan-container) {
        overflow: hidden !important;
        padding: 12px 16px !important;
    }

    .bg-grid-pattern {
        background-image: linear-gradient(to right, rgba(0,0,0,0.05) 1px, transparent 1px), linear-gradient(to bottom, rgba(0,0,0,0.05) 1px, transparent 1px);
        background-size: 20px 20px;
    }
    .bg-grid-pattern-light {
        background-image: linear-gradient(to right, rgba(0,0,0,0.02) 1px, transparent 1px), linear-gradient(to bottom, rgba(0,0,0,0.02) 1px, transparent 1px);
        background-size: 20px 20px;
    }
    .table-element {
        will-change: transform;
        touch-action: none;
    }
    .table-element.dragging {
        z-index: 50;
        opacity: 0.9;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.2);
    }
    .table-element.collision {
        border-color: #ef4444 !important;
        background-color: #fef2f2 !important;
        border-width: 2px;
        border-style: dashed;
        animation: shake 0.5s;
    }
</style>

@code {
    private List<TableDto> _tables = new();
    private List<AreaDto> _areas = new();
    private List<TableDto> _currentTables = new();
    private int _currentAreaId;
    
    private bool _isLoading = true;
    private bool _isEditMode = false;
    private bool _hasCollision = false;
    private bool _showFloorplanBackground = true;
    private string _viewMode = "Canvas"; // "Canvas" or "Grid"
    
    // Filter properties for Grid View
    private string _searchKeyword = "";
    private int? _filterStatus = null;
    
    private IEnumerable<TableDto> FilteredTables => _currentTables
        .Where(t => string.IsNullOrWhiteSpace(_searchKeyword) || t.Name.Contains(_searchKeyword, StringComparison.OrdinalIgnoreCase))
        .Where(t => _filterStatus == null || t.Status == _filterStatus);
    
    private TableDto? _selectedTable;

    private DotNetObjectReference<TableManagement>? _dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERROR OnInitialized]: {ex}");
            _areas = new List<AreaDto>();
            _tables = new List<TableDto>();
        }
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            var taskTables = ApiClient.GetTablesAsync();
            var taskAreas = ApiClient.GetAreasAsync();
            
            await Task.WhenAll(taskTables, taskAreas);
            
            _areas = taskAreas.Result.Where(a => a.IsActive).OrderBy(a => a.SortOrder).ToList();
            _tables = taskTables.Result;

            UpdateCurrentTables();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tables: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void UpdateCurrentTables()
    {
        _currentTables = (_currentAreaId == 0)
            ? _tables.ToList()
            : _tables.Where(t => t.AreaId == _currentAreaId).ToList();
        _selectedTable = null;
        _isJsInitialized = false;
    }

    private bool _isJsInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isLoading && _areas.Any() && _viewMode == "Canvas")
        {
            if (!_isJsInitialized)
            {
                try 
                {
                    var tablesData = _currentTables.Select(t => new { 
                        tableId = t.Id, 
                        positionX = t.PositionX, 
                        positionY = t.PositionY, 
                        width = t.Width, 
                        height = t.Height,
                        shape = t.Shape,
                        rotation = t.Rotation
                    }).ToList();

                    await JS.InvokeVoidAsync("floorplan.init", _dotNetRef, tablesData);
                    _isJsInitialized = true;
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[JS-ERROR] Không thể khởi tạo Floorplan: {ex.Message}");
                }
            }
            else
            {
                try
                {
                    await JS.InvokeVoidAsync("floorplan.updateScale");
                }
                catch { }
            }
        }
    }

    private void OnAreaChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int areaId))
        {
            _currentAreaId = areaId;
            UpdateCurrentTables();
        }
    }

    private async Task ToggleBackgroundFloorplan()
    {
        _showFloorplanBackground = !_showFloorplanBackground;
        await Task.Yield();
        try
        {
            await JS.InvokeVoidAsync("floorplan.updateScale");
        }
        catch { }
    }

    private async Task ToggleEditMode()
    {
        _isEditMode = !_isEditMode;
        _selectedTable = null;
        _isJsInitialized = false;
        await Task.Yield();
        try
        {
            await JS.InvokeVoidAsync("floorplan.updateScale");
        }
        catch { }
    }

    private async Task SwitchViewMode(string mode)
    {
        _viewMode = mode;
        _isEditMode = false;
        _selectedTable = null;
        _isJsInitialized = false;
        if (mode == "Canvas")
        {
            await Task.Yield();
            try
            {
                await JS.InvokeVoidAsync("floorplan.updateScale");
            }
            catch { }
        }
    }

    private async Task OnTableClicked(TableDto table)
    {
        _selectedTable = table;
        await Task.Yield();
        try
        {
            await JS.InvokeVoidAsync("floorplan.updateScale");
        }
        catch { }
    }

    private async Task CloseSelectedTable()
    {
        _selectedTable = null;
        await Task.Yield();
        try
        {
            await JS.InvokeVoidAsync("floorplan.updateScale");
        }
        catch { }
    }

    [JSInvokable]
    public void OnTableMoved(int tableId, double x, double y, bool hasCollision)
    {
        var table = _currentTables.FirstOrDefault(t => t.Id == tableId);
        if (table != null)
        {
            table.PositionX = x;
            table.PositionY = y;
        }
        _hasCollision = hasCollision;
        InvokeAsync(StateHasChanged);
    }

    private void RotateSelectedTable()
    {
        if (_selectedTable != null)
        {
            _selectedTable.Rotation = (_selectedTable.Rotation + 90) % 360;
            var temp = _selectedTable.Width;
            _selectedTable.Width = _selectedTable.Height;
            _selectedTable.Height = temp;
            
            _isJsInitialized = false;
            StateHasChanged();
        }
    }

    private void ChangeShape(int shape)
    {
        if (_selectedTable != null)
        {
            _selectedTable.Shape = shape;
            if (shape == 0 || shape == 1)
            {
                var size = Math.Max(_selectedTable.Width, _selectedTable.Height);
                if (size < 80) size = 80;
                _selectedTable.Width = size;
                _selectedTable.Height = size;
            }
            else if (shape == 2)
            {
                _selectedTable.Width = 120;
                _selectedTable.Height = 80;
            }
            _isJsInitialized = false;
            StateHasChanged();
        }
    }

    private async Task SaveLayoutAsync()
    {
        if (_hasCollision) return;

        try
        {
            var layoutRequest = _currentTables.Select(t => new UpdateTableLayoutRequest
            {
                TableId = t.Id,
                PositionX = t.PositionX,
                PositionY = t.PositionY,
                Width = t.Width,
                Height = t.Height,
                Shape = t.Shape,
                Rotation = t.Rotation
            }).ToList();

            await ApiClient.UpdateBatchLayoutAsync(_currentAreaId, layoutRequest);
            _isEditMode = false;
            _selectedTable = null;
            _isJsInitialized = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving layout: {ex.Message}");
        }
    }


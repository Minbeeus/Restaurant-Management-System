        ["D05"] = (975, 565, 50, 55),
        ["D06"] = (1035, 565, 50, 55),
        ["D07"] = (1095, 565, 50, 55),
    };

    private (int X, int Y, int W, int H) GetTableDisplayCoordinates(TableDto table)
    {
        var rawX = table.PositionX;
        var rawY = table.PositionY;
        var baseW = table.Width > 0 ? table.Width : 60;
        var baseH = table.Height > 0 ? table.Height : 60;

        bool isMisplaced = (rawY < 70 || rawX < 90 || rawX > 1180 || rawY > 660);
        if (!isMisplaced && table.Name.StartsWith("B") && rawY < 300) isMisplaced = true;
        if (!isMisplaced && table.Name.StartsWith("C") && (rawY < 270 || rawX < 850)) isMisplaced = true;
        if (!isMisplaced && table.Name.StartsWith("D") && rawY < 500) isMisplaced = true;

        if (isMisplaced && StandardTablePositions.TryGetValue(table.Name, out var std))
        {
            rawX = std.X;
            rawY = std.Y;
            baseW = (int)std.W;
            baseH = (int)std.H;
        }

        return ((int)Math.Round(rawX), (int)Math.Round(rawY), baseW, baseH);
    }

    private async Task ResetToStandardLayoutAsync()
    {
        foreach (var t in _tables)
        {
            if (StandardTablePositions.TryGetValue(t.Name, out var std))
            {
                t.PositionX = std.X;
                t.PositionY = std.Y;
                t.Width = (int)std.W;
                t.Height = (int)std.H;
            }
        }
        UpdateCurrentTables();
        _isJsInitialized = false;
        
        try
        {
            var layoutRequest = _tables.Select(t => new UpdateTableLayoutRequest
            {
                TableId = t.Id,
                PositionX = t.PositionX,
                PositionY = t.PositionY,
                Width = t.Width,
                Height = t.Height,
                Shape = t.Shape,
                Rotation = t.Rotation
            }).ToList();

            await ApiClient.UpdateBatchLayoutAsync(0, layoutRequest);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error resetting standard layout: {ex.Message}");
        }
        StateHasChanged();
    }


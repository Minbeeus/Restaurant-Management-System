    private (int X, int Y, int W, int H) GetTableDisplayCoordinates(TableDto table)
    {
        var rawX = table.PositionX;
        var rawY = table.PositionY;
        var baseW = table.Width > 0 ? table.Width : 60;
        var baseH = table.Height > 0 ? table.Height : 60;

        bool isMisplaced = (rawY < 70 || rawX < 90 || rawX > 1180 || rawY > 660);
        if (!isMisplaced && table.Name.StartsWith("B") && rawY < 300) isMisplaced = true;
        if (!isMisplaced && table.Name.StartsWith("C") && (rawY < 270 || rawX < 850)) isMisplaced = true;
        if (!isMisplaced && table.Name.StartsWith("D") && rawY < 500) isMisplaced = true;

        if (isMisplaced && StandardTablePositions.TryGetValue(table.Name, out var std))
        {
            rawX = std.X;
            rawY = std.Y;
            baseW = (int)std.W;
            baseH = (int)std.H;
        }

        return ((int)Math.Round(rawX), (int)Math.Round(rawY), baseW, baseH);
    }

    private async Task ResetToStandardLayoutAsync()
    {
        foreach (var t in _tables)
        {
            if (StandardTablePositions.TryGetValue(t.Name, out var std))
            {
                t.PositionX = std.X;
                t.PositionY = std.Y;
                t.Width = (int)std.W;
                t.Height = (int)std.H;
            }
        }
        UpdateCurrentTables();
        _isJsInitialized = false;
        
        try
        {
            var layoutRequest = _tables.Select(t => new UpdateTableLayoutRequest
            {
                TableId = t.Id,
                PositionX = t.PositionX,
                PositionY = t.PositionY,
                Width = t.Width,
                Height = t.Height,
                Shape = t.Shape,
                Rotation = t.Rotation
            }).ToList();

            await ApiClient.UpdateBatchLayoutAsync(0, layoutRequest);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error resetting standard layout: {ex.Message}");
        }
        StateHasChanged();
    }

    private string GetTableShapeClass(TableDto table)
    {
        if (table.Shape == 0) return "rounded-full";
        if (table.Shape == 1) return "rounded-lg";
        return "rounded-lg";
    }

    private string GetTableStatusClass(TableDto table)
    {
        if (!table.IsActive) return "bg-surface-variant text-on-surface-variant border border-outline-variant";
        return "bg-white text-on-surface border-2 border-[#C4C9B3]";
    }

    private string GetQrCodeUrl(int tableId)
    {
        return Endpoints.GetApiUrl($"api/v1/tables/{tableId}/qr-code");
    }
    
    public async ValueTask DisposeAsync()
    {
        try 
        {
            await JS.InvokeVoidAsync("floorplan.destroy");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[JS-ERROR Dispose]: {ex.Message}");
        }
        finally
        {
            _dotNetRef?.Dispose();
        }
    }
    
    // CRUD MODAL LOGIC
    private bool _showModal = false;
    private TableFormModel _model = new();
    private bool _isEditing = false;
    private int _editingId;

    private void OpenAddModal()
    {
        _isEditing = false;
        _model = new TableFormModel 
        { 
            AreaId = _currentAreaId,
            Capacity = 4, 
            IsActive = true, 
            Width = 80,
            Height = 80,
            Shape = 1
        };
        _showModal = true;
    }

    private void OpenEditModal(TableDto table)
    {
        _isEditing = true;
        _editingId = table.Id;
        _model = new TableFormModel
        {
            AreaId = table.AreaId,
            Name = table.Name,
            Capacity = table.Capacity,
            SortOrder = table.SortOrder,
            IsActive = table.IsActive,
            Width = table.Width,
            Height = table.Height,
            Shape = table.Shape
        };
        _showModal = true;
    }

    private void CloseModal() => _showModal = false;

    private async Task SaveTableAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.Name)) return;

        try
        {
            if (_isEditing)
            {
                var req = new UpdateTableRequest
                {
                    AreaId = _model.AreaId, Name = _model.Name, Capacity = _model.Capacity,
                    SortOrder = _model.SortOrder, IsActive = _model.IsActive,
                    Width = _model.Width, Height = _model.Height, Shape = _model.Shape,
                    PositionX = _selectedTable?.PositionX ?? 0,
                    PositionY = _selectedTable?.PositionY ?? 0
                };
                await ApiClient.UpdateTableAsync(_editingId, req);
            }
            else
            {
                var req = new CreateTableRequest
                {
                    AreaId = _model.AreaId, Name = _model.Name, Capacity = _model.Capacity,
                    SortOrder = _tables.Count, Width = _model.Width, Height = _model.Height, Shape = _model.Shape,
                    PositionX = 20, PositionY = 20
                };
                await ApiClient.CreateTableAsync(req);
            }
            _showModal = false;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }
    }
    
    private TableDto? _tableToDelete;
    private bool _showDeleteConfirm = false;
    private bool _isDeleting = false;
    private string? _deleteErrorMessage;

    private void ConfirmDelete(TableDto table)
    {
        _tableToDelete = table;
        _deleteErrorMessage = null;
        _showDeleteConfirm = true;
    }

    private async Task ExecuteDeleteAsync()
    {
        if (_tableToDelete != null)
        {
            _isDeleting = true;
            _deleteErrorMessage = null;
            try
            {
                await ApiClient.DeleteTableAsync(_tableToDelete.Id);
                _showDeleteConfirm = false;
                _selectedTable = null;
                await LoadDataAsync();
            }
            catch (HttpRequestException)
            {
                _deleteErrorMessage = "Không thể xóa bàn đang có khách hoặc đang phục vụ. Vui lòng thanh toán đơn hàng trước.";
            }
            finally
            {
                _isDeleting = false;
                StateHasChanged();
            }
        }
    }

    public class TableFormModel
    {
        public int AreaId { get; set; }
        public string Name { get; set; } = string.Empty;
        public int Capacity { get; set; } = 4;
        public int SortOrder { get; set; }
        public bool IsActive { get; set; } = true;
        public int Width { get; set; }
        public int Height { get; set; }
        public int Shape { get; set; }
    }
}

@if (_showModal)
{
    <div class="fixed inset-0 bg-black/50 z-[100] flex items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-surface-container-lowest rounded-xl shadow-lg w-full max-w-sm overflow-hidden p-5 animate-in fade-in zoom-in-95 duration-200">
            <h3 class="font-bold text-base mb-3 text-on-background">@(_isEditing ? L["Table_Modal_Edit"] : L["Table_Modal_Create"])</h3>
            <EditForm Model="@_model" OnValidSubmit="SaveTableAsync">
                <div class="space-y-3 mb-5">
                    <div>
                        <label class="text-xs font-semibold block mb-1 text-on-surface">@L["Table_Name_Label"]</label>
                        <InputText @bind-Value="_model.Name" class="w-full border border-outline-variant rounded-lg p-2 text-xs bg-surface focus:border-primary focus:outline-none" placeholder="@L["Table_Name_Placeholder"]" />
                    </div>
                    <div>
                        <label class="text-xs font-semibold block mb-1 text-on-surface">@L["Table_Capacity_Input"]</label>
                        <InputNumber @bind-Value="_model.Capacity" class="w-full border border-outline-variant rounded-lg p-2 text-xs bg-surface focus:border-primary focus:outline-none" min="1" />
                    </div>
                </div>
                <div class="flex justify-end gap-2">
                    <button type="button" class="px-3 py-1.5 border border-outline-variant text-on-surface rounded-lg hover:bg-surface-low text-xs font-semibold transition-colors" @onclick="CloseModal">@L["Common_Cancel"]</button>
                    <button type="submit" class="px-3 py-1.5 bg-primary text-white rounded-lg text-xs font-semibold hover:bg-primary/90 transition-colors">@L["Common_Save_Changes"]</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showDeleteConfirm)
{
    <div class="fixed inset-0 bg-black/50 z-[100] flex items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-surface-container-lowest rounded-xl shadow-lg w-full max-w-sm overflow-hidden p-5 animate-in fade-in zoom-in-95 duration-200">
            <div class="text-center">
                <div class="w-12 h-12 rounded-full bg-error-container text-error mx-auto flex items-center justify-center mb-3">
                    <span class="material-symbols-outlined text-2xl" data-icon="warning">warning</span>
                </div>
                <h3 class="text-base font-bold text-on-background mb-1">@L["Category_Delete_Confirm_Title"]</h3>
                <p class="text-on-surface-variant text-xs mb-4">@string.Format(L["Table_Delete_Confirm"], _tableToDelete?.Name)</p>
                
                @if (!string.IsNullOrEmpty(_deleteErrorMessage))
                {
                    <div class="mb-4 p-2.5 bg-error-container text-error rounded-lg text-xs text-left border border-error/20">
                        @_deleteErrorMessage
                    </div>
                }

                <div class="flex justify-center gap-2">
                    <button class="px-3 py-1.5 border border-outline-variant text-on-surface rounded-lg hover:bg-surface-low transition-colors text-xs font-semibold flex-1" @onclick="() => _showDeleteConfirm = false">@L["Common_Cancel"]</button>
                    <button class="px-3 py-1.5 bg-error text-white rounded-lg hover:bg-error/90 transition-colors text-xs font-semibold flex-1 flex items-center justify-center gap-1.5" @onclick="ExecuteDeleteAsync" disabled="@_isDeleting">
                        @if (_isDeleting)
                        {
                            <span class="material-symbols-outlined animate-spin text-xs" data-icon="progress_activity">progress_activity</span>
                        }
                        @L["Category_Delete_Now_Btn"]
                    </button>
                </div>
            </div>
        </div>
    </div>
}

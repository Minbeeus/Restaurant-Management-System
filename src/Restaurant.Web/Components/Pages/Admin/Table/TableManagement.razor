    // UI Helpers
    private string GetTableShapeClass(TableDto table)
    {
        if (table.Shape == 0) return "rounded-full"; // Round
        if (table.Shape == 1) return "rounded-lg"; // Square
        return "rounded-lg"; // Rectangle
    }

    private string GetTableStatusClass(TableDto table)
    {
        // Mock colors based on status (0: Available, 1: Occupied)
        if (!table.IsActive) return "bg-surface-variant text-on-surface-variant border border-outline-variant";
        
        return "bg-white text-on-surface border-2 border-[#C4C9B3]"; // Available (Basil theme)
        // If Occupied: return "bg-[#EFF3FF] text-[#446371] border-2 border-[#446371]"
    }

    private string GetQrCodeUrl(int tableId)
    {
        return $"http://localhost:5011/api/v1/tables/{tableId}/qr-code";
    }
    
    public async ValueTask DisposeAsync()
    {
        try 
        {
            await JS.InvokeVoidAsync("floorplan.destroy");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[JS-ERROR Dispose]: {ex.Message}");
        }
        finally
        {
            _dotNetRef?.Dispose();
        }
    }
    
    // -----------------------------------------------------
    // CRUD MODAL LOGIC (Kept for completeness)
    // -----------------------------------------------------
    private bool _showModal = false;
    private TableFormModel _model = new();
    private bool _isEditing = false;
    private int _editingId;

    private void OpenAddModal()
    {
        _isEditing = false;
        _model = new TableFormModel 
        { 
            AreaId = _currentAreaId,
            Capacity = 4, 
            IsActive = true, 
            Width = 80,
            Height = 80,
            Shape = 1 // Square
        };
        _showModal = true;
    }

    private void OpenEditModal(TableDto table)
    {
        _isEditing = true;
        _editingId = table.Id;
        _model = new TableFormModel
        {
            AreaId = table.AreaId,
            Name = table.Name,
            Capacity = table.Capacity,
            SortOrder = table.SortOrder,
            IsActive = table.IsActive,
            Width = table.Width,
            Height = table.Height,
            Shape = table.Shape
        };
        _showModal = true;
    }

    private void CloseModal() => _showModal = false;

    private async Task SaveTableAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.Name)) return;

        try
        {
            if (_isEditing)
            {
                var req = new UpdateTableRequest
                {
                    AreaId = _model.AreaId, Name = _model.Name, Capacity = _model.Capacity,
                    SortOrder = _model.SortOrder, IsActive = _model.IsActive,
                    Width = _model.Width, Height = _model.Height, Shape = _model.Shape,
                    PositionX = _selectedTable?.PositionX ?? 0,
                    PositionY = _selectedTable?.PositionY ?? 0
                };
                await ApiClient.UpdateTableAsync(_editingId, req);
            }
            else
            {
                var req = new CreateTableRequest
                {
                    AreaId = _model.AreaId, Name = _model.Name, Capacity = _model.Capacity,
                    SortOrder = _tables.Count, Width = _model.Width, Height = _model.Height, Shape = _model.Shape,
                    PositionX = 20, PositionY = 20 // Default spawn position
                };
                await ApiClient.CreateTableAsync(req);
            }
            _showModal = false;
            await LoadDataAsync(); // Reload all to get DB assigned IDs
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }
    }
    
    private TableDto? _tableToDelete;
    private bool _showDeleteConfirm = false;
    private bool _isDeleting = false;
    private string? _deleteErrorMessage;

    private void ConfirmDelete(TableDto table)
    {
        _tableToDelete = table;
        _deleteErrorMessage = null;
        _showDeleteConfirm = true;
    }

    private async Task ExecuteDeleteAsync()
    {
        if (_tableToDelete != null)
        {
            _isDeleting = true;
            _deleteErrorMessage = null;
            try
            {
                await ApiClient.DeleteTableAsync(_tableToDelete.Id);
                _showDeleteConfirm = false;
                _selectedTable = null;
                await LoadDataAsync();
            }
            catch (HttpRequestException)
            {
                _deleteErrorMessage = "Không thể xóa bàn đang có khách hoặc đang phục vụ. Vui lòng thanh toán đơn hàng trước.";
            }
            finally
            {
                _isDeleting = false;
                StateHasChanged();
            }
        }
    }

    public class TableFormModel
    {
        public int AreaId { get; set; }
        public string Name { get; set; } = string.Empty;
        public int Capacity { get; set; } = 4;
        public int SortOrder { get; set; }
        public bool IsActive { get; set; } = true;
        public int Width { get; set; }
        public int Height { get; set; }
        public int Shape { get; set; }
    }
}

<!-- Simple Modal HTML (since file is getting large) -->
@if (_showModal)
{
    <div class="fixed inset-0 bg-black/50 z-[100] flex items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-surface-container-lowest rounded-xl shadow-lg w-full max-w-sm overflow-hidden p-6 animate-in fade-in zoom-in-95 duration-200">
            <h3 class="font-bold text-lg mb-4 text-on-background">@(_isEditing ? L["Table_Modal_Edit"] : L["Table_Modal_Create"])</h3>
            <EditForm Model="@_model" OnValidSubmit="SaveTableAsync">
                <div class="space-y-3 mb-6">
                    <div>
                        <label class="text-sm font-bold block mb-1 text-on-surface">@L["Table_Name_Label"]</label>
                        <InputText @bind-Value="_model.Name" class="w-full border border-outline rounded p-2 bg-surface focus:border-primary focus:outline-none" placeholder="@L["Table_Name_Placeholder"]" />
                    </div>
                    <div>
                        <label class="text-sm font-bold block mb-1 text-on-surface">@L["Table_Capacity_Input"]</label>
                        <InputNumber @bind-Value="_model.Capacity" class="w-full border border-outline rounded p-2 bg-surface focus:border-primary focus:outline-none" min="1" />
                    </div>
                </div>
                <div class="flex justify-end gap-2">
                    <button type="button" class="px-4 py-2 border border-outline text-on-surface rounded hover:bg-surface-low font-label-bold transition-colors" @onclick="CloseModal">@L["Common_Cancel"]</button>
                    <button type="submit" class="px-4 py-2 bg-primary text-white rounded font-label-bold hover:bg-primary/90 transition-colors">@L["Common_Save_Changes"]</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Delete Confirmation -->
@if (_showDeleteConfirm)
{
    <div class="fixed inset-0 bg-black/50 z-[100] flex items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-surface-container-lowest rounded-xl shadow-lg w-full max-w-sm overflow-hidden p-6 animate-in fade-in zoom-in-95 duration-200">
            <div class="text-center">
                <div class="w-16 h-16 rounded-full bg-error-container text-error mx-auto flex items-center justify-center mb-4">
                    <span class="material-symbols-outlined text-3xl" data-icon="warning">warning</span>
                </div>
                <h3 class="text-xl font-bold text-on-background mb-2">@L["Category_Delete_Confirm_Title"]</h3>
                <p class="text-on-surface-variant text-sm mb-6">@string.Format(L["Table_Delete_Confirm"], _tableToDelete?.Name)</p>
                
                @if (!string.IsNullOrEmpty(_deleteErrorMessage))
                {
                    <div class="mb-6 p-3 bg-error-container text-error rounded text-sm text-left border border-error/20">
                        @_deleteErrorMessage
                    </div>
                }

                <div class="flex justify-center gap-3">
                    <button class="px-4 py-2 border border-outline text-on-surface rounded hover:bg-surface-low transition-colors font-label-bold flex-1" @onclick="() => _showDeleteConfirm = false">@L["Common_Cancel"]</button>
                    <button class="px-4 py-2 bg-error text-white rounded hover:bg-error/90 transition-colors font-label-bold flex-1 flex items-center justify-center gap-2" @onclick="ExecuteDeleteAsync" disabled="@_isDeleting">
                        @if (_isDeleting)
                        {
                            <span class="material-symbols-outlined animate-spin text-sm" data-icon="progress_activity">progress_activity</span>
                        }
                        @L["Category_Delete_Now_Btn"]
                    </button>
                </div>
            </div>
        </div>
    </div>
}

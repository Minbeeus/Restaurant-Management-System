@page "/admin/dashboard"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Manager")]
@using Restaurant.Application.Interfaces
@using Restaurant.Web.Components.Pages.Dashboard.Widgets
@using Restaurant.Application.DTOs.Dashboard
@using Restaurant.Web.Services
@inject DashboardApiClient ApiClient
@inject IServiceProvider ServiceProvider
@layout Restaurant.Web.Components.Layout.AdminLayout

<PageTitle>Dashboard</PageTitle>

<div class="flex flex-col gap-6 w-full max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex justify-between items-end pb-sm">
        <div>
            <h1 class="font-display-lg text-display-lg text-on-surface tracking-tight">Tổng quan hôm nay</h1>
            <p class="font-body-md text-body-md text-outline mt-1">Ca làm việc: Sáng • 08:00 - 15:00</p>
        </div>
        <button class="bg-primary-container text-on-primary px-4 py-2 rounded shadow-sm hover:bg-surface-tint transition-colors font-label-bold text-sm">
            Tạo đơn mới (POS)
        </button>
    </div>

    <!-- Stat Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <StatCard Title="Doanh thu" Value="@(_summary?.TodayRevenue.ToString("N0") + "đ")" SubText="@((_summary?.RevenueTrendPercentage > 0 ? "+" : "") + _summary?.RevenueTrendPercentage + "% so với hôm qua")" IconName="payments" TrendText="@(_summary?.IsRevenueTrendingUp == true ? "Tăng" : "Giảm")" TrendColor="@(_summary?.IsRevenueTrendingUp == true ? "text-success-green" : "text-tomato-container")" TrendIcon="@(_summary?.IsRevenueTrendingUp == true ? "trending_up" : "trending_down")" IconBgColor="bg-primary-container" IconColor="text-on-primary" />
        
        <StatCard Title="Đơn hàng mới" Value="@(_summary?.ActiveOrders.ToString() ?? "0")" SubText="Cần duyệt ngay" SubTextColor="text-warning-amber" IconName="receipt" TrendText="" StatusColor="bg-warning-amber" IconBgColor="bg-warning-bg" IconColor="text-warning-amber" />
        
        <StatCard Title="Bàn đang phục vụ" Value="@($"{_summary?.OccupiedTables ?? 0}/{_summary?.TotalTables ?? 0}")" SubText="@($"Tỉ lệ lấp đầy {(_summary?.TotalTables > 0 ? (_summary.OccupiedTables * 100 / _summary.TotalTables) : 0)}%")" IconName="table_restaurant" TrendText="" IconBgColor="bg-secondary-container" IconColor="text-on-secondary-container" />
        
        <StatCard Title="Nguyên liệu sắp hết" Value="@(_summary?.LowStockMaterials.ToString() ?? "0")" SubText="Cần nhập hàng" SubTextColor="text-tomato-container" IconName="inventory_2" TrendText="" StatusColor="@(_summary?.LowStockMaterials > 0 ? "bg-tomato-container" : "")" IconBgColor="bg-error-container" IconColor="text-tomato-container" />
    </div>

    <!-- Main Grid Area -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
        <!-- Left Column (Chart + Top Movers) -->
        <div class="lg:col-span-2 flex flex-col gap-6">
            <SalesChartWidget />
            <TopMoversWidget Items="@_topMovers" />
        </div>
        
        <!-- Right Column (Activity Feed) -->
        <div class="lg:col-span-1 h-[800px]">
            <ActivityFeedWidget Items="@_activityFeed" />
        </div>
    </div>
</div>

@code {
    private DashboardSummaryDto? _summary;
    private List<SalesChartPointDto>? _chartData;
    private List<TopMoverDto>? _topMovers;
    private List<ActivityFeedItemDto>? _activityFeed;

    [Inject]
    public NavigationManager Navigation { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try 
        {
            _summary = await ApiClient.GetSummaryAsync();
            _chartData = await ApiClient.GetSalesChartAsync();
            _topMovers = await ApiClient.GetTopMoversAsync();
            _activityFeed = await ApiClient.GetActivityFeedAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard: {ex.Message}");
            // Khởi tạo data giả để tránh crash trang
            _summary = new DashboardSummaryDto();
            _chartData = new List<SalesChartPointDto>();
            _topMovers = new List<TopMoverDto>();
            _activityFeed = new List<ActivityFeedItemDto>();
        }
    }
}

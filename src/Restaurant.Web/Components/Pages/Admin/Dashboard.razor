@page "/admin/dashboard"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Manager")]
@using Restaurant.Application.Interfaces
@using Restaurant.Web.Components.Pages.Dashboard.Widgets
@using Restaurant.Application.DTOs.Dashboard
@using Restaurant.Web.Services
@inject DashboardApiClient ApiClient
@inject NavigationManager Navigation
@layout Restaurant.Web.Components.Layout.AdminLayout
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable

<PageTitle>@L["Dashboard_Title"]</PageTitle>

<div class="flex flex-col gap-6 w-full max-w-7xl mx-auto pb-8">
    <!-- Header & Controls -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-2 border-b border-outline-variant/30">
        <div>
            <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight font-bold">
                @(IsToday ? L["Dashboard_Header_Today"] : string.Format(L["Dashboard_Header_Date"], _selectedDate.ToString("dd/MM/yyyy")))
            </h1>
            <p class="font-body-md text-sm text-on-surface-variant mt-1">
                @L["Dashboard_Subtitle"]
            </p>
        </div>
        
        <div class="flex flex-wrap items-center gap-3">
            <!-- Date Filter & Quick Presets -->
            <div class="flex items-center gap-2 bg-surface-container-low p-1.5 rounded-lg border border-outline-variant/40 shadow-xs">
                <button class="px-3 py-1.5 rounded text-xs font-bold transition-colors @(IsToday ? "bg-white text-primary shadow-xs" : "text-on-surface-variant hover:text-on-surface")" @onclick="SelectToday">
                    @L["Dashboard_Btn_Today"]
                </button>
                <button class="px-3 py-1.5 rounded text-xs font-bold transition-colors @(IsYesterday ? "bg-white text-primary shadow-xs" : "text-on-surface-variant hover:text-on-surface")" @onclick="SelectYesterday">
                    @L["Dashboard_Btn_Yesterday"]
                </button>
                
                <input type="date" value="@_selectedDate.ToString("yyyy-MM-dd")" @onchange="OnDateInputChanged" class="px-2 py-1 text-xs border border-outline rounded bg-surface focus:outline-none focus:border-primary text-on-surface cursor-pointer font-medium" />
            </div>

            <button class="p-2 bg-surface-container text-on-surface hover:bg-surface-container-high rounded-lg border border-outline-variant/40 transition-colors shadow-xs" @onclick="LoadDashboardData" title="@L["Dashboard_Tooltip_Refresh"]">
                <span class="material-symbols-outlined text-[20px] @(_isLoading ? "animate-spin text-primary" : "")" data-icon="refresh">refresh</span>
            </button>
        </div>
    </div>

    <!-- Stat Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <StatCard Title="@L["Dashboard_Stat_Revenue"]" 
                  Value="@((_summary?.TodayRevenue ?? 0).ToString("N0") + "đ")" 
                  SubText="@((_summary?.RevenueTrendPercentage > 0 ? "+" : "") + (_summary?.RevenueTrendPercentage ?? 0) + "% " + L["Dashboard_Trend_Compared"])" 
                  IconName="payments" 
                  TrendText="@(_summary?.IsRevenueTrendingUp == true ? L["Dashboard_Trend_Up"] : L["Dashboard_Trend_Down"])" 
                  TrendColor="@(_summary?.IsRevenueTrendingUp == true ? "text-success-green" : "text-tomato-container")" 
                  TrendIcon="@(_summary?.IsRevenueTrendingUp == true ? "trending_up" : "trending_down")" 
                  IconBgColor="bg-primary-container" 
                  IconColor="text-on-primary" />
        
        <StatCard Title="@L["Dashboard_Stat_ActiveOrders"]" 
                  Value="@(_summary?.ActiveOrders.ToString() ?? "0")" 
                  SubText="@L["Dashboard_Stat_ActiveOrders_Sub"]" 
                  SubTextColor="text-warning-amber" 
                  IconName="receipt_long" 
                  TrendText="" 
                  StatusColor="bg-warning-amber" 
                  IconBgColor="bg-warning-bg" 
                  IconColor="text-warning-amber" />
        
        <StatCard Title="@L["Dashboard_Stat_OccupiedTables"]" 
                  Value="@($"{_summary?.OccupiedTables ?? 0}/{_summary?.TotalTables ?? 0}")" 
                  SubText="@string.Format(L["Dashboard_Stat_OccupancyRate"], (_summary?.TotalTables > 0 ? (_summary.OccupiedTables * 100 / _summary.TotalTables) : 0))" 
                  IconName="table_restaurant" 
                  TrendText="" 
                  IconBgColor="bg-secondary-container" 
                  IconColor="text-on-secondary-container" />
        
        <StatCard Title="@L["Dashboard_Stat_LowStock"]" 
                  Value="@(_summary?.LowStockMaterials.ToString() ?? "0")" 
                  SubText="@L["Dashboard_Stat_LowStock_Sub"]" 
                  SubTextColor="text-tomato-container" 
                  IconName="inventory_2" 
                  TrendText="" 
                  StatusColor="@(_summary?.LowStockMaterials > 0 ? "bg-tomato-container" : "")" 
                  IconBgColor="bg-error-container" 
                  IconColor="text-tomato-container" />
    </div>

    <!-- Main Grid Area -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
        <!-- Left Column (Chart + Top Movers) -->
        <div class="lg:col-span-2 flex flex-col gap-6">
            <SalesChartWidget Data="@_chartData" SelectedDate="@_selectedDate" />
            <TopMoversWidget Items="@_topMovers" />
        </div>
        
        <!-- Right Column (Activity Feed) -->
        <div class="lg:col-span-1 h-[780px]">
            <ActivityFeedWidget Items="@_activityFeed" OnRefresh="LoadDashboardData" />
        </div>
    </div>
</div>

@code {
    private DashboardSummaryDto? _summary;
    private List<SalesChartPointDto>? _chartData;
    private List<TopMoverDto>? _topMovers;
    private List<ActivityFeedItemDto>? _activityFeed;
    
    private DateTime _selectedDate = DateTime.Today;
    private bool _isLoading = false;
    private HubConnection? _hubConnection;
    private System.Threading.Timer? _refreshTimer;

    private bool IsToday => _selectedDate.Date == DateTime.Today;
    private bool IsYesterday => _selectedDate.Date == DateTime.Today.AddDays(-1);

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();

        // 1. Periodic auto-refresh every 15 seconds
        _refreshTimer = new System.Threading.Timer(_ =>
        {
            _ = InvokeAsync(async () =>
            {
                if (!_isLoading && IsToday)
                {
                    await LoadDashboardData();
                    StateHasChanged();
                }
            });
        }, null, 15000, 15000);

        // 2. Real-time SignalR listeners
        _hubConnection = new HubConnectionBuilder()
            .WithUrl("http://localhost:5011/hubs/restaurant?clientType=pos")
            .WithAutomaticReconnect()
            .Build();

        void TriggerReload()
        {
            _ = InvokeAsync(async () =>
            {
                if (IsToday)
                {
                    await LoadDashboardData();
                    StateHasChanged();
                }
            });
        }

        _hubConnection.On<int, int, string, string, decimal>("ReceiveNewQrOrder", (a, b, c, d, e) => TriggerReload());
        _hubConnection.On<Restaurant.Application.DTOs.KitchenTicketDto>("ReceiveKitchenTicket", _ => TriggerReload());
        _hubConnection.On<int, string, int>("ReceiveItemStatusUpdate", (a, b, c) => TriggerReload());
        _hubConnection.On<int, string, decimal, string>("ReceivePaymentCompleted", (a, b, c, d) => TriggerReload());
        _hubConnection.On<int, string>("ReceiveTableStatusSync", (a, b) => TriggerReload());

        try
        {
            await _hubConnection.StartAsync();
        }
        catch { }
    }

    private async Task LoadDashboardData()
    {
        _isLoading = true;
        try 
        {
            var taskSummary = ApiClient.GetSummaryAsync(_selectedDate);
            var taskChart = ApiClient.GetSalesChartAsync(_selectedDate);
            var taskTopMovers = ApiClient.GetTopMoversAsync(_selectedDate);
            var taskFeed = ApiClient.GetActivityFeedAsync();

            await Task.WhenAll(taskSummary, taskChart, taskTopMovers, taskFeed);

            _summary = taskSummary.Result ?? new DashboardSummaryDto();
            _chartData = taskChart.Result ?? new List<SalesChartPointDto>();
            _topMovers = taskTopMovers.Result ?? new List<TopMoverDto>();
            _activityFeed = taskFeed.Result ?? new List<ActivityFeedItemDto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard data: {ex.Message}");
            _summary = new DashboardSummaryDto();
            _chartData = new List<SalesChartPointDto>();
            _topMovers = new List<TopMoverDto>();
            _activityFeed = new List<ActivityFeedItemDto>();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SelectToday()
    {
        _selectedDate = DateTime.Today;
        await LoadDashboardData();
    }

    private async Task SelectYesterday()
    {
        _selectedDate = DateTime.Today.AddDays(-1);
        await LoadDashboardData();
    }

    private async Task OnDateInputChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var parsedDate))
        {
            _selectedDate = parsedDate;
            await LoadDashboardData();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _refreshTimer?.Dispose();
        if (_hubConnection != null)
        {
            await _hubConnection.DisposeAsync();
        }
    }
}

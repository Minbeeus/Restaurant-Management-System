@page "/admin/system/audit-logs"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.AdminLayout
@using Restaurant.Application.DTOs
@using Restaurant.Web.Services
@inject AdminApiClient ApiClient

<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
    <div>
        <h2 class="text-2xl font-headline-sm text-primary m-0">Nhật Ký Hệ Thống & Kiểm Toán (Audit Logs)</h2>
        <p class="text-on-surface-variant text-sm mt-1">Truy vết toàn bộ các thao tác trọng yếu: mở/đóng ca, xuất két, duyệt hủy món, điều chỉnh giá và kho hàng</p>
    </div>
    <div class="flex items-center gap-3">
        <button class="bg-surface hover:bg-surface-container text-on-surface border border-outline-variant/40 px-4 py-2.5 rounded-xl font-label-bold flex items-center gap-2 shadow-xs transition-all cursor-pointer text-sm"
                @onclick="LoadLogsAsync">
            <span class="material-symbols-outlined text-lg" data-icon="refresh">refresh</span>
            <span>Làm Mới</span>
        </button>
    </div>
</div>

<div class="bg-surface rounded-2xl p-4 border border-outline-variant/30 mb-6 flex flex-col md:flex-row gap-4 justify-between items-center">
    <div class="relative w-full md:w-96">
        <span class="material-symbols-outlined absolute left-3 top-2.5 text-on-surface-variant" data-icon="search">search</span>
        <input type="text" class="w-full pl-10 pr-4 py-2 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary focus:outline-none text-sm"
               placeholder="Tìm theo hành động, nhân sự, chi tiết..." @bind="_searchTerm" @bind:event="oninput" />
    </div>
    <div class="text-xs text-on-surface-variant font-medium">
        Hiển thị <strong>@FilteredLogs.Count</strong> / @_logs.Count bản ghi kiểm toán gần nhất
    </div>
</div>

@if (_isLoading)
{
    <div class="flex items-center justify-center p-12">
        <span class="material-symbols-outlined animate-spin text-4xl text-primary" data-icon="progress_activity">progress_activity</span>
    </div>
}
else if (!FilteredLogs.Any())
{
    <div class="bg-surface rounded-2xl p-12 text-center border border-outline-variant/30">
        <span class="material-symbols-outlined text-5xl text-outline-variant mb-2" data-icon="history">history</span>
        <p class="text-on-surface-variant font-medium">Không tìm thấy bản ghi kiểm toán phù hợp.</p>
    </div>
}
else
{
    <div class="bg-surface rounded-2xl shadow-sm border border-outline-variant/30 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container/50 border-b border-outline-variant/30 text-xs font-bold text-on-surface-variant uppercase tracking-wider">
                        <th class="py-4 px-6">Thời Gian</th>
                        <th class="py-4 px-6">Nhân Sự</th>
                        <th class="py-4 px-6">Hành Động</th>
                        <th class="py-4 px-6">Đối Tượng</th>
                        <th class="py-4 px-6">Chi Tiết Thao Tác</th>
                        <th class="py-4 px-6 text-right">IP Address</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant/20 text-sm">
                    @foreach (var log in FilteredLogs)
                    {
                        <tr class="hover:bg-surface-container/20 transition-colors">
                            <td class="py-4 px-6 text-xs text-on-surface-variant whitespace-nowrap">
                                @log.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")
                            </td>
                            <td class="py-4 px-6 font-semibold text-on-surface whitespace-nowrap">
                                <div class="flex items-center gap-2">
                                    <span class="w-7 h-7 rounded-full bg-primary/10 text-primary flex items-center justify-center text-xs font-bold">
                                        @(string.IsNullOrEmpty(log.UserName) ? "U" : log.UserName.Substring(0, 1).ToUpperInvariant())
                                    </span>
                                    <span>@log.UserName</span>
                                </div>
                            </td>
                            <td class="py-4 px-6 whitespace-nowrap">
                                <span class="px-2.5 py-1 rounded-lg text-xs font-mono font-bold @GetActionBadgeClass(log.Action)">
                                    @log.Action
                                </span>
                            </td>
                            <td class="py-4 px-6 text-xs font-medium text-on-surface-variant whitespace-nowrap">
                                @log.EntityName @(string.IsNullOrEmpty(log.EntityId) ? "" : $"#{log.EntityId}")
                            </td>
                            <td class="py-4 px-6 text-xs text-on-surface">
                                @log.Details
                            </td>
                            <td class="py-4 px-6 text-right font-mono text-xs text-on-surface-variant whitespace-nowrap">
                                @(string.IsNullOrEmpty(log.IpAddress) ? "127.0.0.1" : log.IpAddress)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<AuditLogDto> _logs = new();
    private bool _isLoading = true;
    private string _searchTerm = string.Empty;

    private List<AuditLogDto> FilteredLogs => string.IsNullOrWhiteSpace(_searchTerm)
        ? _logs
        : _logs.Where(l =>
            (l.Action?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (l.UserName?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (l.EntityName?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (l.Details?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadLogsAsync();
    }

    private async Task LoadLogsAsync()
    {
        _isLoading = true;
        try
        {
            _logs = await ApiClient.GetAuditLogsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading audit logs: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetActionBadgeClass(string action)
    {
        var act = action.ToUpperInvariant();
        if (act.Contains("APPROVE") || act.Contains("CREATE")) return "bg-emerald-100 text-emerald-800";
        if (act.Contains("REJECT") || act.Contains("VOID") || act.Contains("DELETE")) return "bg-red-100 text-red-800";
        if (act.Contains("UPDATE") || act.Contains("MODIFY")) return "bg-amber-100 text-amber-800";
        return "bg-blue-100 text-blue-800";
    }
}

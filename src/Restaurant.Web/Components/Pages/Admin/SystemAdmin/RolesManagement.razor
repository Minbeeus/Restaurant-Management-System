@page "/admin/system/roles"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.AdminLayout
@using Restaurant.Application.DTOs
@using Restaurant.Web.Services
@inject AdminApiClient ApiClient

<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
    <div>
        <h2 class="text-2xl font-headline-sm text-primary m-0">Quản Lý Phân Quyền & Vai Trò</h2>
        <p class="text-on-surface-variant text-sm mt-1">Cấu hình các nhóm quyền hạn truy cập nghiệp vụ POS, BOH, KDS và Kho hàng</p>
    </div>
</div>

@if (_isLoading)
{
    <div class="flex items-center justify-center p-12">
        <span class="material-symbols-outlined animate-spin text-4xl text-primary" data-icon="progress_activity">progress_activity</span>
    </div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var role in _roles)
        {
            <div class="bg-surface rounded-2xl p-6 shadow-sm border border-outline-variant/30 flex flex-col justify-between hover:border-primary/50 transition-all">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
                                <span class="material-symbols-outlined" data-icon="@GetRoleIcon(role.Name)">@GetRoleIcon(role.Name)</span>
                            </div>
                            <div>
                                <h3 class="font-bold text-lg text-on-surface m-0">@role.Name</h3>
                                <span class="text-xs text-on-surface-variant font-medium">@role.UserCount nhân sự</span>
                            </div>
                        </div>
                        <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-primary-fixed/20 text-primary">
                            Role #@role.Id
                        </span>
                    </div>

                    <p class="text-sm text-on-surface-variant mb-4">
                        @(string.IsNullOrEmpty(role.Description) ? "Không có mô tả chi tiết." : role.Description)
                    </p>

                    <div class="border-t border-outline-variant/20 pt-3">
                        <h4 class="text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-2">Quyền hạn áp dụng:</h4>
                        <div class="flex flex-wrap gap-1.5">
                            @foreach (var perm in role.Permissions)
                            {
                                <span class="text-xs bg-surface-container px-2.5 py-1 rounded-lg text-on-surface font-medium border border-outline-variant/20">
                                    ✓ @perm
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <div class="mt-6 pt-4 border-t border-outline-variant/20 flex justify-between items-center text-xs text-on-surface-variant">
                    <span>Trạng thái: <strong class="text-emerald-600">Đang hoạt động</strong></span>
                    <a href="/admin/staff" class="text-primary hover:underline font-semibold flex items-center gap-1">
                        Xem nhân sự <span class="material-symbols-outlined text-sm" data-icon="arrow_forward">arrow_forward</span>
                    </a>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<RoleDto> _roles = new();
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadRolesAsync();
    }

    private async Task LoadRolesAsync()
    {
        _isLoading = true;
        try
        {
            _roles = await ApiClient.GetRolesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading roles: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetRoleIcon(string roleName) => roleName.ToUpperInvariant() switch
    {
        "ADMIN" => "admin_panel_settings",
        "MANAGER" => "manage_accounts",
        "CASHIER" => "point_of_sale",
        "CHEF" => "soup_kitchen",
        _ => "badge"
    };
}

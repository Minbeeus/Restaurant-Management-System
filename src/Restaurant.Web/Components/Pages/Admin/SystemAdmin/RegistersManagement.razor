@page "/admin/system/registers"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.AdminLayout
@using Restaurant.Application.DTOs
@using Restaurant.Web.Services
@inject AdminApiClient ApiClient

<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
    <div>
        <h2 class="text-2xl font-headline-sm text-primary m-0">Quản Lý Máy Tính Tiền (POS Registers)</h2>
        <p class="text-on-surface-variant text-sm mt-1">Quản lý định danh các thiết bị thanh toán POS tại quầy và thiết bị di động</p>
    </div>
    <button class="bg-primary hover:bg-primary/90 text-on-primary px-4 py-2.5 rounded-xl font-label-bold flex items-center gap-2 shadow-sm transition-all cursor-pointer" @onclick="OpenAddModal">
        <span class="material-symbols-outlined text-lg" data-icon="add">add</span>
        <span>Thêm Máy POS</span>
    </button>
</div>

@if (!string.IsNullOrEmpty(_feedbackMessage))
{
    <div class="p-4 mb-6 rounded-xl border flex items-center justify-between @(_isError ? "bg-red-50 text-red-700 border-red-200" : "bg-emerald-50 text-emerald-700 border-emerald-200")">
        <span class="font-medium text-sm">@_feedbackMessage</span>
        <button type="button" @onclick="() => _feedbackMessage = null" class="text-sm font-bold">✕</button>
    </div>
}

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="bg-surface rounded-2xl p-5 border border-outline-variant/30 flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
            <span class="material-symbols-outlined text-2xl" data-icon="point_of_sale">point_of_sale</span>
        </div>
        <div>
            <div class="text-xs text-on-surface-variant font-medium">Tổng số máy POS</div>
            <div class="text-2xl font-bold text-on-surface">@_registers.Count</div>
        </div>
    </div>
    <div class="bg-surface rounded-2xl p-5 border border-outline-variant/30 flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-600">
            <span class="material-symbols-outlined text-2xl" data-icon="check_circle">check_circle</span>
        </div>
        <div>
            <div class="text-xs text-on-surface-variant font-medium">Máy đang hoạt động</div>
            <div class="text-2xl font-bold text-emerald-600">@_registers.Count(r => r.IsActive)</div>
        </div>
    </div>
    <div class="bg-surface rounded-2xl p-5 border border-outline-variant/30 flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-slate-500/10 flex items-center justify-center text-slate-500">
            <span class="material-symbols-outlined text-2xl" data-icon="pause_circle">pause_circle</span>
        </div>
        <div>
            <div class="text-xs text-on-surface-variant font-medium">Máy tạm ngưng</div>
            <div class="text-2xl font-bold text-slate-600">@_registers.Count(r => !r.IsActive)</div>
        </div>
    </div>
</div>

@if (_isLoading)
{
    <div class="flex items-center justify-center p-12">
        <span class="material-symbols-outlined animate-spin text-4xl text-primary" data-icon="progress_activity">progress_activity</span>
    </div>
}
else
{
    <div class="bg-surface rounded-2xl shadow-sm border border-outline-variant/30 overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-surface-container/50 border-b border-outline-variant/30 text-xs font-bold text-on-surface-variant uppercase tracking-wider">
                    <th class="py-4 px-6">Mã Thiết Bị</th>
                    <th class="py-4 px-6">Tên Máy / Vị Trí Quầy</th>
                    <th class="py-4 px-6">Ngày Tạo</th>
                    <th class="py-4 px-6">Trạng Thái</th>
                    <th class="py-4 px-6 text-right">Thao Tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant/20 text-sm">
                @foreach (var reg in _registers)
                {
                    <tr class="hover:bg-surface-container/20 transition-colors">
                        <td class="py-4 px-6 font-bold text-primary font-mono">@reg.Code</td>
                        <td class="py-4 px-6 font-medium text-on-surface">@reg.Name</td>
                        <td class="py-4 px-6 text-on-surface-variant text-xs">@reg.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="py-4 px-6">
                            @if (reg.IsActive)
                            {
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">
                                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                    Hoạt động
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-600">
                                    <span class="w-2 h-2 rounded-full bg-slate-400"></span>
                                    Tạm ngưng
                                </span>
                            }
                        </td>
                        <td class="py-4 px-6 text-right">
                            <button type="button" class="px-3 py-1.5 text-xs font-semibold rounded-lg border transition-all cursor-pointer @(reg.IsActive ? "border-red-200 text-red-600 hover:bg-red-50" : "border-emerald-200 text-emerald-600 hover:bg-emerald-50")"
                                    @onclick="() => ToggleStatus(reg)">
                                @(reg.IsActive ? "Vô hiệu hóa" : "Kích hoạt")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_isModalOpen)
{
    <div class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
        <div class="bg-surface rounded-2xl p-6 w-full max-w-md shadow-xl border border-outline-variant/30">
            <h3 class="text-lg font-bold text-on-surface mb-4">Thêm Máy POS Mới</h3>
            
            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-on-surface-variant mb-1">Mã Máy (Code) *</label>
                    <input type="text" class="w-full px-3 py-2 border rounded-xl font-mono uppercase bg-surface text-on-surface border-outline-variant/40 focus:border-primary focus:outline-none"
                           placeholder="VD: POS-04" @bind="_newRegister.Code" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-on-surface-variant mb-1">Tên Máy / Vị Trí *</label>
                    <input type="text" class="w-full px-3 py-2 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary focus:outline-none"
                           placeholder="VD: Quầy Thu Ngân Tầng 2" @bind="_newRegister.Name" />
                </div>
                <div class="flex items-center gap-2">
                    <input type="checkbox" id="regActive" class="rounded text-primary focus:ring-primary w-4 h-4" @bind="_newRegister.IsActive" />
                    <label for="regActive" class="text-sm text-on-surface">Kích hoạt sử dụng ngay</label>
                </div>
            </div>

            <div class="flex justify-end gap-3 mt-6">
                <button type="button" class="px-4 py-2 text-sm font-semibold text-on-surface-variant hover:bg-surface-container rounded-xl cursor-pointer"
                        @onclick="() => _isModalOpen = false">
                    Hủy
                </button>
                <button type="button" class="px-5 py-2 text-sm font-bold text-on-primary bg-primary hover:bg-primary/90 rounded-xl cursor-pointer"
                        @onclick="SaveNewRegister">
                    Lưu Máy POS
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<RegisterDto> _registers = new();
    private bool _isLoading = true;
    private bool _isModalOpen = false;
    private CreateRegisterRequest _newRegister = new();
    private string? _feedbackMessage;
    private bool _isError = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadRegistersAsync();
    }

    private async Task LoadRegistersAsync()
    {
        _isLoading = true;
        try
        {
            _registers = await ApiClient.GetRegistersAsync();
        }
        catch (Exception ex)
        {
            _feedbackMessage = $"Lỗi tải dữ liệu: {ex.Message}";
            _isError = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenAddModal()
    {
        _newRegister = new CreateRegisterRequest
        {
            Code = $"POS-0{_registers.Count + 1}",
            IsActive = true
        };
        _isModalOpen = true;
    }

    private async Task SaveNewRegister()
    {
        if (string.IsNullOrWhiteSpace(_newRegister.Code) || string.IsNullOrWhiteSpace(_newRegister.Name))
        {
            _feedbackMessage = "Vui lòng nhập đầy đủ mã máy và tên máy!";
            _isError = true;
            return;
        }

        var success = await ApiClient.CreateRegisterAsync(_newRegister);
        if (success)
        {
            _feedbackMessage = "Thêm máy POS mới thành công!";
            _isError = false;
            _isModalOpen = false;
            await LoadRegistersAsync();
        }
        else
        {
            _feedbackMessage = "Thêm máy POS thất bại. Vui lòng thử lại!";
            _isError = true;
        }
    }

    private async Task ToggleStatus(RegisterDto reg)
    {
        var success = await ApiClient.ToggleRegisterStatusAsync(reg.Id);
        if (success)
        {
            reg.IsActive = !reg.IsActive;
            _feedbackMessage = $"Đã cập nhật trạng thái máy {reg.Code}!";
            _isError = false;
        }
        else
        {
            _feedbackMessage = "Cập nhật trạng thái thất bại!";
            _isError = true;
        }
    }
}

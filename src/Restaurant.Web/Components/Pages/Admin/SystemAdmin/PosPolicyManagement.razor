@page "/admin/system/pos-policy"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.AdminLayout
@using Restaurant.Application.Common
@using Restaurant.Web.Services
@inject AdminApiClient ApiClient

<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
    <div>
        <h2 class="text-2xl font-headline-sm text-primary m-0">Chính Sách & Hạn Mức POS (POS Policy)</h2>
        <p class="text-on-surface-variant text-sm mt-1">Cấu hình các hạn mức phê duyệt, giới hạn chiết khấu, hạn mức xuất két và bảo mật PIN</p>
    </div>
    <button class="bg-primary hover:bg-primary/90 text-on-primary px-5 py-2.5 rounded-xl font-label-bold flex items-center gap-2 shadow-sm transition-all cursor-pointer" @onclick="SavePolicy" disabled="@_isSaving">
        <span class="material-symbols-outlined text-lg" data-icon="save">save</span>
        <span>@(_isSaving ? "Đang lưu..." : "Lưu Thay Đổi")</span>
    </button>
</div>

@if (!string.IsNullOrEmpty(_feedbackMessage))
{
    <div class="p-4 mb-6 rounded-xl border flex items-center justify-between @(_isError ? "bg-red-50 text-red-700 border-red-200" : "bg-emerald-50 text-emerald-700 border-emerald-200")">
        <span class="font-medium text-sm">@_feedbackMessage</span>
        <button type="button" @onclick="() => _feedbackMessage = null" class="text-sm font-bold">✕</button>
    </div>
}

@if (_isLoading)
{
    <div class="flex items-center justify-center p-12">
        <span class="material-symbols-outlined animate-spin text-4xl text-primary" data-icon="progress_activity">progress_activity</span>
    </div>
}
else
{
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Hạn mức tiền tệ & chiết khấu -->
        <div class="bg-surface rounded-2xl p-6 shadow-sm border border-outline-variant/30 space-y-5">
            <div class="flex items-center gap-3 pb-3 border-b border-outline-variant/20">
                <span class="material-symbols-outlined text-primary text-2xl" data-icon="payments">payments</span>
                <div>
                    <h3 class="font-bold text-lg text-on-surface m-0">Hạn Mức Tiền Mặt & Chiết Khấu</h3>
                    <p class="text-xs text-on-surface-variant">Ngưỡng tối đa thu ngân được phép thực hiện mà không cần mã quản lý</p>
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-on-surface-variant mb-1">Hạn Mức Rút Tiền Két (Till Out Limit - VNĐ)</label>
                <div class="relative">
                    <input type="number" step="10000" class="w-full px-3 py-2 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary focus:outline-none font-semibold"
                           @bind="_policy.TillOutLimit" />
                    <span class="absolute right-3 top-2.5 text-xs text-on-surface-variant font-medium">VNĐ</span>
                </div>
                <p class="text-xs text-on-surface-variant mt-1">Xuất két vượt mức này sẽ yêu cầu Quản lý nhập mã PIN phê duyệt.</p>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-on-surface-variant mb-1">Giới Hạn Giảm Giá (%)</label>
                    <div class="relative">
                        <input type="number" step="1" max="100" min="0" class="w-full px-3 py-2 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary focus:outline-none font-semibold"
                               @bind="_policy.DiscountPercentLimit" />
                        <span class="absolute right-3 top-2.5 text-xs text-on-surface-variant font-medium">%</span>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-on-surface-variant mb-1">Hạn Mức Giảm Tiền Mặt (VNĐ)</label>
                    <div class="relative">
                        <input type="number" step="10000" class="w-full px-3 py-2 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary focus:outline-none font-semibold"
                               @bind="_policy.DiscountAmountLimit" />
                        <span class="absolute right-3 top-2.5 text-xs text-on-surface-variant font-medium">VNĐ</span>
                    </div>
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-on-surface-variant mb-1">Hạn Mức Hoàn Tiền Hóa Đơn (Refund Limit - VNĐ)</label>
                <div class="relative">
                    <input type="number" step="10000" class="w-full px-3 py-2 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary focus:outline-none font-semibold"
                           @bind="_policy.RefundLimit" />
                    <span class="absolute right-3 top-2.5 text-xs text-on-surface-variant font-medium">VNĐ</span>
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-on-surface-variant mb-1">Hạn Mức Điều Chỉnh Tiền (Cash Adjustment Limit - VNĐ)</label>
                <div class="relative">
                    <input type="number" step="10000" class="w-full px-3 py-2 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary focus:outline-none font-semibold"
                           @bind="_policy.CashAdjustmentLimit" />
                    <span class="absolute right-3 top-2.5 text-xs text-on-surface-variant font-medium">VNĐ</span>
                </div>
            </div>
        </div>

        <!-- Quy tắc phê duyệt & Bảo mật mã PIN -->
        <div class="bg-surface rounded-2xl p-6 shadow-sm border border-outline-variant/30 space-y-5">
            <div class="flex items-center gap-3 pb-3 border-b border-outline-variant/20">
                <span class="material-symbols-outlined text-primary text-2xl" data-icon="security">security</span>
                <div>
                    <h3 class="font-bold text-lg text-on-surface m-0">Quy Tắc Phê Duyệt & Bảo Mật</h3>
                    <p class="text-xs text-on-surface-variant">Bắt buộc xác thực cấp quản lý và phòng chống brute-force PIN</p>
                </div>
            </div>

            <div class="space-y-4 pt-2">
                <div class="flex items-start gap-3 p-3.5 bg-surface-container/50 rounded-xl">
                    <input type="checkbox" id="reqRefundApp" class="mt-0.5 rounded text-primary focus:ring-primary w-4 h-4 cursor-pointer"
                           @bind="_policy.RequireManagerApprovalForRefund" />
                    <label for="reqRefundApp" class="text-sm cursor-pointer select-none">
                        <strong class="block text-on-surface font-semibold">Bắt buộc Quản lý duyệt Hoàn tiền (Refund)</strong>
                        <span class="text-xs text-on-surface-variant">Mọi giao dịch hủy hóa đơn đã thanh toán hoặc hoàn lại tiền đều cần xác nhận bằng PIN Quản lý.</span>
                    </label>
                </div>

                <div class="flex items-start gap-3 p-3.5 bg-surface-container/50 rounded-xl">
                    <input type="checkbox" id="reqShiftApp" class="mt-0.5 rounded text-primary focus:ring-primary w-4 h-4 cursor-pointer"
                           @bind="_policy.RequireApprovalForShiftVariance" />
                    <label for="reqShiftApp" class="text-sm cursor-pointer select-none">
                        <strong class="block text-on-surface font-semibold">Bắt buộc Quản lý duyệt khi Lệch ca thu ngân</strong>
                        <span class="text-xs text-on-surface-variant">Khi đóng ca có chênh lệch tiền mặt so với hệ thống tính toán, cần có chữ ký số/PIN quản lý xác nhận.</span>
                    </label>
                </div>
            </div>

            <div class="border-t border-outline-variant/20 pt-4 space-y-4">
                <div>
                    <label class="block text-xs font-bold text-on-surface-variant mb-1">Số Lần Nhập Sai PIN Tối Đa Trước Khi Khóa</label>
                    <input type="number" min="3" max="10" class="w-full px-3 py-2 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary focus:outline-none font-semibold"
                           @bind="_policy.MaxPinAttemptsBeforeCooldown" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-on-surface-variant mb-1">Thời Gian Khóa Tạm Thời (Phút)</label>
                    <input type="number" min="1" max="60" class="w-full px-3 py-2 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary focus:outline-none font-semibold"
                           @bind="_policy.PinCooldownMinutes" />
                </div>
            </div>
        </div>
    </div>
}

@code {
    private PosPolicyOptions _policy = new();
    private bool _isLoading = true;
    private bool _isSaving = false;
    private string? _feedbackMessage;
    private bool _isError = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadPolicyAsync();
    }

    private async Task LoadPolicyAsync()
    {
        _isLoading = true;
        try
        {
            _policy = await ApiClient.GetPosPolicyAsync();
        }
        catch (Exception ex)
        {
            _feedbackMessage = $"Lỗi: {ex.Message}";
            _isError = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SavePolicy()
    {
        _isSaving = true;
        try
        {
            var success = await ApiClient.UpdatePosPolicyAsync(_policy);
            if (success)
            {
                _feedbackMessage = "Cập nhật chính sách POS thành công!";
                _isError = false;
            }
            else
            {
                _feedbackMessage = "Lưu chính sách POS thất bại!";
                _isError = true;
            }
        }
        catch (Exception ex)
        {
            _feedbackMessage = $"Lỗi: {ex.Message}";
            _isError = true;
        }
        finally
        {
            _isSaving = false;
        }
    }
}

@page "/admin/suppliers"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.AdminLayout
@using Restaurant.Application.DTOs
@using Restaurant.Web.Services
@inject AdminApiClient ApiClient

@if (!_isFormOpen)
{
    <!-- ========================================== -->
    <!-- VIEW A: DANH SÁCH NHÀ CUNG CẤP -->
    <!-- ========================================== -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
        <div>
            <h2 class="text-2xl font-headline-sm text-primary m-0">Quản Lý Nhà Cung Cấp Hàng Hóa</h2>
            <p class="text-on-surface-variant text-sm mt-1">Danh bạ nhà phân phối nguyên vật liệu, liên hệ đại diện và hợp đồng cung ứng</p>
        </div>
        <div class="flex items-center gap-2">
            <button class="bg-surface hover:bg-surface-container border border-outline-variant/40 text-on-surface px-4 py-2.5 rounded-xl font-bold text-xs shadow-2xs transition-all flex items-center gap-1.5 cursor-pointer" 
                    @onclick="RestoreStandardSuppliers" title="Khôi phục/Bổ sung lại các nhà cung cấp mẫu chuẩn">
                <span class="material-symbols-outlined text-base text-primary">restore_page</span>
                <span>Khôi phục NCC chuẩn</span>
            </button>
            <button class="bg-primary hover:bg-primary/90 text-on-primary px-5 py-2.5 rounded-xl font-bold text-xs shadow-sm transition-all flex items-center gap-1.5 cursor-pointer active:scale-95" @onclick="OpenAddForm">
                <span class="material-symbols-outlined text-base" data-icon="add_circle">add_circle</span>
                <span>Thêm Nhà Cung Cấp Mới</span>
            </button>
        </div>
    </div>

    <!-- Filter Tabs -->
    <div class="flex items-center gap-2 mb-6 border-b border-outline-variant/30 pb-3">
        <button class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer @(_statusFilter == "all" ? "bg-primary text-on-primary shadow-xs" : "bg-surface-high text-on-surface hover:bg-surface-high/80")"
                @onclick='() => _statusFilter = "all"'>
            Tất cả (@_suppliers.Count)
        </button>
        <button class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer @(_statusFilter == "active" ? "bg-emerald-600 text-white shadow-xs" : "bg-surface-high text-on-surface hover:bg-surface-high/80")"
                @onclick='() => _statusFilter = "active"'>
            Đang hợp tác (@_suppliers.Count(s => s.IsActive))
        </button>
        <button class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer @(_statusFilter == "inactive" ? "bg-rose-600 text-white shadow-xs" : "bg-surface-high text-on-surface hover:bg-surface-high/80")"
                @onclick='() => _statusFilter = "inactive"'>
            Đã ngừng hợp tác (@_suppliers.Count(s => !s.IsActive))
        </button>
    </div>

    @if (_isLoading)
    {
        <div class="flex justify-center p-16">
            <span class="material-symbols-outlined animate-spin text-4xl text-primary" data-icon="progress_activity">progress_activity</span>
        </div>
    }
    else if (!FilteredSuppliers.Any())
    {
        <div class="bg-surface rounded-2xl border border-outline-variant/30 p-12 text-center text-on-surface-variant flex flex-col items-center justify-center">
            <span class="material-symbols-outlined text-5xl mb-2 opacity-40">local_shipping</span>
            <p class="font-bold text-base mb-1">Không có nhà cung cấp nào trong danh sách</p>
            <p class="text-xs mb-4">Bạn có thể tạo mới hoặc khôi phục lại các nhà cung cấp mẫu mặc định.</p>
            <button class="bg-primary hover:bg-primary/90 text-on-primary px-4 py-2 rounded-xl font-bold text-xs shadow-xs" @onclick="RestoreStandardSuppliers">
                Khôi phục nhà cung cấp mẫu
            </button>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            @foreach (var sup in FilteredSuppliers)
            {
                <div class="bg-surface rounded-2xl shadow-sm border p-6 flex flex-col justify-between transition-all @(sup.IsActive ? "border-outline-variant/30 hover:border-primary/50" : "border-rose-300/50 bg-rose-50/10 opacity-75")">
                    <div>
                        <div class="flex justify-between items-start mb-3">
                            <div class="flex items-center gap-3">
                                <div class="w-12 h-12 rounded-xl flex items-center justify-center @(sup.IsActive ? "bg-primary/10 text-primary" : "bg-rose-100 text-rose-600")">
                                    <span class="material-symbols-outlined text-2xl" data-icon="local_shipping">local_shipping</span>
                                </div>
                                <div>
                                    <h3 class="text-lg font-bold text-on-surface m-0 @(sup.IsActive ? "" : "line-through text-on-surface-variant")">@sup.Name</h3>
                                    <span class="text-xs text-on-surface-variant font-mono">NCC ID #@sup.Id</span>
                                </div>
                            </div>
                            @if (sup.IsActive)
                            {
                                <span class="px-2.5 py-1 bg-emerald-100 text-emerald-800 rounded-full text-xs font-bold border border-emerald-200">
                                    Đang hợp tác
                                </span>
                            }
                            else
                            {
                                <span class="px-2.5 py-1 bg-rose-100 text-rose-800 rounded-full text-xs font-bold border border-rose-200">
                                    Đã ngừng hợp tác
                                </span>
                            }
                        </div>

                        <div class="space-y-2.5 text-sm text-on-surface-variant mt-4 bg-surface-container/20 p-4 rounded-xl border border-outline-variant/20">
                            <div class="flex items-center gap-2.5">
                                <span class="material-symbols-outlined text-base text-primary" data-icon="person">person</span>
                                <span>Người đại diện: <strong class="text-on-surface">@(sup.ContactPerson ?? "Chưa cập nhật")</strong></span>
                            </div>
                            <div class="flex items-center gap-2.5">
                                <span class="material-symbols-outlined text-base text-primary" data-icon="call">call</span>
                                <span>Hotline: <strong class="text-on-surface font-mono">@(sup.PhoneNumber ?? "Chưa cập nhật")</strong></span>
                            </div>
                            <div class="flex items-center gap-2.5">
                                <span class="material-symbols-outlined text-base text-primary" data-icon="location_on">location_on</span>
                                <span>Địa chỉ kho: <span class="text-on-surface">@(sup.Address ?? "Chưa cập nhật")</span></span>
                            </div>
                        </div>
                    </div>

                    <div class="flex justify-end gap-2 pt-4 mt-6 border-t border-outline-variant/20">
                        @if (sup.IsActive)
                        {
                            <button class="px-3.5 py-2 text-xs bg-surface border border-outline-variant/40 hover:bg-surface-container text-on-surface rounded-xl font-bold transition-all cursor-pointer inline-flex items-center gap-1"
                                    @onclick="() => OpenEditForm(sup)">
                                <span class="material-symbols-outlined text-sm" data-icon="edit">edit</span>
                                <span>Chỉnh sửa</span>
                            </button>
                            <button class="px-3.5 py-2 text-xs text-rose-600 hover:bg-rose-50 border border-rose-200 rounded-xl font-bold transition-all cursor-pointer inline-flex items-center gap-1"
                                    @onclick="() => RequestDeleteSupplier(sup)">
                                <span class="material-symbols-outlined text-sm" data-icon="delete">delete</span>
                                <span>Ngừng hợp tác</span>
                            </button>
                        }
                        else
                        {
                            <button class="px-3.5 py-2 text-xs text-emerald-700 bg-emerald-50 hover:bg-emerald-100 border border-emerald-300 rounded-xl font-bold transition-all cursor-pointer inline-flex items-center gap-1 shadow-2xs"
                                    @onclick="() => RestoreSupplier(sup.Id)">
                                <span class="material-symbols-outlined text-sm">settings_backup_restore</span>
                                <span>Khôi phục hợp tác</span>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
}
else
{
    <!-- ========================================== -->
    <!-- VIEW B: GIAO DIỆN RIÊNG THÊM / SỬA NHÀ CUNG CẤP -->
    <!-- (To bằng trang nội dung, giữ nguyên thanh nav) -->
    <!-- ========================================== -->
    <div class="mb-6">
        <nav class="flex items-center gap-2 text-xs text-on-surface-variant mb-2">
            <button class="hover:text-primary transition-colors cursor-pointer" @onclick="CloseForm">Nhà Cung Cấp</button>
            <span>/</span>
            <span class="font-bold text-on-surface">@(_isEditing ? $"Chỉnh Sửa: {_model.Name}" : "Thêm Nhà Cung Cấp Mới")</span>
        </nav>
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div>
                <h2 class="text-2xl font-headline-sm text-primary m-0">@(_isEditing ? "Cập Nhật Hồ Sơ Nhà Cung Cấp" : "Đăng Ký Nhà Cung Cấp Mới")</h2>
                <p class="text-on-surface-variant text-sm mt-1">Thông tin pháp lý, đầu mối liên hệ kinh doanh và địa điểm giao nhận hàng</p>
            </div>
            <div class="flex items-center gap-3">
                <button type="button" class="px-4 py-2.5 rounded-xl border border-outline-variant/40 text-on-surface hover:bg-surface-container font-semibold text-sm transition-all cursor-pointer"
                        @onclick="CloseForm">
                    Hủy & Quay Lại
                </button>
                <button type="button" class="px-6 py-2.5 rounded-xl bg-primary hover:bg-primary/90 text-on-primary font-bold text-sm shadow-md transition-all cursor-pointer flex items-center gap-2 disabled:opacity-50"
                        disabled="@_isSaving" @onclick="SaveSupplier">
                    @if (_isSaving)
                    {
                        <span class="material-symbols-outlined animate-spin text-base" data-icon="progress_activity">progress_activity</span>
                        <span>Đang lưu...</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-base" data-icon="save">save</span>
                        <span>Lưu Hồ Sơ NCC</span>
                    }
                </button>
            </div>
        </div>
    </div>

    <div class="bg-surface rounded-2xl p-6 border border-outline-variant/30 shadow-sm max-w-3xl space-y-5">
        <div class="flex items-center gap-3 pb-3 border-b border-outline-variant/20">
            <span class="material-symbols-outlined text-primary text-2xl" data-icon="store">store</span>
            <h3 class="font-bold text-lg text-on-surface m-0">Thông Tin Đối Tác</h3>
        </div>

        <div>
            <label class="block text-xs font-bold text-on-surface-variant mb-1.5">Tên Đơn Vị / Công Ty Nhà Cung Cấp <span class="text-red-500">*</span></label>
            <input type="text" class="w-full px-3.5 py-2.5 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary text-sm font-bold"
                   placeholder="VD: Công ty TNHH Thực phẩm Ý Việt" @bind="_model.Name" />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="block text-xs font-bold text-on-surface-variant mb-1.5">Người Đại Diện / Phụ Trách Kinh Doanh</label>
                <input type="text" class="w-full px-3.5 py-2.5 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary text-sm font-semibold"
                       placeholder="VD: Nguyễn Văn Hùng" @bind="_model.ContactPerson" />
            </div>
            <div>
                <label class="block text-xs font-bold text-on-surface-variant mb-1.5">Số Điện Thoại Hotline / Zalo</label>
                <input type="text" class="w-full px-3.5 py-2.5 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary text-sm font-mono font-bold"
                       placeholder="VD: 0901234567" @bind="_model.PhoneNumber" />
            </div>
        </div>

        <div>
            <label class="block text-xs font-bold text-on-surface-variant mb-1.5">Địa Chỉ Trụ Sở / Kho Hàng Giao Nhận</label>
            <textarea rows="3" class="w-full px-3.5 py-2.5 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary text-sm"
                      placeholder="Số nhà, tên đường, quận huyện, tỉnh thành..." @bind="_model.Address"></textarea>
        </div>
    </div>
}

<!-- Modal Xác Nhận Ngừng Hợp Tác (Tránh vô tình ấn nhầm) -->
@if (_supplierToDelete != null)
{
    <div class="fixed inset-0 bg-black/50 backdrop-blur-xs flex items-center justify-center z-50 p-4">
        <div class="bg-surface rounded-2xl border border-outline-variant/40 shadow-xl max-w-md w-full p-6 animate-in fade-in zoom-in duration-150">
            <div class="flex items-center gap-3 text-rose-600 mb-3">
                <span class="material-symbols-outlined text-3xl">warning</span>
                <h3 class="text-lg font-bold text-on-surface m-0">Xác Nhận Ngừng Hợp Tác</h3>
            </div>
            <p class="text-sm text-on-surface-variant mb-6">
                Bạn có chắc chắn muốn ngừng hợp tác với nhà cung cấp <strong class="text-on-surface">@_supplierToDelete.Name</strong> không? 
                <br /><span class="text-xs text-on-surface-variant/80 mt-1 block">(Nhà cung cấp này sẽ chuyển sang trạng thái "Đã ngừng hợp tác" và bạn có thể khôi phục lại bất kỳ lúc nào).</span>
            </p>
            <div class="flex justify-end gap-3">
                <button class="px-4 py-2 text-xs font-bold bg-surface border border-outline-variant rounded-xl text-on-surface hover:bg-surface-container cursor-pointer"
                        @onclick="() => _supplierToDelete = null">
                    Hủy bỏ
                </button>
                <button class="px-4 py-2 text-xs font-bold bg-rose-600 hover:bg-rose-700 text-white rounded-xl cursor-pointer shadow-xs"
                        @onclick="ConfirmDeleteSupplier">
                    Đồng ý ngừng hợp tác
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<SupplierDto> _suppliers = new();
    private bool _isLoading = true;
    private bool _isFormOpen = false;
    private bool _isEditing = false;
    private bool _isSaving = false;
    private int _editingId;
    private string _statusFilter = "active";
    private SupplierDto? _supplierToDelete;

    private IEnumerable<SupplierDto> FilteredSuppliers
    {
        get
        {
            if (_statusFilter == "active") return _suppliers.Where(s => s.IsActive);
            if (_statusFilter == "inactive") return _suppliers.Where(s => !s.IsActive);
            return _suppliers;
        }
    }

    private SupplierFormModel _model = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            _suppliers = await ApiClient.GetSuppliersAsync(includeInactive: true);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenAddForm()
    {
        _isEditing = false;
        _model = new SupplierFormModel();
        _isFormOpen = true;
    }

    private void OpenEditForm(SupplierDto sup)
    {
        _isEditing = true;
        _editingId = sup.Id;
        _model = new SupplierFormModel
        {
            Name = sup.Name,
            ContactPerson = sup.ContactPerson,
            PhoneNumber = sup.PhoneNumber,
            Address = sup.Address
        };
        _isFormOpen = true;
    }

    private void CloseForm()
    {
        _isFormOpen = false;
    }

    private async Task SaveSupplier()
    {
        if (string.IsNullOrWhiteSpace(_model.Name)) return;

        _isSaving = true;
        try
        {
            var req = new CreateSupplierRequest
            {
                Name = _model.Name,
                ContactPerson = _model.ContactPerson,
                PhoneNumber = _model.PhoneNumber,
                Address = _model.Address
            };

            if (_isEditing)
            {
                await ApiClient.UpdateSupplierAsync(_editingId, req);
            }
            else
            {
                await ApiClient.CreateSupplierAsync(req);
            }

            _isFormOpen = false;
            await LoadData();
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void RequestDeleteSupplier(SupplierDto sup)
    {
        _supplierToDelete = sup;
    }

    private async Task ConfirmDeleteSupplier()
    {
        if (_supplierToDelete != null)
        {
            await ApiClient.DeleteSupplierAsync(_supplierToDelete.Id);
            _supplierToDelete = null;
            await LoadData();
        }
    }

    private async Task RestoreSupplier(int id)
    {
        await ApiClient.ToggleSupplierStatusAsync(id);
        await LoadData();
    }

    private async Task RestoreStandardSuppliers()
    {
        var standardList = new List<CreateSupplierRequest>
        {
            new CreateSupplierRequest { Name = "Công ty TNHH Thực phẩm Ý Việt", ContactPerson = "Nguyễn Văn Hùng", PhoneNumber = "0901234567", Address = "123 Quận 1, TP.HCM" },
            new CreateSupplierRequest { Name = "Nông sản Sạch Đà Lạt", ContactPerson = "Trần Thị Mai", PhoneNumber = "0987654321", Address = "45 Phường 3, Đà Lạt" },
            new CreateSupplierRequest { Name = "Công ty CP Sữa & Phô Mai Anchor Việt Nam", ContactPerson = "Lê Hoàng Long", PhoneNumber = "0918882233", Address = "Khu chế xuất Tân Thuận, Quận 7, TP.HCM" },
            new CreateSupplierRequest { Name = "Nhà Phân Phối Hải Sản & Thịt Tươi Biển Đông", ContactPerson = "Phạm Văn Tuấn", PhoneNumber = "0934567890", Address = "Cảng cá Hạ Long, Quảng Ninh" }
        };

        foreach (var s in standardList)
        {
            var existing = _suppliers.FirstOrDefault(x => x.Name == s.Name);
            if (existing == null)
            {
                await ApiClient.CreateSupplierAsync(s);
            }
            else if (!existing.IsActive)
            {
                await ApiClient.ToggleSupplierStatusAsync(existing.Id);
            }
        }

        await LoadData();
    }

    public class SupplierFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string? ContactPerson { get; set; }
        public string? PhoneNumber { get; set; }
        public string? Address { get; set; }
    }
}

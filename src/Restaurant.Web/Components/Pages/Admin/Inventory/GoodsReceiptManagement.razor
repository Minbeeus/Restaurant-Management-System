@page "/admin/goods-receipts"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.AdminLayout
@using Restaurant.Application.DTOs
@using Restaurant.Web.Services
@inject AdminApiClient ApiClient

@if (_currentView == ViewMode.List)
{
    <!-- ========================================== -->
    <!-- VIEW A: DANH SÁCH LỊCH SỬ NHẬP KHO -->
    <!-- ========================================== -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
        <div>
            <h2 class="text-2xl font-headline-sm text-primary m-0">Quản Lý Nhập Kho Nguyên Vật Liệu</h2>
            <p class="text-on-surface-variant text-sm mt-1">Theo dõi các phiếu nhập hàng từ nhà cung cấp, kiểm soát công nợ và giá vốn</p>
        </div>
        <button class="bg-primary hover:bg-primary/90 text-on-primary px-5 py-2.5 rounded-xl font-label-bold shadow-sm transition-all flex items-center gap-2 cursor-pointer active:scale-95" @onclick="SwitchToCreateView">
            <span class="material-symbols-outlined text-lg" data-icon="add_circle">add_circle</span>
            <span>Tạo Phiếu Nhập Kho Mới</span>
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_feedbackMessage))
    {
        <div class="p-4 mb-6 rounded-xl border flex items-center justify-between @(_isError ? "bg-red-50 text-red-700 border-red-200" : "bg-emerald-50 text-emerald-700 border-emerald-200")">
            <span class="font-medium text-sm">@_feedbackMessage</span>
            <button type="button" @onclick="() => _feedbackMessage = null" class="text-sm font-bold">✕</button>
        </div>
    }

    <!-- KPI Thống Kê Nhập Kho -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-surface rounded-2xl p-5 border border-outline-variant/30 flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-2xl" data-icon="receipt_long">receipt_long</span>
            </div>
            <div>
                <div class="text-xs text-on-surface-variant font-medium">Tổng số phiếu nhập</div>
                <div class="text-2xl font-bold text-on-surface">@_receipts.Count</div>
            </div>
        </div>
        <div class="bg-surface rounded-2xl p-5 border border-outline-variant/30 flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-600">
                <span class="material-symbols-outlined text-2xl" data-icon="payments">payments</span>
            </div>
            <div>
                <div class="text-xs text-on-surface-variant font-medium">Tổng giá trị nhập kho</div>
                <div class="text-2xl font-bold text-emerald-600 font-mono tabular-nums">@_receipts.Sum(r => r.TotalAmount).ToString("N0") đ</div>
            </div>
        </div>
        <div class="bg-surface rounded-2xl p-5 border border-outline-variant/30 flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-amber-500/10 flex items-center justify-center text-amber-600">
                <span class="material-symbols-outlined text-2xl" data-icon="local_shipping">local_shipping</span>
            </div>
            <div>
                <div class="text-xs text-on-surface-variant font-medium">Nhà cung cấp đối tác</div>
                <div class="text-2xl font-bold text-amber-600">@_suppliers.Count</div>
            </div>
        </div>
    </div>

    <!-- Bảng danh sách phiếu nhập kho -->
    <div class="bg-surface rounded-2xl shadow-sm border border-outline-variant/30 overflow-hidden">
        <!-- Header & Counter -->
        <div class="p-4 border-b border-outline-variant/30 flex flex-col md:flex-row justify-between items-start md:items-center gap-3 bg-surface-container/30">
            <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-primary text-2xl">history</span>
                <div>
                    <h3 class="font-bold text-on-surface text-base m-0">Lịch Sử Phiếu Nhập Kho</h3>
                    <p class="text-xs text-on-surface-variant m-0">Tìm kiếm và lọc theo thời gian hoặc nhà phân phối</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-xs text-on-surface-variant font-medium bg-surface px-3 py-1 rounded-full border border-outline-variant/40">
                    Hiển thị <strong class="text-primary">@FilteredReceipts.Count()</strong> / @_receipts.Count phiếu
                </span>
            </div>
        </div>

        <!-- Bộ Lọc (Date & Supplier Filter Toolbar) -->
        <div class="p-4 border-b border-outline-variant/20 bg-surface-container/10 flex flex-wrap items-center justify-between gap-3 text-xs">
            <div class="flex flex-wrap items-center gap-3 flex-1 min-w-[280px]">
                <!-- Lọc Nhà Cung Cấp -->
                <div class="flex items-center gap-1.5 min-w-[200px]">
                    <span class="font-bold text-on-surface-variant uppercase tracking-wider text-[11px] shrink-0">Nhà cung cấp:</span>
                    <select class="px-3 py-1.5 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary font-medium text-xs cursor-pointer w-full md:w-auto"
                            @bind="_filterSupplierId">
                        <option value="0">-- Tất cả Nhà Cung Cấp --</option>
                        @foreach (var sup in _suppliers)
                        {
                            <option value="@sup.Id">@sup.Name</option>
                        }
                    </select>
                </div>

                <!-- Lọc Theo Ngày -->
                <div class="flex items-center gap-1.5">
                    <span class="font-bold text-on-surface-variant uppercase tracking-wider text-[11px] shrink-0">Từ ngày:</span>
                    <input type="date" class="px-2.5 py-1.5 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary text-xs font-mono"
                           @bind="_filterFromDate" />
                    <span class="text-on-surface-variant">-</span>
                    <span class="font-bold text-on-surface-variant uppercase tracking-wider text-[11px] shrink-0">Đến:</span>
                    <input type="date" class="px-2.5 py-1.5 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary text-xs font-mono"
                           @bind="_filterToDate" />
                </div>

                <!-- Quick date presets -->
                <div class="flex items-center gap-1 shrink-0">
                    <button class="px-2.5 py-1 rounded-lg border border-outline-variant/30 text-on-surface hover:bg-surface-container font-medium text-[11px] cursor-pointer"
                            @onclick='() => SetDateFilterQuick("today")'>
                        Hôm nay
                    </button>
                    <button class="px-2.5 py-1 rounded-lg border border-outline-variant/30 text-on-surface hover:bg-surface-container font-medium text-[11px] cursor-pointer"
                            @onclick='() => SetDateFilterQuick("7days")'>
                        7 ngày
                    </button>
                    <button class="px-2.5 py-1 rounded-lg border border-outline-variant/30 text-on-surface hover:bg-surface-container font-medium text-[11px] cursor-pointer"
                            @onclick='() => SetDateFilterQuick("thisMonth")'>
                        Tháng này
                    </button>
                </div>
            </div>

            <!-- Tìm kiếm mã phiếu & Reset -->
            <div class="flex items-center gap-2">
                <div class="relative">
                    <span class="material-symbols-outlined text-outline absolute left-2.5 top-1.5 text-base pointer-events-none">search</span>
                    <input type="text" placeholder="Tìm mã phiếu..." 
                           class="pl-8 pr-3 py-1.5 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary text-xs w-40"
                           @bind="_filterSearchTerm" @bind:event="oninput" />
                </div>
                @if (_filterSupplierId > 0 || _filterFromDate.HasValue || _filterToDate.HasValue || !string.IsNullOrEmpty(_filterSearchTerm))
                {
                    <button class="px-2.5 py-1.5 rounded-xl text-rose-600 hover:bg-rose-50 border border-rose-200 font-bold text-xs flex items-center gap-1 cursor-pointer"
                            @onclick="ResetFilters" title="Đặt lại bộ lọc">
                        <span class="material-symbols-outlined text-sm">restart_alt</span>
                        <span>Xóa lọc</span>
                    </button>
                }
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="flex justify-center p-12">
                <span class="material-symbols-outlined animate-spin text-4xl text-primary" data-icon="progress_activity">progress_activity</span>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-surface-container/50 border-b border-outline-variant/30 text-xs font-bold text-on-surface-variant uppercase tracking-wider">
                        <tr>
                            <th class="py-4 px-6">Mã Phiếu</th>
                            <th class="py-4 px-6">Nhà Cung Cấp</th>
                            <th class="py-4 px-6">Người Lập Phiếu</th>
                            <th class="py-4 px-6 text-center">Thời Gian Nhập</th>
                            <th class="py-4 px-6 text-right">Tổng Tiền (VNĐ)</th>
                            <th class="py-4 px-6 text-center">Trạng Thái</th>
                            <th class="py-4 px-6 text-right">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant/20 text-sm">
                        @if (!FilteredReceipts.Any())
                        {
                            <tr>
                                <td colspan="7" class="p-10 text-center text-on-surface-variant">
                                    @if (_filterSupplierId > 0 || _filterFromDate.HasValue || _filterToDate.HasValue || !string.IsNullOrEmpty(_filterSearchTerm))
                                    {
                                        <div>
                                            <p class="font-bold text-sm mb-1">Không tìm thấy phiếu nhập nào phù hợp với bộ lọc.</p>
                                            <button class="mt-2 px-3 py-1 rounded-lg bg-surface border border-outline-variant text-xs font-bold cursor-pointer hover:bg-surface-container"
                                                    @onclick="ResetFilters">
                                                Xóa bộ lọc để hiển thị tất cả
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <span>Chưa có phiếu nhập kho nào. Nhấn <strong>"Tạo Phiếu Nhập Kho Mới"</strong> để bắt đầu.</span>
                                    }
                                </td>
                            </tr>
                        }
                        @foreach (var r in FilteredReceipts)
                        {
                            <tr class="hover:bg-surface-container/20 transition-colors">
                                <td class="py-4 px-6 font-mono font-bold text-primary">@r.ReceiptCode</td>
                                <td class="py-4 px-6 font-semibold text-on-surface">@r.SupplierName</td>
                                <td class="py-4 px-6 text-xs text-on-surface-variant">@r.ReceivedByUserName</td>
                                <td class="py-4 px-6 text-center text-xs text-on-surface-variant">@r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="py-4 px-6 text-right font-mono tabular-nums font-bold text-on-surface">@r.TotalAmount.ToString("N0") đ</td>
                                <td class="py-4 px-6 text-center">
                                    <span class="inline-flex items-center gap-1 px-3 py-1 bg-emerald-100 text-emerald-800 rounded-full text-xs font-bold">
                                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                        Đã nhập kho
                                    </span>
                                </td>
                                <td class="py-4 px-6 text-right space-x-2">
                                    <button class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-surface border border-outline-variant/40 hover:bg-surface-container text-on-surface transition-all cursor-pointer inline-flex items-center gap-1"
                                            @onclick="() => SwitchToDetailView(r)">
                                        <span class="material-symbols-outlined text-sm" data-icon="visibility">visibility</span>
                                        <span>Chi tiết</span>
                                    </button>
                                    <button class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-primary/10 border border-primary/20 hover:bg-primary/20 text-primary transition-all cursor-pointer inline-flex items-center gap-1"
                                            @onclick="() => SwitchToDetailView(r, true)">
                                        <span class="material-symbols-outlined text-sm" data-icon="print">print</span>
                                        <span>In</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
else if (_currentView == ViewMode.Create)
{
    <!-- ========================================== -->
    <!-- VIEW B: GIAO DIỆN RIÊNG TẠO PHIẾU NHẬP KHO -->
    <!-- ========================================== -->
    <div class="mb-6">
        <nav class="flex items-center gap-2 text-xs text-on-surface-variant mb-2">
            <button class="hover:text-primary transition-colors cursor-pointer" @onclick="SwitchToListView">Quản Lý Nhập Kho</button>
            <span>/</span>
            <span class="font-bold text-on-surface">Tạo Phiếu Nhập Kho Mới</span>
        </nav>
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div>
                <h2 class="text-2xl font-headline-sm text-primary m-0">Lập Phiếu Nhập Kho Hàng Hóa</h2>
                <p class="text-on-surface-variant text-sm mt-1">Chọn nhà cung cấp để tải danh sách các mặt hàng chuyên biệt được cung cấp</p>
            </div>
            <div class="flex items-center gap-3">
                <button type="button" class="px-4 py-2.5 rounded-xl border border-outline-variant/40 text-on-surface hover:bg-surface-container font-semibold text-sm transition-all cursor-pointer"
                        @onclick="SwitchToListView">
                    Hủy & Quay Lại
                </button>
                <button type="button" class="px-6 py-2.5 rounded-xl bg-primary hover:bg-primary/90 text-on-primary font-bold text-sm shadow-md transition-all cursor-pointer flex items-center gap-2 disabled:opacity-50"
                        disabled="@_isSaving" @onclick="SaveReceipt">
                    @if (_isSaving)
                    {
                        <span class="material-symbols-outlined animate-spin text-base" data-icon="progress_activity">progress_activity</span>
                        <span>Đang lưu phiếu...</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-base" data-icon="check_circle">check_circle</span>
                        <span>Xác Nhận & Lưu Phiếu Nhập</span>
                    }
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="p-4 mb-6 rounded-xl bg-red-50 text-red-700 border border-red-200 text-sm font-medium flex justify-between items-center">
            <span>@_errorMessage</span>
            <button type="button" @onclick="() => _errorMessage = null" class="font-bold">✕</button>
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Thông tin chứng từ / Nhà cung cấp -->
        <div class="bg-surface rounded-2xl p-6 border border-outline-variant/30 space-y-5 lg:col-span-1 shadow-sm">
            <div class="flex items-center gap-3 pb-3 border-b border-outline-variant/20">
                <span class="material-symbols-outlined text-primary text-2xl" data-icon="local_shipping">local_shipping</span>
                <h3 class="font-bold text-lg text-on-surface m-0">Nhà Cung Cấp & Chứng Từ</h3>
            </div>

            <div>
                <label class="block text-xs font-bold text-on-surface-variant mb-1.5">Nhà Cung Cấp Hàng Hóa <span class="text-red-500">*</span></label>
                <select class="w-full px-3.5 py-2.5 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary focus:outline-none text-sm font-semibold cursor-pointer"
                        value="@_selectedSupplierId" @onchange="OnSupplierChanged">
                    <option value="0">-- Vui lòng chọn Nhà Cung Cấp --</option>
                    @foreach (var sup in _suppliers)
                    {
                        <option value="@sup.Id">@sup.Name (@(string.IsNullOrEmpty(sup.PhoneNumber) ? "Đối tác" : sup.PhoneNumber))</option>
                    }
                </select>
                @if (_selectedSupplierId > 0)
                {
                    <p class="text-xs text-primary font-bold mt-1.5 flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm">filter_alt</span>
                        <span>Đã lọc @_supplierMaterials.Count mặt hàng chuyên biệt từ nhà cung cấp này.</span>
                    </p>
                }
                else
                {
                    <p class="text-xs text-on-surface-variant mt-1.5">
                        Hệ thống sẽ lọc danh sách mặt hàng tương ứng theo nhà cung cấp này.
                    </p>
                }
            </div>

            <div>
                <label class="block text-xs font-bold text-on-surface-variant mb-1.5">Ghi Chú / Số Hóa Đơn NCC</label>
                <textarea rows="3" class="w-full px-3.5 py-2.5 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary focus:outline-none text-sm"
                          placeholder="VD: Hóa đơn đỏ số 00412, biên bản giao hàng số..." @bind="_receiptNote"></textarea>
            </div>

            <div class="border-t border-outline-variant/20 pt-4 space-y-3 text-xs text-on-surface-variant">
                <div class="flex justify-between">
                    <span>Thời gian lập:</span>
                    <strong class="text-on-surface">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</strong>
                </div>
                <div class="flex justify-between">
                    <span>Kho tiếp nhận:</span>
                    <strong class="text-on-surface">Kho Nguyên Liệu Bếp Trung Tâm</strong>
                </div>
            </div>
        </div>

        <!-- Bảng chi tiết mặt hàng nhập -->
        <div class="bg-surface rounded-2xl p-6 border border-outline-variant/30 lg:col-span-2 shadow-sm space-y-4 flex flex-col justify-between">
            <div>
                <div class="flex justify-between items-center pb-3 border-b border-outline-variant/20">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary text-2xl" data-icon="inventory_2">inventory_2</span>
                        <h3 class="font-bold text-lg text-on-surface m-0">Danh Sách Mặt Hàng Nhập</h3>
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-primary/10 text-primary">@_receiptRows.Count dòng</span>
                    </div>
                    <button type="button" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-xl text-xs font-bold transition-all shadow-sm flex items-center gap-1.5 cursor-pointer disabled:opacity-50"
                            disabled="@(_selectedSupplierId == 0)" @onclick="AddEmptyReceiptRow">
                        <span class="material-symbols-outlined text-base" data-icon="add">add</span>
                        <span>Thêm Mặt Hàng</span>
                    </button>
                </div>

                @if (_selectedSupplierId == 0)
                {
                    <div class="p-12 text-center text-on-surface-variant border border-dashed border-outline-variant/40 rounded-xl my-4 bg-surface-container/10">
                        <span class="material-symbols-outlined text-4xl text-outline-variant mb-2" data-icon="storefront">storefront</span>
                        <p class="font-medium text-sm">Vui lòng chọn <strong>Nhà Cung Cấp</strong> ở cột bên trái để tải danh mục mặt hàng có thể nhập.</p>
                    </div>
                }
                else if (!_receiptRows.Any())
                {
                    <div class="p-12 text-center text-on-surface-variant border border-dashed border-outline-variant/40 rounded-xl my-4 bg-surface-container/10">
                        <span class="material-symbols-outlined text-4xl text-outline-variant mb-2" data-icon="post_add">post_add</span>
                        <p class="font-medium text-sm mb-3">Chưa có dòng mặt hàng nào trong phiếu nhập.</p>
                        <button type="button" class="bg-primary text-on-primary px-4 py-2 rounded-xl text-xs font-bold cursor-pointer" @onclick="AddEmptyReceiptRow">
                            + Bấm để thêm mặt hàng đầu tiên
                        </button>
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto my-3">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-surface-container/50 text-xs font-bold text-on-surface-variant border-b border-outline-variant/30 uppercase">
                                    <th class="py-3 px-3 w-10 text-center">STT</th>
                                    <th class="py-3 px-3">Mặt Hàng (Từ NCC Đã Chọn) *</th>
                                    <th class="py-3 px-3 text-center w-24">Đơn Vị</th>
                                    <th class="py-3 px-3 text-right w-32">Khối Lượng / SL *</th>
                                    <th class="py-3 px-3 text-right w-36">Đơn Giá Nhập (VNĐ)</th>
                                    <th class="py-3 px-3 text-right w-36">Thành Tiền (VNĐ)</th>
                                    <th class="py-3 px-3 text-center w-12"></th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-outline-variant/20 text-sm">
                                @for (int i = 0; i < _receiptRows.Count; i++)
                                {
                                    var rowIndex = i;
                                    var row = _receiptRows[rowIndex];
                                    <tr class="hover:bg-surface-container/20 transition-colors">
                                        <td class="py-3 px-3 text-center text-xs text-on-surface-variant font-mono">@(rowIndex + 1)</td>
                                        <td class="py-3 px-3">
                                            <select class="w-full px-3 py-1.5 border rounded-lg bg-surface text-on-surface border-outline-variant/40 focus:border-primary text-sm font-semibold"
                                                    value="@row.MaterialId" @onchange="(e) => OnMaterialSelected(row, e)">
                                                <option value="0">-- Chọn mặt hàng --</option>
                                                @foreach (var mat in _supplierMaterials)
                                                {
                                                    <option value="@mat.Id">@mat.Name</option>
                                                }
                                            </select>
                                        </td>
                                        <td class="py-3 px-3 text-center text-xs font-medium text-on-surface-variant">
                                            @(string.IsNullOrEmpty(row.UnitName) ? "---" : row.UnitName)
                                        </td>
                                        <td class="py-3 px-3 text-right">
                                            <input type="number" step="0.1" min="0" class="w-full px-2.5 py-1.5 border rounded-lg bg-surface text-on-surface border-outline-variant/40 focus:border-primary text-sm font-bold text-right font-mono"
                                                   placeholder="0" @bind="row.Quantity" />
                                        </td>
                                        <td class="py-3 px-3 text-right">
                                            <input type="number" step="1000" min="0" class="w-full px-2.5 py-1.5 border rounded-lg bg-surface text-on-surface border-outline-variant/40 focus:border-primary text-sm font-medium text-right font-mono"
                                                   placeholder="0" @bind="row.UnitCost" />
                                        </td>
                                        <td class="py-3 px-3 text-right font-mono font-bold text-on-surface">
                                            @((row.Quantity * row.UnitCost).ToString("N0"))đ
                                        </td>
                                        <td class="py-3 px-3 text-center">
                                            <button type="button" class="text-red-500 hover:text-red-700 hover:bg-red-50 p-1.5 rounded-lg transition-colors cursor-pointer"
                                                    title="Xóa dòng" @onclick="() => RemoveReceiptRow(rowIndex)">
                                                <span class="material-symbols-outlined text-base" data-icon="delete">delete</span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- Tổng kết tiền hàng -->
            <div class="p-4 bg-surface-container/60 rounded-xl flex flex-col md:flex-row justify-between items-center gap-4 border border-outline-variant/20 mt-4">
                <div class="text-xs text-on-surface-variant">
                    <span>Tổng số lượng nhập: </span>
                    <strong class="text-on-surface font-mono text-sm">@_receiptRows.Sum(r => r.Quantity).ToString("N1")</strong>
                </div>
                <div class="flex items-baseline gap-3">
                    <span class="text-sm font-bold text-on-surface">TỔNG TIỀN PHIẾU NHẬP:</span>
                    <span class="text-2xl font-bold font-mono text-primary">
                        @_receiptRows.Sum(r => r.Quantity * r.UnitCost).ToString("N0") VNĐ
                    </span>
                </div>
            </div>
        </div>
    </div>
}
else if (_currentView == ViewMode.Detail && _selectedReceiptForDetail != null)
{
    <!-- ========================================== -->
    <!-- VIEW C: GIAO DIỆN XEM CHI TIẾT & IN PHIẾU -->

@code {
    private enum ViewMode { List, Create, Detail }

    private ViewMode _currentView = ViewMode.List;
    private List<GoodsReceiptDto> _receipts = new();
    private List<SupplierDto> _suppliers = new();
    private List<MaterialDto> _allMaterials = new();
    private List<MaterialDto> _supplierMaterials = new();

    private bool _isLoading = true;
    private bool _isSaving = false;
    private string? _feedbackMessage;
    private string? _errorMessage;
    private bool _isError = false;

    // Create view fields
    private int _selectedSupplierId = 0;
    private string _receiptNote = string.Empty;
    private List<ReceiptRowModel> _receiptRows = new();

    // Detail view fields
    private GoodsReceiptDto? _selectedReceiptForDetail;

    // Filter fields for ViewMode.List
    private DateTime? _filterFromDate;
    private DateTime? _filterToDate;
    private int _filterSupplierId = 0;
    private string _filterSearchTerm = string.Empty;

    private IEnumerable<GoodsReceiptDto> FilteredReceipts
    {
        get
        {
            var query = _receipts.AsEnumerable();

            if (_filterSupplierId > 0)
            {
                query = query.Where(r => r.SupplierId == _filterSupplierId);
            }

            if (_filterFromDate.HasValue)
            {
                query = query.Where(r => r.CreatedAt.Date >= _filterFromDate.Value.Date);
            }

            if (_filterToDate.HasValue)
            {
                query = query.Where(r => r.CreatedAt.Date <= _filterToDate.Value.Date);
            }

            if (!string.IsNullOrWhiteSpace(_filterSearchTerm))
            {
                var term = _filterSearchTerm.Trim().ToLowerInvariant();
                query = query.Where(r => 
                    r.ReceiptCode.ToLowerInvariant().Contains(term) || 
                    r.SupplierName.ToLowerInvariant().Contains(term) ||
                    (!string.IsNullOrEmpty(r.ReceivedByUserName) && r.ReceivedByUserName.ToLowerInvariant().Contains(term)));
            }

            return query;
        }
    }

    private void SetDateFilterQuick(string range)
    {
        var now = DateTime.Today;
        switch (range)
        {
            case "all":
                _filterFromDate = null;
                _filterToDate = null;
                break;
            case "today":
                _filterFromDate = now;
                _filterToDate = now;
                break;
            case "7days":
                _filterFromDate = now.AddDays(-7);
                _filterToDate = now;
                break;
            case "thisMonth":
                _filterFromDate = new DateTime(now.Year, now.Month, 1);
                _filterToDate = now;
                break;
        }
    }

    private void ResetFilters()
    {
        _filterFromDate = null;
        _filterToDate = null;
        _filterSupplierId = 0;
        _filterSearchTerm = string.Empty;
    }

    public class ReceiptRowModel
    {
        public int MaterialId { get; set; } = 0; // Empty by default
        public string MaterialName { get; set; } = string.Empty;
        public string UnitName { get; set; } = string.Empty;
        public decimal Quantity { get; set; } = 0; // Empty by default
        public decimal UnitCost { get; set; } = 0; // Empty by default
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            _receipts = await ApiClient.GetGoodsReceiptsAsync();
            _suppliers = await ApiClient.GetSuppliersAsync();
            _allMaterials = await ApiClient.GetMaterialsAsync();
        }
        catch (Exception ex)
        {
            _feedbackMessage = $"Lỗi tải dữ liệu: {ex.Message}";
            _isError = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SwitchToListView()
    {
        _currentView = ViewMode.List;
        _errorMessage = null;
    }

    private void SwitchToCreateView()
    {
        _selectedSupplierId = 0;
        _receiptNote = string.Empty;
        _receiptRows = new List<ReceiptRowModel>();
        _supplierMaterials = new List<MaterialDto>();
        _errorMessage = null;
        _currentView = ViewMode.Create;
    }

    private void SwitchToDetailView(GoodsReceiptDto receipt, bool triggerPrint = false)
    {
        _selectedReceiptForDetail = receipt;
        _currentView = ViewMode.Detail;
    }

    private async Task OnSupplierChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var supId))
        {
            _selectedSupplierId = supId;
            if (supId > 0)
            {
                _supplierMaterials = await ApiClient.GetMaterialsBySupplierAsync(supId);
                // Clear items that don't match or reset
                _receiptRows.Clear();
                AddEmptyReceiptRow();
            }
            else
            {
                _supplierMaterials.Clear();
                _receiptRows.Clear();
            }
        }
    }

    private void AddEmptyReceiptRow()
    {
        _receiptRows.Add(new ReceiptRowModel
        {
            MaterialId = 0, // Bắt đầu trống
            Quantity = 0,   // Bắt đầu trống
            UnitCost = 0
        });
    }

    private void OnMaterialSelected(ReceiptRowModel row, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var matId))
        {
            row.MaterialId = matId;
            var mat = _supplierMaterials.FirstOrDefault(m => m.Id == matId) 
                      ?? _allMaterials.FirstOrDefault(m => m.Id == matId);
            if (mat != null)
            {
                row.MaterialName = mat.Name;
                row.UnitName = mat.UnitName;
                row.UnitCost = mat.CostPerUnit;
            }
            else
            {
                row.MaterialName = string.Empty;
                row.UnitName = string.Empty;
                row.UnitCost = 0;
            }
        }
    }

    private void RemoveReceiptRow(int index)
    {
        if (index >= 0 && index < _receiptRows.Count)
        {
            _receiptRows.RemoveAt(index);
        }
    }

    private async Task SaveReceipt()
    {
        if (_selectedSupplierId <= 0)
        {
            _errorMessage = "Vui lòng chọn Nhà Cung Cấp hàng hóa!";
            return;
        }

        var validRows = _receiptRows.Where(r => r.MaterialId > 0 && r.Quantity > 0).ToList();
        if (!validRows.Any())
        {
            _errorMessage = "Vui lòng thêm ít nhất một mặt hàng hợp lệ có số lượng lớn hơn 0!";
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            var req = new CreatePurchaseOrderRequest
            {
                SupplierId = _selectedSupplierId,
                Note = _receiptNote,
                Items = validRows.Select(r => new PurchaseOrderItemRequest
                {
                    MaterialId = r.MaterialId,
                    Quantity = r.Quantity,
                    UnitCost = r.UnitCost
                }).ToList()
            };

            await ApiClient.CreateGoodsReceiptAsync(req);
            _feedbackMessage = "Lập phiếu nhập kho thành công! Số lượng tồn kho đã được cộng dồn.";
            _isError = false;
            _currentView = ViewMode.List;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Lỗi khi lưu phiếu nhập kho: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void PrintDocument()
    {
        // Simple JS print
    }
}

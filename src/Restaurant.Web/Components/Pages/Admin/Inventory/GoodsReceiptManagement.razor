@page "/admin/goods-receipts"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.AdminLayout
@using Restaurant.Application.DTOs
@using Restaurant.Web.Services
@inject AdminApiClient ApiClient

<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
    <div>
        <h2 class="text-2xl font-headline-sm text-primary m-0">Quản lý Nhập kho (Goods Receipts)</h2>
        <p class="text-on-surface-variant text-sm mt-1">Lập phiếu nhập kho nguyên liệu từ nhà cung cấp và ghi nhận giá vốn lô hàng.</p>
    </div>
    <button class="bg-primary text-on-primary px-4 py-2 rounded font-label-bold shadow-sm hover:bg-primary/90 transition-colors flex items-center" @onclick="OpenCreateReceiptModal">
        <span class="material-symbols-outlined align-middle text-sm mr-1" data-icon="add">add</span> Tạo Phiếu Nhập Kho
    </button>
</div>

<!-- Lịch sử Phiếu nhập kho -->
<div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden">
    <div class="p-4 border-b border-outline-variant/30 flex justify-between items-center bg-surface-container-low">
        <h3 class="font-bold text-on-surface text-base m-0">Lịch sử Phiếu Nhập Kho gần đây</h3>
        <span class="text-xs text-on-surface-variant">Hiển thị các phiếu trong tháng</span>
    </div>

    <table class="w-full text-left border-collapse">
        <thead class="bg-surface-container-low text-xs font-bold text-on-surface-variant uppercase">
            <tr>
                <th class="p-4">Mã Phiếu</th>
                <th class="p-4">Nhà Cung Cấp</th>
                <th class="p-4 text-center">Ngày Nhập</th>
                <th class="p-4 text-right">Tổng Tiền hàng</th>
                <th class="p-4 text-center">Trạng thái</th>
                <th class="p-4 text-center">Hành động</th>
            </tr>
        </thead>
        <tbody>
            <tr class="border-b border-outline-variant/20 hover:bg-surface-low">
                <td class="p-4 font-mono font-bold text-primary">GR-20260918-01</td>
                <td class="p-4 font-bold text-on-surface">Công ty TNHH Thực phẩm Ý Việt</td>
                <td class="p-4 text-center text-sm text-on-surface-variant">18/09/2026 09:30</td>
                <td class="p-4 text-right font-mono font-bold text-base">4,850,000đ</td>
                <td class="p-4 text-center">
                    <span class="px-2.5 py-1 bg-success-green/10 text-success-green rounded-full text-xs font-bold border border-success-green/20">Đã nhập kho</span>
                </td>
                <td class="p-4 text-center">
                    <button class="text-primary hover:bg-primary-container p-1.5 rounded" title="In phiếu" @onclick="() => PrintReceipt(1)">
                        <span class="material-symbols-outlined text-sm" data-icon="print">print</span>
                    </button>
                </td>
            </tr>
            <tr class="border-b border-outline-variant/20 hover:bg-surface-low">
                <td class="p-4 font-mono font-bold text-primary">GR-20260915-02</td>
                <td class="p-4 font-bold text-on-surface">Nông sản Sạch Đà Lạt</td>
                <td class="p-4 text-center text-sm text-on-surface-variant">15/09/2026 14:15</td>
                <td class="p-4 text-right font-mono font-bold text-base">1,200,000đ</td>
                <td class="p-4 text-center">
                    <span class="px-2.5 py-1 bg-success-green/10 text-success-green rounded-full text-xs font-bold border border-success-green/20">Đã nhập kho</span>
                </td>
                <td class="p-4 text-center">
                    <button class="text-primary hover:bg-primary-container p-1.5 rounded" title="In phiếu" @onclick="() => PrintReceipt(2)">
                        <span class="material-symbols-outlined text-sm" data-icon="print">print</span>
                    </button>
                </td>
            </tr>
        </tbody>
    </table>
</div>

<!-- Modal Create Goods Receipt -->
@if (_showModal)
{
    <div class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-surface-container-lowest rounded-xl shadow-lg w-full max-w-2xl max-h-[90vh] flex flex-col overflow-hidden">
            <div class="px-6 py-4 border-b border-outline-variant/30 flex justify-between items-center bg-surface-container-low shrink-0">
                <h3 class="font-bold text-on-background m-0">Tạo Phiếu Nhập Kho Nguyên Liệu</h3>
                <button class="text-on-surface-variant hover:text-error" @onclick="CloseModal">
                    <span class="material-symbols-outlined" data-icon="close">close</span>
                </button>
            </div>

            <div class="p-6 overflow-y-auto flex-1 space-y-4">
                <div>
                    <label class="block text-sm font-bold text-on-surface mb-1">Nhà cung cấp <span class="text-error">*</span></label>
                    <select @bind="_selectedSupplierId" class="w-full px-3 py-2 border border-outline rounded bg-surface text-sm focus:outline-none focus:border-primary">
                        <option value="0">-- Chọn nhà cung cấp --</option>
                        @foreach (var sup in _suppliers)
                        {
                            <option value="@sup.Id">@sup.Name (@sup.PhoneNumber)</option>
                        }
                    </select>
                </div>

                <div class="flex justify-between items-center pt-2">
                    <label class="font-bold text-sm text-on-surface">Danh sách hàng nhập</label>
                    <button class="text-xs bg-primary-container text-on-primary-container px-2.5 py-1 rounded font-bold hover:bg-primary/20" @onclick="AddReceiptRow">
                        + Thêm mặt hàng
                    </button>
                </div>

                @foreach (var item in _receiptItems)
                {
                    <div class="grid grid-cols-12 gap-2 items-center bg-surface-low p-2 rounded border border-outline-variant/30">
                        <div class="col-span-5">
                            <select @bind="item.MaterialId" class="w-full px-2 py-1.5 text-xs border border-outline rounded bg-surface">
                                <option value="0">-- Chọn Nguyên liệu --</option>
                                @foreach (var mat in _materials)
                                {
                                    <option value="@mat.Id">@mat.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-span-3">
                            <input type="number" step="0.1" @bind="item.Quantity" placeholder="Số lượng" class="w-full px-2 py-1.5 text-xs border border-outline rounded bg-surface font-mono" />
                        </div>
                        <div class="col-span-3">
                            <input type="number" @bind="item.UnitCost" placeholder="Đơn giá nhập" class="w-full px-2 py-1.5 text-xs border border-outline rounded bg-surface font-mono" />
                        </div>
                        <div class="col-span-1 text-center">
                            <button class="text-error hover:bg-error-container p-1 rounded" @onclick="() => RemoveReceiptRow(item)">
                                <span class="material-symbols-outlined text-sm" data-icon="delete">delete</span>
                            </button>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="p-3 bg-error-container text-on-error-container text-xs rounded border border-error/20">
                        @_errorMessage
                    </div>
                }
            </div>

            <div class="px-6 py-4 border-t border-outline-variant/30 flex justify-end gap-3 bg-surface-container-low shrink-0">
                <button class="px-4 py-2 text-on-surface-variant hover:bg-surface-low rounded text-sm font-bold" @onclick="CloseModal">Hủy</button>
                <button class="px-4 py-2 bg-primary text-on-primary rounded text-sm font-bold shadow-sm hover:bg-primary/90 flex items-center" disabled="@_isSaving" @onclick="SaveReceipt">
                    @if (_isSaving)
                    {
                        <span class="material-symbols-outlined animate-spin text-sm mr-2" data-icon="progress_activity">progress_activity</span>
                        <span>Đang xử lý...</span>
                    }
                    else
                    {
                        <span>Hoàn tất Nhập kho</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<SupplierDto> _suppliers = new();
    private List<MaterialDto> _materials = new();

    private bool _showModal = false;
    private bool _isSaving = false;
    private string? _errorMessage;
    private int _selectedSupplierId = 0;

    private List<ReceiptRow> _receiptItems = new();

    protected override async Task OnInitializedAsync()
    {
        _suppliers = await ApiClient.GetSuppliersAsync();
        _materials = await ApiClient.GetMaterialsAsync();
    }

    private void OpenCreateReceiptModal()
    {
        _selectedSupplierId = _suppliers.FirstOrDefault()?.Id ?? 0;
        _receiptItems = new List<ReceiptRow> { new ReceiptRow() };
        _errorMessage = null;
        _showModal = true;
    }

    private void AddReceiptRow() => _receiptItems.Add(new ReceiptRow());
    private void RemoveReceiptRow(ReceiptRow row) => _receiptItems.Remove(row);
    private void CloseModal() => _showModal = false;

    private async Task SaveReceipt()
    {
        if (_selectedSupplierId <= 0)
        {
            _errorMessage = "Vui lòng chọn nhà cung cấp.";
            return;
        }

        _isSaving = true;
        try
        {
            var req = new CreatePurchaseOrderRequest
            {
                SupplierId = _selectedSupplierId,
                Items = _receiptItems.Select(i => new PurchaseOrderItemRequest
                {
                    MaterialId = i.MaterialId,
                    Quantity = i.Quantity,
                    UnitCost = i.UnitCost
                }).ToList()
            };

            await ApiClient.CreatePurchaseOrderAsync(req);
            _showModal = false;
        }
        catch
        {
            _showModal = false;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void PrintReceipt(int id)
    {
        // Print action handler
    }

    public class ReceiptRow
    {
        public int MaterialId { get; set; } = 1;
        public decimal Quantity { get; set; } = 10m;
        public decimal UnitCost { get; set; } = 50000m;
    }
}

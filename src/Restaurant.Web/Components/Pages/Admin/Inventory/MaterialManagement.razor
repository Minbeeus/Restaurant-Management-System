@page "/admin/materials"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.AdminLayout
@using Restaurant.Application.DTOs
@using Restaurant.Web.Services
@inject AdminApiClient ApiClient

@if (!_isFormOpen)
{
    <!-- ========================================== -->
    <!-- VIEW A: DANH SÁCH NGUYÊN VẬT LIỆU -->
    <!-- ========================================== -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
        <div>
            <h2 class="text-2xl font-headline-sm text-primary m-0">Quản Lý Danh Mục Nguyên Vật Liệu</h2>
            <p class="text-on-surface-variant text-sm mt-1">Kiểm soát tồn kho thực tế, ngưỡng cảnh báo an toàn và giá vốn định mức</p>
        </div>
        <button class="bg-primary hover:bg-primary/90 text-on-primary px-5 py-2.5 rounded-xl font-bold text-xs shadow-sm transition-all flex items-center gap-1.5 cursor-pointer active:scale-95" @onclick="OpenAddForm">
            <span class="material-symbols-outlined text-base" data-icon="add_circle">add_circle</span>
            <span>Thêm Nguyên Liệu Mới</span>
        </button>
    </div>

    <!-- Toolbar Lọc & Cảnh báo -->
    <div class="bg-surface rounded-2xl shadow-sm border border-outline-variant/30 p-4 mb-6 flex flex-col md:flex-row justify-between items-center gap-4">
        <div class="w-full md:w-96 relative">
            <span class="material-symbols-outlined absolute left-3.5 top-2.5 text-on-surface-variant text-sm" data-icon="search">search</span>
            <input type="text" @bind="_searchKeyword" @bind:event="oninput"
                   class="w-full pl-10 pr-4 py-2 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary focus:outline-none text-sm transition-colors"
                   placeholder="Tìm theo tên nguyên liệu..." />
        </div>
        
        <div class="flex items-center gap-2">
            <button class="px-3.5 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer flex items-center gap-1.5 border @(_filterLowStock ? "bg-red-500 text-white border-red-600" : "bg-surface-container text-on-surface hover:bg-surface-container-high border-outline-variant/30")"
                    @onclick="ToggleLowStockFilter">
                <span class="material-symbols-outlined text-sm" data-icon="warning">warning</span>
                <span>Cảnh Báo Tồn Thấp (@_materials.Count(m => m.IsLowStock))</span>
            </button>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="flex justify-center p-16">
            <span class="material-symbols-outlined animate-spin text-4xl text-primary" data-icon="progress_activity">progress_activity</span>
        </div>
    }
    else
    {
        <div class="bg-surface rounded-2xl shadow-sm border border-outline-variant/30 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-surface-container/50 border-b border-outline-variant/30 text-xs font-bold text-on-surface-variant uppercase tracking-wider">
                        <tr>
                            <th class="py-4 px-5 w-16 text-center">ID</th>
                            <th class="py-4 px-5">Tên Nguyên Liệu</th>
                            <th class="py-4 px-5 text-right w-36">Tồn Thực Tế</th>
                            <th class="py-4 px-5 text-center w-24">Đơn Vị</th>
                            <th class="py-4 px-5 text-right w-36">Định Mức Tối Thiểu</th>
                            <th class="py-4 px-5 text-right w-36">Đơn Giá Vốn</th>
                            <th class="py-4 px-5 text-center w-36">Trạng Thái Kho</th>
                            <th class="py-4 px-5 text-right w-28">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant/20 text-sm">
                        @if (!FilteredMaterials.Any())
                        {
                            <tr>
                                <td colspan="8" class="p-10 text-center text-on-surface-variant">
                                    Không có nguyên liệu nào phù hợp với điều kiện tìm kiếm.
                                </td>
                            </tr>
                        }
                        @foreach (var mat in FilteredMaterials)
                        {
                            <tr class="hover:bg-surface-container/20 transition-colors">
                                <td class="py-4 px-5 text-center text-xs text-on-surface-variant font-mono">#@mat.Id</td>
                                <td class="py-4 px-5 font-bold text-on-surface">
                                    <div>@mat.DisplayName</div>
                                    @if (!string.IsNullOrEmpty(mat.NameEn))
                                    {
                                        <div class="text-xs text-on-surface-variant/70 italic font-normal">EN: @mat.NameEn</div>
                                    }
                                </td>
                                <td class="py-4 px-5 text-right font-mono font-bold text-base @(mat.IsLowStock ? "text-red-600" : "text-emerald-700")">
                                    @mat.CurrentStock.ToString("N1")
                                </td>
                                <td class="py-4 px-5 text-center text-xs font-medium text-on-surface-variant">@mat.UnitName</td>
                                <td class="py-4 px-5 text-right font-mono text-xs text-on-surface-variant">@mat.MinStockLevel.ToString("N1")</td>
                                <td class="py-4 px-5 text-right font-mono text-sm text-on-surface font-semibold">@mat.CostPerUnit.ToString("N0")đ</td>
                                <td class="py-4 px-5 text-center">
                                    @if (mat.IsLowStock)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-red-100 text-red-800 rounded-full text-xs font-bold animate-pulse">
                                            <span class="w-1.5 h-1.5 rounded-full bg-red-600"></span> Sắp hết hàng
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-emerald-100 text-emerald-800 rounded-full text-xs font-bold">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span> An toàn
                                        </span>
                                    }
                                </td>
                                <td class="py-4 px-5 text-right space-x-1">
                                    <button class="p-1.5 text-primary hover:bg-primary/10 rounded-lg transition-colors cursor-pointer" title="Chỉnh sửa" @onclick="() => OpenEditForm(mat)">
                                        <span class="material-symbols-outlined text-base" data-icon="edit">edit</span>
                                    </button>
                                    <button class="p-1.5 text-red-500 hover:bg-red-50 rounded-lg transition-colors cursor-pointer" title="Xóa" @onclick="() => ConfirmDelete(mat)">
                                        <span class="material-symbols-outlined text-base" data-icon="delete">delete</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
else
{
    <!-- ========================================== -->
    <!-- VIEW B: GIAO DIỆN RIÊNG THÊM / SỬA NGUYÊN LIỆU -->
    <!-- (To bằng trang nội dung, giữ nguyên thanh nav) -->
    <!-- ========================================== -->
    <div class="mb-6">
        <nav class="flex items-center gap-2 text-xs text-on-surface-variant mb-2">
            <button class="hover:text-primary transition-colors cursor-pointer" @onclick="CloseForm">Quản Lý Nguyên Vật Liệu</button>
            <span>/</span>
            <span class="font-bold text-on-surface">@(_isEditing ? $"Chỉnh Sửa: {_model.Name}" : "Thêm Nguyên Liệu Mới")</span>
        </nav>
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div>
                <h2 class="text-2xl font-headline-sm text-primary m-0">@(_isEditing ? "Cập Nhật Thông Tin Nguyên Liệu" : "Thêm Nguyên Vật Liệu Mới Vào Kho")</h2>
                <p class="text-on-surface-variant text-sm mt-1">Cấu hình đơn vị đo lường, mức dự trữ an toàn và đơn giá nhập định mức</p>
            </div>
            <div class="flex items-center gap-3">
                <button type="button" class="px-4 py-2.5 rounded-xl border border-outline-variant/40 text-on-surface hover:bg-surface-container font-semibold text-sm transition-all cursor-pointer"
                        @onclick="CloseForm">
                    Hủy & Quay Lại
                </button>
                <button type="button" class="px-6 py-2.5 rounded-xl bg-primary hover:bg-primary/90 text-on-primary font-bold text-sm shadow-md transition-all cursor-pointer flex items-center gap-2 disabled:opacity-50"
                        disabled="@_isSaving" @onclick="SaveMaterial">
                    @if (_isSaving)
                    {
                        <span class="material-symbols-outlined animate-spin text-base" data-icon="progress_activity">progress_activity</span>
                        <span>Đang lưu...</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-base" data-icon="save">save</span>
                        <span>Lưu Nguyên Liệu</span>
                    }
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="p-4 mb-6 rounded-xl bg-red-50 text-red-700 border border-red-200 text-sm font-medium flex justify-between items-center">
            <span>@_errorMessage</span>
            <button type="button" @onclick="() => _errorMessage = null" class="font-bold">✕</button>
        </div>
    }

    <div class="bg-surface rounded-2xl p-6 border border-outline-variant/30 shadow-sm max-w-3xl space-y-5">
        <div class="flex items-center gap-3 pb-3 border-b border-outline-variant/20">
            <span class="material-symbols-outlined text-primary text-2xl" data-icon="inventory_2">inventory_2</span>
            <h3 class="font-bold text-lg text-on-surface m-0">Thuộc Tính Nguyên Vật Liệu</h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="block text-xs font-bold text-on-surface-variant mb-1.5">Tên Nguyên Liệu (Tiếng Việt) <span class="text-red-500">*</span></label>
                <input type="text" class="w-full px-3.5 py-2.5 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary text-sm font-bold"
                       placeholder="VD: Phô mai Mozzarella khối" @bind="_model.Name" />
            </div>
            <div>
                <label class="block text-xs font-bold text-on-surface-variant mb-1.5">Tên Tiếng Anh (English Name)</label>
                <input type="text" class="w-full px-3.5 py-2.5 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary text-sm font-medium"
                       placeholder="e.g. Block Mozzarella Cheese" @bind="_model.NameEn" />
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
                <label class="block text-xs font-bold text-on-surface-variant mb-1.5">Đơn Vị Tính <span class="text-red-500">*</span></label>
                <select class="w-full px-3.5 py-2.5 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary text-sm font-semibold cursor-pointer"
                        @bind="_model.UnitOfMeasureId">
                    <option value="1">Kg (Kilogram)</option>
                    <option value="2">g (Gram)</option>
                    <option value="3">L (Lít)</option>
                    <option value="4">ml (Mililít)</option>
                    <option value="5">Pcs (Cái/Chiếc)</option>
                    <option value="6">Lon (Hộp)</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-on-surface-variant mb-1.5">Tồn Kho Tối Thiểu (Min Stock)</label>
                <input type="number" step="0.1" min="0" class="w-full px-3.5 py-2.5 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary text-sm font-mono font-bold"
                       placeholder="10" @bind="_model.MinStockLevel" />
            </div>
            <div>
                <label class="block text-xs font-bold text-on-surface-variant mb-1.5">Đơn Giá Vốn Ước Tính (VNĐ)</label>
                <div class="relative">
                    <input type="number" step="1000" min="0" class="w-full px-3.5 py-2.5 border rounded-xl bg-surface text-on-surface border-outline-variant/40 focus:border-primary text-sm font-mono font-bold"
                           placeholder="150000" @bind="_model.CostPerUnit" />
                    <span class="absolute right-3.5 top-2.5 text-xs text-on-surface-variant font-bold">VNĐ</span>
                </div>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (_showDeleteConfirm)
{
    <div class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-surface rounded-2xl shadow-xl w-full max-w-sm p-6 text-center border border-outline-variant/30">
            <div class="w-14 h-14 rounded-full bg-red-100 text-red-600 mx-auto flex items-center justify-center mb-4">
                <span class="material-symbols-outlined text-3xl" data-icon="delete">delete</span>
            </div>
            <h3 class="text-lg font-bold text-on-surface mb-2">Xác Nhận Xóa Nguyên Liệu</h3>
            <p class="text-on-surface-variant text-sm mb-6">Bạn có chắc chắn muốn ngừng sử dụng nguyên liệu <strong>@_itemToDelete?.Name</strong>?</p>
            <div class="flex justify-center gap-3">
                <button type="button" class="px-4 py-2 border border-outline-variant/40 text-on-surface rounded-xl hover:bg-surface-container font-bold text-sm flex-1 cursor-pointer"
                        @onclick="() => _showDeleteConfirm = false">Hủy</button>
                <button type="button" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-xl font-bold text-sm flex-1 cursor-pointer"
                        @onclick="ExecuteDelete">Xóa Bỏ</button>
            </div>
        </div>
    </div>
}

@code {
    private List<MaterialDto> _materials = new();
    private bool _isLoading = true;
    private bool _isFormOpen = false;
    private bool _isEditing = false;
    private bool _isSaving = false;
    private string? _errorMessage;
    private int _editingId;

    private string _searchKeyword = "";
    private bool _filterLowStock = false;

    private MaterialFormModel _model = new();
    private bool _showDeleteConfirm = false;
    private MaterialDto? _itemToDelete;

    private IEnumerable<MaterialDto> FilteredMaterials => _materials
        .Where(m => string.IsNullOrWhiteSpace(_searchKeyword) 
                 || m.Name.Contains(_searchKeyword, StringComparison.OrdinalIgnoreCase)
                 || (m.NameEn != null && m.NameEn.Contains(_searchKeyword, StringComparison.OrdinalIgnoreCase)))
        .Where(m => !_filterLowStock || m.IsLowStock);

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            _materials = await ApiClient.GetMaterialsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading materials: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ToggleLowStockFilter()
    {
        _filterLowStock = !_filterLowStock;
    }

    private void OpenAddForm()
    {
        _isEditing = false;
        _model = new MaterialFormModel { UnitOfMeasureId = 1, MinStockLevel = 10, CostPerUnit = 50000 };
        _errorMessage = null;
        _isFormOpen = true;
    }

    private void OpenEditForm(MaterialDto mat)
    {
        _isEditing = true;
        _editingId = mat.Id;
        _model = new MaterialFormModel
        {
            Name = mat.Name,
            NameEn = mat.NameEn,
            UnitOfMeasureId = mat.UnitOfMeasureId > 0 ? mat.UnitOfMeasureId : 1,
            MinStockLevel = mat.MinStockLevel,
            CostPerUnit = mat.CostPerUnit
        };
        _errorMessage = null;
        _isFormOpen = true;
    }

    private void CloseForm()
    {
        _isFormOpen = false;
    }

    private async Task SaveMaterial()
    {
        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            _errorMessage = "Tên nguyên liệu không được để trống.";
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            var req = new CreateMaterialRequest
            {
                Name = _model.Name,
                NameEn = _model.NameEn,
                UnitOfMeasureId = _model.UnitOfMeasureId,
                MinStockLevel = _model.MinStockLevel,
                CostPerUnit = _model.CostPerUnit
            };

            if (_isEditing)
            {
                await ApiClient.UpdateMaterialAsync(_editingId, req);
            }
            else
            {
                await ApiClient.CreateMaterialAsync(req);
            }

            _isFormOpen = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Lỗi khi lưu nguyên vật liệu: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ConfirmDelete(MaterialDto mat)
    {
        _itemToDelete = mat;
        _showDeleteConfirm = true;
    }

    private async Task ExecuteDelete()
    {
        if (_itemToDelete != null)
        {
            await ApiClient.DeleteMaterialAsync(_itemToDelete.Id);
            _showDeleteConfirm = false;
            await LoadData();
        }
    }

    public class MaterialFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string? NameEn { get; set; }
        public int UnitOfMeasureId { get; set; } = 1;
        public decimal MinStockLevel { get; set; }
        public decimal CostPerUnit { get; set; }
    }
}

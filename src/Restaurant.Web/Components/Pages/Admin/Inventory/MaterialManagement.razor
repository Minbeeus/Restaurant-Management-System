@page "/admin/materials"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.AdminLayout
@using Restaurant.Application.DTOs
@using Restaurant.Web.Services
@inject AdminApiClient ApiClient

<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
    <div>
        <h2 class="text-2xl font-headline-sm text-primary m-0">@L["Material_Management_Title"]</h2>
        <p class="text-on-surface-variant text-sm mt-1">@L["Material_Sub"]</p>
    </div>
    <button class="bg-primary text-on-primary px-4 py-2 rounded font-label-bold shadow-sm hover:bg-primary/90 transition-colors flex items-center" @onclick="OpenAddModal">
        <span class="material-symbols-outlined align-middle text-sm mr-1" data-icon="add">add</span> @L["Material_Add_New"]
    </button>
</div>

<!-- Toolbar Lọc & Cảnh báo -->
<div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-4 mb-6 flex flex-col md:flex-row justify-between items-center gap-4">
    <div class="w-full md:w-96 relative">
        <span class="material-symbols-outlined absolute left-3 top-2.5 text-on-surface-variant text-sm" data-icon="search">search</span>
        <input type="text" @bind="_searchKeyword" @bind:event="oninput" class="w-full pl-9 pr-4 py-2 border border-outline rounded bg-surface focus:outline-none focus:border-primary text-sm" placeholder="@L["Material_Search_Placeholder"]" />
    </div>
    
    <div class="flex items-center gap-2">
        <button class="px-3 py-1.5 rounded text-xs font-bold transition-colors @(_filterLowStock ? "bg-error text-white" : "bg-surface-container text-on-surface hover:bg-surface-low border border-outline-variant/30")" @onclick="ToggleLowStockFilter">
            <span class="material-symbols-outlined text-xs align-middle mr-1" data-icon="warning">warning</span>
            @string.Format(L["Material_Low_Stock_Alert"], _materials.Count(m => m.IsLowStock))
        </button>
    </div>
</div>

@if (_isLoading)
{
    <div class="flex justify-center p-12">
        <span class="material-symbols-outlined animate-spin text-4xl text-primary" data-icon="progress_activity">progress_activity</span>
    </div>
}
else
{
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead class="bg-surface-container-low border-b border-outline-variant/30 text-on-surface-variant font-label-bold text-xs uppercase">
                <tr>
                    <th class="p-4 w-16 text-center">@L["Area_Header_ID"]</th>
                    <th class="p-4">@L["Material_Col_Name"]</th>
                    <th class="p-4 text-right">@L["Material_Col_Stock"]</th>
                    <th class="p-4 text-center">@L["Material_Col_Unit"]</th>
                    <th class="p-4 text-right">@L["Material_Col_MinStock"]</th>
                    <th class="p-4 text-right">@L["Material_Col_Cost"]</th>
                    <th class="p-4 text-center w-36">@L["Material_Col_Status"]</th>
                    <th class="p-4 text-center w-32">@L["Area_Header_Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (!FilteredMaterials.Any())
                {
                    <tr>
                        <td colspan="8" class="p-8 text-center text-on-surface-variant">@L["Material_No_Data"]</td>
                    </tr>
                }
                @foreach (var mat in FilteredMaterials)
                {
                    <tr class="border-b border-outline-variant/20 last:border-0 hover:bg-surface-low/50 transition-colors">
                        <td class="p-4 text-center text-on-surface-variant">#@mat.Id</td>
                        <td class="p-4 font-bold text-on-background">
                            <div>@mat.DisplayName</div>
                            @if (!string.IsNullOrEmpty(mat.NameEn) && System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName != "en")
                            {
                                <div class="text-xs text-on-surface-variant/70 italic font-normal">EN: @mat.NameEn</div>
                            }
                        </td>
                        <td class="p-4 text-right font-mono font-bold text-base @(mat.IsLowStock ? "text-error" : "text-primary")">@mat.CurrentStock</td>
                        <td class="p-4 text-center text-sm text-on-surface-variant">@mat.UnitName</td>
                        <td class="p-4 text-right font-mono text-sm">@mat.MinStockLevel</td>
                        <td class="p-4 text-right font-mono text-sm">@mat.CostPerUnit.ToString("N0")đ</td>
                        <td class="p-4 text-center">
                            @if (mat.IsLowStock)
                            {
                                <span class="px-2.5 py-1 bg-error-container text-error rounded-full text-xs font-bold border border-error/20 inline-flex items-center gap-1 animate-pulse">
                                    <span class="material-symbols-outlined text-xs" data-icon="warning">warning</span> @L["Material_Status_Low"]
                                </span>
                            }
                            else
                            {
                                <span class="px-2.5 py-1 bg-success-green/10 text-success-green rounded-full text-xs font-bold border border-success-green/20">@L["Material_Status_Safe"]</span>
                            }
                        </td>
                        <td class="p-4 text-center space-x-1">
                            <button class="text-primary hover:bg-primary-container p-2 rounded-full transition-colors" title="@L["Common_Edit"]" @onclick="() => OpenEditModal(mat)">
                                <span class="material-symbols-outlined text-sm" data-icon="edit">edit</span>
                            </button>
                            <button class="text-error hover:bg-error-container p-2 rounded-full transition-colors" title="@L["Common_Delete"]" @onclick="() => ConfirmDelete(mat)">
                                <span class="material-symbols-outlined text-sm" data-icon="delete">delete</span>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Modal Add/Edit Material -->
@if (_showModal)
{
    <div class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-surface-container-lowest rounded-xl shadow-lg w-full max-w-md overflow-hidden">
            <div class="px-6 py-4 border-b border-outline-variant/30 flex justify-between items-center bg-surface-container-low">
                <h3 class="font-bold text-on-background m-0">@(_isEditing ? L["Material_Modal_Update"] : L["Material_Modal_Create"])</h3>
                <button class="text-on-surface-variant hover:text-error" @onclick="CloseModal">
                    <span class="material-symbols-outlined" data-icon="close">close</span>
                </button>
            </div>
            
            <div class="p-6 space-y-4">
                <div>
                    <label class="block text-sm font-bold text-on-surface mb-1">@L["Material_Name_Label"] <span class="text-error">*</span></label>
                    <input type="text" @bind="_model.Name" class="w-full px-3 py-2 border border-outline rounded bg-surface text-sm focus:outline-none focus:border-primary" placeholder="VD: Bột mì Tipo 00" />
                </div>

                <div>
                    <label class="block text-sm font-bold text-on-surface mb-1">Tên Tiếng Anh (English Name)</label>
                    <input type="text" @bind="_model.NameEn" class="w-full px-3 py-2 border border-outline rounded bg-surface text-sm focus:outline-none focus:border-primary" placeholder="e.g. Tipo 00 Flour" />
                </div>
                
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-bold text-on-surface mb-1">@L["Material_Unit_Label"]</label>
                        <select @bind="_model.UnitOfMeasureId" class="w-full px-3 py-2 border border-outline rounded bg-surface text-sm focus:outline-none focus:border-primary">
                            <option value="1">Kg (Kilogram)</option>
                            <option value="2">Lít (Liter)</option>
                            <option value="3">Hộp / Lon</option>
                            <option value="4">Gói / Bao</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-on-surface mb-1">@L["Material_Min_Stock_Label"]</label>
                        <input type="number" step="0.1" @bind="_model.MinStockLevel" class="w-full px-3 py-2 border border-outline rounded bg-surface text-sm focus:outline-none focus:border-primary" />
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-bold text-on-surface mb-1">@L["Material_Cost_Label"]</label>
                    <input type="number" @bind="_model.CostPerUnit" class="w-full px-3 py-2 border border-outline rounded bg-surface text-sm focus:outline-none focus:border-primary" />
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="p-3 bg-error-container text-on-error-container text-xs rounded border border-error/20">
                        @_errorMessage
                    </div>
                }
            </div>

            <div class="px-6 py-4 border-t border-outline-variant/30 flex justify-end gap-3 bg-surface-container-low">
                <button class="px-4 py-2 text-on-surface-variant hover:bg-surface-low rounded text-sm font-bold" @onclick="CloseModal">@L["Common_Cancel"]</button>
                <button class="px-4 py-2 bg-primary text-on-primary rounded text-sm font-bold shadow-sm hover:bg-primary/90 flex items-center" disabled="@_isSaving" @onclick="SaveMaterial">
                    @if (_isSaving)
                    {
                        <span class="material-symbols-outlined animate-spin text-sm mr-2" data-icon="progress_activity">progress_activity</span>
                        <span>@L["Common_Saving"]</span>
                    }
                    else
                    {
                        <span>@L["Material_Save_Btn"]</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<MaterialDto> _materials = new();
    private bool _isLoading = true;
    private bool _showModal = false;
    private bool _isEditing = false;
    private bool _isSaving = false;
    private string? _errorMessage;
    private int _editingId;

    private string _searchKeyword = "";
    private bool _filterLowStock = false;

    private MaterialFormModel _model = new();

    private IEnumerable<MaterialDto> FilteredMaterials => _materials
        .Where(m => string.IsNullOrWhiteSpace(_searchKeyword) 
                 || m.Name.Contains(_searchKeyword, StringComparison.OrdinalIgnoreCase)
                 || (m.NameEn != null && m.NameEn.Contains(_searchKeyword, StringComparison.OrdinalIgnoreCase)))
        .Where(m => !_filterLowStock || m.IsLowStock);

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            _materials = await ApiClient.GetMaterialsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading materials: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ToggleLowStockFilter()
    {
        _filterLowStock = !_filterLowStock;
    }

    private void OpenAddModal()
    {
        _isEditing = false;
        _model = new MaterialFormModel { UnitOfMeasureId = 1, MinStockLevel = 10m, CostPerUnit = 50000 };
        _errorMessage = null;
        _showModal = true;
    }

    private void OpenEditModal(MaterialDto item)
    {
        _isEditing = true;
        _editingId = item.Id;
        _model = new MaterialFormModel
        {
            Name = item.Name,
            NameEn = item.NameEn,
            UnitOfMeasureId = item.UnitOfMeasureId > 0 ? item.UnitOfMeasureId : 1,
            MinStockLevel = item.MinStockLevel,
            CostPerUnit = item.CostPerUnit
        };
        _errorMessage = null;
        _showModal = true;
    }

    private void CloseModal()
    {
        _showModal = false;
    }

    private async Task SaveMaterial()
    {
        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            _errorMessage = "Tên nguyên liệu không được để trống.";
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            var req = new CreateMaterialRequest
            {
                Name = _model.Name,
                NameEn = _model.NameEn,
                UnitOfMeasureId = _model.UnitOfMeasureId,
                MinStockLevel = _model.MinStockLevel,
                CostPerUnit = _model.CostPerUnit
            };

            if (_isEditing)
            {
                await ApiClient.UpdateMaterialAsync(_editingId, req);
            }
            else
            {
                await ApiClient.CreateMaterialAsync(req);
            }

            _showModal = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Có lỗi xảy ra: {ex.Message}";
            Console.WriteLine(ex);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ConfirmDelete(MaterialDto item)
    {
        try
        {
            await ApiClient.DeleteMaterialAsync(item.Id);
            await LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }
    }

    public class MaterialFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string? NameEn { get; set; }
        public int UnitOfMeasureId { get; set; } = 1;
        public decimal MinStockLevel { get; set; } = 10m;
        public decimal CostPerUnit { get; set; } = 50000m;
    }
}

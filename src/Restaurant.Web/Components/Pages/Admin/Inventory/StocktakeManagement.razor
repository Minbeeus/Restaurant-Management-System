@page "/admin/stocktakes"
@rendermode InteractiveServer
@layout Restaurant.Web.Components.Layout.AdminLayout
@using Restaurant.Application.DTOs
@using Restaurant.Web.Services
@inject AdminApiClient ApiClient

<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
    <div>
        <h2 class="text-2xl font-headline-sm text-primary m-0">@L["Stocktake_Management_Title"]</h2>
        <p class="text-on-surface-variant text-sm mt-1">@L["Stocktake_Sub"]</p>
    </div>
    <button class="bg-primary text-on-primary px-4 py-2 rounded font-label-bold shadow-sm hover:bg-primary/90 transition-colors flex items-center" @onclick="OpenStartAuditModal">
        <span class="material-symbols-outlined align-middle text-sm mr-1" data-icon="fact_check">fact_check</span> @L["Stocktake_Start"]
    </button>
</div>

<!-- Lịch sử Đợt kiểm kê -->
<div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden">
    <div class="p-4 border-b border-outline-variant/30 flex justify-between items-center bg-surface-container-low">
        <h3 class="font-bold text-on-surface text-base m-0">@L["Stocktake_History_Title"]</h3>
        <span class="text-xs text-on-surface-variant">Tháng 09/2026</span>
    </div>

    <table class="w-full text-left border-collapse">
        <thead class="bg-surface-container-low text-xs font-bold text-on-surface-variant uppercase">
            <tr>
                <th class="p-4">@L["Stocktake_Col_Code"]</th>
                <th class="p-4">@L["Stocktake_Col_Staff"]</th>
                <th class="p-4 text-center">@L["Stocktake_Col_Time"]</th>
                <th class="p-4 text-right">@L["Stocktake_Col_TotalCount"]</th>
                <th class="p-4 text-right">@L["Stocktake_Col_Variance"]</th>
                <th class="p-4 text-center">@L["Stocktake_Col_Status"]</th>
            </tr>
        </thead>
        <tbody>
            <tr class="border-b border-outline-variant/20 hover:bg-surface-low">
                <td class="p-4 font-mono font-bold text-primary">AUDIT-20260915</td>
                <td class="p-4 font-bold text-on-surface">Thủ kho Nguyễn Văn Nam</td>
                <td class="p-4 text-center text-sm text-on-surface-variant">15/09/2026 17:00</td>
                <td class="p-4 text-right font-mono font-bold">12 nguyên liệu</td>
                <td class="p-4 text-right font-mono font-bold text-error">- 2.400.000đ</td>
                <td class="p-4 text-center">
                    <span class="px-2.5 py-1 bg-success-green/10 text-success-green rounded-full text-xs font-bold border border-success-green/20">@L["Stocktake_Status_Done"]</span>
                </td>
            </tr>
        </tbody>
    </table>
</div>

<!-- Modal Start Audit -->
@if (_showModal)
{
    <div class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 backdrop-blur-sm">
        <div class="bg-surface-container-lowest rounded-xl shadow-lg w-full max-w-3xl max-h-[90vh] flex flex-col overflow-hidden">
            <div class="px-6 py-4 border-b border-outline-variant/30 flex justify-between items-center bg-surface-container-low shrink-0">
                <h3 class="font-bold text-on-background m-0">@L["Stocktake_Modal_Title"]</h3>
                <button class="text-on-surface-variant hover:text-error" @onclick="CloseModal">
                    <span class="material-symbols-outlined" data-icon="close">close</span>
                </button>
            </div>

            <div class="p-6 overflow-y-auto flex-1 space-y-4">
                <div class="bg-primary-container/10 p-3 rounded-lg border border-primary/20 text-xs text-on-background">
                    💡 @L["Stocktake_Guide"]
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead class="bg-surface-container-low text-xs font-bold text-on-surface-variant uppercase">
                            <tr>
                                <th class="p-3">@L["Material_Col_Name"]</th>
                                <th class="p-3 text-right">@L["Stocktake_Col_SystemStock"]</th>
                                <th class="p-3 text-right">@L["Stocktake_Col_ActualStock"]</th>
                                <th class="p-3 text-right">@L["Stocktake_Col_Diff"]</th>
                                <th class="p-3">@L["Stocktake_Col_Reason"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _auditRows)
                            {
                                var diff = row.ActualStock - row.SystemStock;
                                <tr class="border-b border-outline-variant/20 hover:bg-surface-low">
                                    <td class="p-3 font-bold text-on-surface text-sm">@row.MaterialName (@row.UnitName)</td>
                                    <td class="p-3 text-right font-mono font-bold text-on-surface-variant">@row.SystemStock</td>
                                    <td class="p-3 text-right">
                                        <input type="number" step="0.1" @bind="row.ActualStock" class="w-24 px-2 py-1 text-sm border border-outline rounded bg-surface font-mono text-right" />
                                    </td>
                                    <td class="p-3 text-right font-mono font-bold text-sm @(diff < 0 ? "text-error" : (diff > 0 ? "text-success-green" : "text-on-surface-variant"))">
                                        @(diff > 0 ? "+" : "")@diff
                                    </td>
                                    <td class="p-3">
                                        <input type="text" @bind="row.Reason" placeholder="Vỡ / Hao hụt tự nhiên..." class="w-full px-2 py-1 text-xs border border-outline rounded bg-surface" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="px-6 py-4 border-t border-outline-variant/30 flex justify-end gap-3 bg-surface-container-low shrink-0">
                <button class="px-4 py-2 text-on-surface-variant hover:bg-surface-low rounded text-sm font-bold" @onclick="CloseModal">@L["Common_Cancel"]</button>
                <button class="px-4 py-2 bg-primary text-on-primary rounded text-sm font-bold shadow-sm hover:bg-primary/90 flex items-center" disabled="@_isSaving" @onclick="SubmitAudit">
                    @if (_isSaving)
                    {
                        <span class="material-symbols-outlined animate-spin text-sm mr-2" data-icon="progress_activity">progress_activity</span>
                        <span>@L["Common_Saving"]</span>
                    }
                    else
                    {
                        <span>@L["Stocktake_Submit_Btn"]</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<MaterialDto> _materials = new();
    private bool _showModal = false;
    private bool _isSaving = false;

    private List<AuditRow> _auditRows = new();

    protected override async Task OnInitializedAsync()
    {
        _materials = await ApiClient.GetMaterialsAsync();
    }

    private void OpenStartAuditModal()
    {
        _auditRows = _materials.Select(m => new AuditRow
        {
            MaterialId = m.Id,
            MaterialName = m.Name,
            UnitName = m.UnitName,
            SystemStock = m.CurrentStock,
            ActualStock = m.CurrentStock
        }).ToList();

        _showModal = true;
    }

    private void CloseModal() => _showModal = false;

    private async Task SubmitAudit()
    {
        _isSaving = true;
        try
        {
            var req = new StockAuditRequest
            {
                Note = "Kiểm kê định kỳ",
                Items = _auditRows.Select(r => new StockAuditItemRequest
                {
                    MaterialId = r.MaterialId,
                    ActualStock = r.ActualStock,
                    Reason = r.Reason
                }).ToList()
            };

            await ApiClient.ConductStockAuditAsync(req);
            _showModal = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            // Optionally could add error message display here if UI is updated to support it
        }
        finally
        {
            _isSaving = false;
        }
    }

    public class AuditRow
    {
        public int MaterialId { get; set; }
        public string MaterialName { get; set; } = string.Empty;
        public string UnitName { get; set; } = string.Empty;
        public decimal SystemStock { get; set; }
        public decimal ActualStock { get; set; }
        public string? Reason { get; set; }
    }
}

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public RenderFragment? HeaderExtra { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? BodyClass { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private bool HasHeader => !string.IsNullOrEmpty(Title) || HeaderExtra != null || !string.IsNullOrEmpty(Subtitle);
}

<div class="bg-surface rounded-2xl border border-outline-variant/40 shadow-xs transition-all duration-200 overflow-hidden flex flex-col @(OnClick.HasDelegate ? "cursor-pointer hover:border-primary/40 hover:shadow-sm" : "") @Class"
     @onclick="OnClick">
    @if (HasHeader)
    {
        <div class="px-5 py-4 border-b border-outline-variant/20 flex items-center justify-between gap-3 bg-surface-container/20">
            <div class="flex items-center gap-2.5 min-w-0">
                @if (!string.IsNullOrEmpty(Icon))
                {
                    <span class="material-symbols-outlined text-primary text-2xl shrink-0" data-icon="@Icon">@Icon</span>
                }
                <div class="min-w-0">
                    @if (!string.IsNullOrEmpty(Title))
                    {
                        <h3 class="text-base font-bold font-heading text-on-surface m-0 truncate">@Title</h3>
                    }
                    @if (!string.IsNullOrEmpty(Subtitle))
                    {
                        <p class="text-xs text-on-surface-variant m-0 mt-0.5 truncate">@Subtitle</p>
                    }
                </div>
            </div>
            @if (HeaderExtra != null)
            {
                <div class="shrink-0 flex items-center gap-2">@HeaderExtra</div>
            }
        </div>
    }
    <div class="p-5 md:p-6 flex-1 @BodyClass">
        @ChildContent
    </div>
    @if (Footer != null)
    {
        <div class="px-5 py-3.5 border-t border-outline-variant/20 bg-surface-container/10 flex items-center justify-between">
            @Footer
        </div>
    }
</div>

@code {
    [Parameter] public string TableName { get; set; } = "Table";
    [Parameter] public int Capacity { get; set; }
    [Parameter] public string Status { get; set; } = "Available"; // Available, Occupied, NewOrder, Billing
    [Parameter] public decimal TotalAmount { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    
    private string BorderAndBgClass => Status.ToLower() switch
    {
        "available" or "trống" => "border-emerald-500/40 bg-emerald-500/5 hover:border-emerald-500",
        "occupied" or "có khách" => "border-red-500/40 bg-red-500/5 hover:border-red-500",
        "neworder" or "đơn mới" => "border-amber-500/60 bg-amber-500/10 hover:border-amber-500 animate-pulse",
        "billing" or "đang tính tiền" or "chờ thanh toán" => "border-sky-500/50 bg-sky-500/5 hover:border-sky-500",
        _ => "border-outline-variant/60 bg-surface hover:border-primary/50"
    };
    
    private string BadgeType => Status.ToLower() switch
    {
        "available" or "trống" => "Success",
        "occupied" or "có khách" => "Danger",
        "neworder" or "đơn mới" => "Warning",
        "billing" or "đang tính tiền" or "chờ thanh toán" => "Info",
        _ => "Neutral"
    };

    private string LocalizedStatusName => Status.ToLower() switch
    {
        "available" => "Bàn Trống",
        "occupied" => "Có Khách",
        "neworder" => "Đơn Mới",
        "billing" => "Chờ Thanh Toán",
        _ => Status
    };
}

<div class="rounded-2xl shadow-2xs border-2 p-4 md:p-5 cursor-pointer hover:shadow-md transition-all active:scale-95 flex flex-col items-center justify-between min-h-[160px] select-none @BorderAndBgClass"
     @onclick="OnClick">
    <div class="w-full text-center">
        <h4 class="font-black text-xl md:text-2xl text-on-surface mb-1 tracking-tight font-heading">@TableName</h4>
        
        <div class="flex items-center justify-center gap-1 text-on-surface-variant text-xs font-semibold mb-2">
            <span class="material-symbols-outlined text-[16px]">group</span>
            <span>@Capacity chỗ</span>
        </div>
    </div>
    
    <div class="my-1">
        <Restaurant.Web.Components.UI.Badges.StatusBadge Type="@BadgeType" Text="@LocalizedStatusName" ShowDot="true" />
    </div>
    
    @if (TotalAmount > 0)
    {
        <div class="mt-2.5 font-mono font-black text-primary text-sm md:text-base bg-primary/10 px-3 py-1 rounded-xl border border-primary/20 shadow-2xs">
            @TotalAmount.ToString("N0") đ
        </div>
    }
    else
    {
        <div class="mt-2.5 text-xs text-transparent select-none">
            -
        </div>
    }
</div>

@code {
    [Parameter] public string OrderId { get; set; } = "";
    [Parameter] public string TableName { get; set; } = "";
    [Parameter] public DateTime CreatedAt { get; set; }
    [Parameter] public RenderFragment? ItemsList { get; set; }
    [Parameter] public EventCallback OnComplete { get; set; }
}

<div class="flex flex-col bg-surface-container dark:bg-inverse-surface rounded-xl border border-outline-variant dark:border-outline shadow-sm min-w-[320px] h-full overflow-hidden">
    <!-- Header -->
    <div class="flex justify-between items-center p-4 border-b border-outline-variant dark:border-outline bg-surface-low dark:bg-background">
        <div>
            <span class="font-headline-sm text-headline-sm font-bold text-on-surface dark:text-on-background">@TableName</span>
            <span class="ml-2 text-on-surface-variant dark:text-outline text-sm">#@OrderId</span>
        </div>
        <Restaurant.Web.Components.UI.Badges.StatusBadge Type="Warning" Text="15m" />
    </div>
    
    <!-- Body -->
    <div class="flex-1 overflow-y-auto custom-scrollbar bg-surface dark:bg-[#1a212d]">
        @ItemsList
    </div>
    
    <!-- Footer -->
    <div class="p-4 border-t border-outline-variant dark:border-outline bg-surface-low dark:bg-background text-center">
        <button class="w-full bg-primary text-on-primary font-label-bold text-label-bold py-3 rounded-lg hover:bg-primary-container active:scale-95 transition-all flex items-center justify-center gap-2" @onclick="OnComplete">
            <span class="material-symbols-outlined" data-icon="check_circle">check_circle</span>
            Hoàn thành
        </button>
    </div>
</div>

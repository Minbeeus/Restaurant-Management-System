@code {
    [Parameter] public string OrderId { get; set; } = "";
    [Parameter] public string TableName { get; set; } = "";
    [Parameter] public DateTime CreatedAt { get; set; }
    [Parameter] public RenderFragment? ItemsList { get; set; }
    [Parameter] public EventCallback OnComplete { get; set; }

    private double WaitingMinutes => Math.Max(0, (DateTime.UtcNow - CreatedAt).TotalMinutes);
    private string ElapsedTimeText => WaitingMinutes < 1 ? "< 1m" : $"{(int)WaitingMinutes}m";
    private string BadgeType => WaitingMinutes >= 15 ? "Danger" : (WaitingMinutes >= 8 ? "Warning" : "Success");
}

<div class="flex flex-col bg-slate-800 rounded-xl border border-slate-700 shadow-sm min-w-[320px] h-full overflow-hidden">
    <!-- Header -->
    <div class="flex justify-between items-center p-4 border-b border-slate-700 bg-slate-900">
        <div>
            <span class="font-headline-sm text-headline-sm font-bold text-slate-100">@TableName</span>
            <span class="ml-2 text-slate-400 text-sm">#@OrderId</span>
        </div>
        <Restaurant.Web.Components.UI.Badges.StatusBadge Type="@BadgeType" Text="@ElapsedTimeText" />
    </div>
    
    <!-- Body -->
    <div class="flex-1 overflow-y-auto custom-scrollbar bg-slate-800">
        @ItemsList
    </div>
    
    <!-- Footer -->
    <div class="p-4 border-t border-slate-700 bg-slate-900 text-center">
        <button class="w-full bg-emerald-600 text-white font-label-bold text-label-bold py-3 rounded-lg hover:bg-emerald-500 active:scale-95 transition-all flex items-center justify-center gap-2" @onclick="OnComplete">
            <span class="material-symbols-outlined" data-icon="check_circle">check_circle</span>
            Hoàn thành cả vé
        </button>
    </div>
</div>

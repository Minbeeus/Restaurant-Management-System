@code {
    [Parameter] public string OrderId { get; set; } = "";
    [Parameter] public string TableName { get; set; } = "";
    [Parameter] public DateTime CreatedAt { get; set; }
    [Parameter] public RenderFragment? ItemsList { get; set; }
    [Parameter] public EventCallback OnComplete { get; set; }
    [Parameter] public bool ShowCompleteButton { get; set; } = true;

    private double WaitingMinutes => Math.Max(0, (DateTime.UtcNow - CreatedAt).TotalMinutes);
    private string ElapsedTimeText => WaitingMinutes < 1 ? "< 1m" : $"{(int)WaitingMinutes}m";
    private string BadgeType => WaitingMinutes >= 15 ? "Danger" : (WaitingMinutes >= 8 ? "Warning" : "Success");
    
    private string BorderClass => WaitingMinutes >= 15 
        ? "border-red-500 shadow-[0_0_15px_rgba(239,68,68,0.3)] animate-pulse-red" 
        : (WaitingMinutes >= 8 ? "border-amber-500/80" : "border-slate-700");
}

<div class="flex flex-col bg-slate-800 rounded-2xl border-2 shadow-sm min-w-[320px] max-w-[360px] h-full overflow-hidden transition-all duration-200 select-none @BorderClass">
    <!-- Header -->
    <div class="flex justify-between items-center p-4 border-b border-slate-700 bg-slate-900/90 shrink-0">
        <div class="flex items-center gap-2">
            <span class="font-heading font-black text-lg text-slate-100">@TableName</span>
            <span class="text-slate-400 text-xs font-mono">#@OrderId</span>
        </div>
        <Restaurant.Web.Components.UI.Badges.StatusBadge Type="@BadgeType" Text="@ElapsedTimeText" ShowDot="true" />
    </div>
    
    <!-- Body -->
    <div class="flex-1 overflow-y-auto custom-scrollbar bg-slate-800 p-2">
        @ItemsList
    </div>
    
    <!-- Footer -->
    <div class="p-3 border-t border-slate-700 bg-slate-900/90 text-center shrink-0">
        @if (ShowCompleteButton)
        {
            <button class="w-full bg-emerald-600 hover:bg-emerald-500 active:scale-95 text-white font-bold text-sm py-2 px-4 rounded-xl shadow-xs transition-all flex items-center justify-center gap-2 cursor-pointer" 
                    @onclick="OnComplete">
                <span class="material-symbols-outlined text-lg" data-icon="check_circle">check_circle</span>
                <span>Hoàn thành cả vé</span>
            </button>
        }
        else
        {
            <div class="w-full bg-emerald-950/60 border border-emerald-800 text-emerald-400 font-bold text-xs py-2 px-4 rounded-xl flex items-center justify-center gap-1.5">
                <span class="material-symbols-outlined text-base">task_alt</span>
                <span>Đã hoàn thành toàn bộ vé</span>
            </div>
        }
    </div>
</div>

@using System.Timers
@implements IDisposable

@code {
    [Parameter] public DateTime StartTime { get; set; }
    [Parameter] public int WarningMinutes { get; set; } = 15;
    [Parameter] public string? Class { get; set; }

    private Timer? _timer;
    private TimeSpan _elapsed;
    private bool _isWarning;
    private bool _isApproaching;

    protected override void OnInitialized()
    {
        UpdateTimer();
        _timer = new Timer(5000); // refresh every 5s
        _timer.Elapsed += (s, e) => { UpdateTimer(); InvokeAsync(StateHasChanged); };
        _timer.Start();
    }

    private void UpdateTimer()
    {
        _elapsed = DateTime.UtcNow - StartTime;
        _isWarning = _elapsed.TotalMinutes >= WarningMinutes;
        _isApproaching = !_isWarning && _elapsed.TotalMinutes >= (WarningMinutes - 5);
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}

<span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold font-mono border select-none transition-all
             @(_isWarning ? "bg-red-500/20 text-red-400 border-red-500/50 animate-pulse-red" : 
               (_isApproaching ? "bg-amber-500/20 text-amber-400 border-amber-500/40 animate-pulse-amber" : 
               "bg-slate-700/80 text-slate-200 border-slate-600")) @Class"
      title="Thời gian chờ chế biến">
    <span class="material-symbols-outlined text-[14px] mr-1">schedule</span>
    <span>@((int)_elapsed.TotalMinutes)m</span>
</span>

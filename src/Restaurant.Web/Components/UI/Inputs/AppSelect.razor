@typeparam TValue

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    [Parameter] public string ErrorMessage { get; set; } = "";
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public bool IsDisabled { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task OnChange(ChangeEventArgs e)
    {
        if (e.Value is string stringValue)
        {
            try 
            {
                var convertedValue = (TValue)Convert.ChangeType(stringValue, typeof(TValue));
                await ValueChanged.InvokeAsync(convertedValue);
            }
            catch 
            {
                await ValueChanged.InvokeAsync(default);
            }
        }
    }
}

<div class="mb-4 @Class">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-1.5 font-body">
            @Label
            @if (Required)
            {
                <span class="text-red-500 ml-0.5">*</span>
            }
        </label>
    }
    <select class="w-full px-3.5 py-2.5 rounded-xl border bg-surface text-on-surface text-sm font-body font-semibold transition-all focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary cursor-pointer disabled:opacity-50 disabled:bg-surface-low @(!string.IsNullOrEmpty(ErrorMessage) ? "border-red-500 focus:ring-red-300 focus:border-red-500" : "border-outline-variant/50 hover:border-outline")" 
            value="@Value" 
            @onchange="OnChange"
            disabled="@IsDisabled">
        @ChildContent
    </select>
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="text-xs text-red-600 font-semibold mt-1 flex items-center gap-1 font-body">
            <span class="material-symbols-outlined text-[14px]">error</span>
            <span>@ErrorMessage</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(HelperText))
    {
        <div class="text-xs text-on-surface-variant/70 mt-1 font-body">@HelperText</div>
    }
</div>

@using Microsoft.AspNetCore.Components.Web

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    
    <!-- Material Symbols Outlined -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <!-- Google Fonts: Montserrat & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Montserrat:wght@600;700&display=swap" rel="stylesheet" />
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
          darkMode: "class",
          theme: {
            extend: {
              "colors": {
                      "primary": "#059669",
                      "primary-hover": "#047857",
                      "primary-container": "#10b981",
                      "primary-light": "#ecfdf5",
                      "on-primary": "#ffffff",
                      "on-primary-container": "#ffffff",
                      "on-primary-fixed": "#064e3b",
                      "primary-fixed": "#d1fae5",
                      "primary-fixed-dim": "#a7f3d0",

                      "secondary": "#0284c7",
                      "secondary-container": "#e0f2fe",
                      "on-secondary": "#ffffff",
                      "on-secondary-container": "#0369a1",
                      "secondary-fixed": "#e0f2fe",
                      "secondary-fixed-dim": "#bae6fd",

                      "tertiary": "#e11d48",
                      "tertiary-container": "#ffe4e6",
                      "on-tertiary": "#ffffff",
                      "on-tertiary-container": "#9f1239",
                      "tertiary-fixed": "#ffe4e6",
                      "tertiary-fixed-dim": "#fecdd3",

                      "error": "#e11d48",
                      "error-container": "#ffe4e6",
                      "on-error": "#ffffff",
                      "on-error-container": "#9f1239",

                      "background": "#f8fafc",
                      "on-background": "#0f172a",

                      "surface": "#ffffff",
                      "surface-bright": "#ffffff",
                      "on-surface": "#0f172a",
                      "on-surface-variant": "#64748b",

                      "surface-low": "#f8fafc",
                      "surface-mid": "#f1f5f9",
                      "surface-high": "#e2e8f0",
                      "surface-highest": "#cbd5e1",
                      "surface-dim": "#f1f5f9",

                      "surface-container-lowest": "#ffffff",
                      "surface-container-low": "#f8fafc",
                      "surface-container": "#f1f5f9",
                      "surface-container-high": "#e2e8f0",
                      "surface-container-highest": "#cbd5e1",
                      "surface-variant": "#f1f5f9",

                      "outline": "#94a3b8",
                      "outline-variant": "#e2e8f0",

                      "success-bg": "#ecfdf5",
                      "success-green": "#059669",
                      "warning-bg": "#fffbeb",
                      "warning-amber": "#d97706"
              },
              "borderRadius": {
                      "sm": "0.25rem",
                      "md": "0.375rem",
                      "lg": "0.5rem",
                      "xl": "0.75rem",
                      "2xl": "1rem",
                      "3xl": "1.5rem",
                      "full": "9999px"
              },
              "spacing": {
                      "margin-page": "32px",
                      "container-gap": "24px",
                      "touch-target-min": "44px",
                      "gutter-sm": "12px",
                      "sidebar-width": "260px",
                      "margin-mobile": "16px"
              },
              "fontFamily": {
                      "label-caps": [
                              "Inter"
                      ],
                      "headline-md": [
                              "Montserrat"
                      ],
                      "body-md": [
                              "Inter"
                      ],
                      "label-bold": [
                              "Inter"
                      ],
                      "display-lg": [
                              "Montserrat"
                      ],
                      "headline-sm": [
                              "Montserrat"
                      ],
                      "display-lg-mobile": [
                              "Montserrat"
                      ],
                      "body-lg": [
                              "Inter"
                      ]
              },
              "fontSize": {
                      "label-caps": [
                              "11px",
                              {
                                      "lineHeight": "16px",
                                      "letterSpacing": "0.08em",
                                      "fontWeight": "700"
                              }
                      ],
                      "headline-md": [
                              "24px",
                              {
                                      "lineHeight": "32px",
                                      "fontWeight": "600"
                              }
                      ],
                      "body-md": [
                              "14px",
                              {
                                      "lineHeight": "20px",
                                      "fontWeight": "400"
                              }
                      ],
                      "label-bold": [
                              "12px",
                              {
                                      "lineHeight": "16px",
                                      "letterSpacing": "0.05em",
                                      "fontWeight": "600"
                              }
                      ],
                      "display-lg": [
                              "32px",
                              {
                                      "lineHeight": "40px",
                                      "fontWeight": "700"
                              }
                      ],
                      "headline-sm": [
                              "20px",
                              {
                                      "lineHeight": "28px",
                                      "fontWeight": "600"
                              }
                      ],
                      "display-lg-mobile": [
                              "24px",
                              {
                                      "lineHeight": "32px",
                                      "fontWeight": "700"
                              }
                      ],
                      "body-lg": [
                              "16px",
                              {
                                      "lineHeight": "24px",
                                      "fontWeight": "400"
                              }
                      ]
              }
            }
          }
        }
    </script>
    
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Restaurant.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="js/chart-widgets.js"></script>
    <script src="js/floorplan.js"></script>
</body>

</html>
